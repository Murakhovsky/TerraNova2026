{
  "name": "estatebook/cos-symfony",
  "description": "Canonical Symfony 7.4 server-first runtime for COS Experience Platform",
  "type": "project",
  "license": "proprietary",
  "require": {
    "doctrine/doctrine-bundle": "^2.19",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^3.7",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "php": ">=8.3",
    "symfony/asset": "7.4.*",
    "symfony/asset-mapper": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/flex": "^2.6",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/redis-messenger": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/scheduler": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/stimulus-bundle": "^2.36.0",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/ux-autocomplete": "^2.36.0",
    "symfony/ux-chartjs": "^2.36.0",
    "symfony/ux-dropzone": "^2.36.0",
    "symfony/ux-icons": "^2.36.0",
    "symfony/ux-live-component": "^2.36.0",
    "symfony/ux-map": "^2.36.0",
    "symfony/ux-toolkit": "^2.36.0",
    "symfony/ux-translator": "^2.36.0",
    "symfony/ux-turbo": "^2.36.0",
    "symfony/ux-twig-component": "^2.36.0",
    "symfony/validator": "7.4.*",
    "symfony/workflow": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/twig": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Kernel\\": "../app/Kernel/",
      "Platform\\": "../app/Platform/",
      "Domains\\": "../app/Domains/",
      "Infrastructure\\": "../app/Infrastructure/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "extra": {
    "runtime": {
      "disable_dotenv": true
    },
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  }
}
