{
  "id": "/admin",
  "name": "COS — Company Operating System",
  "short_name": "COS",
  "description": "Company Operating System",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f5f6f8",
  "theme_color": "#17191d",
  "lang": "uk",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/cos-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/cos-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/cos-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
