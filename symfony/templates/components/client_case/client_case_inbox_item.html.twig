<article class="cos-card cos-pattern-stack" role="listitem" data-client-case-inbox-item>
    <div class="cos-card__header">
        <div>
            <p class="cos-card__eyebrow">{{ item.intentLabel }} / #{{ item.id }}</p>
            <h2 class="cos-card__title">{{ item.name }}</h2>
            <p class="cos-card__copy">{{ item.contact }} · {{ item.createdAt }}</p>
        </div>
        <twig:CosStatus label="{{ item.statusLabel }}" tone="{{ item.statusTone }}" />
    </div>

    <div class="cos-section-grid">
        <div class="cos-pattern-stack">
            <p class="cos-card__copy">
                <strong>Об’єкт:</strong>
                {% if item.propertyHref %}
                    <a href="{{ item.propertyHref }}">{{ item.propertyLabel }}</a>
                {% else %}
                    {{ item.propertyLabel }}
                {% endif %}
            </p>
            <p class="cos-card__copy">
                <strong>Кейс:</strong>
                {% if item.caseHref %}
                    <a href="{{ item.caseHref }}">{{ item.caseLabel }}</a>
                {% else %}
                    {{ item.caseLabel }}
                {% endif %}
            </p>
            <p class="cos-card__copy"><strong>Менеджер:</strong> {{ item.manager }}</p>
            <p class="cos-card__copy"><strong>Наступний контакт:</strong> {{ item.nextContact }}</p>
            <p class="cos-card__copy"><strong>Дій:</strong> {{ item.activityCount }}</p>

            {% if item.message %}
                <p class="cos-card__copy">{{ item.message }}</p>
            {% endif %}
            {% if item.managerNote %}
                <p class="cos-card__copy"><strong>Нотатка:</strong> {{ item.managerNote }}</p>
            {% endif %}
        </div>

        <form class="cos-card cos-pattern-stack" action="/client-case/updateInboundRequest/{{ item.id }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <input type="hidden" name="return_url" value="{{ returnUrl }}">

            <div class="cos-section-grid">
                <label class="cos-field">
                    <span>Статус</span>
                    <select class="cos-select" name="status">
                        {% for code, label in statusOptions %}
                            <option value="{{ code }}" {% if item.status == code %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>

                <label class="cos-field">
                    <span>Відповідальний</span>
                    <select class="cos-select" name="assigned_user_id">
                        <option value="0">Не призначено</option>
                        {% for manager in managerOptions %}
                            <option value="{{ manager.id }}" {% if item.assignedUserId == manager.id %}selected{% endif %}>{{ manager.label }}</option>
                        {% endfor %}
                    </select>
                </label>

                <label class="cos-field">
                    <span>Наступний контакт</span>
                    <input class="cos-input" name="next_contact_at" type="datetime-local" value="{{ item.nextContactInput }}">
                </label>

                <label class="cos-field">
                    <span>Дія</span>
                    <select class="cos-select" name="activity_type">
                        {% for code, label in activityOptions %}
                            <option value="{{ code }}">{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>

            <label class="cos-field">
                <span>Нотатка менеджера</span>
                <textarea class="cos-textarea" name="manager_note" rows="3">{{ item.managerNote }}</textarea>
            </label>

            <label class="cos-field">
                <span>Коментар до дії</span>
                <input class="cos-input" name="activity_body" type="text" maxlength="500" placeholder="Що зроблено або що потрібно зробити далі">
            </label>

            <twig:CosActionBar label="Оновлення заявки" align="start">
                <button class="cos-button cos-button--primary" type="submit">Оновити заявку</button>
            </twig:CosActionBar>
        </form>
    </div>

    <twig:CosActionBar label="Дії з кейсом" align="start">
        {% if item.caseId == 0 %}
            <form class="cos-action-bar cos-action-bar--start" action="/client-case/createFromInboundRequest/{{ item.id }}" method="post">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <input type="hidden" name="return_url" value="{{ returnUrl }}">
                <label class="cos-field">
                    <span class="visually-hidden">Відповідальний</span>
                    <select class="cos-select" name="assigned_user_id" aria-label="Відповідальний">
                        <option value="0">Поточний менеджер</option>
                        {% for manager in managerOptions %}
                            <option value="{{ manager.id }}">{{ manager.label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="cos-field">
                    <span class="visually-hidden">Пріоритет</span>
                    <select class="cos-select" name="priority" aria-label="Пріоритет">
                        {% for code, label in priorityOptions %}
                            <option value="{{ code }}">{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <button class="cos-button cos-button--primary" type="submit">Створити кейс</button>
            </form>

            {% if openCaseOptions is not empty %}
                <form class="cos-action-bar cos-action-bar--start" action="/client-case/linkInboundRequest" method="post">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="hidden" name="return_url" value="{{ returnUrl }}">
                    <input type="hidden" name="request_id" value="{{ item.id }}">
                    <label class="cos-field">
                        <span class="visually-hidden">Кейс</span>
                        <select class="cos-select" name="case_id" aria-label="Кейс">
                            {% for option in openCaseOptions %}
                                <option value="{{ option.id }}">{{ option.label }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <button class="cos-button cos-button--ghost" type="submit">Приєднати</button>
                </form>
            {% endif %}
        {% else %}
            <twig:CosButton label="Відкрити кейс" href="{{ item.caseHref }}" variant="ghost" />
        {% endif %}
    </twig:CosActionBar>
</article>
