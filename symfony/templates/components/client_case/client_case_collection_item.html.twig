<article class="cos-card cos-pattern-stack" role="listitem" data-client-case-collection-item>
    <div class="cos-card__header">
        <div>
            <p class="cos-card__eyebrow">{{ item.publicId }} · {{ item.typeLabel }} · {{ item.priorityLabel }}</p>
            <h2 class="cos-card__title"><a href="{{ item.href }}">{{ item.title }}</a></h2>
            <p class="cos-card__copy">{{ item.person }} · {{ item.contact }}</p>
        </div>
        <twig:CosStatus label="{{ item.stageLabel }}" tone="{{ item.stageTone }}" />
    </div>

    <div class="cos-section-grid">
        <div><small>Бюджет</small><strong>{{ item.budget }}</strong></div>
        <div><small>Менеджер</small><strong>{{ item.manager }}</strong></div>
        <div><small>Звʼязки</small><strong>{{ item.relations }}</strong></div>
        <div><small>Наступний контакт</small><strong>{{ item.nextContact }}</strong><small>{{ item.activityCount }} дій</small></div>
    </div>

    {% if item.propertyContext %}<p class="cos-card__copy">{{ item.propertyContext }}</p>{% endif %}

    <form class="cos-section-grid" action="/client-case/quickUpdate/{{ item.id }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <input type="hidden" name="return_url" value="client-case">
        <label class="cos-field"><span>Етап</span><select class="cos-select" name="stage_id">
            {% for option in stageOptions %}<option value="{{ option.id }}" {% if item.stageId == option.id %}selected{% endif %}>{{ option.label }}</option>{% endfor %}
        </select></label>
        <label class="cos-field"><span>Статус</span><select class="cos-select" name="status">
            {% for code,label in statusOptions %}<option value="{{ code }}" {% if item.status == code %}selected{% endif %}>{{ label }}</option>{% endfor %}
        </select></label>
        <label class="cos-field"><span>Пріоритет</span><select class="cos-select" name="priority">
            {% for code,label in priorityOptions %}<option value="{{ code }}" {% if item.priority == code %}selected{% endif %}>{{ label }}</option>{% endfor %}
        </select></label>
        <label class="cos-field"><span>Відповідальний</span><select class="cos-select" name="assigned_user_id">
            <option value="0">Без менеджера</option>
            {% for manager in managerOptions %}<option value="{{ manager.id }}" {% if item.assignedUserId == manager.id %}selected{% endif %}>{{ manager.label }}</option>{% endfor %}
        </select></label>
        <twig:CosActionBar label="Швидке оновлення" align="start">
            <button class="cos-button cos-button--primary cos-button--sm" type="submit">ОК</button>
            <twig:CosButton label="Відкрити" href="{{ item.href }}" variant="ghost" size="sm" />
        </twig:CosActionBar>
    </form>
</article>
