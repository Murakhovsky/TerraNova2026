<div
    id="{{ id }}"
    class="{{ this.cssClass() }}"
    data-controller="dropdown"
    data-action="keydown.esc@window->dropdown#escape click@window->dropdown#outside"
>
    <button
        id="{{ id }}-trigger"
        class="cos-button cos-dropdown__trigger"
        type="button"
        aria-haspopup="menu"
        aria-expanded="false"
        data-dropdown-target="trigger"
        data-action="click->dropdown#toggle"
    >{{ label }}</button>

    <div
        class="cos-dropdown__menu"
        role="menu"
        aria-labelledby="{{ id }}-trigger"
        hidden
        data-dropdown-target="menu"
        data-action="keydown->dropdown#keydown"
    >{% block content %}{% endblock %}</div>
</div>
