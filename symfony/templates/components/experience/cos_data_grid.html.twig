<section
    id="{{ id }}"
    class="cos-data-grid"
    aria-label="{{ label }}"
    data-controller="data-grid"
    data-selection-count="0"
>
    {% if state.value == 'permission_denied' %}
        <twig:CosOutcomeState state="permission_denied" />
    {% else %}
    <form class="cos-data-grid__toolbar" method="get" action="{{ baseUrl }}">
        {% for key, value in this.fixedQueryParameters() %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
        <label class="cos-data-grid__search">
            <span class="cos-field__label">{{ 'grid.search'|trans({}, 'cuw_quality') }}</span>
            <input
                class="cos-input"
                type="search"
                name="q"
                value="{{ query.search }}"
                autocomplete="off"
                placeholder="{{ 'grid.placeholder'|trans({}, 'cuw_quality') }}"
            >
        </label>

        <div class="cos-data-grid__filters">
            {% for filter in filters %}
                <label class="cos-data-grid__filter">
                    <span class="cos-data-grid__filter-label">{{ filter.label }}</span>
                    {% if filter.type == 'text' %}
                        <input
                            class="cos-input"
                            type="text"
                            name="filter[{{ filter.key }}]"
                            value="{{ filter.value ?? '' }}"
                            placeholder="{{ filter.placeholder ?? '' }}"
                        >
                    {% else %}
                        <select class="cos-select" name="filter[{{ filter.key }}]">
                            {% for optionValue, optionLabel in filter.options %}
                                <option value="{{ optionValue }}" {% if filter.value == optionValue %}selected{% endif %}>{{ optionLabel }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </label>
            {% endfor %}
        </div>

        {% if query.sort %}
            <input type="hidden" name="sort" value="{{ query.sort }}">
            <input type="hidden" name="dir" value="{{ query.direction }}">
        {% endif %}
        {% if query.perPage != 25 %}
            <input type="hidden" name="per_page" value="{{ query.perPage }}">
        {% endif %}
        {% if query.view %}
            <input type="hidden" name="view" value="{{ query.view }}">
        {% endif %}
        {% for column in query.visibleColumns %}
            <input type="hidden" name="columns[]" value="{{ column }}">
        {% endfor %}

        <button class="cos-button cos-button--primary" type="submit">{{ 'grid.apply'|trans({}, 'cuw_quality') }}</button>

        {% if this.exportLink() %}
            <a class="cos-button cos-button--ghost" href="{{ this.exportLink() }}">{{ 'grid.export'|trans({}, 'cuw_quality') }}</a>
        {% endif %}

        <details class="cos-data-grid__columns">
            <summary class="cos-button cos-button--ghost">{{ 'grid.columns'|trans({}, 'cuw_quality') }}</summary>
            <div class="cos-data-grid__columns-panel">
                <p class="cos-card__eyebrow">{{ 'grid.visible'|trans({}, 'cuw_quality') }}</p>
                {% for column in columns %}
                    <label class="cos-choice">
                        <input
                            form="{{ id }}-columns-form"
                            type="checkbox"
                            name="columns[]"
                            value="{{ column.key }}"
                            {% if this.isColumnVisible(column) %}checked{% endif %}
                        >
                        <span>{{ column.label }}</span>
                    </label>
                {% endfor %}
                <button class="cos-button cos-button--sm" form="{{ id }}-columns-form" type="submit">{{ 'grid.apply_columns'|trans({}, 'cuw_quality') }}</button>
            </div>
        </details>
    </form>

    <form id="{{ id }}-columns-form" method="get" action="{{ baseUrl }}" hidden>
        {% for key, value in this.fixedQueryParameters() %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
        {% if query.search %}<input type="hidden" name="q" value="{{ query.search }}">{% endif %}
        {% if query.sort %}
            <input type="hidden" name="sort" value="{{ query.sort }}">
            <input type="hidden" name="dir" value="{{ query.direction }}">
        {% endif %}
        {% if query.perPage != 25 %}<input type="hidden" name="per_page" value="{{ query.perPage }}">{% endif %}
        {% if query.view %}<input type="hidden" name="view" value="{{ query.view }}">{% endif %}
        {% for key, value in query.filters %}
            <input type="hidden" name="filter[{{ key }}]" value="{{ value }}">
        {% endfor %}
    </form>

    {% if savedViews is not empty %}
        <nav class="cos-data-grid__saved-views" aria-label="{{ 'grid.saved_views'|trans({}, 'cuw_quality') }}">
            {% for view in savedViews %}
                <a
                    class="cos-data-grid__view"
                    href="{{ this.savedViewUrl(view) }}"
                    {% if query.view == view.id %}aria-current="page"{% endif %}
                >{{ view.label }}</a>
            {% endfor %}
        </nav>
    {% endif %}

    {% if selectable and bulkActions is not empty %}
        <div class="cos-data-grid__bulk" data-data-grid-target="bulkBar" hidden>
            <strong><span data-data-grid-target="selectedCount">0</span> {{ 'grid.selected'|trans({}, 'cuw_quality') }}</strong>
            {% for action in bulkActions %}
                <button
                    class="cos-button cos-button--sm {{ action.dangerLevel > 0 ? 'cos-button--danger' : '' }}"
                    type="button"
                    data-action="click->data-grid#bulkAction"
                    data-action-id="{{ action.id }}"
                    {% if not action.enabled %}disabled title="{{ action.disabledReason }}"{% endif %}
                >{{ action.label }}</button>
            {% endfor %}
        </div>
    {% endif %}

    {% if state.value == 'loading' %}
        <twig:CosOutcomeState state="loading" />
    {% elseif state.value == 'error' %}
        <twig:CosOutcomeState state="error" :detail="errorMessage" />
    {% elseif this.isEmpty() %}
        <twig:CosEmptyState
            :title="'grid.empty_title'|trans({}, 'cuw_quality')"
            :copy="'grid.empty_detail'|trans({}, 'cuw_quality')"
        />
    {% else %}
        <div class="cos-data-grid__table-wrap" tabindex="0" role="region" aria-label="{{ label }}">
            <table class="cos-data-grid__table">
                <thead>
                    <tr>
                        {% if selectable %}
                            <th class="cos-data-grid__select" scope="col">
                                <input
                                    type="checkbox"
                                    aria-label="{{ 'grid.select_all'|trans({}, 'cuw_quality') }}"
                                    data-data-grid-target="selectAll"
                                    data-action="change->data-grid#toggleAll"
                                >
                            </th>
                        {% endif %}
                        {% for column in this.visibleColumns() %}
                            <th
                                scope="col"
                                class="cos-data-grid__cell--{{ column.align }}"
                                aria-sort="{{ query.sort == column.key ? (query.direction == 'asc' ? 'ascending' : 'descending') : 'none' }}"
                            >
                                {% if column.sortable %}
                                    <a class="cos-data-grid__sort" href="{{ this.sortUrl(column) }}">
                                        {{ column.label }}
                                        {% if query.sort == column.key %}
                                            <span aria-hidden="true">{{ query.direction == 'asc' ? '↑' : '↓' }}</span>
                                        {% endif %}
                                    </a>
                                {% else %}
                                    {{ column.label }}
                                {% endif %}
                            </th>
                        {% endfor %}
                        {% if rowActions is not empty %}<th scope="col"><span class="visually-hidden">{{ 'grid.actions'|trans({}, 'cuw_quality') }}</span></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in page.rows %}
                        {% set rowId = this.rowId(row) %}
                        <tr>
                            {% if selectable %}
                                <td class="cos-data-grid__select">
                                    <input
                                        type="checkbox"
                                        value="{{ rowId }}"
                                        aria-label="{{ 'grid.select'|trans({'%id%': rowId}, 'cuw_quality') }}"
                                        data-data-grid-target="rowCheckbox"
                                        data-action="change->data-grid#selectionChanged"
                                    >
                                </td>
                            {% endif %}
                            {% for column in this.visibleColumns() %}
                                <td class="cos-data-grid__cell--{{ column.align }}">{{ this.value(row, column.key) }}</td>
                            {% endfor %}
                            {% if rowActions is not empty %}
                                <td>
                                    <div class="cos-data-grid__actions">
                                        {% for action in rowActions %}
                                            <button
                                                class="cos-button cos-button--sm cos-button--ghost {{ action.dangerLevel > 0 ? 'cos-button--danger' : '' }}"
                                                type="button"
                                                data-action="click->data-grid#rowAction"
                                                data-action-id="{{ action.id }}"
                                                data-row-id="{{ rowId }}"
                                                {% if not action.enabled %}disabled title="{{ action.disabledReason }}"{% endif %}
                                            >{{ action.label }}</button>
                                        {% endfor %}
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="cos-data-grid__mobile">
            {% for row in page.rows %}
                {% set rowId = this.rowId(row) %}
                <article class="cos-data-grid__card">
                    <header class="cos-data-grid__card-head">
                        {% if selectable %}
                            <label class="cos-choice">
                                <input
                                    type="checkbox"
                                    value="{{ rowId }}"
                                    data-data-grid-target="rowCheckbox"
                                    data-action="change->data-grid#selectionChanged"
                                >
                                <span>{{ 'grid.select'|trans({'%id%': rowId}, 'cuw_quality') }}</span>
                            </label>
                        {% endif %}
                        <strong>{{ rowId }}</strong>
                    </header>
                    <dl class="cos-data-grid__card-fields">
                        {% for column in this.mobileColumns() %}
                            <div class="cos-data-grid__card-field">
                                <dt>{{ column.label }}</dt>
                                <dd>{{ this.value(row, column.key) }}</dd>
                            </div>
                        {% endfor %}
                    </dl>
                    {% if rowActions is not empty %}
                        <footer class="cos-data-grid__actions">
                            {% for action in rowActions %}
                                <button
                                    class="cos-button cos-button--sm cos-button--ghost {{ action.dangerLevel > 0 ? 'cos-button--danger' : '' }}"
                                    type="button"
                                    data-action="click->data-grid#rowAction"
                                    data-action-id="{{ action.id }}"
                                    data-row-id="{{ rowId }}"
                                    {% if not action.enabled %}disabled title="{{ action.disabledReason }}"{% endif %}
                                >{{ action.label }}</button>
                            {% endfor %}
                        </footer>
                    {% endif %}
                </article>
            {% endfor %}
        </div>

        <nav class="cos-data-grid__pagination" aria-label="{{ label }} · {{ 'grid.pagination'|trans({}, 'cuw_quality') }}">
            <span>{{ 'grid.showing'|trans({'%from%': page.from(), '%to%': page.to(), '%total%': page.total}, 'cuw_quality') }}</span>
            <div class="cos-data-grid__pages">
                {% if page.page > 1 %}
                    <a class="cos-button cos-button--sm" href="{{ this.url({'page': page.page - 1}) }}">{{ 'grid.previous'|trans({}, 'cuw_quality') }}</a>
                {% else %}
                    <span class="cos-button cos-button--sm" aria-disabled="true">{{ 'grid.previous'|trans({}, 'cuw_quality') }}</span>
                {% endif %}
                <span>{{ 'grid.page'|trans({'%page%': page.page, '%count%': page.pageCount()}, 'cuw_quality') }}</span>
                {% if page.page < page.pageCount() %}
                    <a class="cos-button cos-button--sm" href="{{ this.url({'page': page.page + 1}) }}">{{ 'grid.next'|trans({}, 'cuw_quality') }}</a>
                {% else %}
                    <span class="cos-button cos-button--sm" aria-disabled="true">{{ 'grid.next'|trans({}, 'cuw_quality') }}</span>
                {% endif %}
            </div>
        </nav>
    {% endif %}
    {% endif %}
</section>
