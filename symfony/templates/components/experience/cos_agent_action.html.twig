<article class="cos-agent-action" data-stage="{{ action.stage }}">
    <header class="cos-agent-action__header">
        <div>
            <span class="cos-agent-action__stage">{{ action.stage }}</span>
            <strong>{{ action.action.type }}</strong>
        </div>
        <small>{{ action.action.status.value }}</small>
    </header>

    {% if action.action.targetType and action.action.targetId %}
        <code class="cos-agent-action__entity">{{ action.action.targetType }}:{{ action.action.targetId }}</code>
    {% endif %}

    {% if action.action.parameters is not empty %}
        <details class="cos-agent-action__parameters">
            <summary>Parameters</summary>
            <pre>{{ action.action.parameters|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        </details>
    {% endif %}

    <dl class="cos-ai-context-card__facts">
        <div><dt>Action ID</dt><dd><code>{{ action.action.id }}</code></dd></div>
        <div><dt>Execution mode</dt><dd>{{ action.action.executionMode }}</dd></div>
        <div><dt>Risk</dt><dd>{{ action.action.riskLevel }}</dd></div>
        {% if action.action.approvalId %}
            <div><dt>Approval</dt><dd>{{ action.action.approvalStatus }} · <code>{{ action.action.approvalId }}</code></dd></div>
        {% endif %}
    </dl>
    {% if action.uiActions is not empty %}
        <ul>
            {% for uiAction in action.uiActions %}
                <li>{{ uiAction.label }} · {{ uiAction.enabled ? 'Available in governed operations' : uiAction.disabledReason }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="cos-agent-action__note">No currently permitted AI-proposal action is available.</p>
    {% endif %}
    <p class="cos-agent-action__note">Action lifecycle is not independent proof of a business outcome.</p>
    <a class="cos-button cos-button--ghost" href="/cos/control-center" data-turbo-frame="_top">Inspect approval and execute through Control Center</a>
</article>
