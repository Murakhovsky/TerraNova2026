<section class="cos-entity-summary" aria-label="{{ label }}">
    {% for item in items %}
        <div class="cos-entity-summary__item">
            <span>{{ item.label }}</span>
            <strong class="cos-numeric">{{ item.value }}</strong>
            {% if item.hint ?? false %}<small>{{ item.hint }}</small>{% endif %}
        </div>
    {% endfor %}
</section>
