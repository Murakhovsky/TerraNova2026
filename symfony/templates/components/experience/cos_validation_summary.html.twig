{% if errors is not empty %}
    <section
        id="{{ id }}"
        class="cos-validation-summary"
        role="alert"
        aria-labelledby="{{ id }}-title"
        tabindex="-1"
    >
        <strong id="{{ id }}-title" class="cos-validation-summary__title">{{ title }}</strong>
        <ul class="cos-validation-summary__list">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
