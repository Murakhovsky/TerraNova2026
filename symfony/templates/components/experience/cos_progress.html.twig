<div
    class="cos-progress"
    role="progressbar"
    aria-label="{{ label }}"
    aria-valuemin="0"
    {% if max > 0 %}aria-valuemax="{{ max }}" aria-valuenow="{{ this.clampedValue() }}"{% endif %}
>
    <div class="cos-progress__track">
        <div class="cos-progress__bar" style="--cos-progress: {{ this.percent() }}%"></div>
    </div>
    <div class="cos-progress__meta">
        <span>{{ label }}</span>
        {% if max > 0 %}<span>{{ this.percent() }}%</span>{% endif %}
    </div>
</div>
