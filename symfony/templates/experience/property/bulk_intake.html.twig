{% extends 'experience/portal_shell.html.twig' %}
{% block title %}Імпорт Property Assets | COS{% endblock %}
{% block portal_content %}
<section class="cos-page__stack" data-cos-property-bulk>
  <header class="cos-card">
    <p class="cos-card__eyebrow">Property / Федеративний імпорт</p>
    <h1 class="cos-card__title">Імпорт до 10 об'єктів</h1>
    <p class="cos-card__copy">Завантаження → перевірка дублікатів → погодження Plan → Platform Workflow → Property → незалежна перевірка. Публікація оголошень не виконується.</p>
    <a class="cos-button cos-button--ghost" href="/workspace/goals">Мої цілі</a>
  </header>
  {% include 'experience/adaptive/_controls.html.twig' %}

  {% if not batch %}
    <section class="cos-card">
      <h2 class="cos-card__title">1. Підготувати дані</h2>
      <p class="cos-card__copy">Завантажте CSV із Excel або вставте JSON. Для перевірки дублікатів потрібні тип, місто й точна адреса.</p>
      <form method="post" enctype="multipart/form-data" action="{{ path('cos_property_bulk_csv_stage') }}" class="cos-page__stack">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <label class="cos-field"><span>CSV UTF-8 (до 10 рядків, до 64 КіБ)</span>
          <input class="cos-input" type="file" name="file" accept=".csv,text/csv" required>
        </label>
        <p class="cos-card__copy">Назви колонок: <code>type_code,city,address,area_total</code>. Підтримуються роздільники кома, крапка з комою або табуляція.</p>
        <button type="submit" class="cos-button cos-button--primary">Перевірити CSV-пакет</button>
      </form>
{% include 'experience/adaptive/_toggle.html.twig' with {sectionId:'bulk.json_input',sectionLabel:'uw.adaptive.json_input'} %}
{% if 'bulk.json_input' in adaptive.composition.visibleSections %}
      <h3>Або JSON</h3>
      <form method="post" action="{{ path('cos_property_bulk_stage') }}" class="cos-page__stack">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <label class="cos-field">
          <span>Об'єкти у форматі JSON</span>
          <textarea name="items_json" class="cos-input" rows="12" maxlength="65536" required>[{"type_code":"house","city":"Львів","address":"Приклад, 10","area_total":120},{"type_code":"apartment","city":"Львів","address":"Приклад, 12","area_total":55}]</textarea>
        </label>
        <button type="submit" class="cos-button cos-button--primary">Перевірити і підготувати пакет</button>
      </form>
{% endif %}
    </section>
  {% else %}
    <section class="cos-card" data-property-bulk-operation="{{ batch.batch_id }}">
      {% set verifiedItems = batch.items|filter(item => item.status == 'verified' and item.native_asset_id)|length %}
      <p class="cos-card__eyebrow">{{ batch.state }}</p>
      <h2 class="cos-card__title">2. Перевірка пакета</h2>
      <p class="cos-card__copy">Об'єктів: {{ batch.count }}.</p>
      {% include 'experience/adaptive/_toggle.html.twig' with {sectionId:'bulk.identifiers',sectionLabel:'uw.adaptive.identifiers'} %}
{% if 'bulk.identifiers' in adaptive.composition.visibleSections %}
      <p data-cos-expert-ids class="cos-card__copy">Пакет <code>{{ batch.batch_id }}</code> · Знімок <code>{{ batch.digest }}</code>.</p>
{% endif %}
      <p class="cos-card__copy" role="status" data-property-bulk-progress="{{ verifiedItems }}/{{ batch.count }}">
        <strong>Підтверджено {{ verifiedItems }} із {{ batch.count }} об'єктів.</strong>
        Підготовка та погодження Plan не вважаються виконанням.
      </p>
      <a class="cos-button cos-button--ghost" data-property-bulk-deep-link
         href="/workspace/property/bulk?batch={{ batch.batch_id|url_encode }}">Постійне посилання на пакет</a>
      {% if adaptive.mode != 'result' %}
        <p class="cos-card__copy" data-cos-bulk-process>{{ 'uw.adaptive.bulk_process'|trans }} · {{ batch.state }}</p>
      {% endif %}
      {% for item in batch.items %}
        <div class="cos-card" data-property-bulk-item="{{ item.index }}" data-property-bulk-item-state="{{ item.status }}">
          <strong>#{{ item.index + 1 }} · {{ item.input.type_code }} · {{ item.input.city }}</strong>
          <p class="cos-card__copy">{{ item.input.address }} · статус: {{ item.status }}</p>
          {% if item.status == 'verified' and item.native_asset_id %}
            <a class="cos-button cos-button--ghost" data-property-bulk-item-verified
               href="/workspace/capabilities?reference={{ item.native_asset_id|url_encode }}">
               Перевірити об'єкт {{ item.native_asset_id }}
            </a>
          {% else %}
            <p class="cos-card__copy" role="status" data-property-bulk-item-pending>
              Підтвердженого запису Property ще немає. Не запускайте повторне створення без звірки Action/Receipt.
            </p>
          {% endif %}
        </div>
      {% endfor %}
      {% if batch.state == 'staged' %}
        <form method="post" action="{{ path('cos_property_bulk_propose', {'batchId':batch.batch_id}) }}">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <input type="hidden" name="digest" value="{{ batch.digest }}">
          <button type="submit" class="cos-button cos-button--primary">Створити план для незалежного погодження</button>
        </form>
      {% endif %}
      {% if batch.goal_id and batch.plan_id %}
        {% if 'bulk.identifiers' in adaptive.composition.visibleSections %}
          <p class="cos-card__copy">Goal: <code>{{ batch.goal_id }}</code> · Plan: <code>{{ batch.plan_id }}</code>.</p>
        {% endif %}
        <p class="cos-card__copy">Наступний крок: запитати незалежне погодження Plan у Goals, потім погодження Action та запуск через Platform Workflow. Сама підготовка пакета нічого не виконує.</p>
        <a class="cos-button cos-button--primary" href="/workspace/goals">Погодити й виконати в Goals</a>
      {% endif %}
      {% if batch.state == 'verified' and verifiedItems == batch.count %}
        <div class="cos-alert cos-alert--success" data-property-bulk-verified>Native Property записи перевірені. Для фінального Goal Outcome виконайте незалежну оцінку після завершення Run.</div>
      {% elseif batch.state == 'verified' %}
        <div class="cos-alert" role="alert" data-property-bulk-reconciliation-required>
          Стан пакета не відповідає підтвердженим записам. Потрібна перевірка Action/Receipt, автоматичний повтор не запускається.
        </div>
      {% else %}
        <p class="cos-card__copy" role="status" data-property-bulk-awaiting-verification>
          Результат ще не підтверджений. Поверніться за посиланням після виконання та звірки квитанцій.
        </p>
      {% endif %}
    </section>
  {% endif %}
</section>
{% endblock %}
