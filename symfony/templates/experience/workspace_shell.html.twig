{% extends 'base.html.twig' %}

{% block body %}
<div
    class="cos-shell"
    data-controller="workspace-shell"
    data-workspace-shell-search-url-value="{{ path('cos_web_global_search') }}"
    data-workspace-shell-activity-url-value="{{ path('cos_web_activity_center') }}"
    data-workspace-shell-ai-url-value="{{ path('cos_web_ai_panel') }}"
    data-action="cos:realtime-update->workspace-shell#refreshActivityCenter"
>
    <aside
        class="cos-shell__sidebar"
        id="cos-workspace-navigation"
        aria-label="{{ 'shell.company_workspace_navigation'|trans }}"
        data-workspace-shell-target="sidebar"
    >
        <div class="cos-shell__brand">
            <span class="cos-shell__brand-mark" aria-hidden="true">COS</span>
            <span class="cos-shell__brand-copy">
                <strong>{{ 'shell.brand_name'|trans }}</strong>
                <small>{{ shell.tenantLabel }}</small>
            </span>
        </div>

        <nav class="cos-shell__nav" aria-label="{{ 'shell.primary_navigation'|trans }}">
            {% for item in shell.primaryNavigation %}
                <div class="cos-shell__nav-group">
                    <a
                        class="cos-shell__nav-item{% if item.active %} is-active{% endif %}"
                        href="{{ item.path }}"
                        {% if item.active %}aria-current="page"{% endif %}
                    >
                        <span class="cos-shell__nav-glyph" aria-hidden="true">{{ item.glyph }}</span>
                        <span>{{ item.label|trans }}</span>
                    </a>

                    {% if item.children is not empty %}
                        <div class="cos-shell__subnav">
                            {% for child in item.children %}
                                <a
                                    class="{% if child.active %}is-active{% endif %}"
                                    href="{{ child.path }}"
                                    {% if child.active %}aria-current="page"{% endif %}
                                >{{ child.label|trans }}</a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </nav>

        {% if shell.utilityNavigation is not empty %}
            <nav class="cos-shell__nav cos-shell__nav--utility" aria-label="{{ 'shell.utility_navigation'|trans }}">
                {% for item in shell.utilityNavigation %}
                    <a
                        class="cos-shell__nav-item{% if item.active %} is-active{% endif %}"
                        href="{{ item.path }}"
                    >
                        <span class="cos-shell__nav-glyph" aria-hidden="true">{{ item.glyph }}</span>
                        <span>{{ item.label|trans }}</span>
                    </a>
                {% endfor %}
            </nav>
        {% endif %}
    </aside>

    <div class="cos-shell__main">
        <header class="cos-shell__topbar">
            <div class="cos-shell__context">
                <button
                    class="cos-shell__menu"
                    type="button"
                    aria-controls="cos-workspace-navigation"
                    aria-expanded="false"
                    aria-label="{{ 'shell.open_navigation'|trans }}"
                    data-workspace-shell-target="menuButton"
                    data-action="click->workspace-shell#toggleSidebar"
                >☰</button>

                <div class="cos-shell__title-block">
                    {% if shell.breadcrumbs is not empty %}
                        <nav class="cos-shell__breadcrumbs" aria-label="{{ 'shell.breadcrumb'|trans }}">
                            {% for breadcrumb in shell.breadcrumbs %}
                                {% if not loop.first %}<span aria-hidden="true">/</span>{% endif %}
                                {% if breadcrumb.path %}
                                    <a href="{{ breadcrumb.path }}">{{ breadcrumb.label|trans }}</a>
                                {% else %}
                                    <span>{{ breadcrumb.label|trans }}</span>
                                {% endif %}
                            {% endfor %}
                        </nav>
                    {% endif %}
                    <div class="cos-shell__title">{{ shell.title|trans }}</div>
                </div>
            </div>

            <div class="cos-shell__actions">
                <button
                    class="cos-shell__search-trigger"
                    type="button"
                    aria-haspopup="dialog"
                    data-action="click->workspace-shell#openPalette"
                >
                    <span>{{ 'shell.search_workspace'|trans }}</span>
                    <kbd>⌘K</kbd>
                </button>

                <form class="cos-shell__locale-form" method="post" action="{{ path('cos_web_locale_switch') }}" data-action="change->workspace-shell#submitLocale">
                    <input type="hidden" name="_token" value="{{ csrf_token('cos_locale_switch') }}">
                    <label class="cos-visually-hidden" for="cos-shell-locale">{{ 'shell.language'|trans }}</label>
                    <select id="cos-shell-locale" class="cos-shell__locale-select" name="locale" aria-label="{{ 'shell.language'|trans }}">
                        <option value="uk"{% if app.request.locale == 'uk' %} selected{% endif %}>Українська</option>
                        <option value="en"{% if app.request.locale == 'en' %} selected{% endif %}>English</option>
                    </select>
                </form>

                {% if shell.aiAvailable %}
                    <button
                        class="cos-shell__icon-button"
                        type="button"
                        aria-label="{{ 'shell.open_ai_assistant'|trans }}"
                        aria-controls="cos-ai-panel"
                        aria-expanded="false"
                        data-workspace-shell-target="aiButton"
                        data-action="click->workspace-shell#openAI"
                    >AI</button>
                {% endif %}

                <span
                    class="cos-shell__connection"
                    data-state="{{ shell.connectionState.value }}"
                    data-cos-realtime-state
                    title="{{ 'shell.realtime_connection_state'|trans }}"
                ><span data-cos-realtime-state-label>{{ ('shell.connection.' ~ shell.connectionState.value)|trans }}</span></span>

                <button
                    class="cos-shell__icon-button"
                    type="button"
                    aria-label="{{ 'shell.notifications'|trans }}"
                    aria-controls="cos-activity-center-panel"
                    aria-expanded="false"
                    data-workspace-shell-target="notificationButton"
                    data-action="click->workspace-shell#open{{ 'shell.notifications'|trans }}"
                >
                    NT
                    <span
                        class="cos-shell__counter"
                        data-workspace-shell-target="notificationCounter"
                        {% if shell.notificationCount <= 0 %}hidden{% endif %}
                    >{{ shell.notificationCount > 99 ? '99+' : shell.notificationCount }}</span>
                </button>

                <button
                    class="cos-shell__icon-button"
                    type="button"
                    aria-label="{{ 'shell.activity_center'|trans }}"
                    aria-controls="cos-activity-center-panel"
                    aria-expanded="false"
                    data-workspace-shell-target="activityButton"
                    data-action="click->workspace-shell#openActivityCenter"
                >
                    <span class="cos-shell__activity-label">AC</span>
                    <span
                        class="cos-shell__counter"
                        data-workspace-shell-target="activityCounter"
                        {% if shell.activityCount <= 0 %}hidden{% endif %}
                    >{{ shell.activityCount > 99 ? '99+' : shell.activityCount }}</span>
                </button>

                <a class="cos-shell__profile" href="/cabinet">
                    <span class="cos-shell__profile-mark" aria-hidden="true">{{ shell.userInitials }}</span>
                    <span class="cos-shell__profile-copy">
                        <strong>{{ shell.userLabel }}</strong>
                        <small>{{ shell.tenantLabel }}</small>
                    </span>
                </a>
            </div>
        </header>

        <main class="cos-shell__content">
            {% block workspace_content %}{% endblock %}
        </main>
    </div>

    <nav class="cos-shell__mobile-nav" aria-label="Mobile Workspace navigation">
        {% for item in shell.primaryNavigation|slice(0, 4) %}
            <a
                class="{% if item.active %}is-active{% endif %}"
                href="{{ item.path }}"
                {% if item.active %}aria-current="page"{% endif %}
            >{{ item.label|trans }}</a>
        {% endfor %}
        <button
            type="button"
            aria-controls="cos-workspace-navigation"
            data-action="click->workspace-shell#openSidebar"
        >{{ 'shell.more'|trans }}</button>
    </nav>

    <div id="cos-async-operation-signal" hidden aria-hidden="true"></div>

    <div class="cos-ai-panel" id="cos-ai-panel" hidden data-workspace-shell-target="aiPanel">
        <button
            class="cos-ai-panel__backdrop"
            type="button"
            tabindex="-1"
            aria-label="{{ 'shell.close_ai_assistant'|trans }}"
            data-action="click->workspace-shell#closeAI"
        ></button>
        <aside class="cos-ai-panel__panel" role="dialog" aria-modal="true" aria-label="COS AI">
            <turbo-frame
                id="cos-ai-panel-frame"
                data-workspace-shell-target="aiFrame"
                data-action="turbo:frame-load->workspace-shell#aiLoaded"
            >
                <div class="cos-ai-panel__loading" aria-live="polite">{{ 'shell.loading_ai'|trans }}</div>
            </turbo-frame>
        </aside>
    </div>

    <div
        class="cos-activity-center"
        id="cos-activity-center-panel"
        hidden
        data-workspace-shell-target="activityPanel"
    >
        <button
            class="cos-activity-center__backdrop"
            type="button"
            tabindex="-1"
            aria-label="{{ 'shell.close_activity_center'|trans }}"
            data-action="click->workspace-shell#closeActivityCenter"
        ></button>

        <aside class="cos-activity-center__panel" role="dialog" aria-modal="true" aria-label="{{ 'shell.activity_center'|trans }}">
            <turbo-frame
                id="cos-activity-center-frame"
                src="{{ path('cos_web_activity_center', {tab: 'activity'}) }}"
                data-workspace-shell-target="activityFrame"
                data-action="turbo:frame-load->workspace-shell#activityCenterLoaded"
            >
                <div class="cos-activity-center__loading" aria-live="polite">{{ 'shell.loading_activity'|trans }}</div>
            </turbo-frame>
        </aside>
    </div>

    <div class="cos-command" hidden data-workspace-shell-target="palette">
        <button
            class="cos-command__backdrop"
            type="button"
            tabindex="-1"
            aria-label="{{ 'shell.close_command_palette'|trans }}"
            data-action="click->workspace-shell#closePalette"
        ></button>

        <section class="cos-command__panel" role="dialog" aria-modal="true" aria-label="{{ 'shell.global_command_palette'|trans }}">
            <div class="cos-command__search">
                <input
                    class="cos-command__input"
                    type="search"
                    placeholder="{{ 'shell.search_workspace_placeholder'|trans }}"
                    autocomplete="off"
                    spellcheck="false"
                    aria-controls="cos-global-search-results"
                    data-workspace-shell-target="paletteInput"
                    data-action="input->workspace-shell#searchPalette"
                >
                <button class="cos-button cos-button--sm" type="button" data-action="click->workspace-shell#closePalette">Esc</button>
            </div>

            <turbo-frame
                id="cos-global-search-results"
                data-workspace-shell-target="searchFrame"
                data-action="turbo:frame-load->workspace-shell#searchLoaded"
            >
                <div class="cos-command__list" role="listbox" aria-label="Global commands">
                    <p class="cos-command__group">{{ 'shell.commands'|trans }}</p>
                    {% for command in shell.commands %}
                        <a
                            class="cos-command__item"
                            href="{{ command.path }}"
                            target="_top"
                            role="option"
                            aria-selected="false"
                            data-workspace-shell-target="resultItem"
                        >
                            <span>
                                <strong>{{ command.label|trans }}</strong>
                                {% if command.hint %}<small>{{ command.hint|trans }}</small>{% endif %}
                            </span>
                            <small>{{ command.kind|trans }}</small>
                        </a>
                    {% else %}
                        <p class="cos-command__empty">{{ 'shell.no_commands'|trans }}</p>
                    {% endfor %}
                </div>
            </turbo-frame>
        </section>
    </div>
</div>
{% endblock %}
