{% extends 'experience/portal_shell.html.twig' %}

{% block title %}Цілі COS | Company Operating System{% endblock %}

{% block portal_content %}
<section class="cos-page__stack" data-cos-federation-goals data-experience-mode="{{ mode }}">
    <header class="cos-card">
        <p class="cos-card__eyebrow">COS / Goal to Outcome</p>
        <h1 class="cos-card__title">Ваші бізнес-цілі</h1>
        <p class="cos-card__copy">Спочатку визначаємо вимірюваний результат. Виконання між доменами вмикається окремо після перевірки плану та необхідних погоджень.</p>
        <a class="cos-button cos-button--ghost" href="/cabinet">До кабінету</a>
    </header>

    <nav class="cos-card" aria-label="Режим перегляду COS">
        <p class="cos-card__eyebrow">Рівень деталізації</p>
        <form method="post" action="{{ path('cos_federation_goals_mode') }}" class="cos-pattern-inline">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            {% for option, title in {'result':'Результат', 'process':'Процес', 'expert':'Експерт'} %}
                <button type="submit" name="mode" value="{{ option }}"
                    class="cos-button {{ mode == option ? 'cos-button--primary' : 'cos-button--ghost' }}"
                    aria-pressed="{{ mode == option ? 'true' : 'false' }}">{{ title }}</button>
            {% endfor %}
        </form>
        <p class="cos-card__copy">Ці режими змінюють кількість деталей, але не ваші права та не стан бізнес-операцій.</p>
    </nav>

    {% set notices = {
        'plan_proposed':'План збережено. Це ще не запуск. Наступний крок: запросити незалежне погодження.',
        'approval_requested':'Запит на погодження створено. Інший уповноважений користувач має підтвердити його в системі Action/Approval.',
        'run_started':'План прийнято до виконання через Platform Workflow. Для переходу до наступного кроку натисніть «Продовжити».',
        'run_advanced':'Стан виконання оновлено. Перевірте кроки та необхідні погодження.',
        'action_queued':'Дію передано до канонічної черги Action. Дочекайтесь перевіреного результату, повторний запуск не потрібен.',
        'evidence_pending':'Очікується підтвердження результату від відповідального домену. Повторний Action не надсилається.'
    } %}
    {% set blockers = {
        'rollout_disabled':'Запуск заблоковано: для цієї організації не активовано COS_FEDERATION_CANONICAL_ORGANIZATION. Налаштувати може адміністратор; старий виконавець не використовується.',
        'already_started':'Цей план уже має виконання. Повторний запуск заборонений, перевірте існуючий Run.',
        'spec_frozen':'Ціль уже має плани. Змінювати дозволені дії після створення плану не можна.',
        'not_found':'Ціль, план або запуск відсутній у вашій організації чи став недоступним.',
        'approval_policy':'Немає активної політики, яка вимагає незалежного погодження цього плану або дії. Налаштуйте Policy/Approval.',
        'waiting_approval':'План ще не має завершеної канонічної квитанції незалежного погодження. Потрібне рішення іншої уповноваженої особи та виконання Approval Action.',
        'universe_unavailable':'Не знайдено активний Growth Universe цієї організації, спрямований у Sales. Перевірте ID і активацію джерела.',
        'capability_unavailable':'Операція недоступна: модуль або реальний Action handler не активований для організації, або бракує дозволу менеджера.',
        'invalid_steps':'Перевірте кількість дій (1–3), справжні ID угод, назви та терміни задач.',
        'owner_required':'Змінити чи запустити план може лише власник цієї цілі.',
        'stale_execution':'План або його погодження застаріли після зміни специфікації.',
        'reconcile_required':'Виконання очікує перевірки квитанції чи ручного втручання. Повторювати зовнішню дію небезпечно.',
        'step_approval_waiting':'Поточна операція очікує окремого незалежного погодження Action. Поки його не прийнято, виконання зупинене.',
        'approval_unavailable':'Сервіс погоджень тимчасово недоступний. Погодження не підтверджене.',
        'start_unavailable':'Platform Workflow не зміг створити Run. Перевірте стан затвердження, доступність сховища та журнал виконання.',
        'advance_unavailable':'Platform Workflow не зміг продовжити Run. Перевірте статус кроків і погоджень.',
        'storage_unavailable':'План не збережено: сховище або перевірка даних недоступні.',
        'plan_blocked':'План заблоковано: дані цілі, схема Action або підтвердження не пройшли перевірку.'
    } %}
    {% if notices[notice|default('')] is defined %}
        <div class="cos-alert cos-alert--success" role="status">{{ notices[notice] }}</div>
    {% endif %}
    {% if blockers[blocker|default('')] is defined %}
        <div class="cos-alert" role="alert" data-goal-blocker="{{ blocker }}"><strong>Що заважає:</strong> {{ blockers[blocker] }}</div>
    {% endif %}
    {% if created %}
        <div class="cos-alert cos-alert--success" role="status">Чернетку цілі збережено.</div>
    {% endif %}
    {% if error %}
        <div class="cos-alert" role="alert">Перевірте опис цілі, код показника та числове значення.</div>
    {% endif %}

    <section class="cos-card" aria-labelledby="goal-new-title">
        <p class="cos-card__eyebrow">Нова ціль</p>
        <h2 id="goal-new-title" class="cos-card__title">Якого результату потрібно досягти?</h2>
        <form method="post" action="{{ path('cos_federation_goals_create') }}" class="cos-page__stack">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <label class="cos-field"><span>Опишіть бізнес-результат</span>
                <textarea class="cos-input" name="desired_result" rows="3" maxlength="1200" required
                    placeholder="Наприклад: отримати п'ять нових кваліфікованих клієнтів за місяць"></textarea>
            </label>
            <div class="cos-section-grid">
                <label class="cos-field"><span>Показник (машинний код)</span>
                    <input class="cos-input" name="criterion" value="sales.won_deals" list="federation-supported-outcomes" pattern="[a-z][a-z0-9_.-]*" maxlength="64" required>
                    <datalist id="federation-supported-outcomes">
                        <option value="federation.verified_proposals">Federation: 50 перевірених пропозицій, прив’язаних до Sales Leads</option>
                        <option value="sales.won_deals">Sales: виграні угоди</option>
                        <option value="sales.closed_deals">Sales: закриті угоди</option>
                        <option value="sales.local_tasks_created">Sales: створені завдання в локальній CRM</option>
                        <option value="growth.inbound_responses_recorded">Growth: отримані відповіді контактів</option>
                        <option value="growth.run_linked_inbound_responses">Growth: відповіді, пов'язані з перевіреними діями Run</option>
                        <option value="capital_markets.research_results_validated">Research: валідовані результати досліджень</option>
                        <option value="documents.signatures_recorded">Documents: зареєстровані підписи</option>
                        <option value="capital_markets.run_linked_validated_results">Research: результат конкретного Run (потребує Action handler)</option>
                        <option value="documents.run_linked_signatures">Documents: підпис конкретного Run (потребує Action handler)</option>
                    </datalist>
                </label>
                <label class="cos-field"><span>Цільове значення</span>
                    <input class="cos-input" type="number" name="target" min="1" max="1000000" value="5" required>
                </label>
            </div>
            <p class="cos-card__copy">Для простого старту виберіть <code>sales.local_tasks_created</code> і, наприклад, ціль 1. Після збереження можна побудувати план із 1–3 завдань для реальних угод Sales. Заплановані завдання не гарантують виграної угоди.</p>
            <p class="cos-card__copy">Для еталонного сценарію Package A виберіть <code>federation.verified_proposals</code> та значення <strong>50</strong>. Лише цей профіль Goal отримує п’ять дозволених Growth/Sales/Documents Action у плані. Кожен план і кожна дія потребують окремого погодження; жодне виконання не запускається при створенні Goal.</p>
            <p class="cos-card__copy">Автоматично підтверджуються <code>sales.won_deals</code>, <code>sales.closed_deals</code> і <code>sales.local_tasks_created</code>, якщо Sales активний. Додатково підтримуються <code>growth.inbound_responses_recorded</code>, <code>capital_markets.research_results_validated</code> і <code>documents.signatures_recorded</code>. Run-linked метрики Research і Documents наразі непідтверджені, поки не активовано перевірені Action handlers. Інші коди без довіреного джерела також залишаються непідтвердженими.</p>
            <button class="cos-button cos-button--primary" type="submit">Зберегти чернетку Goal</button>
        </form>
        <p class="cos-card__copy">Збереження не запускає агентів і не створює зовнішніх операцій.</p>
    </section>

    <section class="cos-page__section" aria-labelledby="goal-list-title">
        <h2 id="goal-list-title">Поточні цілі</h2>
        <div class="cos-page__stack">
        {% for goal in goals %}
            <article class="cos-card" data-goal-id="{{ goal.id }}">
                <p class="cos-card__eyebrow">{{ goal.state == 'draft' ? 'Чернетка' : goal.state }}</p>
                <h3 class="cos-card__title">{{ goal.desired_result }}</h3>
                <p class="cos-card__copy">
                    {% for criterion in goal.criteria %}
                        {{ criterion.id }}: {{ criterion.operator == 'at_least' ? 'щонайменше' : criterion.operator }} {{ criterion.expected }}{% if not loop.last %}; {% endif %}
                    {% endfor %}
                </p>

                <p class="cos-card__copy">
                    <a href="{{ path('cos_federation_goal_aggregate', {goalId: goal.id}) }}"
                       data-goal-native-aggregate-link
                       rel="nofollow">Перевірити реальні результати Growth → Sales → Documents (JSON)</a>
                    <small>Лише читання. Не означає автоматичного підтвердження бізнес-цілі.</small>
                </p>

                {% set criterionId = goal.criteria[0].id|default('') %}
                <details class="cos-page__stack" data-goal-plan-builder>
                    <summary class="cos-button cos-button--primary">Побудувати план</summary>
                    {% if criterionId == 'federation.verified_proposals' and goal.criteria[0].expected|default(0) == 50 %}
                        <p class="cos-card__copy">Еталонний Golden 50. Спочатку побудуємо один Discovery-крок із реального Growth Universe, а не 50 фіктивних лідів.</p>
                        <form method="post" action="{{ path('cos_federation_goals_build_plan', {goalId:goal.id}) }}" class="cos-page__stack">
                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                            <input type="hidden" name="scenario" value="golden-discovery">
                            <label class="cos-field"><span>ID активного Sales Growth Universe</span>
                                <input class="cos-input" name="universe_id" maxlength="80" required placeholder="ID реального Growth Universe"></label>
                            <div class="cos-section-grid">
                                <label class="cos-field"><span>Слот збору (1–10)</span>
                                    <input class="cos-input" type="number" min="1" max="10" name="slot" value="1" required></label>
                                <label class="cos-field"><span>Максимум кандидатів (1–200)</span>
                                    <input class="cos-input" type="number" min="1" max="200" name="limit" value="3" required></label>
                            </div>
                            <button class="cos-button cos-button--primary" type="submit">Зберегти Discovery-план</button>
                        </form>
                    {% elseif criterionId in ['sales.local_tasks_created','sales.won_deals','sales.closed_deals'] %}
                        <p class="cos-card__copy">Малий сценарій: 1–3 послідовні створення завдань для наявних угод у CRM. Без запуску до погоджень.</p>
                        <form method="post" action="{{ path('cos_federation_goals_build_plan', {goalId:goal.id}) }}" class="cos-page__stack">
                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                            <input type="hidden" name="scenario" value="small-tasks">
                            <label class="cos-field"><span>Кількість операцій</span>
                                <select class="cos-input" name="task_count">
                                    <option value="1">1 дія</option>
                                    <option value="2">2 дії</option>
                                    <option value="3">3 дії</option>
                                </select></label>
                            {% for i in 1..3 %}
                                <fieldset class="cos-card">
                                    <legend>Дія {{ i }}{% if i > 1 %} (лише якщо обрано {{ i }} чи більше){% endif %}</legend>
                                    <label class="cos-field"><span>ID існуючої угоди Sales</span>
                                        <input class="cos-input" name="deal_{{ i }}" maxlength="100" placeholder="deal-123" {% if i == 1 %}required{% endif %}></label>
                                    <label class="cos-field"><span>Назва завдання</span>
                                        <input class="cos-input" name="title_{{ i }}" maxlength="220" placeholder="Зателефонувати клієнту" {% if i == 1 %}required{% endif %}></label>
                                    <label class="cos-field"><span>Термін, хвилин від створення</span>
                                        <input class="cos-input" type="number" name="minutes_{{ i }}" min="1" max="43200" value="60"></label>
                                </fieldset>
                            {% endfor %}
                            <button class="cos-button cos-button--primary" type="submit">Зберегти план на погодження</button>
                        </form>
                    {% else %}
                        <p class="cos-card__copy" role="status">Для цього показника поки немає перевіреного шаблону дій. Ціль збережена, але виконання заблоковано. Доступні малі сценарії Sales та еталонний Golden 50.</p>
                    {% endif %}
                </details>
                {% for plan in plansByGoal[goal.id]|default([]) %}
                    <section class="cos-card" data-goal-plan="{{ plan.plan_id }}">
                        <h4 class="cos-card__title">План №{{ plan.plan_version }} · {{ plan.steps|length }} операцій</h4>
                        <p class="cos-card__copy">Статус: <strong>{{ plan.state == 'approved' ? 'Погоджений' : (plan.state == 'proposed' ? 'Очікує погодження' : plan.state) }}</strong></p>
                        <p class="cos-card__copy">Контрактні відбитки:
                            {% if plan.contract_pin_state == 'PINS_PRESENT_NOT_ATTESTED' %}
                                <strong>присутні у плані</strong>. Дійсність буде повторно перевірена перед виконанням.
                            {% elseif plan.contract_pin_state == 'LEGACY_NO_PINS' %}
                                <strong>історичний план без digest</strong>. Працює за попередніми обмеженнями; автоматичної міграції немає.
                            {% else %}
                                <strong>неповний pinning, виконання потребує перевірки</strong>.
                            {% endif %}
                        </p>
                        <ol class="cos-card__copy">
                            {% for step in plan.steps %}
                                <li>{{ step.capability }}{% if step.title %}: {{ step.title }}{% endif %}{% if step.target %} · {{ step.target }}{% endif %}</li>
                            {% endfor %}
                        </ol>
                        {% if plan.approval %}
                            <p class="cos-card__copy">Approval Action: {{ plan.approval.status }}{% if mode == 'expert' %} <code>{{ plan.approval.id }}</code>{% endif %}.
                                {% if plan.approval.status == 'PENDING_APPROVAL' %}
                                    Очікує рішення іншого уповноваженого користувача.
                                {% elseif plan.approval.status == 'QUEUED' %}
                                    Погодження підтверджене, але Approval Action ще не виконано.
                                {% endif %}
                            </p>
                        {% endif %}
                        {% if plan.state == 'proposed' and not plan.approval %}
                            <form method="post" action="{{ path('cos_federation_goals_request_approval',{planId:plan.plan_id}) }}">
                                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                <button class="cos-button cos-button--primary" type="submit">Запросити незалежне погодження</button>
                            </form>
                        {% elseif plan.state == 'approved' and not plan.run_id and not plan.legacy_run_id %}
                            {% if canonicalRolloutEnabled %}
                                <form method="post" action="{{ path('cos_federation_goals_start_plan',{planId:plan.plan_id}) }}">
                                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                    <button class="cos-button cos-button--primary" type="submit">Запустити через Platform Workflow</button>
                                </form>
                            {% else %}
                                <p class="cos-card__copy" role="status">Запуск заблоковано: Platform Workflow не активований для цієї організації (COS_FEDERATION_CANONICAL_ORGANIZATION).</p>
                            {% endif %}
                        {% elseif plan.run_id %}
                            <p class="cos-card__copy">Виконується в Platform Workflow. Run: <code>{{ plan.run_id }}</code>.</p>
                        {% elseif plan.legacy_run_id %}
                            <p class="cos-card__copy">Історичний Federation Run; повторний запуск заборонено.</p>
                        {% endif %}
                    </section>
                {% endfor %}
                {% for linkedRun in runsByGoal[goal.id]|default([]) %}
                    <div class="cos-card__copy" data-goal-progress="{{ linkedRun.run_id }}">
                        <strong>Виконання:</strong> {{ linkedRun.completed_steps }}/{{ linkedRun.total_steps }} кроків завершено ({{ linkedRun.state }}).
                        {% if linkedRun.outcome %}
                            Бізнес-результат: {{ linkedRun.outcome.result }}.
                            {% for measure in linkedRun.outcome.criteria %}
                                {{ measure.criterion_id }}: {{ measure.observed is not null ? measure.observed : 'не виміряно' }} / {{ measure.expected }}.
                            {% endfor %}
                        {% else %}
                            Бізнес-результат ще не підтверджено.
                        {% endif %}
                        {% if mode in ['process','expert'] %}
                            <ul>
                            {% for step in linkedRun.steps %}
                                <li>{{ step.capability_id }}: {{ step.state }}{% if mode == 'expert' and step.receipt %} (квитанція: <code>{{ step.receipt }}</code>){% endif %}</li>
                            {% endfor %}
                            </ul>
                        {% endif %}
                        {% if linkedRun.canonical and linkedRun.state in ['created','running'] %}
                            <form method="post" action="{{ path('cos_federation_goals_advance_run',{runId:linkedRun.run_id}) }}">
                                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                <button type="submit" class="cos-button cos-button--ghost">Продовжити виконання</button>
                            </form>
                        {% elseif linkedRun.state in ['waiting','ambiguous'] %}
                            <strong>Потрібна перевірка погоджень або квитанцій. Повторні Action не запускаються автоматично.</strong>
                        {% endif %}
                    </div>
                {% endfor %}
                {% if mode in ['process','expert'] and plansByGoal[goal.id]|default([]) is empty %}
                    <p class="cos-card__copy" data-goal-process>Плану ще немає. Відкрийте «Побудувати план» вище.</p>
                {% endif %}

                {% if mode == 'expert' %}
                    <dl class="cos-card__copy" data-goal-expert>
                        <div><dt>Goal ID</dt><dd><code>{{ goal.id }}</code></dd></div>
                        <div><dt>Версія специфікації</dt><dd>{{ goal.version }}</dd></div>
                        <div><dt>Власник</dt><dd>{{ goal.owner }}</dd></div>
                        <div><dt>Дозволені capabilities</dt><dd>{{ goal.allowed_capabilities is empty ? 'Поки не визначено' : goal.allowed_capabilities|join(', ') }}</dd></div>
                    </dl>
                {% endif %}
            </article>
        {% else %}
            <div class="cos-card"><p class="cos-card__copy">Цілей ще немає. Почніть із вимірюваного результату вище.</p></div>
        {% endfor %}
        </div>
    </section>
    <section class="cos-page__section" aria-labelledby="federation-run-title" data-federation-runs>
        <h2 id="federation-run-title">Виконання та відновлення</h2>
        <p class="cos-card__copy">Система не повторює зовнішні дії, якщо результат попередньої спроби невідомий. Тут можна підтвердити лише завершені операції з перевіреними квитанціями.</p>
        {% if reconciled %}
            <div class="cos-alert cos-alert--success" role="status">Перевірку квитанцій виконано. Непідтверджені операції залишаються без повторного запуску.</div>
        {% endif %}
        {% if evaluated|default(false) %}
            <div class="cos-alert cos-alert--success" role="status">Оцінку бізнес-результату збережено на основі даних відповідального домену.</div>
        {% endif %}
        {% if outcomeError|default(false) %}
            <div class="cos-alert" role="alert">Не вдалося перевірити результат. Запуск має бути завершений, а джерело даних доступне.</div>
        {% endif %}
        <div class="cos-page__stack">
        {% for run in runs|default([]) %}
            <article class="cos-card" data-run-id="{{ run.run_id }}" data-recovery-mode="{{ mode }}">
                <p class="cos-card__eyebrow">Run: {{ run.state }}</p>
                {% if run.created_at_kyiv is defined %}
                    <p class="cos-card__copy">Початок: {{ run.created_at_kyiv }} (Київ)</p>
                {% endif %}
                <h3 class="cos-card__title">Ціль {{ run.goal_id }}</h3>
                <div class="cos-page__stack" data-goal-outcome-summary>
                    {% if run.outcome is defined and run.outcome %}
                        {% set outcomeLabels = {
                            'satisfied': 'Ціль досягнуто',
                            'partial': 'Частково досягнуто',
                            'unsatisfied': 'Ціль не досягнуто',
                            'unverifiable': 'Результат не підтверджено'
                        } %}
                        <p class="cos-card__copy" data-goal-outcome-result="{{ run.outcome.result }}">
                            <strong>Бізнес-результат:</strong> {{ outcomeLabels[run.outcome.result]|default('Потребує перевірки') }}.
                            {% if run.outcome.result == 'unverifiable' %}
                                Немає достатніх достовірних даних для підтвердження критеріїв.
                            {% endif %}
                        </p>
                        <p class="cos-card__copy" data-goal-outcome-attribution>
                            {% if run.outcome.criteria|filter(c => c.result != 'unverifiable' and c.attribution|default('temporal_only') != 'run_linked_action')|length > 0 %}
                                Увага: частина результатів є спостереженнями за періодом. Їхній зв'язок із конкретним Run не підтверджено.
                            {% elseif run.outcome.criteria|filter(c => c.attribution|default('') == 'run_linked_action')|length > 0 %}
                                Результати пов’язані з перевіреними Action цього Run. Економічну причинність не доведено.
                            {% else %}
                                Немає підтверджених бізнес-результатів або атрибуції.
                            {% endif %}
                        </p>
                        <p class="cos-card__copy">Оцінено: {{ run.outcome.recorded_at_kyiv|default(run.outcome.recorded_at ~ ' UTC') }} (Київ).
                            Перевірено {{ run.outcome.criteria|filter(c => c.result != 'unverifiable')|length }}
                            із {{ run.outcome.criteria|length }} критеріїв.</p>
                        {% if mode in ['process', 'expert'] %}
                            <div class="cos-page__stack" data-goal-outcome-process>
                                {% for criterion in run.outcome.criteria %}
                                    <p class="cos-card__copy">
                                        <strong>{{ criterion.criterion_id }}</strong>:
                                        {{ criterion.observed is not null ? criterion.observed : 'Немає вимірювання' }}
                                        (ціль: {{ criterion.expected }}), стан: {{ criterion.result }}.
                                        {% if criterion.result != 'unverifiable' %}
                                            <span data-goal-criterion-attribution>
                                                {{ criterion.attribution|default('temporal_only') == 'run_linked_action'
                                                    ? 'Є записаний зв’язок із перевіреною дією Run'
                                                    : 'Лише часовий збіг, не доказ причинності' }}.
                                            </span>
                                        {% endif %}
                                        {% if criterion.source is defined and criterion.source %}
                                            Джерело: {{ criterion.source }}.
                                        {% endif %}
                                        {% if mode == 'expert' %}
                                            <span data-goal-outcome-expert>
                                                {% if criterion.window_start is defined and criterion.window_start %}
                                                    Інтервал (Київ): {{ criterion.window_start_kyiv|default(criterion.window_start) }} — {{ criterion.window_end_kyiv|default(criterion.window_end) }}.
                                                {% endif %}
                                                {% if criterion.verified_actions is defined and criterion.verified_actions is not null %}
                                                    <code>Verified Actions: {{ criterion.verified_actions }}</code>
                                                {% endif %}
                                                {% for evidence in criterion.evidence %}
                                                    <code>{{ evidence }}</code>
                                                {% endfor %}
                                            </span>
                                        {% endif %}
                                    </p>
                                {% endfor %}
                            </div>
                        {% endif %}
                        {% if mode == 'expert' %}
                            <p class="cos-card__copy" data-goal-outcome-expert>
                                <code>Evaluation: {{ run.outcome.evaluation_id }}</code>,
                                <code>Policy: {{ run.outcome.evidence_policy }}</code>,
                                Goal version {{ run.outcome.specification_version }}.
                            </p>
                        {% endif %}
                    {% elseif run.outcome_unavailable|default(false) %}
                        <p class="cos-card__copy" role="status" data-goal-outcome-result="unavailable">
                            Збережена оцінка недоступна для перевірки. Успіх цілі не підтверджено.
                        </p>
                    {% else %}
                        <p class="cos-card__copy" data-goal-outcome-result="pending">
                            {% if run.state == 'completed' %}
                                Бізнес-результат ще не оцінювали. Завершення дій не означає досягнення цілі.
                            {% else %}
                                Оцінка бізнес-результату доступна після фіналізації виконання.
                            {% endif %}
                        </p>
                    {% endif %}
                    {% if run.state == 'completed' and not run.outcome_unavailable|default(false) %}
                        <form method="post" action="{{ path('cos_federation_goals_evaluate', {runId: run.run_id}) }}">
                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                            <button type="submit" class="cos-button cos-button--ghost">Перевірити бізнес-результат за даними доменів</button>
                        </form>
                    {% endif %}
                </div>
                <p class="cos-card__copy" data-goal-run-progress>
                    <strong>Прогрес:</strong> {{ run.completed_steps }}/{{ run.total_steps }} завершених кроків.
                    {% if run.canonical %}Джерело: Platform Workflow.{% else %}Історичний Federation Run.{% endif %}
                </p>
                {% if run.progress_error %}
                    <p class="cos-card__copy" role="alert">Стан кроків не вдалося перевірити. Виконання не слід вважати завершеним.</p>
                {% endif %}
                {% if run.canonical and run.state in ['created','running'] %}
                    <form method="post" action="{{ path('cos_federation_goals_advance_run',{runId:run.run_id}) }}">
                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                        <button class="cos-button cos-button--ghost" type="submit">Продовжити Platform Workflow</button>
                    </form>
                {% endif %}
                {% if run.recovery %}
                    <p class="cos-card__copy">Потребують уваги: <strong>{{ run.recovery.attention_count }}</strong>.
                        Готові до перевірки квитанцій: <strong>{{ run.recovery.recoverable_count }}</strong>.</p>
                    {% if run.recovery.attention_count > 0 %}
                        <div class="cos-alert" role="status">Є невизначені або непідтверджені дії. Автоматичний повтор заблокований.</div>
                    {% endif %}
                    {% if mode in ['process', 'expert'] %}
                        <div class="cos-page__stack" data-goal-recovery-process>
                        {% for step in run.recovery.steps %}
                            <p class="cos-card__copy">
                                Крок <strong>{{ step.step_id }}</strong>: {{ step.recovery_state }}
                                {% if step.attention_required %}(потребує ручної перевірки){% endif %}
                                {% if mode == 'expert' and step.action_id %}
                                    <code data-goal-recovery-expert>Action {{ step.action_id }}</code>
                                {% endif %}
                            </p>
                        {% endfor %}
                        </div>
                    {% endif %}
                    {% if run.recovery.recoverable_count > 0 %}
                        <form method="post" action="{{ path('cos_federation_goals_reconcile', {runId: run.run_id}) }}">
                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                            <button type="submit" class="cos-button cos-button--ghost">Звірити завершені дії без повторного запуску</button>
                        </form>
                    {% endif %}
                {% elseif not run.canonical %}
                    <p class="cos-card__copy">Діагностика історичного виконання недоступна. Зверніться до адміністратора.</p>
                {% elseif run.state in ['waiting','ambiguous'] %}
                    <p class="cos-card__copy">Workflow очікує погодження Action, зовнішньої квитанції або ручного reconciliation. Автоматичний повтор заблокований.</p>
                {% endif %}
                {% if mode == 'expert' %}
                    <p class="cos-card__copy"><code>Run ID: {{ run.run_id }}</code>,
                        <code>Plan ID: {{ run.plan_id }}</code>, revision {{ run.revision }}</p>
                    <a class="cos-button cos-button--ghost" href="{{ path('cos_federation_run_recovery', {runId: run.run_id}) }}">Детальна діагностика JSON</a>
                {% endif %}
            </article>
        {% else %}
            <div class="cos-card"><p class="cos-card__copy">Запусків поки немає. Визначте бізнес-ціль і погодьте план через управління Federation.</p></div>
        {% endfor %}
        </div>
    </section>
    <aside class="cos-card" aria-label="Обмеження виконання">
        <h2 class="cos-card__title">Увага до ризиків і погоджень</h2>
        <p class="cos-card__copy">Результат роботи агента не дорівнює досягненню бізнес-мети. Для кожної оцінки потрібні перевірені факти. Небезпечні дії потребують окремої політики та погодження.</p>
    </aside>
</section>
{% endblock %}
