{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}{{ pageTitle }} | Terra Nova COS{% endblock %}
{% block workspace_content %}
{% set w=workspace|default({}) %}{% set v=growthView %}
<div class="cos-page__stack cos-growth-workspace" data-controller="growth" data-csrf="{{ csrfToken }}"
 {% if v=='growth/candidate' %}data-growth-candidate data-candidate-id="{{ w.candidate.candidate_id|default('') }}"{% endif %}
 {% if v=='growth/collectors' %}data-growth-collectors{% endif %}{% if v=='growth/learning' %}data-growth-learning{% endif %}
 {% if v=='growth/experiments' %}data-growth-experiments{% endif %}{% if v=='growth/experiment' %}data-growth-experiment data-experiment-id="{{ w.brief.experiment.experiment_id|default('') }}"{% endif %}
 {% if v=='growth/settings' %}data-growth-settings{% endif %}{% if v=='growth/market' %}data-growth-market{% endif %}>
<header class="cos-growth-header"><div><small>Growth · Canonical Workspace</small><h1>{{ pageTitle }}</h1></div><nav class="cos-growth-actions"><a class="btn btn-outline-secondary" href="/growth">Overview</a><a class="btn btn-outline-secondary" href="/growth/candidates">Opportunities</a><a class="btn btn-outline-secondary" href="/growth/accounts">Accounts</a></nav></header>
{% if v=='error/failure' %}<section class="cos-panel"><h2>{{ failureTitle|default('Growth unavailable') }}</h2><p>{{ failureMessage|default('The Growth workspace could not be loaded.') }}</p><strong>{{ failureCode|default(500) }}</strong><p>{{ failureRequestId|default('—') }}</p></section>
{% elseif v=='growth/dashboard' %}
<section class="cos-growth-kpis">{% for x in [['Candidates',w.candidate_total|default(0)],['Qualified',w.qualified_total|default(0)],['Ready',w.ready_total|default(0)],['Monitoring',w.monitoring_total|default(0)],['Accounts',w.account_total|default(0)],['Signals',w.signal_total|default(0)]] %}<article class="cos-growth-kpi"><small>{{ x[0] }}</small><h2>{{ x[1] }}</h2></article>{% endfor %}</section>
<section class="cos-panel"><h2>Recently updated opportunities</h2>{% for c in w.recent_candidates|default([]) %}<a class="cos-growth-row" href="/growth/candidates/{{ c.candidate_id|url_encode }}"><span><strong>{{ c.account_name|default(c.subject_id|default('Opportunity')) }}</strong><small>{{ c.candidate_id }}</small></span><span>{{ c.status|upper }}</span><span>{{ c.growth_mode|default('—') }}</span><span>{{ c.target_domain|default('—') }}</span></a>{% else %}<p>No opportunities yet.</p>{% endfor %}</section>
{% elseif v=='growth/accounts' %}<form class="cos-panel cos-growth-filter"><input name="q" value="{{ query.q|default('') }}" placeholder="Search account/domain"><button class="btn btn-primary">Filter</button></form><section class="cos-panel">{% for a in w.accounts|default([]) %}<a class="cos-growth-row" href="/growth/accounts/{{ a.account_id|url_encode }}"><span><strong>{{ a.name|default('Account') }}</strong><small>{{ a.canonical_domain|default('') }}</small></span><span>ICP {{ a.latest_fit_score is null ? '—':a.latest_fit_score~'%' }}</span><span>{{ a.committee_coverage is null ? '—':a.committee_coverage~'%' }}</span><span>{{ a.candidate_count|default(0) }} candidates</span></a>{% else %}<p>No accounts match.</p>{% endfor %}</section>
{% elseif v=='growth/account' %}{% set b=w.account|default({}) %}{% set a=b.account|default(b) %}<section class="cos-panel"><h2>{{ a.name|default('Account') }}</h2><p>{{ a.canonical_domain|default('') }}</p><p>ICP fit: {{ b.icp_match.fit_score|default('—') }} · Committee: {{ w.committee.assessment.coverage_score|default('—') }}</p></section><section class="cos-panel"><h2>Opportunity candidates</h2>{% for c in w.candidates|default([]) %}<a class="cos-growth-row" href="/growth/candidates/{{ c.candidate_id|url_encode }}"><strong>{{ c.candidate_id }}</strong><span>{{ c.status|upper }}</span><span>{{ c.target_domain|default('—') }}</span></a>{% else %}<p>No candidates.</p>{% endfor %}</section>
{% elseif v=='growth/candidates' %}<form class="cos-panel cos-growth-filter"><input name="q" value="{{ query.q|default('') }}" placeholder="Search"><input name="status" value="{{ query.status|default('') }}" placeholder="Status"><input name="growth_mode" value="{{ query.growth_mode|default('') }}" placeholder="Mode"><input name="target_domain" value="{{ query.target_domain|default('') }}" placeholder="Target"><button class="btn btn-primary">Filter</button></form><section class="cos-panel">{% for c in w.candidates|default([]) %}<a class="cos-growth-row" href="/growth/candidates/{{ c.candidate_id|url_encode }}"><span><strong>{{ c.account_name|default(c.subject_id|default('Opportunity')) }}</strong><small>{{ c.candidate_id }}</small></span><span>{{ c.opportunity_type|default('—') }}</span><span>{{ c.status|upper }}</span><span>{{ c.signal_count|default(0) }} signals</span><span>{{ c.target_domain|default('—') }}</span></a>{% else %}<p>No candidates match.</p>{% endfor %}</section>
{% elseif v=='growth/signals' %}<section class="cos-panel">{% for s in w.signals|default([]) %}<div class="cos-growth-row"><span><strong>{{ s.signal_type|default('Signal') }}</strong><small>{{ s.signal_id }}</small></span><span>{{ s.subject_type }} · {{ s.subject_id }}</span><span>{{ s.collector_name|default('manual') }}</span><span>{{ ((s.confidence|default(0))*100)|round }}%</span></div>{% else %}<p>No signals.</p>{% endfor %}</section>
{% elseif v=='growth/market' %}{% if canManageGrowth %}<section class="cos-panel"><h2>Create Market Universe</h2><form class="cos-growth-form" data-growth-market-create><input name="name" required placeholder="Name"><input name="url" type="url" required placeholder="Provider URL"><select name="auth_mode"><option value="bearer">Bearer</option><option value="api_key_header">API key header</option></select><input name="credential_reference" required placeholder="Credential reference"><input name="api_key_header" placeholder="X-Api-Key"><input name="profile_id" required placeholder="ICP profile"><input name="profile_revision" type="number" value="1"><input name="min_icp_fit" type="number" value="60"><input name="opportunity_type" required placeholder="Opportunity type"><input name="growth_mode" required placeholder="Mode"><input name="target_domain" required placeholder="Target"><label><input type="checkbox" name="enabled" checked> Enabled</label><button class="btn btn-primary">Create</button><small data-growth-form-status></small></form></section>{% endif %}<section class="cos-panel">{% for u in w.universes|default([]) %}<article><h3>{{ u.name }}</h3><p>{{ u.member_count|default(0) }} accounts · {{ u.opportunity_count|default(0) }} opportunities · {{ u.latest_run_status|default('—') }}</p>{% if canManageGrowth %}<form data-growth-market-run data-universe-id="{{ u.universe_id }}"><input name="limit" type="number" value="100"><button class="btn btn-primary">Run discovery</button><small data-growth-form-status></small></form>{% endif %}</article>{% else %}<p>No universes.</p>{% endfor %}</section>
{% elseif v=='growth/collectors' %}<section class="cos-panel"><h2>Collectors</h2>{% for name in w.collectors|default([]) %}<article><strong>{{ name }}</strong>{% if canManageGrowth %}<form data-growth-collector-run data-collector-name="{{ name }}"><input name="cursor" placeholder="Cursor"><input name="limit" type="number" value="100"><button class="btn btn-primary">Run</button><small data-growth-form-status></small></form>{% endif %}</article>{% else %}<p>No collectors.</p>{% endfor %}</section><section class="cos-panel"><h2>Recent runs</h2>{% for r in w.runs|default([]) %}<div class="cos-growth-row"><strong>{{ r.collector_name }}</strong><span>{{ r.status|upper }}</span><span>{{ r.accepted_count|default(0) }} accepted</span><span>{{ r.failed_count|default(0) }} failed</span></div>{% else %}<p>No runs.</p>{% endfor %}</section>
{% elseif v=='growth/learning' %}<section class="cos-growth-kpis">{% for key,label in {contacted:'Contacted',qualified:'Qualified',reply_received:'Replies',meeting_completed:'Meetings',won:'Won',lost:'Lost'} %}<article class="cos-growth-kpi"><small>{{ label }}</small><h2>{{ w.learning.counts[key]|default(0) }}</h2></article>{% endfor %}</section><section class="cos-panel"><h2>Outcome evidence</h2>{% for o in w.outcomes|default([]) %}<a class="cos-growth-row" href="/growth/candidates/{{ o.candidate_id|url_encode }}"><strong>{{ o.outcome_type|upper }}</strong><span>{{ o.account_name|default(o.subject_id|default(o.candidate_id)) }}</span><span>{{ o.reason_code|default('—') }}</span><span>{{ o.economic_value|default('—') }} {{ o.currency|default('') }}</span></a>{% else %}<p>No outcomes.</p>{% endfor %}</section>
{% elseif v=='growth/experiments' %}<section class="cos-panel">{% for e in w.experiments|default([]) %}<a class="cos-growth-row" href="/growth/experiments/{{ e.experiment_id|url_encode }}"><span><strong>{{ e.name|default('Experiment') }}</strong><small>{{ e.experiment_id }}</small></span><span>{{ e.dimension }}</span><span>{{ e.status|upper }}</span><span>{{ e.variants|default([])|length }} variants</span></a>{% else %}<p>No experiments.</p>{% endfor %}</section>
{% elseif v=='growth/experiment' %}{% set e=w.brief.experiment|default({}) %}<section class="cos-panel"><h2>{{ e.name|default('Experiment') }}</h2><p>{{ e.hypothesis|default('') }}</p><p>Status: {{ e.status|default('unknown')|upper }} · {{ e.variants|default([])|length }} variants</p>{% if canManageGrowth %}{% for t in ['start','pause','resume','complete','archive'] %}<button class="btn btn-outline-secondary" data-growth-experiment-transition="{{ t }}">{{ t|title }}</button>{% endfor %}<small data-growth-experiment-status></small>{% endif %}</section>
{% elseif v=='growth/settings' %}{% set l=w.engagement_limits.effective|default({}) %}{% set a=w.engagement_activation.effective|default({}) %}<section class="cos-panel"><h2>Outreach governance</h2><p>Daily limit {{ l.daily_limit|default('—') }} · cooldown {{ l.contact_cooldown_hours|default('—') }}h</p>{% if canManageGrowth %}<form data-growth-limit-settings class="cos-growth-form"><input name="daily_limit" type="number" value="{{ l.daily_limit|default(50) }}"><input name="email_daily_limit" type="number" value="{{ l.channel_daily_limits.email|default(50) }}"><input name="linkedin_daily_limit" type="number" value="{{ l.channel_daily_limits.linkedin|default(50) }}"><input name="phone_daily_limit" type="number" value="{{ l.channel_daily_limits.phone|default(50) }}"><input name="contact_cooldown_hours" type="number" value="{{ l.contact_cooldown_hours|default(24) }}"><input name="reason" required placeholder="Change reason"><button class="btn btn-primary">Save limits</button><small data-growth-form-status></small></form>{% endif %}</section>
{% elseif v=='growth/candidate' %}{% set c=w.candidate|default({}) %}<section class="cos-panel"><h2>{{ c.subject_id|default('Opportunity') }}</h2><p>{{ c.opportunity_type|default('') }} · {{ c.growth_mode|default('') }} → {{ c.target_domain|default('') }}</p><p>Status {{ c.status|default('unknown')|upper }}</p></section><section class="cos-panel"><h2>Evidence</h2>{% for s in w.signals|default([]) %}<div class="cos-growth-row"><strong>{{ s.signal_type }}</strong><span>{{ s.source_reference|default('') }}</span><span>{{ ((s.confidence|default(0))*100)|round }}%</span></div>{% else %}<p>No linked signals.</p>{% endfor %}</section><section class="cos-panel"><h2>Actions</h2>{% if canManageGrowth %}<button class="btn btn-primary" data-growth-action="research-generate">Generate research</button><button class="btn btn-outline-secondary" data-growth-engagement-generate>Generate next action</button><form data-growth-handoff-prepare class="cos-growth-form"><input name="target_domain" value="{{ c.target_domain|default('sales') }}"><input name="reason" placeholder="Reason"><button class="btn btn-primary">Prepare handoff</button><small data-growth-form-status></small></form>{% endif %}<small data-growth-action-status></small><small data-growth-engagement-status></small></section>
{% endif %}</div>{% endblock %}
