{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}{{ pageTitle }} | Terra Nova COS{% endblock %}
{% block workspace_content %}
{% set w = workspace|default({}) %}
{% set v = growthView %}
<div class="cos-page__stack cos-growth-workspace"
     data-controller="growth"
     {% if page %}
     data-cos-archetype="{{ page.archetypeId() }}"
     data-cos-page-state="{{ page.state }}"
     data-cos-page-density="{{ page.density }}"
     {% endif %}
     data-csrf="{{ csrfToken }}"
     {% if v=='growth/candidate' %}data-growth-candidate data-candidate-id="{{ w.candidate.candidate_id|default('') }}"{% endif %}
     {% if v=='growth/collectors' %}data-growth-collectors{% endif %}
     {% if v=='growth/learning' %}data-growth-learning{% endif %}
     {% if v=='growth/experiments' %}data-growth-experiments{% endif %}
     {% if v=='growth/experiment' %}data-growth-experiment data-experiment-id="{{ w.brief.experiment.experiment_id|default('') }}"{% endif %}
     {% if v=='growth/settings' %}data-growth-settings{% endif %}
     {% if v=='growth/market' %}data-growth-market{% endif %}>
  {% if v == 'growth/dashboard' %}
    <twig:CosPageHeader
      eyebrow="Growth · Opportunity Intelligence"
      title="Growth Overview"
      subtitle="Signals, qualified opportunities and the next useful action across the Growth pipeline."
      metaValue="{{ w.ready_total|default(0) }}"
      metaLabel="ready opportunities"
    >
      <twig:CosButton label="Opportunities" href="/growth/candidates" variant="primary" />
      <twig:CosButton label="Accounts" href="/growth/accounts" variant="ghost" />
      <twig:CosButton label="Signals" href="/growth/signals" variant="ghost" />
    </twig:CosPageHeader>
  {% else %}
    <header class="cos-growth-header">
      <div><small>Growth · Canonical Workspace</small><h1>{{ pageTitle }}</h1></div>
      <nav class="cos-growth-actions">
        <a class="btn btn-outline-secondary" href="/growth">Overview</a>
        <a class="btn btn-outline-secondary" href="/growth/candidates">Opportunities</a>
        <a class="btn btn-outline-secondary" href="/growth/accounts">Accounts</a>
      </nav>
    </header>
  {% endif %}

  {% if v=='error/failure' %}
    <section class="cos-panel">
      <h2>{{ failureTitle|default('Growth unavailable') }}</h2>
      <p>{{ failureMessage|default('The Growth workspace could not be loaded.') }}</p>
      <strong>{{ failureCode|default(500) }}</strong><p>{{ failureRequestId|default('—') }}</p>
    </section>

  {% elseif v=='growth/dashboard' %}
    <section class="cos-kpi-strip" aria-label="Growth operating state">
      <twig:CosMetric label="Candidates" value="{{ w.candidate_total|default(0) }}" hint="known opportunities" />
      <twig:CosMetric label="Qualified" value="{{ w.qualified_total|default(0) }}" hint="passed qualification" />
      <twig:CosMetric label="Ready" value="{{ w.ready_total|default(0) }}" hint="ready for next action" />
      <twig:CosMetric label="Monitoring" value="{{ w.monitoring_total|default(0) }}" hint="awaiting stronger signal" />
      <twig:CosMetric label="Accounts" value="{{ w.account_total|default(0) }}" hint="tracked accounts" />
      <twig:CosMetric label="Signals" value="{{ w.signal_total|default(0) }}" hint="observed evidence" />
    </section>

    <twig:CosToolbar label="Growth focus">
      {% block start %}
        <span class="cos-badge">Priority: ready opportunities</span>
      {% endblock %}
      {% block end %}
        <twig:CosButton label="Market discovery" href="/growth/market" variant="ghost" />
        <twig:CosButton label="Learning" href="/growth/learning" variant="ghost" />
      {% endblock %}
    </twig:CosToolbar>

    <section class="cos-page__section" aria-labelledby="growth-recent-opportunities">
      <div class="cos-page__section-head">
        <div>
          <h2 id="growth-recent-opportunities">Recently updated opportunities</h2>
          <p>Start with the newest evidence, then open the opportunity that needs a decision or next action.</p>
        </div>
      </div>
      <div class="cos-page__stack" role="list" aria-label="Recently updated opportunities">
        {% for c in w.recent_candidates|default([]) %}
          <twig:CosEntityListItem
            title="{{ c.account_name|default(c.subject_id|default('Opportunity')) }}"
            subtitle="{{ c.growth_mode|default('Opportunity') }} · {{ c.target_domain|default('unassigned') }}"
            statusLabel="{{ c.status|default('unknown')|upper }}"
            href="/growth/candidates/{{ c.candidate_id|url_encode }}"
            meta="{{ c.candidate_id }}"
          />
        {% else %}
          <twig:CosEmptyState
            title="No opportunities yet"
            copy="Growth will surface opportunities here after signals create or update candidates."
          />
        {% endfor %}
      </div>
    </section>

  {% elseif v=='growth/accounts' %}
    <form class="cos-panel cos-growth-filter"><input name="q" value="{{ query.q|default('') }}" placeholder="Search account/domain"><button class="btn btn-primary">Filter</button></form>
    <section class="cos-panel">
      {% for a in w.accounts|default([]) %}
        <a class="cos-growth-row" href="/growth/accounts/{{ a.account_id|url_encode }}"><span><strong>{{ a.name|default('Account') }}</strong><small>{{ a.canonical_domain|default('') }}</small></span><span>ICP {{ a.latest_fit_score is null ? '—' : a.latest_fit_score~'%' }}</span><span>{{ a.committee_coverage is null ? '—' : a.committee_coverage~'%' }}</span><span>{{ a.candidate_count|default(0) }} candidates</span></a>
      {% else %}<p>No accounts match.</p>{% endfor %}
    </section>

  {% elseif v=='growth/account' %}
    {% set b = w.account|default({}) %}{% set a = b.account|default(b) %}
    <section class="cos-panel"><h2>{{ a.name|default('Account') }}</h2><p>{{ a.canonical_domain|default('') }}</p><p>ICP fit: {{ b.icp_match.fit_score|default('—') }} · Committee: {{ w.committee.assessment.coverage_score|default('—') }}</p></section>
    <section class="cos-panel"><h2>Opportunity candidates</h2>{% for c in w.candidates|default([]) %}<a class="cos-growth-row" href="/growth/candidates/{{ c.candidate_id|url_encode }}"><strong>{{ c.candidate_id }}</strong><span>{{ c.status|upper }}</span><span>{{ c.target_domain|default('—') }}</span></a>{% else %}<p>No candidates.</p>{% endfor %}</section>

  {% elseif v=='growth/candidates' %}
    <form class="cos-panel cos-growth-filter"><input name="q" value="{{ query.q|default('') }}" placeholder="Search"><input name="status" value="{{ query.status|default('') }}" placeholder="Status"><input name="growth_mode" value="{{ query.growth_mode|default('') }}" placeholder="Mode"><input name="target_domain" value="{{ query.target_domain|default('') }}" placeholder="Target"><button class="btn btn-primary">Filter</button></form>
    <section class="cos-panel">{% for c in w.candidates|default([]) %}<a class="cos-growth-row" href="/growth/candidates/{{ c.candidate_id|url_encode }}"><span><strong>{{ c.account_name|default(c.subject_id|default('Opportunity')) }}</strong><small>{{ c.candidate_id }}</small></span><span>{{ c.opportunity_type|default('—') }}</span><span>{{ c.status|upper }}</span><span>{{ c.signal_count|default(0) }} signals</span><span>{{ c.target_domain|default('—') }}</span></a>{% else %}<p>No candidates match.</p>{% endfor %}</section>

  {% elseif v=='growth/signals' %}
    <section class="cos-panel">{% for s in w.signals|default([]) %}<div class="cos-growth-row"><span><strong>{{ s.signal_type|default('Signal') }}</strong><small>{{ s.signal_id }}</small></span><span>{{ s.subject_type }} · {{ s.subject_id }}</span><span>{{ s.collector_name|default('manual') }}</span><span>{{ ((s.confidence|default(0))*100)|round }}%</span></div>{% else %}<p>No signals.</p>{% endfor %}</section>

  {% elseif v=='growth/market' %}
    {% if canManageGrowth %}
      <section class="cos-panel">
        <h2>Create Market Universe</h2><p>Opportunity creation waits for an observed Signal; discovery alone does not manufacture pipeline truth.</p>
        <form class="cos-growth-form" data-growth-market-create>
          <input name="name" required placeholder="Market Universe name"><input name="url" type="url" required placeholder="Provider URL">
          <select name="auth_mode"><option value="bearer">Bearer</option><option value="api_key_header">API key header</option></select>
          <input name="credential_reference" required placeholder="Credential reference"><input name="api_key_header" placeholder="X-* API key header">
          <input name="profile_id" required placeholder="ICP profile"><input name="profile_revision" type="number" value="1" min="1"><input name="min_icp_fit" type="number" value="60" min="0" max="100">
          <input name="opportunity_type" required placeholder="Opportunity type"><input name="growth_mode" required placeholder="Growth mode"><input name="target_domain" required placeholder="Target domain">
          <label><input type="checkbox" name="enabled" checked> Enabled</label><button class="btn btn-primary" type="submit">Create Market Universe</button><small data-growth-form-status></small>
        </form>
      </section>
    {% endif %}
    <section class="cos-panel"><h2>Market Universe registry</h2>
      {% for u in w.universes|default([]) %}
        <article class="tn-growth-optimization-card"><h3>{{ u.name }}</h3><p>{{ u.member_count|default(0) }} accounts · {{ u.opportunity_count|default(0) }} opportunities · {{ u.latest_run_status|default('—') }}</p>
          {% if canManageGrowth %}
            <form data-growth-market-run data-universe-id="{{ u.universe_id }}"><input name="limit" type="number" value="100" min="1" max="200"><button class="btn btn-primary" type="submit">Run discovery</button><small data-growth-form-status></small></form>
            <form data-growth-market-toggle data-universe-id="{{ u.universe_id }}" data-action="{{ u.enabled|default(false) ? 'disable' : 'enable' }}"><button class="btn btn-outline-secondary" type="submit">{{ u.enabled|default(false) ? 'Disable' : 'Enable' }}</button><small data-growth-form-status></small></form>
          {% endif %}
        </article>
      {% else %}<p>No universes.</p>{% endfor %}
    </section>

  {% elseif v=='growth/collectors' %}
    {% set polling = w.polling|default({}) %}
    <section class="cos-panel" data-growth-polling-status><h2>Scheduled Signal Polling</h2><p>Automatic monitoring: {{ polling.enabled|default(false) ? 'enabled' : 'disabled' }} · {{ polling.ready|default(false) ? 'ready' : polling.reason|default('not ready') }}</p><p>System actor: {{ polling.actor_configured|default(false) ? 'configured' : 'not configured' }} · Enabled sources: {{ polling.enabled_source_count|default(0) }} · Per-run limit: {{ polling.signal_limit|default('—') }}</p><p>Interval: {{ polling.interval_minutes|default('—') }} minutes. Scheduler configuration is deployment-owned and read-only here.</p></section>
    <section class="cos-panel" data-growth-polling-health><h2>Collector health</h2>{% for collector, health in polling.collector_health|default({}) %}<div class="cos-growth-row"><strong>{{ collector }}</strong><span>{{ health.status|default('unknown') }}</span><span>Consecutive failures: {{ health.consecutive_failures|default(0) }}</span><span>Next retry: {{ health.next_retry_at|default('—') }}</span></div>{% else %}<p>No collector health observations.</p>{% endfor %}</section>
    <section class="cos-panel" data-growth-polling-incidents><h2>Active collector incidents</h2>{% for incident in polling.active_incidents|default([]) %}<div class="cos-growth-row"><strong>{{ incident.collector_name|default('Collector') }}</strong><span>Failure count: {{ incident.failure_count|default(incident.consecutive_failures|default('—')) }}</span><span>Opened: {{ incident.opened_at|default('—') }}</span><span>Last failure: {{ incident.last_failure_at|default('—') }}</span></div>{% else %}<p>No active incidents.</p>{% endfor %}</section>
    <section class="cos-panel"><h2>Collectors</h2><div class="tn-growth-collector-grid">{% for name in w.collectors|default([]) %}<article><strong>{{ name }}</strong>{% if canManageGrowth %}<form data-growth-collector-run data-collector-name="{{ name }}"><input name="cursor" placeholder="Cursor"><input name="limit" type="number" value="100"><button class="btn btn-primary" type="submit">Run</button><small data-growth-form-status></small></form>{% endif %}</article>{% else %}<p>No collectors.</p>{% endfor %}</div></section>

    <section class="cos-panel" data-growth-signal-feeds><h2>RSS / Atom Feeds</h2>
      {% if canManageGrowth %}<form class="cos-growth-form" data-growth-signal-feed-create><input name="name" required placeholder="Feed name"><input name="url" type="url" required placeholder="HTTPS feed URL"><input name="subject_type" required placeholder="Subject type"><input name="subject_id" required placeholder="Subject ID"><input name="signal_type" required placeholder="Signal type"><label>Confidence <input name="confidence" type="number" step="0.01" min="0" max="1" value="0.75"></label><label><input name="enabled" type="checkbox" checked> Enabled</label><button class="btn btn-primary" type="submit">Add feed</button><small data-growth-form-status></small></form>{% endif %}
      {% for feed in w.feeds|default([]) %}<article class="cos-growth-row"><span><strong>{{ feed.name|default('Feed') }}</strong><small>{{ feed.url|default('') }}</small></span><span>{{ feed.signal_type|default('Signal') }}</span>{% if canManageGrowth %}<form data-growth-signal-feed-toggle data-feed-id="{{ feed.feed_id|default(feed.source_id|default('')) }}" data-action="{{ feed.enabled|default(false) ? 'disable' : 'enable' }}"><button class="btn btn-outline-secondary" type="submit">{{ feed.enabled|default(false) ? 'Disable' : 'Enable' }}</button><small data-growth-form-status></small></form>{% endif %}</article>{% else %}<p>No RSS / Atom feeds.</p>{% endfor %}
    </section>

    <section class="cos-panel" data-growth-json-signal-sources><h2>JSON API Sources</h2><p>Credential reference is supplied only when creating a source; stored secrets are never rendered back into the workspace.</p>
      {% if canManageGrowth %}<form class="cos-growth-form" data-growth-json-source-create><input name="name" required placeholder="Source name"><input name="url" type="url" required placeholder="HTTPS JSON API URL"><select name="auth_mode"><option value="bearer">Bearer token</option><option value="api_key_header">X-* API key header</option></select><input name="credential_reference" required placeholder="Credential reference"><input name="api_key_header" placeholder="X-* API key header"><input name="subject_type" required placeholder="Subject type"><input name="subject_id" required placeholder="Subject ID"><input name="signal_type" required placeholder="Signal type"><input name="confidence" type="number" step="0.01" min="0" max="1" value="0.75"><label><input name="enabled" type="checkbox" checked> Enabled</label><button class="btn btn-primary" type="submit">Add JSON source</button><small data-growth-form-status></small></form>{% endif %}
      {% for source in w.json_sources|default([]) %}<article class="cos-growth-row"><span><strong>{{ source.name|default('JSON source') }}</strong><small>{{ source.url|default('') }}</small></span><span>{{ source.credential_configured|default(false) ? 'credential_configured' : 'credential_missing' }}</span>{% if canManageGrowth %}<form data-growth-json-source-toggle data-source-id="{{ source.source_id|default('') }}" data-action="{{ source.enabled|default(false) ? 'disable' : 'enable' }}"><button class="btn btn-outline-secondary" type="submit">{{ source.enabled|default(false) ? 'Disable' : 'Enable' }}</button><small data-growth-form-status></small></form>{% endif %}</article>{% else %}<p>No JSON API sources.</p>{% endfor %}
    </section>

    <section class="cos-panel" data-growth-collector-alert-subscriptions><h2>Collector incident email alerts</h2>
      {% if canManageGrowth %}<form class="cos-growth-form" data-growth-collector-alert-create><input name="recipient_email" type="email" required placeholder="Recipient email"><input name="recipient_name" placeholder="Recipient name"><input name="locale" value="en" required><label><input name="enabled" type="checkbox" checked> Enabled</label><button class="btn btn-primary" type="submit">Add recipient</button><small data-growth-form-status></small></form>{% endif %}
      {% for subscription in w.alert_subscriptions|default([]) %}<article class="cos-growth-row"><strong>{{ subscription.recipient_email|default('Recipient') }}</strong><span>{{ subscription.locale|default('en') }}</span>{% if canManageGrowth %}<form data-growth-collector-alert-toggle data-subscription-id="{{ subscription.subscription_id|default('') }}" data-action="{{ subscription.enabled|default(false) ? 'disable' : 'enable' }}"><button class="btn btn-outline-secondary" type="submit">{{ subscription.enabled|default(false) ? 'Disable' : 'Enable' }}</button><small data-growth-form-status></small></form>{% endif %}</article>{% else %}<p>No alert recipients.</p>{% endfor %}
    </section>

    <section class="cos-panel"><h2>Recent runs</h2>{% for r in w.runs|default([]) %}<div class="cos-growth-row"><strong>{{ r.collector_name }}</strong><span>{{ r.status|upper }}</span><span>{{ r.accepted_count|default(0) }} accepted</span><span>{{ r.failed_count|default(0) }} failed</span></div>{% else %}<p>No runs.</p>{% endfor %}</section>

  {% elseif v=='growth/learning' %}
    {% set optimization = w.optimization|default({}) %}{% set optimizationContext = optimization.context|default({}) %}{% set recommendation = optimization.latest_recommendation|default(null) %}
    <section class="cos-growth-kpis">{% for key,label in {contacted:'Contacted',qualified:'Qualified',reply_received:'Replies',meeting_completed:'Meetings',won:'Won',lost:'Lost'} %}<article class="cos-growth-kpi"><small>{{ label }}</small><h2>{{ w.learning.counts[key]|default(0) }}</h2></article>{% endfor %}</section>
    <section class="cos-panel"><h2>Learning → governed draft</h2><p>{{ optimizationContext.terminal_sample_size|default(0) }} terminal Candidate outcomes · minimum {{ optimizationContext.minimum_terminal_sample|default(8) }}</p><p>Learning can recommend a draft revision from recorded evidence. Activation remains a separate human-controlled operation.</p><div class="tn-growth-optimization-actions">{% if canManageGrowth %}<button class="btn btn-primary" type="button" data-growth-optimization-generate>Generate governed recommendation</button>{% endif %}<small data-growth-optimization-status></small></div></section>
    <section class="cos-panel"><h2>Current active criteria</h2><div class="tn-growth-optimization-grid">{% for targetType, targets in optimizationContext.active_targets|default({}) %}<article class="tn-growth-optimization-card"><h3>{{ targetType }}</h3><pre>{{ targets|json_encode }}</pre></article>{% else %}<p>No active optimization targets.</p>{% endfor %}</div></section>
    {% if recommendation %}
      <section class="cos-panel"><h2>Proposed draft criteria</h2><div class="tn-growth-optimization-grid"><article class="tn-growth-optimization-card"><h3>{{ recommendation.proposed_name|default('Governed draft') }}</h3><div class="tn-growth-optimization-meta"><span>{{ recommendation.target_type|default('target') }} · {{ recommendation.target_id|default('—') }}</span><span>Base revision {{ recommendation.base_revision|default('—') }}</span><span>Status {{ recommendation.status|default('proposed') }}</span><span>Confidence {{ recommendation.confidence|default('—') }}</span></div><pre>{{ recommendation.proposed_criteria|default({})|json_encode }}</pre><h3>Rationale</h3><p>{{ recommendation.rationale|default('—') }}</p></article><article class="tn-growth-optimization-card"><h3>Risks</h3>{% for risk in recommendation.risks|default([]) %}<p>{{ risk }}</p>{% else %}<p>None recorded.</p>{% endfor %}<h3>Assumptions</h3>{% for assumption in recommendation.assumptions|default([]) %}<p>{{ assumption }}</p>{% else %}<p>None recorded.</p>{% endfor %}</article></div>
        <div class="tn-growth-optimization-evidence"><h3>Evidence</h3>{% for evidenceId in recommendation.evidence_ids|default([]) %}<article><strong>{{ evidenceId }}</strong></article>{% else %}<p>No evidence IDs recorded.</p>{% endfor %}</div>
        {% if canManageGrowth %}<div class="tn-growth-optimization-actions">{% if recommendation.status|default('') == 'proposed' %}<form data-growth-optimization-decision="accept" data-recommendation-id="{{ recommendation.recommendation_id }}"><input name="reason" required placeholder="Acceptance reason"><button class="btn btn-primary" type="submit">Accept</button><small data-growth-form-status></small></form><form data-growth-optimization-decision="dismiss" data-recommendation-id="{{ recommendation.recommendation_id }}"><input name="reason" required placeholder="Dismissal reason"><button class="btn btn-outline-secondary" type="submit">Dismiss</button><small data-growth-form-status></small></form>{% elseif recommendation.status|default('') == 'accepted' %}<button class="btn btn-primary" type="button" data-growth-optimization-materialize data-recommendation-id="{{ recommendation.recommendation_id }}">Create draft revision</button>{% endif %}</div>{% endif %}
      </section>
    {% endif %}
    <section class="cos-panel"><h2>Outcome evidence</h2>{% for o in w.outcomes|default([]) %}<a class="cos-growth-row" href="/growth/candidates/{{ o.candidate_id|url_encode }}"><strong>{{ o.outcome_type|upper }}</strong><span>{{ o.account_name|default(o.subject_id|default(o.candidate_id)) }}</span><span>{{ o.reason_code|default('—') }}</span><span>{{ o.economic_value|default('—') }} {{ o.currency|default('') }}</span></a>{% else %}<p>No outcomes.</p>{% endfor %}</section>

  {% elseif v=='growth/experiments' %}
    {% if canManageGrowth %}
      <section class="cos-panel"><h2>Create experiment</h2><p>Experiments measure variants; this workspace does not automatically select a winner.</p>
        <form class="tn-growth-experiment-form" data-growth-experiment-create>
          <div class="tn-growth-experiment-fields"><input name="name" required placeholder="Experiment name"><input name="hypothesis" required placeholder="Hypothesis"><select name="dimension">{% for dimension in w.dimensions|default([]) %}<option value="{{ dimension }}">{{ dimension }}</option>{% endfor %}</select><select name="primary_outcome">{% for outcome in w.outcomes|default([]) %}<option value="{{ outcome }}">{{ outcome }}</option>{% endfor %}</select></div>
          <div class="tn-growth-experiment-variants" data-growth-experiment-variants>{% for row in [1,2] %}<div class="tn-growth-experiment-variant" data-growth-experiment-variant><input data-variant-key required placeholder="Variant key"><input data-variant-name required placeholder="Variant name"><input data-variant-weight type="number" min="1" value="1"><input data-variant-config value="{}" placeholder="JSON config"><button class="btn btn-outline-secondary" type="button" data-growth-experiment-variant-remove>Remove</button></div>{% endfor %}</div>
          <template data-growth-experiment-variant-template><div class="tn-growth-experiment-variant" data-growth-experiment-variant><input data-variant-key required placeholder="Variant key"><input data-variant-name required placeholder="Variant name"><input data-variant-weight type="number" min="1" value="1"><input data-variant-config value="{}" placeholder="JSON config"><button class="btn btn-outline-secondary" type="button" data-growth-experiment-variant-remove>Remove</button></div></template>
          <div class="tn-growth-experiment-actions"><button class="btn btn-outline-secondary" type="button" data-growth-experiment-variant-add>Add variant</button><button class="btn btn-primary" type="submit">Create experiment</button><small data-growth-form-status></small></div>
        </form>
      </section>
    {% endif %}
    <section class="cos-panel"><h2>Experiment registry</h2>{% for e in w.experiments|default([]) %}<a class="cos-growth-row" href="/growth/experiments/{{ e.experiment_id|url_encode }}"><span><strong>{{ e.name|default('Experiment') }}</strong><small>{{ e.experiment_id }}</small></span><span>{{ e.dimension }}</span><span>{{ e.status|upper }}</span><span>{{ e.variants|default([])|length }} variants</span></a>{% else %}<p>No experiments.</p>{% endfor %}</section>

  {% elseif v=='growth/experiment' %}
    {% set brief = w.brief|default({}) %}{% set e = brief.experiment|default({}) %}
    <section class="cos-panel"><h2>{{ e.name|default('Experiment') }}</h2><p>{{ e.hypothesis|default('') }}</p><p>Status: {{ e.status|default('unknown')|upper }} · {{ e.variants|default([])|length }} variants</p><p>Deterministic weighted assignment. Measurement only — no automatic winner selection.</p>{% if canManageGrowth %}{% for t in ['start','pause','resume','complete','archive'] %}<button class="btn btn-outline-secondary" type="button" data-growth-experiment-transition="{{ t }}">{{ t|title }}</button>{% endfor %}<small data-growth-experiment-status></small>{% endif %}</section>
    <section class="cos-panel"><h2>Variant outcomes</h2><div class="tn-growth-experiment-report">{% for variant in brief.attribution.variants|default([]) %}<article class="tn-growth-experiment-card"><h3>{{ variant.name|default(variant.variant_key|default('Variant')) }}</h3><pre>{{ variant|json_encode }}</pre></article>{% else %}<p>No attributed outcomes yet.</p>{% endfor %}</div></section>
    <section class="cos-panel"><h2>Candidate allocation</h2>{% if canManageGrowth %}<form class="tn-growth-experiment-assign" data-growth-experiment-assign><input name="candidate_id" required placeholder="Candidate ID"><input name="variant_key" placeholder="Variant key (optional)"><button class="btn btn-primary" type="submit">Assign</button><small data-growth-form-status></small></form>{% endif %}{% for assignment in brief.assignments|default([]) %}<div class="cos-growth-row"><strong>{{ assignment.candidate_id|default('Candidate') }}</strong><span>{{ assignment.variant_key|default('—') }}</span></div>{% else %}<p>No Candidate allocations.</p>{% endfor %}</section>

  {% elseif v=='growth/settings' %}
    {% set limits = w.engagement_limits.effective|default({}) %}{% set activation = w.engagement_activation.effective|default({}) %}{% set autonomy = w.engagement_autonomy.effective|default({}) %}{% set contentReview = w.engagement_content_review.effective|default({}) %}{% set sequence = w.engagement_sequence_policy.effective|default({}) %}
    <section class="cos-panel"><h2>Tenant outreach limits</h2><p>Daily pre-handoff execution limit and Contact cooldown are tenant-owned guardrails. A channel quota of 0 blocks that channel.</p>{% if canManageGrowth %}<form class="cos-growth-form" data-growth-limit-settings><label>Daily pre-handoff execution limit <input name="daily_limit" type="number" min="1" value="{{ limits.daily_limit|default(50) }}"></label><label>Email daily quota <input name="email_daily_limit" type="number" min="0" value="{{ limits.channel_daily_limits.email|default(50) }}"></label><label>LinkedIn daily quota <input name="linkedin_daily_limit" type="number" min="0" value="{{ limits.channel_daily_limits.linkedin|default(50) }}"></label><label>Phone daily quota <input name="phone_daily_limit" type="number" min="0" value="{{ limits.channel_daily_limits.phone|default(50) }}"></label><label>Contact cooldown <input name="contact_cooldown_hours" type="number" min="1" value="{{ limits.contact_cooldown_hours|default(24) }}"></label><input name="reason" required placeholder="Change reason"><button class="btn btn-primary" type="submit">Save limits</button><small data-growth-form-status></small></form>{% endif %}</section>
    <section class="cos-panel"><h2>Outreach activation policy</h2>{% if canManageGrowth %}<form class="cos-growth-form" data-growth-activation-settings>{% for channel in ['email','linkedin','phone'] %}<label>{{ channel|title }} <select name="{{ channel }}_mode"><option value="blocked">Blocked</option><option value="approval_required">Approval required</option><option value="auto">Auto</option></select></label>{% endfor %}<input name="reason" required placeholder="Change reason"><button class="btn btn-primary" type="submit">Save activation policy</button><small data-growth-form-status></small></form>{% endif %}</section>
    <section class="cos-panel"><h2>Autonomous outreach</h2><p>Safe default is OFF. Enabling it still respects activation, limits, sequence stops and content policy.</p>{% if canManageGrowth %}<form class="cos-growth-form" data-growth-autonomy-settings><label><input name="enabled" type="checkbox" {{ autonomy.enabled|default(false) ? 'checked' : '' }}> Enabled</label><label>Minimum confidence <input name="min_confidence" type="number" min="0" max="1" step="0.01" value="{{ autonomy.min_confidence|default(0.8) }}"></label><label>Maximum actions per run <input name="max_actions_per_run" type="number" min="1" value="{{ autonomy.max_actions_per_run|default(10) }}"></label><fieldset><legend>Allowed channels</legend>{% for channel in ['email','linkedin','phone'] %}<label><input type="checkbox" name="allowed_channels" value="{{ channel }}" {{ channel in autonomy.allowed_channels|default([]) ? 'checked' : '' }}> {{ channel|title }}</label>{% endfor %}</fieldset><fieldset><legend>Allowed recommendation states</legend>{% for status in ['accepted','proposed'] %}<label><input type="checkbox" name="allowed_statuses" value="{{ status }}" {{ status in autonomy.allowed_statuses|default([]) ? 'checked' : '' }}> {{ status|title }}</label>{% endfor %}</fieldset><input name="reason" required placeholder="Change reason"><button class="btn btn-primary" type="submit">Save autonomy policy</button><small data-growth-form-status></small></form>{% endif %}</section>
    <section class="cos-panel"><h2>Autonomous content review</h2>{% if canManageGrowth %}<form class="cos-growth-form" data-growth-content-review-settings>{% for channel in ['email','linkedin','phone'] %}<label>{{ channel|title }} <select name="{{ channel }}_mode"><option value="blocked">Blocked</option><option value="human_review">Human review</option><option value="policy_auto_approve">Policy auto-approve</option></select></label>{% endfor %}<label>Minimum draft confidence <input name="min_draft_confidence" type="number" min="0" max="1" step="0.01" value="{{ contentReview.min_draft_confidence|default(0.8) }}"></label><label>Maximum body characters <input name="max_body_chars" type="number" min="100" max="10000" value="{{ contentReview.max_body_chars|default(2500) }}"></label><input name="reason" required placeholder="Change reason"><button class="btn btn-primary" type="submit">Save content review policy</button><small data-growth-form-status></small></form>{% endif %}</section>
    <section class="cos-panel"><h2>Outreach sequence policy</h2>{% if canManageGrowth %}<form class="cos-growth-form" data-growth-sequence-settings><label><input name="enabled" type="checkbox" {{ sequence.enabled|default(false) ? 'checked' : '' }}> Enabled</label><fieldset><legend>Allowed channels</legend>{% for channel in ['email','linkedin','phone'] %}<label><input type="checkbox" name="allowed_channels" value="{{ channel }}" {{ channel in sequence.allowed_channels|default([]) ? 'checked' : '' }}> {{ channel|title }}</label>{% endfor %}</fieldset><label>Maximum touches including the first <input name="max_touches" type="number" min="1" max="20" value="{{ sequence.max_touches|default(3) }}"></label><label>Follow-up delay <input name="follow_up_delay_hours" type="number" min="1" value="{{ sequence.follow_up_delay_hours|default(72) }}"> hours</label><label>Maximum advances per run <input name="max_advances_per_run" type="number" min="1" max="100" value="{{ sequence.max_advances_per_run|default(20) }}"></label><input name="reason" required placeholder="Change reason"><button class="btn btn-primary" type="submit">Save sequence policy</button><small data-growth-form-status></small></form>{% endif %}</section>

  {% elseif v=='growth/candidate' %}
    {% set c = w.candidate|default({}) %}{% set engagement = w.engagement|default({}) %}{% set recommendation = engagement.latest_recommendation|default(null) %}{% set execution = w.engagement_execution|default({}) %}{% set latest_delivery = execution.latest_delivery|default(null) %}{% set autonomyBrief = w.engagement_autonomy|default({}) %}{% set contentBrief = w.engagement_content|default({}) %}{% set sequenceBrief = w.engagement_sequence|default({}) %}{% set sequencePolicyEffective = sequenceBrief.policy.effective|default({}) %}{% set activeSequence = sequenceBrief.sequence|default(null) %}
    <section class="cos-panel"><h2>{{ c.subject_id|default('Opportunity') }}</h2><p>{{ c.opportunity_type|default('') }} · {{ c.growth_mode|default('') }} → {{ c.target_domain|default('') }}</p><p>Status {{ c.status|default('unknown')|upper }}</p></section>
    <section class="cos-panel"><h2>Evidence</h2>{% for s in w.signals|default([]) %}<div class="cos-growth-row"><strong>{{ s.signal_type }}</strong><span>{{ s.source_reference|default('') }}</span><span>{{ ((s.confidence|default(0))*100)|round }}%</span></div>{% else %}<p>No linked signals.</p>{% endfor %}</section>
    <section class="cos-panel" data-growth-engagement><h2>Engagement intelligence</h2><p>Kernel Action bridge keeps execution governed. Growth stores only the execution link and payload fingerprint.</p>{% if canManageGrowth %}<button class="btn btn-primary" type="button" data-growth-engagement-generate>Generate next action</button>{% endif %}<small data-growth-engagement-status></small>
      {% if recommendation %}<article class="tn-growth-optimization-card"><h3>{{ recommendation.action_type|default('Recommended action') }}</h3><p>{{ recommendation.rationale|default('') }}</p><p>{{ recommendation.channel|default('—') }} · {{ recommendation.status|default('proposed') }}</p></article>
        {% if canManageGrowth and recommendation.status|default('') == 'proposed' %}<div class="tn-growth-optimization-actions"><form data-growth-engagement-decision="accept" data-recommendation-id="{{ recommendation.recommendation_id }}"><input name="reason" required placeholder="Acceptance reason"><button class="btn btn-primary" type="submit">Accept</button><small data-growth-form-status></small></form><form data-growth-engagement-decision="dismiss" data-recommendation-id="{{ recommendation.recommendation_id }}"><input name="reason" required placeholder="Dismissal reason"><button class="btn btn-outline-secondary" type="submit">Dismiss</button><small data-growth-form-status></small></form></div>{% endif %}
        {% if canManageGrowth and recommendation.status|default('') == 'accepted' %}<form class="cos-growth-form" data-growth-engagement-execution data-recommendation-id="{{ recommendation.recommendation_id }}"><label>Approved message / call brief<textarea name="body" required></textarea></label><button class="btn btn-primary" type="submit">Propose governed Action</button><small data-growth-form-status></small></form>{% endif %}
      {% endif %}
      <p>Delivery status: {{ latest_delivery.status|default('—') }} · latest_delivery is read-only execution feedback.</p>
    </section>
    {% if recommendation %}
      <section class="cos-panel"><h2>Autonomous payload staging</h2><p>Staging does not send anything; it only prepares an approved payload for governed automation.</p>{% if canManageGrowth %}<form class="cos-growth-form" data-growth-engagement-autonomy-payload data-recommendation-id="{{ recommendation.recommendation_id }}"><textarea name="body" required placeholder="Approved payload"></textarea><input name="reason" required placeholder="Staging reason"><button class="btn btn-primary" type="submit">Stage payload</button><small data-growth-form-status></small></form>{% endif %}</section>
      <section class="cos-panel"><h2>Governed content</h2>{% if canManageGrowth %}<button class="btn btn-primary" type="button" data-growth-content-generate data-recommendation-id="{{ recommendation.recommendation_id }}">Generate new governed draft</button>{% endif %}<small data-growth-content-status></small>{% set draft = contentBrief.latest_draft|default(null) %}{% if draft %}<article class="tn-growth-optimization-card"><p>{{ draft.body|default('Draft body is stored in the governed content boundary.') }}</p><p>{{ draft.status|default('pending') }}</p>{% if canManageGrowth and draft.status|default('') in ['pending','proposed'] %}<form data-growth-content-decision="approve" data-recommendation-id="{{ recommendation.recommendation_id }}" data-draft-id="{{ draft.draft_id }}"><input name="reason" required placeholder="Decision reason"><button class="btn btn-primary" type="submit">Approve & stage</button><small data-growth-form-status></small></form><form data-growth-content-decision="reject" data-recommendation-id="{{ recommendation.recommendation_id }}" data-draft-id="{{ draft.draft_id }}"><input name="reason" required placeholder="Decision reason"><button class="btn btn-outline-secondary" type="submit">Reject</button><small data-growth-form-status></small></form>{% endif %}</article>{% endif %}</section>
    {% endif %}
    <section class="cos-panel"><h2>Outreach sequence</h2><p>Policy: {{ sequencePolicyEffective.enabled|default(false) ? 'enabled' : 'disabled' }}</p>{% if activeSequence %}<p>{{ activeSequence.status|default('active') }} · {{ activeSequence.sequence_id|default('') }}</p>{% if canManageGrowth %}<form data-growth-sequence-stop data-sequence-id="{{ activeSequence.sequence_id }}"><input name="reason" required placeholder="Stop reason"><button class="btn btn-outline-secondary" type="submit">Stop sequence</button><small data-growth-form-status></small></form>{% endif %}{% else %}<p>No active sequence.</p>{% endif %}</section>
    <section class="cos-panel"><h2>Conversation signals</h2><h3>Inbound responses</h3>{% for response in w.engagement_responses.responses|default(w.engagement_responses|default([])) %}<article class="tn-growth-optimization-card"><strong>{{ response.received_at|default('Response') }}</strong><p>{{ response.summary|default(response.body_preview|default('Inbound response recorded.')) }}</p><p>{{ response.classification|default('Classification pending durable processing.') }} · classification is advisory only</p></article>{% else %}<p>Classification pending durable processing.</p><p>AI classification is advisory only.</p>{% endfor %}</section>
    <section class="cos-panel"><h2>Conversation routing</h2><p>Authoritative route: {{ w.conversation_routing.route.target_domain|default(w.conversation_routing.target_domain|default('—')) }}</p></section>
    <section class="cos-panel"><h2>Actions</h2>{% if canManageGrowth %}<button class="btn btn-primary" type="button" data-growth-action="research-generate">Generate research</button><form data-growth-handoff-prepare class="cos-growth-form"><input name="target_domain" value="{{ c.target_domain|default('sales') }}"><input name="reason" placeholder="Reason"><button class="btn btn-primary" type="submit">Prepare handoff</button><small data-growth-form-status></small></form>{% endif %}<small data-growth-action-status></small></section>
  {% endif %}
</div>
{% endblock %}
