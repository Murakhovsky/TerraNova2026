{% extends 'base.html.twig' %}

{% block title %}COS Design System{% endblock %}

{% block meta %}
    <meta name="robots" content="noindex,nofollow">
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/style-lab.css') }}">
{% endblock %}

{% block body %}
<main class="cos-ui-catalog">
    <header class="cos-ui-catalog__header">
        <div>
            <p class="cos-ui-catalog__kicker">COS Experience Platform</p>
            <h1 class="cos-ui-catalog__title">Design System</h1>
            <p class="cos-ui-catalog__lede">
                Canonical semantic tokens, densities and server-first Twig primitives.
                This page is the visual contract for product UI, not a collection of screenshots.
            </p>
        </div>

    </header>

    {% include 'experience/_style_lab_switcher.html.twig' with {'style': 'origin-a'} only %}

    {% include 'experience/_ui_catalog_playground.html.twig' with {'uiCatalog': uiCatalog|default({})} only %}

    <section class="cos-ui-catalog__section" aria-labelledby="style-lab-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="style-lab-heading">PHASE 2 Style Lab</h2>
            <p>Light/Dark are controls; Origin A/B/C and Glass are visual candidates.</p>
        </div>
        <div class="cos-ui-catalog__grid">
            <article class="cos-card">
                <p class="cos-card__eyebrow">Origin A</p>
                <h3 class="cos-card__title">Graphite Precision</h3>
                <p class="cos-card__copy">Найсуворіший Calm Technical: cold neutral workspace, graphite shell, cobalt signal.</p>
            </article>
            <article class="cos-card">
                <p class="cos-card__eyebrow">Origin B</p>
                <h3 class="cos-card__title">Executive Warmth</h3>
                <p class="cos-card__copy">Точна структура з дуже стриманим amber atmosphere для premium business character.</p>
            </article>
            <article class="cos-card">
                <p class="cos-card__eyebrow">Origin C</p>
                <h3 class="cos-card__title">Future Mineral</h3>
                <p class="cos-card__copy">Холодніший mineral/cobalt direction із сильнішим відчуттям operating system нового покоління.</p>
            </article>
            <article class="cos-card">
                <p class="cos-card__eyebrow">Glass</p>
                <h3 class="cos-card__title">Executive Glass</h3>
                <p class="cos-card__copy">Maximum controlled glassmorphism: translucent structure, amber+cobalt atmosphere, opaque-enough data.</p>
            </article>
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="constitution-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="constitution-heading">COS Visual Constitution</h2>
            <p>Control + Money + Movement. Calm Technical is the canonical product character.</p>
        </div>
        <div class="cos-ui-catalog__grid">
            {% for principle, copy in {
                'Calm': 'Decoration yields to business information.',
                'Precise': 'Grid, alignment, borders and type hierarchy create structure.',
                'Dense': 'Professional information density without visual noise.',
                'Financial': 'Money, KPI, target, forecast and variance are first-class data.',
                'Operational': 'Primary and next actions are discoverable immediately.',
                'Premium': 'Quality comes from precision, not gold, glow or oversized cards.',
                'Neutral': 'Neutral surfaces dominate; color is a signal.',
                'Alive': 'Realtime, activity, progress and AI make the system feel current.',
                'Accessible': 'Keyboard, contrast, reduced motion and semantic states are defaults.',
                'One product': 'Domains share one visual grammar and one Workspace shell.'
            } %}
                <article class="cos-card">
                    <p class="cos-card__eyebrow">{{ principle }}</p>
                    <p class="cos-card__copy">{{ copy }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="tokens-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="tokens-heading">Semantic color tokens</h2>
            <p>No business component may depend on raw brand hex values.</p>
        </div>
        <div class="cos-ui-catalog__swatches">
            {% for label, token in {
                'Canvas': '--cos-color-canvas',
                'Surface': '--cos-color-surface',
                'Raised': '--cos-color-surface-raised',
                'Text': '--cos-color-text',
                'Muted': '--cos-color-text-muted',
                'Primary': '--cos-color-primary',
                'Positive': '--cos-color-positive',
                'Warning': '--cos-color-warning',
                'Danger': '--cos-color-danger',
                'Info': '--cos-color-info'
            } %}
                <article class="cos-ui-swatch" style="--swatch: var({{ token }})">
                    <div class="cos-ui-swatch__sample" aria-hidden="true"></div>
                    <div class="cos-ui-swatch__meta">
                        <strong>{{ label }}</strong>
                        <code>{{ token }}</code>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="surfaces-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="surfaces-heading">Surface hierarchy</h2>
            <p>Canvas → Default → Subtle → Raised → Floating → Overlay. Shadow begins only when the UI truly floats.</p>
        </div>
        <div class="cos-ui-catalog__grid">
            {% for className, label in {
                'cos-surface--canvas': 'Canvas',
                'cos-surface--default': 'Default',
                'cos-surface--subtle': 'Subtle',
                'cos-surface--raised': 'Raised',
                'cos-surface--floating': 'Floating',
                'cos-surface--overlay': 'Overlay'
            } %}
                <article class="cos-surface {{ className }}" style="padding:var(--cos-space-4);border-radius:var(--cos-radius-panel)">
                    <p class="cos-card__eyebrow">{{ label }}</p>
                    <strong>{{ className }}</strong>
                    <p class="cos-card__copy">Semantic depth, not decorative card stacking.</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="type-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="type-heading">Typography and rhythm</h2>
            <p>Dense enterprise UI without collapsing into spreadsheet archaeology.</p>
        </div>
        <div class="cos-ui-catalog__grid">
            <section class="cos-card">
                <p class="cos-card__eyebrow">Display</p>
                <h2 style="margin:0;font-size:var(--cos-font-3xl);letter-spacing:-.04em">Company Operating System</h2>
                <p class="cos-card__copy">Primary interface copy uses the same semantic type scale across workspaces.</p>
            </section>
            <section class="cos-card">
                <p class="cos-card__eyebrow">Rhythm</p>
                <div style="display:grid;gap:var(--cos-space-2)">
                    {% for step in [1, 2, 3, 4, 6, 8] %}
                        <div style="display:flex;align-items:center;gap:var(--cos-space-3)">
                            <code style="width:5rem">space-{{ step }}</code>
                            <span style="display:block;height:.5rem;width:var(--cos-space-{{ step }});background:var(--cos-color-primary);border-radius:var(--cos-radius-pill)"></span>
                        </div>
                    {% endfor %}
                </div>
            </section>
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="typography-lab-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="typography-lab-heading">PHASE 3 Typography Lab</h2>
            <p>Same business content, same scale, three candidate families. Font availability is intentionally not hidden by the lab.</p>
        </div>

        <div class="cos-typography-lab" aria-label="Typography candidate comparison">
            {% for candidate in [
                {'id': 'geist', 'label': 'Geist', 'note': 'Primary brand candidate'},
                {'id': 'inter', 'label': 'Inter', 'note': 'Current production baseline'},
                {'id': 'plex', 'label': 'IBM Plex Sans', 'note': 'Enterprise comparison'}
            ] %}
                <article class="cos-card cos-type-candidate cos-type-candidate--{{ candidate.id }}">
                    <div class="cos-type-candidate__meta">
                        <span class="cos-badge">{{ candidate.label }}</span>
                        <span>{{ candidate.note }}</span>
                    </div>
                    <p class="cos-type-sample cos-type-sample--metric cos-numeric">123,450 €</p>
                    <p class="cos-type-sample cos-type-sample--title">Company Operating System</p>
                    <p class="cos-type-sample">Потенційний клієнт</p>
                    <p class="cos-type-sample">Продаж житлового комплексу</p>
                    <p class="cos-type-sample">Pipeline Forecast</p>
                    <p class="cos-type-sample cos-type-sample--copy">
                        Operational body copy must remain readable at dense UI sizes, not only in oversized headings.
                    </p>
                </article>
            {% endfor %}
        </div>

        <div class="cos-card cos-typography-contract">
            <p class="cos-card__eyebrow">Numeric contract</p>
            <div class="cos-typography-contract__row cos-numeric">
                <strong>€1,284,450</strong>
                <span>+12.4%</span>
                <span>Forecast €1,400,000</span>
                <span>91%</span>
            </div>
            <p class="cos-card__copy">Financial and aligned data surfaces use tabular lining numerals through a semantic utility, not ad-hoc component CSS.</p>
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="buttons-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="buttons-heading">Buttons</h2>
            <p>Presentation only. Business actions remain UIAction + Policy + Command.</p>
        </div>
        <div class="cos-ui-catalog__surface">
            <div class="cos-ui-catalog__row">
                <twig:CosButton label="Primary action" variant="primary" />
                <twig:CosButton label="Secondary" />
                <twig:CosButton label="Ghost" variant="ghost" />
                <twig:CosButton label="Danger" variant="danger" />
                <twig:CosButton label="Small" size="sm" />
                <twig:CosButton label="Large" size="lg" />
                <twig:CosButton label="Disabled" disabled />
            </div>
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="status-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="status-heading">Status language</h2>
            <p>Brand color and semantic state colors remain separate.</p>
        </div>
        <div class="cos-ui-catalog__surface">
            <div class="cos-ui-catalog__row">
                <twig:CosBadge label="Neutral" />
                <twig:CosBadge label="Positive" tone="positive" />
                <twig:CosBadge label="Warning" tone="warning" />
                <twig:CosBadge label="Danger" tone="danger" />
                <twig:CosBadge label="Info" tone="info" />
            </div>
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="phase6-primitives-heading">
        <div class="cos-ui-catalog__section-head">
            <div>
                <h2 id="phase6-primitives-heading">PHASE 6 Canonical Primitives Pass</h2>
                <p>Одна state grammar для controls, signals, surfaces та navigation. Preview hooks існують лише для deterministic visual QA.</p>
            </div>
        </div>

        <div class="cos-state-matrix" aria-label="Canonical control state matrix">
            {% for state in ['default', 'hover', 'focus', 'active'] %}
                <article class="cos-state-matrix__cell">
                    <span class="cos-state-matrix__label">{{ state|capitalize }}</span>
                    <button
                        class="cos-button"
                        type="button"
                        {% if state != 'default' %}data-cos-state="{{ state }}"{% endif %}
                    >Control</button>
                </article>
            {% endfor %}
            <article class="cos-state-matrix__cell">
                <span class="cos-state-matrix__label">Selected</span>
                <twig:CosButton label="Selected" :pressed="true" />
            </article>
            <article class="cos-state-matrix__cell">
                <span class="cos-state-matrix__label">Disabled</span>
                <twig:CosButton label="Disabled" disabled />
            </article>
            <article class="cos-state-matrix__cell">
                <span class="cos-state-matrix__label">Loading</span>
                <twig:CosButton label="Execute" loading loadingLabel="Executing" variant="primary" />
            </article>
            <article class="cos-state-matrix__cell">
                <span class="cos-state-matrix__label">Error</span>
                <twig:CosInput
                    name="phase6_error"
                    label="Amount"
                    value="invalid"
                    :errors="['Enter a valid amount']"
                />
            </article>
        </div>

        <div class="cos-ui-catalog__grid">
            <article class="cos-card">
                <p class="cos-card__eyebrow">Controls</p>
                <div class="cos-primitive-stack">
                    <twig:CosInput name="phase6_input" label="Input" value="Operational value" />
                    <twig:CosSelect
                        name="phase6_select"
                        label="Select"
                        :options="{'normal': 'Normal', 'priority': 'Priority'}"
                        selected="normal"
                    />
                    <twig:CosTextarea name="phase6_textarea" label="Textarea" value="Context remains compact and readable." />
                    <div class="cos-ui-catalog__row">
                        <twig:CosCheckbox name="phase6_checkbox" label="Checkbox" checked />
                        <twig:CosRadio name="phase6_radio" label="Radio" value="one" checked />
                        <twig:CosSwitch name="phase6_switch" label="Switch" checked />
                    </div>
                </div>
            </article>

            <article class="cos-card">
                <p class="cos-card__eyebrow">Signals</p>
                <div class="cos-primitive-stack">
                    <div class="cos-ui-catalog__row">
                        <twig:CosStatus label="Live" tone="positive" />
                        <twig:CosStatus label="Attention" tone="warning" />
                        <twig:CosStatus label="Blocked" tone="danger" />
                        <twig:CosStatus label="Processing" tone="info" />
                    </div>
                    <twig:CosAlert title="Operational warning" copy="Status uses text and shape in addition to color." tone="warning" />
                    <twig:CosProgress :value="68" label="Processing" />
                    <div class="cos-ui-catalog__row">
                        <twig:CosSpinner label="Loading state" />
                        <twig:CosSkeleton shape="line" />
                    </div>
                </div>
            </article>

            <article class="cos-card" data-cos-state="selected">
                <p class="cos-card__eyebrow">Surface state</p>
                <h3 class="cos-card__title">Selected surface</h3>
                <p class="cos-card__copy">Selection reuses semantic state tokens instead of a Domain-specific card treatment.</p>
            </article>
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="cards-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="cards-heading">Cards and metrics</h2>
            <p>Density changes geometry through tokens, not per-page overrides.</p>
        </div>
        <div class="cos-ui-catalog__grid">
            <twig:CosCard
                eyebrow="Workspace"
                title="Operational surface"
                copy="A calm technical card using semantic surface, border and typography tokens."
            />
            <twig:CosCard
                eyebrow="Elevation"
                title="Raised surface"
                copy="Elevation is reserved for hierarchy, not decoration."
                raised
            />
            <section class="cos-card">
                <twig:CosMetric label="Pipeline value" value="$482k" hint="+12.4% versus previous period" />
            </section>
            <section class="cos-card">
                <twig:CosMetric label="Attention items" value="17" hint="4 require human decision" />
            </section>
        </div>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="forms-platform-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="forms-platform-heading">Form primitives / Forms Platform</h2>
            <p>Typed input DTOs, Symfony validation and small browser-only controllers.</p>
        </div>

        {% set validationErrors = formValidationExample|default([]) %}
        <twig:CosValidationSummary
            id="catalog-validation-summary"
            title="Example validation summary"
            :errors="validationErrors"
        />

        {% if formsDemo is defined %}
            <section class="cos-card">
                {{ form_start(formsDemo, {
                    attr: {
                        class: 'cos-form',
                        'data-controller': 'form-state form-validation conditional-fields',
                        'data-action': 'input->form-state#change change->form-state#change submit->form-state#submit',
                        'data-form-state-draft-mode-value': 'manual'
                    }
                }) }}
                    <div class="cos-form__grid">
                        {{ form_row(formsDemo.name) }}
                        {{ form_row(formsDemo.email) }}
                        {{ form_row(formsDemo.priority) }}
                        {{ form_row(formsDemo.notes) }}
                        {{ form_row(formsDemo.attachment) }}
                    </div>
                    <div class="cos-form__actions">
                        <button class="cos-button cos-button--ghost" type="button" data-action="click->form-state#requestDraft">Save draft</button>
                        <button class="cos-button cos-button--primary" type="button">Preview submit</button>
                    </div>
                {{ form_end(formsDemo) }}
            </section>
        {% endif %}

        <section class="cos-card">
            <p class="cos-card__eyebrow">Modal form</p>
            <twig:CosModal id="catalog-form-modal" title="Edit details" triggerLabel="Open form">
                <form
                    class="cos-form"
                    data-controller="form-state form-validation"
                    data-action="input->form-state#change change->form-state#change submit->form-state#submit"
                >
                    <p>Modal form content remains server-rendered.</p>
                    <twig:CosInput
                        name="modal_title"
                        label="Title"
                        autocomplete="off"
                        help="Modal and Drawer forms use the same field semantics."
                        required
                    />
                    <div class="cos-form__actions">
                        <button class="cos-button cos-button--primary" type="button">Save</button>
                    </div>
                </form>
            </twig:CosModal>
        </section>
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="data-platform-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="data-platform-heading">Data Platform / DataGrid</h2>
            <p>Server-owned search, filters, sorting, pagination and export with short-lived browser selection state.</p>
        </div>

        {% if dataGridDemo is defined %}
            <twig:CosDataGrid
                id="catalog-data-grid"
                label="Accounts"
                baseUrl="/dev/ui"
                exportUrl="/dev/ui/data-export"
                rowIdKey="id"
                :query="dataGridDemo.query"
                :page="dataGridDemo.page"
                :columns="dataGridDemo.columns"
                :filters="dataGridDemo.filters"
                :savedViews="dataGridDemo.savedViews"
                :rowActions="dataGridDemo.rowActions"
                :bulkActions="dataGridDemo.bulkActions"
                :state="dataGridDemo.state"
                selectable
            />
        {% endif %}
    </section>

    <section class="cos-ui-catalog__section" aria-labelledby="empty-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="empty-heading">System states</h2>
            <p>Empty, loading, error and offline patterns must be explicit product states.</p>
        </div>
        <twig:CosEmptyState
            title="No records match this view"
            copy="Change filters, switch saved view or create the first record through a governed action."
        />
    </section>

    {% set interactionTabs = [
        {'key': 'overview', 'label': 'Overview'},
        {'key': 'activity', 'label': 'Activity'},
        {'key': 'disabled', 'label': 'Disabled', 'disabled': true}
    ] %}

    <section class="cos-ui-catalog__section" aria-labelledby="interaction-heading">
        <div class="cos-ui-catalog__section-head">
            <h2 id="interaction-heading">Interaction components</h2>
            <p>Server-rendered semantics with small, isolated Stimulus behavior.</p>
        </div>

        <div class="cos-ui-catalog__grid">
            <section class="cos-card">
                <p class="cos-card__eyebrow">Modal</p>
                <twig:CosModal id="catalog-modal" title="Modal example" triggerLabel="Open modal">
                    <p>Modal content remains server-rendered Twig content.</p>
                </twig:CosModal>
            </section>

            <section class="cos-card">
                <p class="cos-card__eyebrow">Drawer</p>
                <twig:CosDrawer id="catalog-drawer" title="Drawer example" triggerLabel="Open drawer">
                    <p>Inspect or edit without losing list context.</p>
                </twig:CosDrawer>
            </section>

            <section class="cos-card">
                <p class="cos-card__eyebrow">Dropdown</p>
                <twig:CosDropdown id="catalog-dropdown" label="Open menu">
                    <a href="#interaction-heading" role="menuitem">First action</a>
                    <button type="button" role="menuitem">Second action</button>
                </twig:CosDropdown>
            </section>

            <section class="cos-card">
                <p class="cos-card__eyebrow">Tabs</p>
                <twig:CosTabs id="catalog-tabs" label="Catalog tabs" :items="interactionTabs" active="overview">
                    <section
                        id="catalog-tabs-panel-overview"
                        role="tabpanel"
                        aria-labelledby="catalog-tabs-tab-overview"
                        data-tabs-target="panel"
                        data-tab-key="overview"
                    >Overview panel</section>
                    <section
                        id="catalog-tabs-panel-activity"
                        role="tabpanel"
                        aria-labelledby="catalog-tabs-tab-activity"
                        data-tabs-target="panel"
                        data-tab-key="activity"
                        hidden
                    >Activity panel</section>
                </twig:CosTabs>
            </section>

            <section class="cos-card">
                <p class="cos-card__eyebrow">Popover + Tooltip</p>
                <div class="cos-ui-catalog__row">
                    <twig:CosPopover
                        id="catalog-popover"
                        triggerLabel="Details"
                        title="Popover"
                        copy="Contextual server-rendered information."
                    />
                    <twig:CosTooltip
                        id="catalog-tooltip"
                        label="Hover or focus"
                        text="Accessible tooltip content"
                    />
                </div>
            </section>

            <section class="cos-card">
                <p class="cos-card__eyebrow">Confirm</p>
                <twig:CosConfirm
                    id="catalog-confirm"
                    title="Confirm destructive action"
                    message="This is presentation confirmation only; backend authorization remains authoritative."
                    triggerLabel="Open confirmation"
                    confirmLabel="Confirm"
                    stepUp
                />
            </section>

            <section class="cos-card">
                <p class="cos-card__eyebrow">Toast</p>
                <twig:CosToast
                    id="catalog-toast"
                    title="Saved"
                    message="The operation completed successfully."
                    tone="positive"
                    :duration="0"
                />
            </section>
        </div>
    </section>

</main>
{% endblock %}
