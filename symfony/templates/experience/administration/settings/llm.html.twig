{% extends 'experience/workspace_shell.html.twig' %}

{% block title %}LLM Settings | COS{% endblock %}

{% block workspace_content %}
<section class="cos-page__stack" data-cos-archetype="{{ page.archetypeId() }}" data-cos-page-state="{{ page.state }}">
    <style>
        .llm-catalog-wrap{overflow:auto;border:1px solid var(--cos-border,#e2e8f0);border-radius:12px}
        .llm-catalog{width:100%;border-collapse:collapse;min-width:980px;font-size:.82rem}
        .llm-catalog th,.llm-catalog td{padding:8px 10px;border-bottom:1px solid var(--cos-border,#edf0f3);text-align:left;vertical-align:top}
        .llm-catalog th{font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;color:var(--cos-text-secondary,#667085);background:var(--cos-surface-subtle,#f8f9fb)}
        .llm-catalog tr:last-child td{border-bottom:0}
        .llm-catalog__muted{display:block;color:var(--cos-text-secondary,#667085);font-size:.72rem;margin-top:2px}
    </style>
    <twig:CosPageHeader
        eyebrow="Platform Settings · AI"
        title="LLM runtime"
        subtitle="Runtime-конфігурація моделей та provider credentials без рестарту контейнерів."
    >
        <twig:CosButton label="Platform Settings" href="/admin/settings" variant="ghost" />
    </twig:CosPageHeader>

    {% if settings.status_message %}
        <twig:CosAlert title="Platform Settings" copy="{{ settings.status_message }}" tone="{{ settings.status_error ? 'danger' : 'positive' }}" />
    {% endif %}

    <form class="cos-page__stack" action="/admin/settings/llm" method="post">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

        <twig:CosFormSection title="Основний LLM" description="Provider, модель за замовчуванням і runtime limits.">
            <div class="cos-pattern-stack">
                <p class="cos-card__eyebrow">Provider</p>
                <h2 class="cos-card__title">Основний LLM</h2>
            </div>

            <div class="cos-section-grid">
                <label class="cos-field">
                    <span>Provider</span>
                    <select class="cos-select" name="provider">
                        {% for provider in ['openai','http','fixture'] %}
                            <option value="{{ provider }}" {% if settings.provider == provider %}selected{% endif %}>{{ provider }}</option>
                        {% endfor %}
                    </select>
                </label>

                <label class="cos-field">
                    <span>Default model</span>
                    <input class="cos-input" name="default_model" type="text" value="{{ settings.default_model }}" placeholder="model id" list="openai-model-catalog">
                </label>

                <label class="cos-field">
                    <span>Timeout, seconds</span>
                    <input class="cos-input" name="timeout_seconds" type="number" min="1" max="600" value="{{ settings.timeout_seconds }}">
                </label>

                <label class="cos-field">
                    <span>Max attempts</span>
                    <input class="cos-input" name="max_attempts" type="number" min="1" max="10" value="{{ settings.max_attempts }}">
                </label>
            </div>
        </twig:CosFormSection>

        <twig:CosFormSection title="OpenAI API key" description="Encrypted secret. Значення назад у форму не повертається.">
            <div class="cos-pattern-stack">
                <p class="cos-card__eyebrow">Encrypted secret</p>
                <h2 class="cos-card__title">OpenAI API key</h2>
                <p class="cos-card__copy">
                    {% if settings.api_key_configured %}
                        Ключ налаштовано{% if settings.api_key_suffix %}, suffix ••••{{ settings.api_key_suffix }}{% endif %}. Значення ніколи не повертається у форму.
                    {% else %}
                        Ключ ще не налаштовано.
                    {% endif %}
                </p>
            </div>

            <label class="cos-field">
                <span>Replace API key</span>
                <input class="cos-input" name="openai_api_key" type="password" autocomplete="new-password" placeholder="залиште порожнім, щоб не змінювати">
            </label>
            <label class="cos-field">
                <span>Повернути ENV fallback</span>
                <span><input type="checkbox" name="remove_openai_api_key" value="1"> Видалити DB override ключа</span>
            </label>
        </twig:CosFormSection>

        <twig:CosFormSection title="Моделі Engineering Agents" description="Порожнє поле повертає роль до ENV/default model.">
            <div class="cos-pattern-stack">
                <p class="cos-card__eyebrow">Engineering Agents</p>
                <h2 class="cos-card__title">Моделі за ролями</h2>
                <p class="cos-card__copy">Порожнє поле повертає роль до ENV/default model.</p>
            </div>

            <div class="cos-section-grid">
                <label class="cos-field"><span>Manager</span><input class="cos-input" name="manager_model" value="{{ settings.manager_model }}" list="openai-model-catalog"></label>
                <label class="cos-field"><span>Architect</span><input class="cos-input" name="architect_model" value="{{ settings.architect_model }}" list="openai-model-catalog"></label>
                <label class="cos-field"><span>Developer</span><input class="cos-input" name="developer_model" value="{{ settings.developer_model }}" list="openai-model-catalog"></label>
                <label class="cos-field"><span>Reviewer</span><input class="cos-input" name="reviewer_model" value="{{ settings.reviewer_model }}" list="openai-model-catalog"></label>
                <label class="cos-field"><span>QA</span><input class="cos-input" name="qa_model" value="{{ settings.qa_model }}" list="openai-model-catalog"></label>
            </div>
        </twig:CosFormSection>

        <twig:CosFormSection title="Каталог моделей і тарифи" description="Вбудовані ставки використовуються для cost accounting, якщо tenant override відсутній.">
            <datalist id="openai-model-catalog">
                {% for model in settings.model_catalog %}
                    <option value="{{ model.model }}">{{ model.name }}</option>
                {% endfor %}
            </datalist>

            <div class="cos-pattern-stack">
                <p class="cos-card__eyebrow">Pricing snapshot · {{ settings.pricing_catalog_version }}</p>
                <h2 class="cos-card__title">OpenAI GPT-6 catalog</h2>
                <p class="cos-card__copy">
                    Input/output ціни зберігаються за 1M tokens. Окрему ставку cached input у наданих даних не вказано, тому до появи override cached tokens оцінюються за стандартною input-ставкою і це фіксується в cost source.
                </p>
            </div>

            <div class="llm-catalog-wrap">
                <table class="llm-catalog" data-llm-model-catalog>
                    <thead>
                    <tr>
                        <th>Модель</th>
                        <th>Input / 1M</th>
                        <th>Output / 1M</th>
                        <th>Context</th>
                        <th>Max output</th>
                        <th>Reasoning</th>
                        <th>Knowledge cutoff</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for model in settings.model_catalog %}
                        <tr>
                            <td>
                                <strong>{{ model.name }}</strong>
                                <span class="llm-catalog__muted"><code>{{ model.model }}</code></span>
                            </td>
                            <td>{{ model.currency }} {{ model.input_per_million|number_format(model.input_per_million < 1 ? 1 : 0, '.', '') }}</td>
                            <td>{{ model.currency }} {{ model.output_per_million|number_format(model.output_per_million < 1 ? 1 : 0, '.', '') }}</td>
                            <td>{{ (model.context_window_tokens / 1000000)|number_format(2, '.', '') }}M</td>
                            <td>{{ (model.max_output_tokens / 1000)|number_format(0, '.', '') }}K</td>
                            <td>{{ model.reasoning|join(', ') }}</td>
                            <td>{{ model.knowledge_cutoff }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:CosFormSection>

        <twig:CosStickyActions label="Save LLM settings">
            <a class="cos-button cos-button--ghost" href="/admin/settings">Скасувати</a>
            <button class="cos-button cos-button--primary" type="submit">Зберегти налаштування</button>
        </twig:CosStickyActions>
    </form>
</section>
{% endblock %}
