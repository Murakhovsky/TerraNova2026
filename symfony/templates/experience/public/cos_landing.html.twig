{% extends 'experience/public_shell.html.twig' %}

{% block html_lang %}{{ cos.lang }}{% endblock %}
{% block title %}{{ cos.metaTitle }}{% endblock %}

{% block meta %}
    <meta name="description" content="{{ cos.metaDescription }}">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="{{ cos.canonicalPath }}">
    {% for lang in cos.languages %}
        <link rel="alternate" hreflang="{{ lang }}" href="/cos/{{ lang }}">
    {% endfor %}
{% endblock %}

{% block public_content %}
<section
    class="cos-page__stack"
    data-cos-public="cos-landing"
    data-cos-lang="{{ cos.lang }}"
    data-cos-archetype="{{ page.archetypeId() }}"
>
    <twig:CosPageHeader
        eyebrow="{{ cos.copy.eyebrow|default('Company Operating System') }}"
        title="{{ cos.copy.hero|default('COS') }}"
        subtitle="{{ cos.copy.intro|default('') }}"
    >
        <twig:CosButton label="{{ cos.copy.cta|default('Start') }}" href="/contacts" variant="primary" />
        <twig:CosButton label="{{ cos.copy.view_domain|default('Domains') }}" href="#domains" variant="ghost" />
    </twig:CosPageHeader>

    <twig:CosActionBar label="COS languages" align="start">
        {% for lang in cos.languages %}
            <twig:CosButton
                label="{{ lang|upper }}"
                href="/cos/{{ lang }}"
                variant="{{ lang == cos.lang ? 'primary' : 'ghost' }}"
                size="sm"
            />
        {% endfor %}
    </twig:CosActionBar>

    <section class="cos-card cos-pattern-stack" aria-labelledby="cos-operating-cycle">
        <p class="cos-card__eyebrow">{{ cos.copy.operating_logic|default('Operating logic') }}</p>
        <h2 id="cos-operating-cycle" class="cos-card__title">{{ cos.copy.cycle_title|default('Event → Decision → Action → Result') }}</h2>
        <p class="cos-card__copy">{{ cos.copy.cycle_copy|default('') }}</p>
        <div class="cos-section-grid">
            {% for key in ['event', 'decision', 'action', 'result'] %}
                <article class="cos-card">
                    <p class="cos-card__eyebrow">{{ '%02d'|format(loop.index) }}</p>
                    <h3 class="cos-card__title">{{ attribute(cos.copy, key)|default(key|title) }}</h3>
                    <p class="cos-card__copy">{{ attribute(cos.copy, key ~ '_copy')|default('') }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section id="domains" class="cos-page__section" aria-labelledby="cos-domains-title">
        <div class="cos-card__header">
            <div>
                <p class="cos-card__eyebrow">{{ cos.copy.domain_architecture|default('Domains') }}</p>
                <h2 id="cos-domains-title" class="cos-card__title">{{ cos.copy.domains_title|default('Operating domains') }}</h2>
                <p class="cos-card__copy">{{ cos.copy.domains_copy|default('') }}</p>
            </div>
        </div>
        <div class="cos-section-grid" role="list">
            {% for slug, domain in cos.domains %}
                <a class="cos-card" role="listitem" href="/cos/{{ cos.lang }}/domains/{{ slug }}" aria-label="{{ domain.title }}">
                    <p class="cos-card__eyebrow">{{ domain.id }} · {{ domain.group }}</p>
                    <h3 class="cos-card__title">{{ domain.title }}</h3>
                    <p class="cos-card__copy">{{ domain.summary }}</p>
                    <span class="cos-button cos-button--ghost cos-button--sm">{{ cos.copy.view_domain|default('Open') }}</span>
                </a>
            {% endfor %}
        </div>
    </section>

    <section class="cos-card cos-pattern-stack" aria-labelledby="cos-governance-title">
        <p class="cos-card__eyebrow">{{ cos.copy.governance|default('Governance') }}</p>
        <h2 id="cos-governance-title" class="cos-card__title">{{ cos.copy.trust_title|default('Controlled autonomy') }}</h2>
        <p class="cos-card__copy">{{ cos.copy.trust_copy|default('') }}</p>
        <div class="cos-section-grid">
            {% for i in 1..3 %}
                <article class="cos-card">
                    <p class="cos-card__eyebrow">{{ '%02d'|format(i) }}</p>
                    <h3 class="cos-card__title">{{ attribute(cos.copy, 'trust_' ~ i)|default('') }}</h3>
                    <p class="cos-card__copy">{{ attribute(cos.copy, 'trust_' ~ i ~ '_copy')|default('') }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section class="cos-card cos-pattern-stack" aria-labelledby="cos-start-title">
        <p class="cos-card__eyebrow">{{ cos.copy.deployment|default('Deployment') }}</p>
        <h2 id="cos-start-title" class="cos-card__title">{{ cos.copy.start_title|default('Start small') }}</h2>
        <p class="cos-card__copy">{{ cos.copy.start_copy|default('') }}</p>
        <twig:CosActionBar label="COS next steps" align="start">
            <twig:CosButton label="{{ cos.copy.cta|default('Contact') }}" href="/contacts" variant="primary" />
            <twig:CosButton label="{{ cos.copy.view_domain|default('Domains') }}" href="#domains" variant="ghost" />
        </twig:CosActionBar>
    </section>
</section>
{% endblock %}
