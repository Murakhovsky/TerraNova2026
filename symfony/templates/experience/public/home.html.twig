{% extends 'experience/public_shell.html.twig' %}

{% block title %}Terra Nova COS | Company Operating System{% endblock %}

{% block meta %}
    <meta name="description" content="Terra Nova COS об’єднує продажі, нерухомість, операції та AI-агентів у керований Company Operating System.">
    <meta name="robots" content="index,follow">
{% endblock %}

{% block javascripts %}
    {{ importmap('public_home') }}
{% endblock %}

{% block public_content %}
<section
    class="cos-page__stack"
    data-cos-public="home"
    data-cos-archetype="{{ page.archetypeId() }}"
    data-cos-page-state="{{ page.state }}"
    data-cos-page-density="{{ page.density }}"
>
    <twig:CosPageHeader
        eyebrow="Terra Nova COS"
        title="Company Operating System"
        subtitle="Одна система для клієнтів, продажів, нерухомості, операцій та контрольованої AI-автоматизації."
    >
        <twig:CosButton label="Відкрити COS" href="/cos" variant="primary" />
        <twig:CosButton label="Нерухомість" href="/property/catalog" variant="ghost" />
        <twig:CosButton label="Увійти" href="/auth/login" variant="ghost" />
    </twig:CosPageHeader>

    <section class="cos-page__section cos-section-grid" aria-label="Основні можливості">
        <article class="cos-card">
            <p class="cos-card__eyebrow">Real Estate</p>
            <h2 class="cos-card__title">Знайти або продати нерухомість</h2>
            <p class="cos-card__copy">Публічний каталог, презентації об’єктів і передача власної нерухомості на модерацію.</p>
            <div class="cos-pattern-inline">
                <twig:CosButton label="Каталог" href="/property/catalog" variant="ghost" size="sm" />
                <twig:CosButton label="Запропонувати об’єкт" href="/property/submit" variant="ghost" size="sm" />
            </div>
        </article>
        <article class="cos-card">
            <p class="cos-card__eyebrow">Company Operating System</p>
            <h2 class="cos-card__title">Керувати процесами, а не вкладками</h2>
            <p class="cos-card__copy">Events, decisions, actions, approvals, outcomes та AI agents працюють через спільний runtime.</p>
            <twig:CosButton label="Як працює COS" href="/cos" variant="ghost" size="sm" />
        </article>
        <article class="cos-card">
            <p class="cos-card__eyebrow">Terra Nova</p>
            <h2 class="cos-card__title">Послуги та партнерство</h2>
            <p class="cos-card__copy">Продаж, підбір, супровід угод і співпраця з власниками, агентами та забудовниками.</p>
            <div class="cos-pattern-inline">
                <twig:CosButton label="Послуги" href="/services" variant="ghost" size="sm" />
                <twig:CosButton label="Партнерам" href="/partners" variant="ghost" size="sm" />
            </div>
        </article>
    </section>

    <section class="cos-page__section">
        <article class="cos-card">
            <p class="cos-card__eyebrow">For existing users</p>
            <h2 class="cos-card__title">Ваш робочий простір</h2>
            <p class="cos-card__copy">Після входу Кабінет показує доступні саме вашій ролі сервіси та наступні робочі дії.</p>
            <div class="cos-pattern-inline">
                <twig:CosButton label="Кабінет" href="/cabinet" variant="primary" size="sm" />
                <twig:CosButton label="Блог" href="/blog" variant="ghost" size="sm" />
            </div>
        </article>
    </section>
</section>
{% endblock %}
