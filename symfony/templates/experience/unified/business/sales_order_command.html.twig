{% set status = null %}
{% set revision = null %}
{% for fact in selectedFacts %}
  {% if fact.label == 'Status' %}{% set status = fact.value %}{% endif %}
  {% if fact.label == 'Revision' %}{% set revision = fact.value %}{% endif %}
{% endfor %}
{% for action in workspace.primaryActions %}
  {% if action.id == 'sales.order.confirm' %}
    <h2 class="cos-card__title">{{ action.label|trans({}, 'cuw_business')|trans }}</h2>
    {% if action.enabled and status == 'placed' and revision and csrfToken and idempotencyKey %}
      <form method="post" action="{{ path('cos_cuw_sales_order_confirm') }}" class="cos-uw__search" data-cos-order-confirm>
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <input type="hidden" name="order_id" value="{{ workspace.entity.id }}">
        <input type="hidden" name="expected_revision" value="{{ revision }}">
        <input type="hidden" name="idempotency_key" value="{{ idempotencyKey }}">
        <label>
          <input type="checkbox" name="confirm" value="yes" required>
          {{ 'Confirm the native Sales order only; no payment or fulfillment is executed.'|trans({}, 'cuw_business')|trans }}
        </label>
        <button class="cos-button cos-button--primary" type="submit">{{ 'Confirm order'|trans({}, 'cuw_business')|trans }}</button>
      </form>
    {% else %}
      <p class="cos-card__copy" role="status">{{ action.disabledReason|default('Only a currently placed order can be confirmed.')|trans({}, 'cuw_business')|trans }}</p>
    {% endif %}
  {% endif %}
{% endfor %}
