{% extends 'experience/workspace_shell.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    {% include 'experience/adaptive/_styles.html.twig' %}
{% endblock %}
{% block title %}Робочі простори | COS{% endblock %}
{% block workspace_content %}
<section class="cos-uw cos-page__stack" data-cos-unified-home data-workspace-id="unified.home">
  <header class="cos-card">
    <p class="cos-card__eyebrow">COS / Unified Workspace</p>
    <h1 class="cos-card__title">{{ 'uw.home.title'|trans }}</h1>
    <p class="cos-card__copy">{{ 'uw.home.active_org'|trans }} <strong>{{ shell.tenantLabel }}</strong>. {{ 'uw.home.no_org_switch'|trans }}</p>
    <div class="cos-uw__row">
      <a class="cos-button cos-button--primary" href="/workspace/unified/actions">{{ 'uw.home.commands'|trans }}</a>
      <a class="cos-button cos-button--ghost" href="{{ path('cos_ux05_operations') }}">{{ 'uw.home.operations'|trans }}</a>
      <a class="cos-button cos-button--ghost" href="{{ path('cos_federation_goals_index') }}">{{ 'uw.home.goals'|trans }}</a>
      <a class="cos-button cos-button--ghost" href="{{ path('cos_web_ai_panel',{view:'workspace'}) }}">{{ 'uw.home.ai_workspace'|trans }}</a>
      <div class="cos-uw__appearance" data-controller="appearance"
           data-appearance-theme-value="light" data-appearance-density-value="comfortable"
           role="group" aria-label="{{ 'uw.home.appearance'|trans }}">
        <button type="button" class="cos-button cos-button--ghost" data-action="click->appearance#setTheme" data-theme="light">{{ 'uw.home.light'|trans }}</button>
        <button type="button" class="cos-button cos-button--ghost" data-action="click->appearance#setTheme" data-theme="dark">{{ 'uw.home.dark'|trans }}</button>
        <button type="button" class="cos-button cos-button--ghost" data-action="click->appearance#setDensity" data-density="comfortable">{{ 'uw.home.comfortable'|trans }}</button>
        <button type="button" class="cos-button cos-button--ghost" data-action="click->appearance#setDensity" data-density="compact">{{ 'uw.home.compact'|trans }}</button>
      </div>
    </div>
  </header>
  {% include 'experience/adaptive/_controls.html.twig' %}
  <section class="cos-card" aria-labelledby="cos-uw-search">
    <h2 id="cos-uw-search" class="cos-card__title">{{ 'uw.home.find'|trans }}</h2>
    <form role="search" method="get" action="{{ path('cos_unified_home') }}" class="cos-uw__search">
      <label for="cos-uw-q">{{ 'uw.home.search_label'|trans }}</label>
      <div class="cos-uw__row">
        <input id="cos-uw-q" class="cos-input" name="q" type="search" maxlength="120" value="{{ query }}" placeholder="{{ 'uw.home.search_placeholder'|trans }}">
        <button class="cos-button cos-button--primary" type="submit">{{ 'uw.common.find'|trans }}</button>
      </div>
    </form>
    {% if query is not empty %}
      <div class="cos-uw__results" aria-live="polite">
        {% for hit in matches %}
          <a class="cos-uw__result" href="{{ hit.path }}"><strong>{{ hit.label }}</strong><small>{{ hit.subtitle ?: hit.kind }}</small></a>
        {% else %}
          <p class="cos-card__copy">{{ 'uw.home.no_results'|trans }}</p>
        {% endfor %}
      </div>
    {% endif %}
  </section>
  <section aria-labelledby="cos-uw-business">
    <h2 id="cos-uw-business" class="cos-card__title">{{ 'uw.home.contexts'|trans }}</h2>
    {% include 'experience/adaptive/_toggle.html.twig' with {sectionId:'home.identifiers',sectionLabel:'uw.adaptive.identifiers'} %}
    <div class="cos-uw__grid" data-cos-provider-workspaces>
      {% for workspace in workspaces %}
        <article class="cos-card" data-cos-provider-workspace="{{ workspace.id }}">
          <p class="cos-card__eyebrow">{{ 'uw.home.registered'|trans }}</p>
          <h3 class="cos-card__title">{{ workspace.label|trans }}</h3>
          {% if 'home.identifiers' in adaptive.composition.visibleSections %}<p class="cos-card__copy" data-cos-expert-ids>{{ workspace.id }}</p>{% endif %}
          <a class="cos-button cos-button--ghost" href="{{ path('cos_unified_business_workspace',{workspaceId:workspace.id}) }}">{{ 'uw.home.open'|trans }}</a>
        </article>
      {% else %}
        <p class="cos-card">{{ 'uw.home.empty'|trans }}</p>
      {% endfor %}
    </div>
    <p class="cos-card__copy">{{ 'uw.home.readiness'|trans }}</p>
  </section>
</section>
{% endblock %}
