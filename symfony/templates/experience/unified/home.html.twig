{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}Робочі простори | COS{% endblock %}
{% block workspace_content %}
<section class="cos-uw cos-page__stack" data-cos-unified-home data-workspace-id="unified.home">
  <header class="cos-card">
    <p class="cos-card__eyebrow">COS / Unified Workspace</p>
    <h1 class="cos-card__title">Мої робочі простори</h1>
    <p class="cos-card__copy">Активна організація: <strong>{{ shell.tenantLabel }}</strong>. Зміна організації в цьому сеансі не доступна.</p>
    <div class="cos-uw__row">
      <a class="cos-button cos-button--primary" href="/workspace/unified/actions">Команди та запити</a>
      <a class="cos-button cos-button--ghost" href="/cos/control-center">Операції та погодження</a>
      <div class="cos-uw__appearance" data-controller="appearance" data-appearance-theme-value="light" role="group" aria-label="Оформлення">
        <button type="button" class="cos-button cos-button--ghost" data-action="click->appearance#setTheme" data-theme="light">Світла тема</button>
        <button type="button" class="cos-button cos-button--ghost" data-action="click->appearance#setTheme" data-theme="dark">Темна тема</button>
      </div>
    </div>
  </header>
  <section class="cos-card" aria-labelledby="cos-uw-search">
    <h2 id="cos-uw-search" class="cos-card__title">Знайти дані</h2>
    <form role="search" method="get" action="{{ path('cos_unified_home') }}" class="cos-uw__search">
      <label for="cos-uw-q">Клієнт, угода, об'єкт або команда</label>
      <div class="cos-uw__row">
        <input id="cos-uw-q" class="cos-input" name="q" type="search" maxlength="120" value="{{ query }}" placeholder="Пошук у доступних даних">
        <button class="cos-button cos-button--primary" type="submit">Знайти</button>
      </div>
    </form>
    {% if query is not empty %}
      <div class="cos-uw__results" aria-live="polite">
        {% for hit in matches %}
          <a class="cos-uw__result" href="{{ hit.path }}"><strong>{{ hit.label }}</strong><small>{{ hit.subtitle ?: hit.kind }}</small></a>
        {% else %}
          <p class="cos-card__copy">Підтверджених результатів немає.</p>
        {% endfor %}
      </div>
    {% endif %}
  </section>
  <section aria-labelledby="cos-uw-business">
    <h2 id="cos-uw-business" class="cos-card__title">Доступні бізнес-контексти</h2>
    <div class="cos-uw__grid" data-cos-provider-workspaces>
      {% for workspace in workspaces %}
        <article class="cos-card" data-cos-provider-workspace="{{ workspace.id }}">
          <p class="cos-card__eyebrow">Зареєстрований контекст</p>
          <h3 class="cos-card__title">{{ workspace.label }}</h3>
          <p class="cos-card__copy">{{ workspace.id }}</p>
          <a class="cos-button cos-button--ghost" href="{{ path('cos_unified_business_workspace',{workspaceId:workspace.id}) }}">Перейти до даних</a>
        </article>
      {% else %}
        <p class="cos-card">Активних бізнес-контекстів немає.</p>
      {% endfor %}
    </div>
    <p class="cos-card__copy">Наявність контексту не підтверджує працездатність усіх його команд.</p>
  </section>
</section>
{% endblock %}
