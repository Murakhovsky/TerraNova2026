{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}Операції бізнесу | COS{% endblock %}
{% block workspace_content %}
<section class="cos-uw cos-page__stack" data-cos-unified-capabilities>
  <header class="cos-card">
    <p class="cos-card__eyebrow">COS / Query · Action · Approval</p>
    <h1 class="cos-card__title">{{ 'uw.actions.title'|trans }}</h1>
    <p class="cos-card__copy">{{ 'uw.actions.intro'|trans }}</p>
    <a class="cos-button cos-button--ghost" href="{{ path('cos_unified_home') }}">{{ 'uw.nav.workspaces'|trans }}</a>
  </header>
  {% if notice %}
    <div class="cos-alert" role="alert">
      {% if notice == 'invalid' %}{{ 'uw.actions.invalid'|trans }}
      {% elseif notice == 'unverified' %}{{ 'uw.actions.unverified'|trans }}
      {% else %}{{ 'uw.actions.unavailable'|trans }}{% endif %}
    </div>
  {% endif %}
  <section class="cos-uw__grid" aria-label="{{ 'uw.actions.catalog'|trans }}" data-cos-operation-catalog>
  {% for op in operations %}
    <article class="cos-card" data-cos-operation-id="{{ op.id }}" data-cos-operation-ready="{{ op.ui_ready ? 'yes' : 'no' }}">
      <p class="cos-card__eyebrow">{{ op.kind }} · {{ op.status }}</p>
      <h2 class="cos-card__title">{{ op.label|trans }}</h2>
      <p class="cos-card__copy">{{ op.reason|trans }}</p>
      {% if op.needs_approval %}<p class="cos-card__copy">{{ 'uw.actions.approval'|trans }}</p>{% endif %}
      {% if op.href %}
        <a class="cos-button cos-button--ghost" href="{{ op.href }}">{{ 'uw.common.open'|trans }}</a>
      {% else %}
        <span class="cos-card__copy" role="status">{{ 'uw.actions.disabled'|trans }}</span>
      {% endif %}
    </article>
  {% else %}
    <p class="cos-card">{{ 'uw.actions.empty'|trans }}</p>
  {% endfor %}
  </section>
  <section id="cos-uw-create" class="cos-card" aria-labelledby="cos-uw-create-label">
    <p class="cos-card__eyebrow">{{ 'uw.actions.human'|trans }}</p>
    <h2 id="cos-uw-create-label" class="cos-card__title">{{ 'uw.actions.create_title'|trans }}</h2>
    <p class="cos-card__copy">{{ 'uw.actions.create_copy'|trans }}</p>
    <form method="post" action="{{ path('cos_capabilities_property_create') }}" class="cos-uw__search">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
      <input type="hidden" name="idempotency_key" value="{{ idempotencyKey }}">
      <input type="hidden" name="return_to" value="unified">
      <label for="cos-uw-kind">{{ 'uw.actions.type'|trans }}</label>
      <input id="cos-uw-kind" name="type_code" class="cos-input" value="house" required maxlength="200">
      <label for="cos-uw-city">{{ 'uw.actions.city'|trans }}</label>
      <input id="cos-uw-city" name="city" class="cos-input" required maxlength="200">
      <label for="cos-uw-region">{{ 'uw.actions.region'|trans }}</label>
      <input id="cos-uw-region" name="region" class="cos-input" maxlength="200">
      <label for="cos-uw-address">{{ 'uw.actions.address'|trans }}</label>
      <input id="cos-uw-address" name="address" class="cos-input" maxlength="400">
      <label for="cos-uw-area">{{ 'uw.actions.area'|trans }}</label>
      <input id="cos-uw-area" name="area_total" class="cos-input" type="number" min="0" max="1000000" step="0.01">
      <button class="cos-button cos-button--primary" type="submit">{{ 'uw.actions.submit'|trans }}</button>
    </form>
  </section>
</section>
{% endblock %}
