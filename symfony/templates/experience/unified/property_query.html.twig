{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}Пошук нерухомості | COS{% endblock %}
{% block workspace_content %}
<section class="cos-uw cos-page__stack" data-cos-unified-property-query>
  <header class="cos-card">
    <p class="cos-card__eyebrow">Property / Application Query</p>
    <h1 class="cos-card__title">{{ 'uw.property.title'|trans }}</h1>
    <a class="cos-button cos-button--ghost" href="{{ path('cos_unified_actions') }}">{{ 'uw.nav.operations'|trans }}</a>
  </header>
  {% include 'experience/adaptive/_controls.html.twig' %}
  <form method="get" action="{{ path('cos_unified_property_query') }}" class="cos-card cos-uw__search" role="search">
    <label for="cos-uw-search-property">{{ 'uw.property.label'|trans }}</label>
    <div class="cos-uw__row">
      <input id="cos-uw-search-property" name="q" class="cos-input" type="search" maxlength="120" value="{{ query }}">
      <button class="cos-button cos-button--primary" type="submit">{{ 'uw.common.find'|trans }}</button>
    </div>
  </form>
  {% if error %}
    <div class="cos-alert" role="alert">{{ error|trans }}</div>
  {% elseif reference is not empty %}
    {% if data and data.property is defined and data.property %}
      <article class="cos-card" data-cos-native-property="{{ data.property.asset_id|default('') }}">
        <h2 class="cos-card__title">{{ 'uw.property.verified'|trans }}</h2>
{% include 'experience/adaptive/_toggle.html.twig' with {sectionId:'property.identifier',sectionLabel:'uw.adaptive.identifiers'} %}
{% if 'property.identifier' in adaptive.composition.visibleSections %}
        <p data-cos-expert-ids class="cos-card__copy">Asset: <code>{{ data.property.asset_id|default('') }}</code></p>
{% endif %}
        <p class="cos-card__copy">{{ 'uw.property.type'|trans }} {{ data.property.type_code|default('uw.property.unknown'|trans) }}</p>
        <p class="cos-card__copy">{{ 'uw.property.address'|trans }} {{ data.property.formatted_address|default('uw.property.not_set'|trans) }}</p>
      </article>
    {% else %}
      <div class="cos-card" role="status">{{ 'uw.property.missing'|trans }}</div>
    {% endif %}
  {% elseif query is not empty %}
    {% set hits=data.items|default([]) %}
    <section class="cos-card" aria-labelledby="cos-uw-property-list">
      <h2 id="cos-uw-property-list" class="cos-card__title">{{ 'uw.property.hits'|trans }}</h2>
      <div class="cos-uw__results" data-cos-property-results>
      {% for item in hits %}
        {% set asset=item.property|default({}) %}
        {% if asset.asset_id|default('') %}
          <a class="cos-uw__result" href="{{ path('cos_unified_property_query', { reference: asset.asset_id }) }}">
            <strong>{{ asset.formatted_address|default(asset.asset_id) ?: asset.asset_id }}</strong>
            <small>{{ asset.type_code|default('Property Asset') }}</small>
          </a>
        {% endif %}
      {% else %}
        <p class="cos-card__copy">{{ 'uw.property.none'|trans }}</p>
      {% endfor %}
      </div>
      {% set total=data.pagination.total|default(0) %}
      <p class="cos-card__copy">{{ 'uw.property.total'|trans }} {{ total }}. {{ 'uw.property.page'|trans }}</p>
      {% if total > page * perPage %}
        <a class="cos-button cos-button--ghost" href="{{ path('cos_unified_property_query', {q:query,page:page+1}) }}">{{ 'uw.property.next'|trans }}</a>
      {% endif %}
    </section>
  {% else %}
    <div class="cos-card" role="status">{{ 'uw.property.empty'|trans }}</div>
  {% endif %}
</section>
{% endblock %}
