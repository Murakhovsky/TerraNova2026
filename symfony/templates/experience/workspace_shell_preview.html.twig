{% extends 'experience/workspace_shell.html.twig' %}

{% block title %}COS Workspace Shell Preview{% endblock %}

{% block meta %}
    <meta name="robots" content="noindex,nofollow">
{% endblock %}

{% block workspace_content %}
    <section class="cos-ui-catalog__section" style="padding-top:0">
        <div class="cos-ui-catalog__section-head">
            <h2>Workspace Shell Preview</h2>
            <p>Wave 12.4 canonical shell composition.</p>
        </div>

        <div class="cos-ui-catalog__grid">
            <twig:CosCard
                eyebrow="Shell"
                title="Typed ViewModel"
                copy="Navigation, breadcrumbs, counters and connection state arrive as presentation data rather than page-specific markup."
            />
            <twig:CosCard
                eyebrow="Global"
                title="Command surface"
                copy="Use / or Cmd/Ctrl+K. Wave 12.5 replaces transitional navigation commands with provider-backed Search and Command registries."
            />
            <section class="cos-card">
                <twig:CosMetric label="Notifications" value="{{ shell.notificationCount }}" hint="Shell-level counter" />
            </section>
            <section class="cos-card">
                <twig:CosMetric label="Activities" value="{{ shell.activityCount }}" hint="Async operations and work queue entry" />
            </section>
        </div>

        <div class="cos-card cos-card--raised">
            <p class="cos-card__eyebrow">Responsive contract</p>
            <h3 class="cos-card__title">Desktop sidebar → mobile bottom navigation</h3>
            <p class="cos-card__copy">
                The same ShellViewModel drives both compositions. No separate mobile business UI exists.
            </p>
        </div>
    </section>
{% endblock %}
