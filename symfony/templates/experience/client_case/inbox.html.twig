{% extends 'experience/workspace_shell.html.twig' %}

{% block title %}Вхідні заявки | COS{% endblock %}

{% block workspace_content %}
<section
    class="cos-page__stack"
    data-client-case-inbox
    data-cos-archetype="{{ page.archetypeId() }}"
    data-cos-page-state="{{ page.state }}"
    data-cos-page-density="{{ page.density }}"
>
    <twig:CosPageHeader
        eyebrow="Clients · Inbox"
        title="Вхідні заявки"
        subtitle="Презентації, перегляди, контакти, нотатки й прив’язка до кейсів."
        metaValue="{{ inbox.newCount }}"
        metaLabel="нові"
    >
        <twig:CosButton label="До кейсів" href="/client-case" variant="ghost" />
    </twig:CosPageHeader>

    {% if actionStatus %}
        <twig:CosAlert title="Зміни застосовано" copy="{{ actionStatus }}" tone="positive" />
    {% endif %}

    {% if inbox.error %}
        <twig:CosAlert title="Вхідні заявки недоступні" copy="{{ inbox.error }}" tone="danger" />
    {% else %}
        <section class="cos-kpi-strip" aria-label="Зведення заявок">
            {% for metric in inbox.metrics %}
                <a class="cos-card" href="{{ metric.href }}">
                    <twig:CosMetric label="{{ metric.label }}" value="{{ metric.value }}" hint="{{ metric.hint }}" />
                </a>
            {% endfor %}
        </section>

        <nav class="cos-action-bar cos-action-bar--start" aria-label="Статус заявок">
            {% for tab in inbox.statusTabs %}
                <a
                    class="cos-button {{ tab.active ? 'cos-button--primary' : 'cos-button--ghost' }} cos-button--sm"
                    href="{{ tab.href }}"
                    {% if tab.active %}aria-current="page"{% endif %}
                >{{ tab.label }}</a>
            {% endfor %}
        </nav>

        <twig:CosFilterBar action="/client-case/inbox" label="Фільтри вхідних заявок">
            <label class="cos-field">
                <span>Пошук</span>
                <input class="cos-input" type="search" name="q" value="{{ inbox.filters.q }}" placeholder="Імʼя, телефон, email, об’єкт, кейс">
            </label>

            <label class="cos-field">
                <span>Намір</span>
                <select class="cos-select" name="request_intent">
                    <option value="">Усі</option>
                    {% for code, label in inbox.intentOptions %}
                        <option value="{{ code }}" {% if inbox.filters.request_intent == code %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="cos-field">
                <span>Статус</span>
                <select class="cos-select" name="status">
                    <option value="">Усі</option>
                    {% for code, label in inbox.statusOptions %}
                        <option value="{{ code }}" {% if inbox.filters.status == code %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="cos-field">
                <span>Відповідальний</span>
                <select class="cos-select" name="assigned_user_id">
                    <option value="0">Усі</option>
                    {% for manager in inbox.managerOptions %}
                        <option value="{{ manager.id }}" {% if inbox.filters.assigned_user_id == manager.id %}selected{% endif %}>{{ manager.label }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="cos-field">
                <span>Кейс</span>
                <select class="cos-select" name="has_case">
                    {% for code, label in inbox.caseOptions %}
                        <option value="{{ code }}" {% if inbox.filters.has_case == code %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="cos-field">
                <span>Сортування</span>
                <select class="cos-select" name="sort">
                    {% for code, label in inbox.sortOptions %}
                        <option value="{{ code }}" {% if inbox.filters.sort == code %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </label>

            <button class="cos-button cos-button--primary" type="submit">Застосувати</button>
            <a class="cos-button cos-button--ghost" href="/client-case/inbox">Скинути</a>
        </twig:CosFilterBar>

        {% if inbox.requests is empty %}
            <twig:CosEmptyState
                title="Заявок за цими фільтрами немає"
                copy="Змініть фільтри або поверніться до загальної черги."
            />
        {% else %}
            <div class="cos-entity-list cos-pattern-stack" role="list" aria-label="Вхідні заявки">
                {% for item in inbox.requests %}
                    <twig:ClientCaseInboxItem
                        :item="item"
                        :statusOptions="inbox.statusOptions"
                        :activityOptions="inbox.activityOptions"
                        :priorityOptions="inbox.priorityOptions"
                        :managerOptions="inbox.managerOptions"
                        :openCaseOptions="inbox.openCaseOptions"
                        csrfToken="{{ csrfToken }}"
                        returnUrl="{{ returnUrl }}"
                    />
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
</section>
{% endblock %}
