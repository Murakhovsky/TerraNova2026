{% extends 'experience/workspace_shell.html.twig' %}

{% block title %}Cross-Venue Discovery · Capital Markets{% endblock %}

{% block workspace_content %}
<div class="cos-page__stack cos-capital-markets">
  <header class="cos-growth-header">
    <div>
      <small>Capital Markets · Market Intelligence</small>
      <h1>Пошук інструментів на різних біржах</h1>
      <p>Історичний каталог bStocks → перевірка актуального лістингу на Binance, Bybit і Kraken.</p>
    </div>
  </header>

  <div class="cos-panel">
    <h2>Початковий каталог</h2>
    <p><strong>{{ watchlist|length }}</strong> кандидатів із файлу bStocks Binance.
      Час даних: <strong>27.09.2026 17:53 UTC</strong>. Це не актуальні котирування та не підтвердження прав на токен.</p>
    <p><a href="/capital-markets/market-data">Налаштувати джерела котирувань</a> ·
      <a href="/capital-markets/instruments">Реєстр інструментів</a> ·
      <a href="/capital-markets/markets">Market Explorer</a></p>
    {% if canScan %}
      <form method="post" action="/capital-markets/discovery/scan" class="d-flex align-items-center gap-2 flex-wrap">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <label for="discovery-limit">Обсяг сканування:</label>
        <select class="form-select" id="discovery-limit" name="limit">
          <option value="10">Перші 10 кандидатів</option>
          <option value="80">Усі 80 кандидатів</option>
        </select>
        <button class="btn btn-primary" type="submit">Перевірити лістинги через API</button>
      </form>
      <p><small>Три публічні каталоги. Запуск лише вручну, не частіше ніж раз на 90 секунд для організації.</small></p>
    {% else %}
      <p>Для запуску перевірки потрібен дозвіл Market Data Manage.</p>
    {% endif %}
  </div>

  <section class="cos-panel">
    <h2>Пул кандидатів (без торгового допуску)</h2>
    <p>Збережені спостереження з останніх успішних перевірок лістингів. Сканування не підтверджує юридичну ідентичність, забезпечення, redemption чи виконуваність угод. При недоступності біржі попереднє спостереження не стирається.</p>
    {% if poolCandidateCounts is empty %}
      <p>Пул поки порожній. Запустіть Discovery для першого наповнення.</p>
    {% else %}
      <div class="cos-kpi-strip">
        {% for status in poolCandidateCounts %}
          <article class="cos-card">
            <strong>{{ status.listing_state }}</strong>
            <p>{{ status.count }} спостережень</p>
          </article>
        {% endfor %}
      </div>
    {% endif %}
    <small>Стан верифікації: UNVERIFIED. Автоматичні підписки і trusted Market State ще не активовані цим модулем.</small>
  </section>

  <section class="cos-panel">
    <h2>Імпорт історичного каталогу</h2>
    <p>Завантажте XLSM/XLSX/CSV із Binance. Файл валідується без виконання макросів. Заявлені атрибути не означають поточний лістинг чи економічну еквівалентність.</p>
    {% if canScan %}
      <form method="post" action="/capital-markets/discovery/import" enctype="multipart/form-data" class="d-flex align-items-center gap-2 flex-wrap">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <label for="cm-seed-file">Каталог (до 5 МіБ)</label>
        <input id="cm-seed-file" type="file" name="seed_file" accept=".xlsm,.xlsx,.csv" required>
        <button class="btn btn-secondary" name="seed_mode" value="preview" type="submit">Перевірити без запису</button>
        <button class="btn btn-primary" name="seed_mode" value="apply" type="submit">Імпортувати</button>
      </form>
    {% else %}
      <p>Потрібен дозвіл на керування ринковими даними.</p>
    {% endif %}
    {% for result in app.flashes('seed_import') %}
      <p class="cos-alert cos-alert--success">Підсумок імпорту: {{ result }}</p>
    {% endfor %}
    {% if app.request.query.get('seedError') %}<p class="cos-alert cos-alert--danger">Імпорт відхилено: помилка формату, доступу, бази даних або конфлікт ідентичності. Причину записано в журнал.</p>{% endif %}
  </section>

  <section class="cos-panel">
    <h2>Канонічні записи для перевірки</h2>
    <p>Перенесення з імпортованих історичних кандидатів створює лише чернетки (DRAFT).
       Воно не підтверджує токенізований актив, не пов'язує його з базовою акцією, не підписується на котирування й не вмикає виконання угод.</p>
    {% if canSeedDrafts %}
      <form method="post" action="/capital-markets/discovery/canonical-drafts" class="d-flex align-items-center gap-2 flex-wrap">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <button class="btn btn-secondary" name="draft_mode" value="preview" type="submit">Перевірити план чернеток</button>
        <button class="btn btn-primary" name="draft_mode" value="apply" type="submit">Створити DRAFT у реєстрі</button>
        <button class="btn btn-secondary" name="draft_mode" value="underlying-preview" type="submit">Перевірити reference ETF/акції</button>
        <button class="btn btn-primary" name="draft_mode" value="underlying-apply" type="submit">Створити DRAFT reference</button>
      </form>
      <small>Перед створенням імпортуйте файл. Якщо є конфлікт ідентичності, зміни блокуються.</small>
    {% else %}
      <p>Для створення чернеток потрібен дозвіл на керування інструментами.</p>
    {% endif %}
    {% for result in app.flashes('canonical_drafts') %}
      <p class="cos-alert cos-alert--success">Результат: {{ result }}</p>
    {% endfor %}
    {% if app.request.query.get('draftError') %}
      <p class="cos-alert cos-alert--danger">Реєстрацію чернеток відхилено; перевірте журнал і повторіть dry-run.</p>
    {% endif %}
  </section>

  {% if scanned %}<div class="cos-alert cos-alert--success">Результат перевірки збережено.</div>{% endif %}
  {% if cooldown %}<div class="cos-alert cos-alert--warning">Зачекайте 90 секунд між перевірками.</div>{% endif %}
  {% if scanError %}<div class="cos-alert cos-alert--danger">Не вдалося провести сканування. Подивіться серверні журнали.</div>{% endif %}

  {% if quoted %}<div class="cos-alert cos-alert--success">Котирування отримано та збережено для аналізу.</div>{% endif %}
  {% if quoteError %}<div class="cos-alert cos-alert--danger">Не вдалося зібрати котирування. Оновіть лістинги й перевірте доступність API.</div>{% endif %}
  {% if quoteCooldown %}<div class="cos-alert cos-alert--warning">Наступна перевірка котирувань доступна через 60 секунд.</div>{% endif %}

  {% if snapshot is not null and canScan %}
    <section class="cos-panel">
      <h2>Котирування з кількох майданчиків</h2>
      <p>Публічні Bid/Ask із Binance Spot, Bybit Spot та Kraken. Лише котирування пар, які щойно підтверджені через Discovery. Ані вартість базової акції, ані справжній арбітраж цей крок не розраховує.</p>
      <form method="post" action="/capital-markets/discovery/quotes">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <button type="submit" class="btn btn-primary">Отримати актуальні Bid/Ask</button>
      </form>
      <small>Потрібен Discovery не старше 15 хвилин. Між запусками не менше 60 секунд. Дані тільки для дослідження.</small>
    </section>
  {% endif %}

  {% if quoteSnapshot is not null %}
    <section class="cos-panel">
      <h2>Останні спостереження цін</h2>
      <p>Час отримання: {{ quoteSnapshot.observed_at_utc }}. Ціни не мають підтвердженого provider timestamp і не є сертифікованим MarketState. Оновіть знімок перед використанням.</p>
      <p><strong>Лише діагностика.</strong> Спільний underlying не означає однаковий токен. USD та USDT не порівнюються без валютної конверсії. Комісії, проскальзування, ліквідність, права погашення та виконуваність не перевірено.</p>
      <div class="cos-kpi-strip">
        {% for venue, source in quoteSnapshot.source_health %}
          <article class="cos-card">
            <strong>{{ venue }}</strong>
            <p>{{ source.status }}</p>
            <small>{{ source.sample_count }} придатних котирувань</small>
            {% if source.received_at_utc|default(null) %}<div><small>Відповідь: {{ source.received_at_utc }}</small></div>{% endif %}
          </article>
        {% endfor %}
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead><tr><th>Underlying</th><th>Інструмент</th><th>Venue</th><th>Котирування</th><th>Bid</th><th>Ask</th><th>Bid Qty</th><th>Ask Qty</th><th>Статус</th></tr></thead>
          <tbody>
          {% for row in quoteSnapshot.rows %}
            {% for venue in row.venues %}
              <tr>
                <td>{{ row.candidate.underlying }}</td>
                <td>{{ venue.symbol|default('—') }}</td>
                <td>{{ venue.venue }}</td>
                <td>{{ venue.quote_observation.quote_currency|default(venue.quote|default('—')) }}</td>
                <td>{% if venue.quote_observation is not null %}{{ venue.quote_observation.bid }}{% else %}—{% endif %}</td>
                <td>{% if venue.quote_observation is not null %}{{ venue.quote_observation.ask }}{% else %}—{% endif %}</td>
                <td>{% if venue.quote_observation is not null %}{{ venue.quote_observation.bid_quantity }}{% else %}—{% endif %}</td>
                <td>{% if venue.quote_observation is not null %}{{ venue.quote_observation.ask_quantity }}{% else %}—{% endif %}</td>
                <td>{{ venue.quote_status }}</td>
              </tr>
            {% endfor %}
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p><small>Статус операційної придатності: NON_EXECUTABLE. Нетто-прибуток не розраховується до перевірки економічної тотожності, комісій, валюти й ризиків.</small></p>
    </section>
  {% endif %}

  {% if snapshot is null %}
    <section class="cos-panel">
      <h2>Немає виконаних сканувань</h2>
      <p>Запустіть перевірку 10 кандидатів. До цього часу всі лістинги вважаються непідтвердженими.</p>
    </section>
  {% else %}
    <section class="cos-panel">
      <h2>Остання перевірка</h2>
      <p>{{ snapshot.as_of_utc }} · кандидатів {{ snapshot.total }} · знімок незмінний після збереження.</p>
      <div class="cos-kpi-strip">
        {% for venue, health in snapshot.source_health %}
          <article class="cos-card">
            <strong>{{ venue }}</strong>
            <p>{{ health.state }}</p>
            <small>{% if health.count is not null %}{{ health.count }} активних USD/USDT пар у каталозі{% else %}Каталог недоступний{% endif %}</small>
            {% if health.reason|default('') %}<p>{{ health.reason }}</p>{% endif %}
          </article>
        {% endfor %}
      </div>
    </section>
    <section class="cos-panel">
      <h2>Результати пошуку</h2>
      <p>Статус «LISTED» означає лише наявність символу в публічному каталозі. Ідентичність токенів, його забезпечення, конвертація валют і можливість виконання угоди <strong>не перевірені</strong>.</p>
      <div class="table-responsive">
        <table class="table">
          <thead><tr><th>Underlying</th><th>Binance bStock</th><th>Плече</th><th>Binance</th><th>Bybit</th><th>Kraken</th><th>Стан</th></tr></thead>
          <tbody>
            {% for row in snapshot.rows %}
              <tr>
                <td>{{ row.candidate.underlying }}</td>
                <td>{{ row.candidate.token }}</td>
                <td>{{ row.candidate.leverage }}</td>
                {% for venue in row.venues %}
                  <td>
                    <strong>{{ venue.status }}</strong>
                    {% if venue.symbol|default(null) %}<div><small>{{ venue.symbol }} / {{ venue.quote }}</small></div>{% endif %}
                  </td>
                {% endfor %}
                <td>{{ row.economic_link }} · PAPER ONLY</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    <section class="cos-panel">
      <h2>Що далі?</h2>
      <p>Підтверджені символи вручну співвідносяться з реєстром COS. Після перевірки ідентичності, типу інструмента та біржових правил налаштовуються Market Data subscriptions і збираються Bid/Ask. Лише тоді їх можна передавати до Opportunity Engine.</p>
      <a href="/capital-markets/market-data">Перейти до налаштування Market Data →</a>
    </section>
  {% endif %}
</div>
{% endblock %}
