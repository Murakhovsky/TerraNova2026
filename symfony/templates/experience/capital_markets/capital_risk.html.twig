{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}{{ pageTitle }} | Terra Nova COS{% endblock %}
{% block workspace_content %}
{% set w=workspace|default({}) %}{% set p=w.portfolio|default({}) %}{% set e=w.exposure|default({}) %}{% set r=w.risk|default({}) %}{% set a=w.allocation_plan|default({}) %}
<div class="cos-page__stack cos-capital-markets" data-csrf="{{ csrfToken }}">
<header class="cos-growth-header"><div><small>Capital Markets · Capital Allocation & Risk</small><h1>{{ pageTitle }}</h1><p>Portfolio-aware capital decisions with deterministic risk constraints. AI can explain and propose, never override hard limits.</p></div>
<nav class="cos-growth-actions"><a class="btn btn-outline-secondary" href="/capital-markets">Overview</a><a class="btn btn-outline-secondary" href="/capital-markets/portfolio">Portfolio</a><a class="btn btn-outline-secondary" href="/capital-markets/risk">Risk</a><a class="btn btn-outline-secondary" href="/capital-markets/allocation">Allocation</a><a class="btn btn-outline-secondary" href="/capital-markets/research">Research Lab</a></nav></header>
<section class="cos-kpi-strip"><twig:CosMetric label="Equity" value="{{ p.equity|default(p.capital|default('—')) }}" hint="portfolio equity" /><twig:CosMetric label="Available" value="{{ p.available_capital|default('—') }}" hint="usable after reservations" /><twig:CosMetric label="Gross exposure" value="{{ e.gross_exposure|default('—') }}" hint="before netting" /><twig:CosMetric label="Net exposure" value="{{ e.net_exposure|default('—') }}" hint="validated economic netting" /><twig:CosMetric label="Risk state" value="{{ r.status|default(r.state|default('NORMAL')) }}" hint="hard limits cannot be bypassed" /></section>
{% if cmView=='portfolio' %}
<section class="cos-panel"><h2>Capital map</h2><div class="table-responsive"><table class="table"><thead><tr><th>State</th><th>Amount</th></tr></thead><tbody><tr><td>Total</td><td>{{ p.equity|default(p.capital|default('—')) }}</td></tr><tr><td>Available</td><td>{{ p.available_capital|default('—') }}</td></tr><tr><td>Reserved</td><td>{{ p.reserved_capital|default('—') }}</td></tr><tr><td>Deployed</td><td>{{ p.deployed_capital|default('—') }}</td></tr></tbody></table></div></section>
<section class="cos-panel"><h2>Exposure</h2><p>Gross {{ e.gross_exposure|default('—') }} · Net {{ e.net_exposure|default('—') }}</p><div class="row"><div class="col-md-6"><h3>By venue</h3><pre>{{ e.by_venue|default({})|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></div><div class="col-md-6"><h3>By strategy</h3><pre>{{ e.by_strategy|default({})|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></div></div></section>
{% elseif cmView=='risk' %}
<section class="cos-panel"><h2>Risk envelope & headroom</h2>{% set env=w.risk_envelope|default({}) %}<pre>{{ env|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></section>
<section class="cos-panel"><h2>Stress results</h2><div class="table-responsive"><table class="table"><thead><tr><th>Scenario</th><th>Estimated loss</th><th>Capital remaining</th></tr></thead><tbody>{% for x in w.stress_results|default([]) %}<tr><td>{{ x.scenario_id }}</td><td>{{ x.estimated_loss }}</td><td>{{ x.capital_remaining }}</td></tr>{% else %}<tr><td colspan="3">No stress runs yet.</td></tr>{% endfor %}</tbody></table></div></section>
{% else %}
<section class="cos-panel"><h2>Allocation plan</h2>{% if a %}<p><strong>{{ a.status }}</strong> · policy {{ a.policy_version }}</p><p>{{ a.reasoning_summary }}</p><div class="table-responsive"><table class="table"><thead><tr><th>Priority</th><th>Opportunity</th><th>Requested</th><th>Approved</th><th>Decision</th><th>Reason</th></tr></thead><tbody>{% for x in a.allocations|default([]) %}<tr><td>{{ x.priority }}</td><td>{{ x.opportunity_id }}</td><td>{{ x.requested_capital }}</td><td>{{ x.approved_capital }}</td><td>{{ x.decision }}</td><td>{{ x.reason }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>No allocation plan has been calculated yet.</p>{% endif %}</section>
{% endif %}
</div>{% endblock %}
