{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}{{ pageTitle }} | Terra Nova COS{% endblock %}

{% block workspace_content %}
{% set w = workspace|default({}) %}
<div class="cos-page__stack cos-capital-markets" data-csrf="{{ csrfToken }}">
  <header class="cos-growth-header">
    <div>
      <small>Capital Markets · Research + Risk + Paper Execution</small>
      <h1>{{ pageTitle }}</h1>
      <p>Canonical instruments, economic relationships, trusted market data and guarded paper research. Live execution remains disabled.</p>
    </div>
    <nav class="cos-growth-actions" aria-label="Capital Markets navigation">
      <a class="btn btn-outline-secondary" href="/capital-markets">Overview</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/instruments">Instruments</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/relationships">Relationships</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/venues">Venues</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/market-data">Market Data</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/tokenized-equities">Tokenized Equity</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/crypto-spot-perpetual">Crypto Spot / Perpetual</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/research">Research Lab</a>
    </nav>
  </header>

  {% if query.saved|default(false) %}
    <div class="alert alert-success">Changes saved and written to COS Audit.</div>
  {% endif %}
  {% if query.error|default('') %}
    <div class="alert alert-danger">{{ query.error }}</div>
  {% endif %}

  {% if cmView == 'failure' %}
    <section class="cos-panel">
      <strong>{{ failureCode|default(500) }}</strong>
      <h2>{{ failureTitle|default('Capital Markets unavailable') }}</h2>
      <p>{{ failureMessage|default('The Foundation workspace could not be loaded.') }}</p>
      <a href="/capital-markets" class="btn btn-primary">Back to Capital Markets</a>
    </section>

  {% elseif cmView == 'overview' %}
    <section class="cos-kpi-strip" aria-label="Capital Markets foundation state">
      <twig:CosMetric label="Instruments" value="{{ w.instrument_count|default(0) }}" hint="canonical identities" />
      <twig:CosMetric label="Relationships" value="{{ w.relationship_count|default(0) }}" hint="directed economic links" />
      <twig:CosMetric label="Venues" value="{{ w.venue_count|default(0) }}" hint="registered venues" />
      <twig:CosMetric label="Stage" value="Market Intelligence" hint="read-only market visibility" />
    </section>

    <section class="cos-panel">
      <h2>System status</h2>
      <p><strong>Foundation + Market Intelligence ready.</strong> The domain understands instruments, relationships, venues and trusted market-state semantics.</p>
      <p>External provider sources remain tenant-configured and explicitly gated. Paper Trading, Live Trading and Auto Execution remain disabled.</p>
    </section>

    <section class="cos-panel">
      <h2>Recently registered instruments</h2>
      {% if w.recent_instruments|default([]) is empty %}
        <p>No instruments yet. Create the first canonical instrument in the Instrument Registry.</p>
      {% else %}
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Symbol</th><th>Name</th><th>Family</th><th>Status</th></tr></thead>
            <tbody>
            {% for item in w.recent_instruments %}
              <tr>
                <td><a href="/capital-markets/instruments/{{ item.id|url_encode }}">{{ item.symbol }}</a></td>
                <td>{{ item.name }}</td>
                <td>{{ item.family }}</td>
                <td>{{ item.status }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>

  {% elseif cmView == 'instruments' %}
    <section class="cos-panel">
      <form method="get" action="/capital-markets/instruments" class="row g-2">
        <div class="col-md-5"><input class="form-control" name="q" value="{{ query.q|default('') }}" placeholder="Search symbol or name"></div>
        <div class="col-md-3">
          <select class="form-select" name="family">
            <option value="">All families</option>
            {% for family in ['equity','tokenized_security','crypto_asset','stablecoin','spot_market','future','perpetual','option','fixed_income','tokenized_fixed_income','fund','rwa','fx','commodity','index'] %}
              <option value="{{ family }}" {% if query.family|default('') == family %}selected{% endif %}>{{ family|upper }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <select class="form-select" name="status">
            <option value="">All statuses</option>
            {% for status in ['DRAFT','ACTIVE','SUSPENDED','DELISTED','UNKNOWN'] %}
              <option value="{{ status }}" {% if query.status|default('') == status %}selected{% endif %}>{{ status }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Filter</button></div>
      </form>
    </section>

    {% if canManageInstruments %}
      <section class="cos-panel">
        <h2>Create instrument</h2>
        <form method="post" action="/capital-markets/instruments" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-2"><input class="form-control" name="symbol" placeholder="AAPL" required></div>
          <div class="col-md-2"><input class="form-control" name="canonical_symbol" placeholder="AAPL"></div>
          <div class="col-md-4"><input class="form-control" name="name" placeholder="Apple Inc." required></div>
          <div class="col-md-2">
            <select class="form-select" name="family" required>
              {% for family in ['equity','tokenized_security','crypto_asset','stablecoin','spot_market','future','perpetual','option','fixed_income','tokenized_fixed_income','fund','rwa','fx','commodity','index'] %}
                <option value="{{ family }}">{{ family|upper }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="status">
              {% for status in ['DRAFT','ACTIVE','SUSPENDED','UNKNOWN'] %}<option value="{{ status }}">{{ status }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" name="currency" placeholder="USD"></div>
          <div class="col-md-2"><input class="form-control" name="quote_asset" placeholder="USD / USDT"></div>
          <div class="col-md-3"><input class="form-control" name="issuer_reference" placeholder="Issuer reference"></div>
          <div class="col-md-2"><input class="form-control" name="jurisdiction" placeholder="Jurisdiction"></div>
          <div class="col-md-3"><input class="form-control" name="primary_venue_reference" placeholder="Primary venue reference"></div>
          <div class="col-md-12"><button class="btn btn-primary">Create instrument</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-panel">
      <h2>Instrument Registry</h2>
      {% if w.instruments|default([]) is empty %}
        <p>No instruments match the current filters.</p>
      {% else %}
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Symbol</th><th>Name</th><th>Family</th><th>Status</th><th>Identifiers</th><th>Updated</th></tr></thead>
            <tbody>
            {% for item in w.instruments %}
              <tr>
                <td><a href="/capital-markets/instruments/{{ item.id|url_encode }}"><strong>{{ item.symbol }}</strong></a></td>
                <td>{{ item.name }}</td>
                <td>{{ item.family }}</td>
                <td>{{ item.status }}</td>
                <td>{{ item.identifiers|length }}</td>
                <td>{{ item.updated_at }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>

  {% elseif cmView == 'instrument' %}
    {% set i = w.instrument %}
    <section class="cos-panel">
      <div class="d-flex justify-content-between align-items-start gap-3">
        <div>
          <small>{{ i.family|upper }}</small>
          <h2>{{ i.symbol }} · {{ i.name }}</h2>
          <p>Canonical symbol: <strong>{{ i.canonical_symbol }}</strong> · Status: <strong>{{ i.status }}</strong></p>
        </div>
        <a class="btn btn-outline-secondary" href="/capital-markets/instruments">Back to registry</a>
      </div>
    </section>

    <section class="cos-panel">
      <h2>Identity</h2>
      <dl class="row">
        <dt class="col-sm-3">Internal ID</dt><dd class="col-sm-9">{{ i.id }}</dd>
        <dt class="col-sm-3">Currency</dt><dd class="col-sm-9">{{ i.currency|default('—') }}</dd>
        <dt class="col-sm-3">Quote asset</dt><dd class="col-sm-9">{{ i.quote_asset|default('—') }}</dd>
        <dt class="col-sm-3">Issuer</dt><dd class="col-sm-9">{{ i.issuer_reference|default('—') }}</dd>
        <dt class="col-sm-3">Jurisdiction</dt><dd class="col-sm-9">{{ i.jurisdiction|default('—') }}</dd>
        <dt class="col-sm-3">Primary venue</dt><dd class="col-sm-9">{{ i.primary_venue_reference|default('—') }}</dd>
      </dl>
      <h3>Identifiers</h3>
      {% if i.identifiers is empty %}<p>No external identifiers.</p>{% endif %}
      <ul>
        {% for identifier in i.identifiers %}
          <li><strong>{{ identifier.type }}</strong>: {{ identifier.value }}{% if identifier.source %} · {{ identifier.source }}{% endif %}</li>
        {% endfor %}
      </ul>
    </section>

    {% if canManageInstruments %}
      <section class="cos-panel">
        <h2>Edit instrument</h2>
        <form method="post" action="/capital-markets/instruments/{{ i.id|url_encode }}" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-2"><input class="form-control" name="symbol" value="{{ i.symbol }}" required></div>
          <div class="col-md-2"><input class="form-control" name="canonical_symbol" value="{{ i.canonical_symbol }}" required></div>
          <div class="col-md-4"><input class="form-control" name="name" value="{{ i.name }}" required></div>
          <div class="col-md-2">
            <select class="form-select" name="family">
              {% for family in ['equity','tokenized_security','crypto_asset','stablecoin','spot_market','future','perpetual','option','fixed_income','tokenized_fixed_income','fund','rwa','fx','commodity','index'] %}
                <option value="{{ family }}" {% if i.family == family %}selected{% endif %}>{{ family|upper }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="status">
              {% for status in ['DRAFT','ACTIVE','SUSPENDED','DELISTED','UNKNOWN'] %}
                <option value="{{ status }}" {% if i.status == status %}selected{% endif %}>{{ status }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" name="currency" value="{{ i.currency|default('') }}" placeholder="USD"></div>
          <div class="col-md-2"><input class="form-control" name="quote_asset" value="{{ i.quote_asset|default('') }}" placeholder="USDT"></div>
          <div class="col-md-3"><input class="form-control" name="issuer_reference" value="{{ i.issuer_reference|default('') }}" placeholder="Issuer"></div>
          <div class="col-md-2"><input class="form-control" name="jurisdiction" value="{{ i.jurisdiction|default('') }}" placeholder="Jurisdiction"></div>
          <div class="col-md-3"><input class="form-control" name="primary_venue_reference" value="{{ i.primary_venue_reference|default('') }}" placeholder="Primary venue"></div>
          <div class="col-md-12"><button class="btn btn-primary">Save instrument</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-panel">
      <h2>Related financial exposures</h2>
      {% if i.relationships is empty %}
        <p>No economic relationships registered.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Source</th><th>Relationship</th><th>Target</th><th>Strength</th><th>Status</th></tr></thead>
          <tbody>
          {% for rel in i.relationships %}
            <tr>
              <td>{{ rel.source_instrument.symbol|default(rel.source_instrument.id) }}</td>
              <td><strong>{{ rel.type }}</strong></td>
              <td>{{ rel.target_instrument.symbol|default(rel.target_instrument.id) }}</td>
              <td>{{ rel.strength }}</td>
              <td>{{ rel.status }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Venue availability</h2>
      {% if i.venues is empty %}
        <p>This instrument is not registered on a venue yet.</p>
      {% else %}
        <ul>
          {% for mapping in i.venues %}
            <li><strong>{{ mapping.venue.name|default(mapping.venue.id) }}</strong> · {{ mapping.venue_symbol }} · {{ mapping.status }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Audit history</h2>
      {% if w.audit|default([]) is empty %}
        <p>No Capital Markets audit entries for this instrument yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Time</th><th>Actor</th><th>Correlation</th><th>Category</th></tr></thead>
          <tbody>
          {% for row in w.audit %}
            <tr><td>{{ row.created_at|default('—') }}</td><td>{{ row.actor_id|default('—') }}</td><td>{{ row.correlation_id|default('—') }}</td><td>{{ row.category|default('platform_activity') }}</td></tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

  {% elseif cmView == 'research_lab' %}
    {% set hypotheses = w.hypotheses|default([]) %}
    {% set experiments = w.experiments|default([]) %}
    {% set datasets = w.datasets|default([]) %}
    {% set strategyVersions = w.strategy_versions|default([]) %}
    {% set knowledge = w.knowledge|default([]) %}
    {% set results = w.results|default([]) %}
    {% set runs = w.backtest_runs|default([]) %}
    {% set oosRuns = w.oos_runs|default([]) %}
    {% set paperRuns = w.paper_runs|default([]) %}
    {% set scorecards = w.scorecards|default([]) %}
    {% set rejections = w.rejections|default([]) %}
    {% set promotions = w.promotion_decisions|default([]) %}
    {% set metrics = w.metrics|default({}) %}

    <section class="cos-kpi-strip" aria-label="Research Lab state">
      <twig:CosMetric label="Hypotheses" value="{{ metrics.hypothesis_count|default(hypotheses|length) }}" hint="formal research objects" />
      <twig:CosMetric label="Experiments" value="{{ metrics.experiment_count|default(experiments|length) }}" hint="immutable specifications" />
      <twig:CosMetric label="Backtests" value="{{ metrics.backtest_count|default(runs|length) }}" hint="historical replay runs" />
      <twig:CosMetric label="OOS" value="{{ metrics.oos_count|default(oosRuns|length) }}" hint="isolated validation runs" />
      <twig:CosMetric label="Failure rate" value="{{ metrics.backtest_failure_rate|default(0) }}" hint="research runtime health" />
      <twig:CosMetric label="Knowledge" value="{{ metrics.knowledge_count|default(knowledge|length) }}" hint="validated + rejected findings" />
      <twig:CosMetric label="Authority" value="GATED" hint="AI cannot promote to Live" />
    </section>

    <section class="cos-panel">
      <div class="d-flex justify-content-between gap-3 flex-wrap">
        <div>
          <small>CM-RESEARCH-LAB</small>
          <h2>Research Pipeline</h2>
          <p>Idea → Hypothesis → Experiment → Frozen Dataset → Backtest → OOS → Paper → Decision → Knowledge.</p>
          <p>Positive and negative results are retained. Promotion is deterministic and auditable. Live activation is outside this workspace.</p>
        </div>
        <div>
          <span class="badge text-bg-info">RESEARCH</span>
          <span class="badge text-bg-warning">PAPER GATED</span>
          <span class="badge text-bg-danger">LIVE OFF</span>
        </div>
      </div>
    </section>

    {% if canManageResearch|default(false) or canRunResearch|default(false) or canPromoteStrategy|default(false) or canUseResearchAgent|default(false) %}
    <section class="cos-panel" data-research-action-console>
      <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start">
        <div>
          <h2>Operator Actions</h2>
          <p>Run Research Lab API operations without leaving the workspace. Choose a preset or edit the endpoint directly, provide a JSON object, then execute.</p>
        </div>
        <span class="badge text-bg-secondary">CSRF protected</span>
      </div>
      <div class="row g-3">
        <div class="col-lg-4">
          <label class="form-label" for="research-action-preset">Operation</label>
          <select class="form-select" id="research-action-preset" data-research-preset>
            <option value="/api/v1/capital-markets/research/hypotheses">Create hypothesis</option>
            <option value="/api/v1/capital-markets/research/datasets">Freeze dataset</option>
            <option value="/api/v1/capital-markets/strategies/versions">Create strategy version</option>
            <option value="/api/v1/capital-markets/research/experiments">Create experiment</option>
            <option value="/api/v1/capital-markets/research/backtests">Queue backtest</option>
            <option value="/api/v1/capital-markets/research/backtests/run">Run backtest now</option>
            <option value="/api/v1/capital-markets/research/walk-forward">Walk-forward</option>
            <option value="/api/v1/capital-markets/research/parameter-search">Queue parameter search</option>
            <option value="/api/v1/capital-markets/research/paper-runs">Start Paper run</option>
            <option value="/api/v1/capital-markets/research/rejections">Reject hypothesis</option>
            <option value="/api/v1/capital-markets/research/knowledge">Record knowledge</option>
            <option value="/api/v1/capital-markets/research/agent/run">Run Research Agent</option>
          </select>
        </div>
        <div class="col-lg-8">
          <label class="form-label" for="research-action-url">API endpoint</label>
          <input class="form-control" id="research-action-url" data-research-url value="/api/v1/capital-markets/research/hypotheses">
          <div class="form-text">For ID-based operations use paths such as <code>/api/v1/capital-markets/research/hypotheses/{id}/revisions</code>, <code>/experiments/{id}/status</code>, <code>/paper-runs/{id}/complete</code>, <code>/strategies/{id}/promotion-request</code> or <code>/strategies/{id}/demotion-request</code>.</div>
        </div>
        <div class="col-12">
          <label class="form-label" for="research-action-json">JSON payload</label>
          <textarea class="form-control font-monospace" id="research-action-json" rows="12" data-research-payload>{
  "hypothesis_id": "h4-demo-001",
  "code": "H4",
  "title": "BTC spot/perpetual basis convergence",
  "description": "Test whether executable basis converges after costs.",
  "economic_reason": "Temporary dislocation between spot and perpetual markets.",
  "edge_source": "BASIS",
  "expected_behavior": "Positive net convergence after fees and slippage.",
  "required_data": ["spot_quote", "perp_quote", "funding_rate"],
  "success_criteria": {"minimum_sample": 200},
  "failure_criteria": {"max_drawdown_ratio": 0.15},
  "risk_assumptions": {"neutral_hedge": true},
  "capital_assumptions": {"mode": "paper"},
  "status": "DRAFT",
  "priority": "P1"
}</textarea>
        </div>
        <div class="col-12 d-flex gap-2 align-items-center flex-wrap">
          <button class="btn btn-primary" type="button" data-research-submit>Execute</button>
          <span class="text-body-secondary" data-research-status>Ready.</span>
        </div>
        <div class="col-12">
          <label class="form-label" for="research-action-response">Response</label>
          <pre class="border rounded p-3 mb-0 overflow-auto" id="research-action-response" data-research-response style="max-height:22rem">No request yet.</pre>
        </div>
      </div>
    </section>
    <script>
    (() => {
      const root=document.querySelector('[data-research-action-console]');
      if(!root)return;
      const preset=root.querySelector('[data-research-preset]');
      const url=root.querySelector('[data-research-url]');
      const payload=root.querySelector('[data-research-payload]');
      const submit=root.querySelector('[data-research-submit]');
      const status=root.querySelector('[data-research-status]');
      const response=root.querySelector('[data-research-response]');
      preset?.addEventListener('change',()=>{url.value=preset.value;});
      submit?.addEventListener('click',async()=>{
        status.textContent='Running…';
        submit.disabled=true;
        try{
          const body=JSON.parse(payload.value||'{}');
          body.csrf_token={{ csrfToken|json_encode|raw }};
          const result=await fetch(url.value,{
            method:'POST',
            credentials:'same-origin',
            headers:{'Content-Type':'application/json','X-CSRF-Token':{{ csrfToken|json_encode|raw }}},
            body:JSON.stringify(body)
          });
          const text=await result.text();
          try{response.textContent=JSON.stringify(JSON.parse(text),null,2);}catch(_){response.textContent=text;}
          status.textContent=result.ok?'Completed. Reloading data…':'Request failed ('+result.status+').';
          if(result.ok)setTimeout(()=>window.location.reload(),700);
        }catch(error){
          status.textContent='Invalid payload or request failure.';
          response.textContent=String(error);
        }finally{
          submit.disabled=false;
        }
      });
    })();
    </script>
    {% endif %}

    {% set stages = ['IDEA','DRAFT','READY_FOR_RESEARCH','RESEARCHING','BACKTESTING','OUT_OF_SAMPLE','PAPER','VALIDATED','REJECTED'] %}
    <section class="cos-panel">
      <h2>Pipeline by stage</h2>
      <div class="row g-3">
        {% for stage in stages %}
          {% set count = 0 %}
          {% for h in hypotheses %}
            {% if h.status|default('') == stage %}{% set count = count + 1 %}{% endif %}
          {% endfor %}
          <div class="col-md-4 col-xl-2">
            <div class="border rounded p-3 h-100">
              <small>{{ stage }}</small>
              <div class="fs-4 fw-bold">{{ count }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="cos-panel">
      <h2>Hypotheses</h2>
      {% if hypotheses is empty %}
        <p>No formal ResearchHypothesis records yet. The legacy H1/H2 and H4/H5/H6 evidence remains available in the vertical slices until migrated into the Lab registry.</p>
      {% else %}
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Code</th><th>Title</th><th>Edge source</th><th>Priority</th><th>Status</th><th>Revision</th><th>Economic thesis</th></tr></thead>
            <tbody>
            {% for h in hypotheses %}
              <tr>
                <td><strong>{{ h.code|default('—') }}</strong></td>
                <td>{{ h.title|default('—') }}</td>
                <td>{{ h.edge_source|default('—') }}</td>
                <td>{{ h.priority|default('—') }}</td>
                <td><strong>{{ h.status|default('—') }}</strong></td>
                <td>v{{ h.revision|default(1) }}</td>
                <td>{{ h.economic_reason|default('—') }}</td>
              </tr>
              <tr>
                <td colspan="7"><small>Success: {{ h.success_criteria|default({})|json_encode }} · Failure: {{ h.failure_criteria|default({})|json_encode }}</small></td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Frozen Datasets</h2>
      {% if datasets is empty %}
        <p>No frozen ResearchDataset snapshots yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Dataset</th><th>Period</th><th>Quality</th><th>Sources</th><th>Instruments</th><th>Snapshot hash</th></tr></thead>
          <tbody>
          {% for d in datasets %}
            <tr>
              <td><strong>{{ d.name|default(d.dataset_id|default('—')) }}</strong><br><small>{{ d.dataset_id|default('—') }}</small></td>
              <td>{{ d.from|default('—') }} → {{ d.to|default('—') }}</td>
              <td>{{ d.quality_status|default('—') }}</td>
              <td>{{ d.data_sources|default([])|join(', ') }}</td>
              <td>{{ d.instrument_universe|default([])|join(', ') }}</td>
              <td><code>{{ d.snapshot_hash|default('—') }}</code></td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Strategy Versions</h2>
      {% if strategyVersions is empty %}
        <p>No immutable StrategyVersion records yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
