{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}{{ pageTitle }} | Terra Nova COS{% endblock %}

{% block workspace_content %}
{% set w = workspace|default({}) %}
<div class="cos-page__stack cos-capital-markets" data-csrf="{{ csrfToken }}">
  <header class="cos-growth-header">
    <div>
      <small>Capital Markets · Research + Risk + Paper Execution</small>
      <h1>{{ pageTitle }}</h1>
      <p>Canonical instruments, economic relationships, trusted market data and guarded paper research. Live execution remains disabled.</p>
    </div>
    <nav class="cos-growth-actions" aria-label="Capital Markets navigation">
      <a class="btn btn-outline-secondary" href="/capital-markets">Overview</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/instruments">Instruments</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/relationships">Relationships</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/venues">Venues</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/market-data">Market Data</a>
      <a class="btn btn-outline-secondary" href="/capital-markets/tokenized-equities">Tokenized Equity</a>
    </nav>
  </header>

  {% if query.saved|default(false) %}
    <div class="alert alert-success">Changes saved and written to COS Audit.</div>
  {% endif %}
  {% if query.error|default('') %}
    <div class="alert alert-danger">{{ query.error }}</div>
  {% endif %}

  {% if cmView == 'failure' %}
    <section class="cos-panel">
      <strong>{{ failureCode|default(500) }}</strong>
      <h2>{{ failureTitle|default('Capital Markets unavailable') }}</h2>
      <p>{{ failureMessage|default('The Foundation workspace could not be loaded.') }}</p>
      <a href="/capital-markets" class="btn btn-primary">Back to Capital Markets</a>
    </section>

  {% elseif cmView == 'overview' %}
    <section class="cos-kpi-strip" aria-label="Capital Markets foundation state">
      <twig:CosMetric label="Instruments" value="{{ w.instrument_count|default(0) }}" hint="canonical identities" />
      <twig:CosMetric label="Relationships" value="{{ w.relationship_count|default(0) }}" hint="directed economic links" />
      <twig:CosMetric label="Venues" value="{{ w.venue_count|default(0) }}" hint="registered venues" />
      <twig:CosMetric label="Stage" value="Market Intelligence" hint="read-only market visibility" />
    </section>

    <section class="cos-panel">
      <h2>System status</h2>
      <p><strong>Foundation + Market Intelligence ready.</strong> The domain understands instruments, relationships, venues and trusted market-state semantics.</p>
      <p>External provider sources remain tenant-configured and explicitly gated. Paper Trading, Live Trading and Auto Execution remain disabled.</p>
    </section>

    <section class="cos-panel">
      <h2>Recently registered instruments</h2>
      {% if w.recent_instruments|default([]) is empty %}
        <p>No instruments yet. Create the first canonical instrument in the Instrument Registry.</p>
      {% else %}
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Symbol</th><th>Name</th><th>Family</th><th>Status</th></tr></thead>
            <tbody>
            {% for item in w.recent_instruments %}
              <tr>
                <td><a href="/capital-markets/instruments/{{ item.id|url_encode }}">{{ item.symbol }}</a></td>
                <td>{{ item.name }}</td>
                <td>{{ item.family }}</td>
                <td>{{ item.status }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>

  {% elseif cmView == 'instruments' %}
    <section class="cos-panel">
      <form method="get" action="/capital-markets/instruments" class="row g-2">
        <div class="col-md-5"><input class="form-control" name="q" value="{{ query.q|default('') }}" placeholder="Search symbol or name"></div>
        <div class="col-md-3">
          <select class="form-select" name="family">
            <option value="">All families</option>
            {% for family in ['equity','tokenized_security','crypto_asset','stablecoin','spot_market','future','perpetual','option','fixed_income','tokenized_fixed_income','fund','rwa','fx','commodity','index'] %}
              <option value="{{ family }}" {% if query.family|default('') == family %}selected{% endif %}>{{ family|upper }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <select class="form-select" name="status">
            <option value="">All statuses</option>
            {% for status in ['DRAFT','ACTIVE','SUSPENDED','DELISTED','UNKNOWN'] %}
              <option value="{{ status }}" {% if query.status|default('') == status %}selected{% endif %}>{{ status }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Filter</button></div>
      </form>
    </section>

    {% if canManageInstruments %}
      <section class="cos-panel">
        <h2>Create instrument</h2>
        <form method="post" action="/capital-markets/instruments" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-2"><input class="form-control" name="symbol" placeholder="AAPL" required></div>
          <div class="col-md-2"><input class="form-control" name="canonical_symbol" placeholder="AAPL"></div>
          <div class="col-md-4"><input class="form-control" name="name" placeholder="Apple Inc." required></div>
          <div class="col-md-2">
            <select class="form-select" name="family" required>
              {% for family in ['equity','tokenized_security','crypto_asset','stablecoin','spot_market','future','perpetual','option','fixed_income','tokenized_fixed_income','fund','rwa','fx','commodity','index'] %}
                <option value="{{ family }}">{{ family|upper }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="status">
              {% for status in ['DRAFT','ACTIVE','SUSPENDED','UNKNOWN'] %}<option value="{{ status }}">{{ status }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" name="currency" placeholder="USD"></div>
          <div class="col-md-2"><input class="form-control" name="quote_asset" placeholder="USD / USDT"></div>
          <div class="col-md-3"><input class="form-control" name="issuer_reference" placeholder="Issuer reference"></div>
          <div class="col-md-2"><input class="form-control" name="jurisdiction" placeholder="Jurisdiction"></div>
          <div class="col-md-3"><input class="form-control" name="primary_venue_reference" placeholder="Primary venue reference"></div>
          <div class="col-md-12"><button class="btn btn-primary">Create instrument</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-panel">
      <h2>Instrument Registry</h2>
      {% if w.instruments|default([]) is empty %}
        <p>No instruments match the current filters.</p>
      {% else %}
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Symbol</th><th>Name</th><th>Family</th><th>Status</th><th>Identifiers</th><th>Updated</th></tr></thead>
            <tbody>
            {% for item in w.instruments %}
              <tr>
                <td><a href="/capital-markets/instruments/{{ item.id|url_encode }}"><strong>{{ item.symbol }}</strong></a></td>
                <td>{{ item.name }}</td>
                <td>{{ item.family }}</td>
                <td>{{ item.status }}</td>
                <td>{{ item.identifiers|length }}</td>
                <td>{{ item.updated_at }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>

  {% elseif cmView == 'instrument' %}
    {% set i = w.instrument %}
    <section class="cos-panel">
      <div class="d-flex justify-content-between align-items-start gap-3">
        <div>
          <small>{{ i.family|upper }}</small>
          <h2>{{ i.symbol }} · {{ i.name }}</h2>
          <p>Canonical symbol: <strong>{{ i.canonical_symbol }}</strong> · Status: <strong>{{ i.status }}</strong></p>
        </div>
        <a class="btn btn-outline-secondary" href="/capital-markets/instruments">Back to registry</a>
      </div>
    </section>

    <section class="cos-panel">
      <h2>Identity</h2>
      <dl class="row">
        <dt class="col-sm-3">Internal ID</dt><dd class="col-sm-9">{{ i.id }}</dd>
        <dt class="col-sm-3">Currency</dt><dd class="col-sm-9">{{ i.currency|default('—') }}</dd>
        <dt class="col-sm-3">Quote asset</dt><dd class="col-sm-9">{{ i.quote_asset|default('—') }}</dd>
        <dt class="col-sm-3">Issuer</dt><dd class="col-sm-9">{{ i.issuer_reference|default('—') }}</dd>
        <dt class="col-sm-3">Jurisdiction</dt><dd class="col-sm-9">{{ i.jurisdiction|default('—') }}</dd>
        <dt class="col-sm-3">Primary venue</dt><dd class="col-sm-9">{{ i.primary_venue_reference|default('—') }}</dd>
      </dl>
      <h3>Identifiers</h3>
      {% if i.identifiers is empty %}<p>No external identifiers.</p>{% endif %}
      <ul>
        {% for identifier in i.identifiers %}
          <li><strong>{{ identifier.type }}</strong>: {{ identifier.value }}{% if identifier.source %} · {{ identifier.source }}{% endif %}</li>
        {% endfor %}
      </ul>
    </section>

    {% if canManageInstruments %}
      <section class="cos-panel">
        <h2>Edit instrument</h2>
        <form method="post" action="/capital-markets/instruments/{{ i.id|url_encode }}" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-2"><input class="form-control" name="symbol" value="{{ i.symbol }}" required></div>
          <div class="col-md-2"><input class="form-control" name="canonical_symbol" value="{{ i.canonical_symbol }}" required></div>
          <div class="col-md-4"><input class="form-control" name="name" value="{{ i.name }}" required></div>
          <div class="col-md-2">
            <select class="form-select" name="family">
              {% for family in ['equity','tokenized_security','crypto_asset','stablecoin','spot_market','future','perpetual','option','fixed_income','tokenized_fixed_income','fund','rwa','fx','commodity','index'] %}
                <option value="{{ family }}" {% if i.family == family %}selected{% endif %}>{{ family|upper }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="status">
              {% for status in ['DRAFT','ACTIVE','SUSPENDED','DELISTED','UNKNOWN'] %}
                <option value="{{ status }}" {% if i.status == status %}selected{% endif %}>{{ status }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" name="currency" value="{{ i.currency|default('') }}" placeholder="USD"></div>
          <div class="col-md-2"><input class="form-control" name="quote_asset" value="{{ i.quote_asset|default('') }}" placeholder="USDT"></div>
          <div class="col-md-3"><input class="form-control" name="issuer_reference" value="{{ i.issuer_reference|default('') }}" placeholder="Issuer"></div>
          <div class="col-md-2"><input class="form-control" name="jurisdiction" value="{{ i.jurisdiction|default('') }}" placeholder="Jurisdiction"></div>
          <div class="col-md-3"><input class="form-control" name="primary_venue_reference" value="{{ i.primary_venue_reference|default('') }}" placeholder="Primary venue"></div>
          <div class="col-md-12"><button class="btn btn-primary">Save instrument</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-panel">
      <h2>Related financial exposures</h2>
      {% if i.relationships is empty %}
        <p>No economic relationships registered.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Source</th><th>Relationship</th><th>Target</th><th>Strength</th><th>Status</th></tr></thead>
          <tbody>
          {% for rel in i.relationships %}
            <tr>
              <td>{{ rel.source_instrument.symbol|default(rel.source_instrument.id) }}</td>
              <td><strong>{{ rel.type }}</strong></td>
              <td>{{ rel.target_instrument.symbol|default(rel.target_instrument.id) }}</td>
              <td>{{ rel.strength }}</td>
              <td>{{ rel.status }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Venue availability</h2>
      {% if i.venues is empty %}
        <p>This instrument is not registered on a venue yet.</p>
      {% else %}
        <ul>
          {% for mapping in i.venues %}
            <li><strong>{{ mapping.venue.name|default(mapping.venue.id) }}</strong> · {{ mapping.venue_symbol }} · {{ mapping.status }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Audit history</h2>
      {% if w.audit|default([]) is empty %}
        <p>No Capital Markets audit entries for this instrument yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Time</th><th>Actor</th><th>Correlation</th><th>Category</th></tr></thead>
          <tbody>
          {% for row in w.audit %}
            <tr><td>{{ row.created_at|default('—') }}</td><td>{{ row.actor_id|default('—') }}</td><td>{{ row.correlation_id|default('—') }}</td><td>{{ row.category|default('platform_activity') }}</td></tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

  {% elseif cmView == 'tokenized_equity' %}
    {% set r = w.research|default({}) %}
    {% set portfolio = w.paper_portfolio|default(null) %}
    <section class="cos-kpi-strip" aria-label="Tokenized Equity research state">
      <twig:CosMetric label="Candidates" value="{{ r.candidate_count|default(0) }}" hint="H1 + H2 observations" />
      <twig:CosMetric label="Opportunities" value="{{ r.opportunity_count|default(0) }}" hint="validated research records" />
      <twig:CosMetric label="Positive net" value="{{ r.positive_net_opportunity_count|default(0) }}" hint="after explicit costs" />
      <twig:CosMetric label="Paper P&L" value="{{ r.paper_realized_pnl|default('0') }}" hint="realized simulated result" />
    </section>

    <section class="cos-panel">
      <div class="d-flex justify-content-between gap-3 flex-wrap">
        <div>
          <small>VERTICAL SLICE #1</small>
          <h2>Tokenized Equity</h2>
          <p><strong>H1</strong> Equity ↔ Tokenized Equity dislocation · <strong>H2</strong> cross-venue tokenized-equity arbitrage.</p>
          <p>Gross spread is only a candidate. Opportunities survive data quality, economic relationship, fees, liquidity and deterministic risk gates before paper execution.</p>
        </div>
        <div>
          <span class="badge text-bg-warning">PAPER</span>
          <span class="badge text-bg-danger">LIVE OFF</span>
        </div>
      </div>
    </section>

    {% set researchPack = w.hypothesis_research|default({}) %}
    {% set hypotheses = researchPack.hypotheses|default({}) %}
    <section class="cos-panel">
      <h2>Hypothesis evidence</h2>
      <p>Verdicts are deterministic and sample-gated. A positive spread is not promoted to truth merely because a chart looked persuasive at 02:00.</p>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr><th>Hypothesis</th><th>Verdict</th><th>Observable scans</th><th>Unobservable</th><th>Detected</th><th>Executable</th><th>Attempts</th><th>Realized</th><th>Invalidated</th><th>Completion</th><th>Avg expected P&amp;L</th><th>Avg realized / attempt</th></tr>
          </thead>
          <tbody>
          {% for code in ['H1','H2'] %}
            {% set h = attribute(hypotheses, code)|default({}) %}
            {% set sample = h.sample|default({}) %}
            {% set economics = h.economics|default({}) %}
            <tr>
              <td><strong>{{ code }}</strong></td>
              <td><strong>{{ h.verdict|default('INSUFFICIENT_DATA') }}</strong></td>
              <td>{{ sample.scan_count|default(0) }}</td>
              <td>{{ sample.unobservable_scan_count|default(0) }}</td>
              <td>{{ sample.detected_count|default(0) }}</td>
              <td>{{ sample.executable_count|default(0) }}</td>
              <td>{{ sample.execution_attempt_count|default(0) }}</td>
              <td>{{ sample.realized_count|default(0) }}</td>
              <td>{{ sample.invalidated_execution_count|default(0) }}</td>
              <td>{{ economics.completion_rate|default('0') }}</td>
              <td>{{ economics.average_expected_pnl|default('0') }}</td>
              <td>{{ economics.average_realized_pnl_per_attempt|default('0') }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p><small>Edge Funnel: observable scan → detected candidate → executable opportunity → execution attempt → realized or invalidated result. Unobservable scans are tracked separately and never count as proof of no edge. H1 remains execution-closed until a real hedge venue exists.</small></p>
    </section>

    <section class="cos-panel">
      <h2>Paper portfolio</h2>
      {% if portfolio %}
        <div class="row g-3">
          <div class="col-md-3"><strong>Currency</strong><br>{{ portfolio.currency }}</div>
          <div class="col-md-3"><strong>Available</strong><br>{{ portfolio.available_capital }}</div>
          <div class="col-md-3"><strong>Reserved</strong><br>{{ portfolio.reserved_capital }}</div>
          <div class="col-md-3"><strong>Realized P&L</strong><br>{{ portfolio.realized_pnl }}</div>
        </div>
      {% else %}
        <p>No paper portfolio initialized. Use the Tokenized Equity API to initialize research capital before paper execution.</p>
      {% endif %}
      {% if portfolio and portfolio.venue_balances|default([]) is not empty %}
        <hr>
        <h3>Pre-funded venue balances</h3>
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Venue</th><th>Asset / instrument</th><th>Available</th><th>Reserved</th></tr></thead>
          <tbody>
          {% for balance in portfolio.venue_balances %}
            <tr>
              <td>{{ balance.venue_id }}</td>
              <td>{{ balance.asset_key }}</td>
              <td>{{ balance.available_amount }}</td>
              <td>{{ balance.reserved_amount }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Opportunity board</h2>
      {% if w.opportunities|default([]) is empty %}
        <p>No H1/H2 opportunities recorded yet. Configure trusted market sources and run a scan.</p>
      {% else %}
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Hypothesis</th><th>Relationship / legs</th><th>Gross edge</th><th>Net edge</th>
                <th>Expected P&L</th><th>Capital</th><th>Risk</th><th>TTL</th><th>Status</th>
              </tr>
            </thead>
            <tbody>
            {% for item in w.opportunities %}
              {% set candidate = item.candidate|default({}) %}
              <tr>
                <td><strong>{{ item.hypothesis|default('—') }}</strong></td>
                <td>
                  {{ candidate.buy_instrument_id|default('—') }} @ {{ candidate.buy_venue_id|default('—') }}
                  ↔
                  {{ candidate.sell_instrument_id|default('—') }} @ {{ candidate.sell_venue_id|default('—') }}
                </td>
                <td>{{ candidate.gross_edge_bps|default('—') }} bps</td>
                <td>{{ item.expected_net_edge_bps|default('—') }} bps</td>
                <td>{{ item.expected_pnl|default('—') }}</td>
                <td>{{ item.required_capital|default('—') }}</td>
                <td>{{ item.risk_score|default('—') }}</td>
                <td>{{ candidate.expires_at|default('—') }}</td>
                <td><strong>{{ item.status|default('—') }}</strong></td>
              </tr>
              {% if item.rejection_reasons|default([]) is not empty %}
                <tr><td colspan="9"><small>Rejected / blocked: {{ item.rejection_reasons|join(', ') }}</small></td></tr>
              {% endif %}
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>

    {% set perf = w.performance|default({}) %}
    {% set recon = w.reconciliation|default({}) %}
    <section class="cos-panel">
      <h2>Execution performance</h2>
      <div class="row g-3">
        <div class="col-md-2"><strong>Attempts</strong><br>{{ perf.execution_attempts|default(0) }}</div>
        <div class="col-md-2"><strong>Completed</strong><br>{{ perf.completed|default(0) }}</div>
        <div class="col-md-2"><strong>Compensated</strong><br>{{ perf.compensated|default(0) }}</div>
        <div class="col-md-2"><strong>Completion</strong><br>{{ perf.completion_rate|default('0') }}</div>
        <div class="col-md-2"><strong>Realized P&L</strong><br>{{ perf.realized_pnl|default('0') }}</div>
        <div class="col-md-2"><strong>Avg edge capture</strong><br>{{ perf.average_edge_capture_ratio|default('0') }}</div>
      </div>
    </section>

    <section class="cos-panel">
      <h2>Recent executions</h2>
      {% if w.executions|default([]) is empty %}
        <p>No paper executions yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Execution</th><th>Status</th><th>Checkpoint</th><th>Requested</th><th>Buy fill</th><th>Sell fill</th><th>Compensated</th><th>Realized P&L</th><th>Edge capture</th></tr></thead>
          <tbody>
          {% for e in w.executions|slice(0,25) %}
            <tr>
              <td><code>{{ e.execution_id|default(e.id|default('—')) }}</code></td>
              <td><strong>{{ e.status|default('—') }}</strong></td>
              <td>{{ e.checkpoint|default('—') }}</td>
              <td>{{ e.requested_quantity|default(e.quantity|default('—')) }}</td>
              <td>{{ e.buy_filled_quantity|default(e.buy_fill.quantity|default('—')) }}</td>
              <td>{{ e.sell_filled_quantity|default(e.sell_fill.quantity|default('—')) }}</td>
              <td>{{ e.compensated|default(false) ? 'yes' : 'no' }}</td>
              <td>{{ e.realized_pnl|default('0') }}</td>
              <td>{{ e.edge_capture_ratio|default('0') }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Positions / exposure</h2>
      {% if w.positions|default([]) is empty %}
        <p>No persisted strategy positions yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Instrument</th><th>Venue</th><th>Status</th><th>Quantity</th><th>Avg entry</th><th>Mark</th><th>Market value</th><th>Realized</th><th>Unrealized</th></tr></thead>
          <tbody>
          {% for p in w.positions %}
            <tr>
              <td>{{ p.instrument_id|default('—') }}</td>
              <td>{{ p.venue_id|default('—') }}</td>
              <td>{{ p.status|default('—') }}</td>
              <td>{{ p.quantity|default('0') }}</td>
              <td>{{ p.average_entry_price|default('0') }}</td>
              <td>{{ p.mark_price|default('0') }}</td>
              <td>{{ p.market_value|default('0') }}</td>
              <td>{{ p.realized_pnl|default('0') }}</td>
              <td>{{ p.unrealized_pnl|default('0') }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Reconciliation / data quality</h2>
      {% if recon.ok|default(false) %}
        <div class="alert alert-success">Paper portfolio reconciliation is clean.</div>
      {% else %}
        <div class="alert alert-warning">
          Reconciliation requires attention.
          {% if recon.issues|default([]) is not empty %}{{ recon.issues|join(', ') }}{% endif %}
        </div>
      {% endif %}
      <div class="row g-3">
        <div class="col-md-3"><strong>Venue balances</strong><br>{{ recon.venue_balance_count|default(0) }}</div>
        <div class="col-md-3"><strong>Positions</strong><br>{{ recon.position_count|default(0) }}</div>
        <div class="col-md-3"><strong>Unsettled executions</strong><br>{{ recon.unsettled_execution_count|default(0) }}</div>
        <div class="col-md-3"><strong>Negative balances</strong><br>{{ recon.negative_balance_count|default(0) }}</div>
      </div>
    </section>

    <section class="cos-panel">
      <h2>Execution policy</h2>
      <p>H2 can reach guarded Paper Execution only after a current-state revalidation and atomic capital reservation. H1 remains research-only until a real executable hedge venue is configured.</p>
      <p>Different quote currencies are not compared directly. AAPL/USD and AAPLx/USDT are <strong>NOT_COMPARABLE</strong> until a trusted conversion layer is available.</p>
    </section>

  {% elseif cmView == 'market_data' %}
    <section class="cos-kpi-strip" aria-label="Capital Markets market data state">
      <twig:CosMetric label="Sources" value="{{ w.sources|default([])|length }}" hint="configured providers" />
      <twig:CosMetric label="Trading states" value="{{ w.states|default([])|length }}" hint="venue + instrument" />
      <twig:CosMetric label="Reference states" value="{{ w.reference_states|default([])|length }}" hint="source + instrument" />
      <twig:CosMetric label="Execution" value="Disabled" hint="read-only market intelligence" />
    </section>

    {% if canManageMarketDataSources %}
      <section class="cos-panel">
        <h2>Create market-data source</h2>
        <p>Sources are created <strong>disabled</strong>. Enable them only after mappings, credentials and provider flags are ready.</p>
        <form method="post" action="/capital-markets/market-data/sources" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-3"><input class="form-control" name="source_id" placeholder="source:bybit-xstocks" required></div>
          <div class="col-md-3">
            <select class="form-select" name="adapter_type" required>
              <option value="">Adapter</option>
              {% for adapter in w.adapter_types|default([]) %}
                <option value="{{ adapter }}">{{ adapter }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-3">
            <select class="form-select" name="venue_id">
              <option value="">No venue / reference source</option>
              {% for venue in w.venues|default([]) %}
                <option value="{{ venue.id }}">{{ venue.code }} · {{ venue.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-3"><input class="form-control" name="credentials_reference" placeholder="env://CM_MASSIVE_API (optional)"></div>

          <div class="col-md-4">
            <label class="me-3"><input type="checkbox" name="roles[]" value="TRADING_SOURCE"> Trading source</label>
            <label><input type="checkbox" name="roles[]" value="REFERENCE_SOURCE"> Reference source</label>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="data_mode">
              <option value="">Data mode</option>
              <option value="LIVE">LIVE</option>
              <option value="DELAYED">DELAYED</option>
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" type="number" min="0" max="10000" name="priority" value="100" placeholder="Priority"></div>
          <div class="col-md-2"><input class="form-control" type="number" min="1" name="request_budget" value="60" placeholder="Requests"></div>
          <div class="col-md-2"><input class="form-control" type="number" min="1" name="window_seconds" value="60" placeholder="Window sec"></div>
          <div class="col-md-8"><input class="form-control" name="license_profile" value="UNSPECIFIED" placeholder="License profile"></div>
          <div class="col-md-4"><button class="btn btn-primary w-100">Create disabled source</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-page__stack">
      <h2>Sources and health</h2>
      {% if w.sources|default([]) is empty %}
        <section class="cos-panel"><p>No market-data sources configured.</p></section>
      {% endif %}
      {% for source in w.sources|default([]) %}
        <section class="cos-panel">
          <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
              <small>{{ source.adapter_type }}</small>
              <h3>{{ source.id }}</h3>
              <p>
                {% if source.enabled %}
                  <span class="badge text-bg-success">ENABLED</span>
                {% else %}
                  <span class="badge text-bg-secondary">DISABLED</span>
                {% endif %}
                {% for role in source.roles %}<span class="badge text-bg-light me-1">{{ role }}</span>{% endfor %}
              </p>
              <p>Venue: <strong>{{ source.venue_id|default('reference / none') }}</strong> · Priority: {{ source.priority }} · License: {{ source.license_profile }}</p>
              <p>Capabilities: {% if source.capabilities is empty %}—{% else %}{{ source.capabilities|join(', ') }}{% endif %}</p>
              {% if source.credentials_configured %}<p>Credentials: <strong>configured</strong> via Platform Credential Vault.</p>{% endif %}
            </div>
            {% if canManageMarketDataSources or canManageMarketData %}
              <div class="d-flex gap-2 flex-wrap">
                {% if canManageMarketDataSources %}
                  {% if source.enabled %}
                    <form method="post" action="/capital-markets/market-data/sources/{{ source.id|url_encode }}/disable">
                      <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                      <button class="btn btn-outline-danger">Disable</button>
                    </form>
                  {% else %}
                    <form method="post" action="/capital-markets/market-data/sources/{{ source.id|url_encode }}/enable">
                      <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                      <button class="btn btn-outline-success">Enable</button>
                    </form>
                  {% endif %}
                {% endif %}
                {% if canManageMarketData %}
                  <form method="post" action="/capital-markets/market-data/sources/{{ source.id|url_encode }}/poll">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="hidden" name="limit" value="100">
                    <button class="btn btn-primary" {% if not source.enabled %}disabled{% endif %}>Poll now</button>
                  </form>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <hr>
          <h4>Health</h4>
          {% if source.health %}
            <p>
              State: <strong>{{ source.health.connection_state }}</strong> ·
              Last event: {{ source.health.last_event_at|default('—') }} ·
              Failures: {{ source.health.failure_count }} ·
              Errors: {{ source.health.error_count }} ·
              Queue lag: {{ source.health.queue_lag }}
            </p>
            {% if source.health.last_error %}<div class="alert alert-warning">{{ source.health.last_error }}</div>{% endif %}
          {% else %}
            <p>No runtime health yet. The source has not produced a successful or failed poll.</p>
          {% endif %}

          <h4>Subscriptions</h4>
          {% if source.subscriptions is empty %}
            <p>No subscriptions configured.</p>
          {% else %}
            <div class="table-responsive"><table class="table">
              <thead><tr><th>Instrument</th><th>Data type</th><th>Status</th><th>Last event</th></tr></thead>
              <tbody>
              {% for subscription in source.subscriptions %}
                <tr>
                  <td>{{ subscription.instrument_id }}</td>
                  <td>{{ subscription.data_type }}</td>
                  <td>{{ subscription.status }}</td>
                  <td>{{ subscription.last_event_at|default('—') }}</td>
                </tr>
              {% endfor %}
              </tbody>
            </table></div>
          {% endif %}

          {% if canManageMarketData %}
            <form method="post" action="/capital-markets/market-data/sources/{{ source.id|url_encode }}/subscriptions" class="row g-2">
              <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
              <div class="col-md-7">
                <select class="form-select" name="instrument_id" required>
                  <option value="">Instrument</option>
                  {% for instrument in w.instruments|default([]) %}
                    <option value="{{ instrument.id }}">{{ instrument.symbol }} · {{ instrument.name }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="col-md-3">
                <select class="form-select" name="data_type" required>
                  <option value="BBO">BBO</option>
                  <option value="VOLUME">VOLUME</option>
                </select>
              </div>
              <div class="col-md-2"><button class="btn btn-outline-primary w-100">Subscribe</button></div>
            </form>
          {% endif %}
        </section>
      {% endfor %}
    </section>

    <section class="cos-panel">
      <h2>Current trading MarketState</h2>
      {% if w.states|default([]) is empty %}
        <p>No trading state yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Venue</th><th>Instrument</th><th>Mid</th><th>Spread bps</th><th>Trust</th><th>Updated</th></tr></thead>
          <tbody>
          {% for state in w.states %}
            <tr>
              <td>{{ state.venue_id }}</td>
              <td>{{ state.instrument_id }}</td>
              <td>{{ state.mid_price|default('—') }}</td>
              <td>{{ state.spread_bps|default('—') }}</td>
              <td><strong>{{ state.trust_status }}</strong></td>
              <td>{{ state.updated_at }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Reference MarketState</h2>
      {% if w.reference_states|default([]) is empty %}
        <p>No reference state yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Source</th><th>Instrument</th><th>Session</th><th>Reference</th><th>Trust</th><th>Updated</th></tr></thead>
          <tbody>
          {% for state in w.reference_states %}
            <tr>
              <td>{{ state.source_id }}</td>
              <td>{{ state.instrument_id }}</td>
              <td>{{ state.session }}</td>
              <td>
                {% if state.current_quote %}
                  {{ state.current_quote.bid_price.value }} / {{ state.current_quote.ask_price.value }}
                {% else %}—{% endif %}
              </td>
              <td><strong>{{ state.quality.status }}</strong></td>
              <td>{{ state.updated_at }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

  {% elseif cmView == 'relationships' %}
    {% if canManageRelationships %}
      <section class="cos-panel">
        <h2>Create relationship</h2>
        <form method="post" action="/capital-markets/relationships" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-3">
            <select class="form-select" name="source_instrument" required>
              <option value="">Source instrument</option>
              {% for item in w.instruments|default([]) %}<option value="{{ item.id }}">{{ item.symbol }} · {{ item.name }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-3">
            <select class="form-select" name="type" required>
              {% for type in ['UNDERLYING_OF','REPRESENTS','REFERENCES','DERIVES_VALUE_FROM','SYNTHETIC_EXPOSURE_TO','HEDGES','REDEEMABLE_INTO','COLLATERALIZED_BY','SETTLED_IN','QUOTED_IN','CORRELATED_WITH'] %}
                <option value="{{ type }}">{{ type }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-3">
            <select class="form-select" name="target_instrument" required>
              <option value="">Target instrument</option>
              {% for item in w.instruments|default([]) %}<option value="{{ item.id }}">{{ item.symbol }} · {{ item.name }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="strength">
              {% for strength in ['EXACT','DIRECT','DERIVED','STATISTICAL'] %}<option value="{{ strength }}">{{ strength }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-1"><button class="btn btn-primary w-100">Add</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-panel">
      <h2>Economic Relationship Graph</h2>
      {% if w.relationships|default([]) is empty %}
        <p>No directed relationships have been registered.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Source</th><th>Type</th><th>Target</th><th>Strength</th><th>Status</th></tr></thead>
          <tbody>
          {% for rel in w.relationships %}
            <tr>
              <td><a href="/capital-markets/instruments/{{ rel.source_instrument.id|url_encode }}">{{ rel.source_instrument.symbol|default(rel.source_instrument.id) }}</a></td>
              <td><strong>{{ rel.type }}</strong></td>
              <td><a href="/capital-markets/instruments/{{ rel.target_instrument.id|url_encode }}">{{ rel.target_instrument.symbol|default(rel.target_instrument.id) }}</a></td>
              <td>{{ rel.strength }}</td>
              <td>{{ rel.status }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

  {% elseif cmView == 'venues' %}
    {% if canManageVenues %}
      <section class="cos-panel">
        <h2>Create venue</h2>
        <form method="post" action="/capital-markets/venues" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-3"><input class="form-control" name="name" placeholder="Tokenized Venue A" required></div>
          <div class="col-md-2"><input class="form-control" name="code" placeholder="VENUE_A" required></div>
          <div class="col-md-3">
            <select class="form-select" name="type">
              {% for type in ['broker','stock_exchange','cex','dex','amm','perpetual_dex','tokenized_securities_venue','rwa_platform','data_provider'] %}
                <option value="{{ type }}">{{ type|upper }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" name="jurisdiction" placeholder="Jurisdiction"></div>
          <div class="col-md-2"><input class="form-control" name="timezone" value="UTC" placeholder="Timezone"></div>
          <div class="col-md-12">
            {% for cap in ['MARKET_DATA','ORDER_BOOK','TRADING','HISTORICAL_DATA','STREAMING','FUNDING_DATA','MARGIN','DEPOSIT','WITHDRAWAL','SETTLEMENT'] %}
              <label class="me-3"><input type="checkbox" name="capabilities[]" value="{{ cap }}"> {{ cap }}</label>
            {% endfor %}
          </div>
          <div class="col-md-12"><button class="btn btn-primary">Create venue</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-page__stack">
      {% if w.venues|default([]) is empty %}
        <section class="cos-panel"><p>No venues registered.</p></section>
      {% endif %}
      {% for venue in w.venues|default([]) %}
        <section class="cos-panel">
          <div class="d-flex justify-content-between gap-3">
            <div>
              <small>{{ venue.type|upper }}</small>
              <h2>{{ venue.name }} · {{ venue.code }}</h2>
              <p>{{ venue.status }} · {{ venue.jurisdiction|default('No jurisdiction') }} · {{ venue.timezone }}</p>
              <p>
                {% if venue.capabilities is empty %}<em>No capabilities declared.</em>{% endif %}
                {% for cap in venue.capabilities %}<span class="badge text-bg-secondary me-1">{{ cap }}</span>{% endfor %}
              </p>
              <p>Supported instruments: <strong>{{ venue.supported_instrument_count }}</strong></p>
            </div>
          </div>

          {% if canManageVenues %}
            <details>
              <summary>Register instrument on this venue</summary>
              <form method="post" action="/capital-markets/venues/{{ venue.id|url_encode }}/instruments" class="row g-2 mt-2">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <div class="col-md-4">
                  <select class="form-select" name="instrument_id" required>
                    <option value="">Instrument</option>
                    {% for item in w.instruments|default([]) %}<option value="{{ item.id }}">{{ item.symbol }} · {{ item.name }}</option>{% endfor %}
                  </select>
                </div>
                <div class="col-md-3"><input class="form-control" name="venue_symbol" placeholder="AAPLx" required></div>
                <div class="col-md-2"><input class="form-control" type="number" min="0" max="30" name="price_precision" value="2"></div>
                <div class="col-md-2"><input class="form-control" type="number" min="0" max="30" name="quantity_precision" value="8"></div>
                <div class="col-md-1"><button class="btn btn-primary w-100">Add</button></div>
              </form>
            </details>
          {% endif %}
        </section>
      {% endfor %}
    </section>
  {% endif %}
</div>
{% endblock %}
