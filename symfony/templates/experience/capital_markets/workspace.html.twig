      <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div>
          <h2>Basis history</h2>
          <p>Mid basis is diagnostic. Executable premium uses spot ask versus perpetual bid; reverse basis requires actual spot-short and borrow capability.</p>
        </div>
        <form method="get" action="/capital-markets/crypto-spot-perpetual" class="d-flex gap-2">
          <input class="form-control" name="market_pair_id" value="{{ w.market_pair_id|default('') }}" placeholder="market_pair_id">
          <button class="btn btn-outline-primary" type="submit">Load basis</button>
        </form>
      </div>
      {% if basisRows is not empty %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Observed</th><th>Spot</th><th>Perpetual</th><th>Mid basis bps</th><th>Long spot / short perp</th><th>Reverse</th><th>Quality</th></tr></thead>
          <tbody>
          {% for row in basisRows|slice(0,100) %}
            <tr>
              <td>{{ row.observed_at|default(row.timestamp|default('—')) }}</td>
              <td>{{ row.spot_market|default('—') }}</td>
              <td>{{ row.perpetual_market|default('—') }}</td>
              <td>{{ row.mid_basis_bps|default('—') }}</td>
              <td>{{ row.long_spot_short_perp_basis|default(row.long_spot_short_perp_executable_basis|default('—')) }}</td>
              <td>{{ row.short_spot_long_perp_basis|default(row.short_spot_long_perp_executable_basis|default('—')) }}</td>
              <td>{{ row.quality|default('—') }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Funding observations</h2>
      {% if funding is empty %}
        <p>No funding observations persisted yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Venue</th><th>Instrument</th><th>Rate</th><th>Status</th><th>Interval</th><th>Next settlement</th><th>Quality</th></tr></thead>
          <tbody>
          {% for row in funding|slice(0,100) %}
            <tr>
              <td>{{ row.venue_id|default('—') }}</td>
              <td>{{ row.instrument_id|default('—') }}</td>
              <td>{{ row.rate|default('—') }}</td>
              <td>{{ row.status|default('—') }}</td>
              <td>{{ row.funding_interval_seconds|default('—') }} s</td>
              <td>{{ row.next_settlement_at|default('—') }}</td>
              <td>{{ row.quality|default('—') }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Paper execution / hedge state</h2>
      {% if executions is empty %}
        <p>No VS2 paper executions yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Execution</th><th>Hypothesis</th><th>Status</th><th>Strategy</th><th>Hedge group</th><th>Realized P&amp;L</th></tr></thead>
          <tbody>
          {% for row in executions|slice(0,100) %}
            <tr>
              <td><code>{{ row.execution_id|default(row.id|default('—')) }}</code></td>
              <td>{{ row.hypothesis|default('—') }}</td>
              <td><strong>{{ row.status|default('—') }}</strong></td>
              <td>{{ row.strategy_version|default('—') }}</td>
              <td><code>{{ row.hedge_group_id|default('—') }}</code></td>
              <td>{{ row.realized_pnl|default('0') }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Funding settlements</h2>
      {% if settlements is empty %}
        <p>No realized paper funding cashflows yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Settlement</th><th>Position</th><th>Venue</th><th>Rate</th><th>Notional</th><th>Side</th><th>Cashflow</th><th>Currency</th></tr></thead>
          <tbody>
          {% for row in settlements|slice(0,100) %}
            <tr>
              <td>{{ row.settlement_at|default('—') }}</td>
              <td><code>{{ row.position_reference|default('—') }}</code></td>
              <td>{{ row.venue_id|default('—') }}</td>
              <td>{{ row.rate|default('—') }}</td>
              <td>{{ row.position_notional|default('—') }}</td>
              <td>{{ row.side|default('—') }}</td>
              <td><strong>{{ row.gross_cashflow|default('—') }}</strong></td>
              <td>{{ row.currency|default('—') }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

  {% elseif cmView == 'market_data' %}
    <section class="cos-kpi-strip" aria-label="Capital Markets market data state">
      <twig:CosMetric label="Sources" value="{{ w.sources|default([])|length }}" hint="configured providers" />
      <twig:CosMetric label="Trading states" value="{{ w.states|default([])|length }}" hint="venue + instrument" />
      <twig:CosMetric label="Reference states" value="{{ w.reference_states|default([])|length }}" hint="source + instrument" />
      <twig:CosMetric label="Execution" value="Disabled" hint="read-only market intelligence" />
    </section>

    {% if canManageMarketDataSources %}
      <section class="cos-panel">
        <h2>Create market-data source</h2>
        <p>Sources are created <strong>disabled</strong>. Enable them only after mappings, credentials and provider flags are ready.</p>
        <form method="post" action="/capital-markets/market-data/sources" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-3"><input class="form-control" name="source_id" placeholder="source:bybit-xstocks" required></div>
          <div class="col-md-3">
            <select class="form-select" name="adapter_type" required>
              <option value="">Adapter</option>
              {% for adapter in w.adapter_types|default([]) %}
                <option value="{{ adapter }}">{{ adapter }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-3">
            <select class="form-select" name="venue_id">
              <option value="">No venue / reference source</option>
              {% for venue in w.venues|default([]) %}
                <option value="{{ venue.id }}">{{ venue.code }} · {{ venue.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-3"><input class="form-control" name="credentials_reference" placeholder="env://CM_MASSIVE_API (optional)"></div>

          <div class="col-md-4">
            <label class="me-3"><input type="checkbox" name="roles[]" value="TRADING_SOURCE"> Trading source</label>
            <label><input type="checkbox" name="roles[]" value="REFERENCE_SOURCE"> Reference source</label>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="data_mode">
              <option value="">Data mode</option>
              <option value="LIVE">LIVE</option>
              <option value="DELAYED">DELAYED</option>
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" type="number" min="0" max="10000" name="priority" value="100" placeholder="Priority"></div>
          <div class="col-md-2"><input class="form-control" type="number" min="1" name="request_budget" value="60" placeholder="Requests"></div>
          <div class="col-md-2"><input class="form-control" type="number" min="1" name="window_seconds" value="60" placeholder="Window sec"></div>
          <div class="col-md-8"><input class="form-control" name="license_profile" value="UNSPECIFIED" placeholder="License profile"></div>
          <div class="col-md-4"><button class="btn btn-primary w-100">Create disabled source</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-page__stack">
      <h2>Sources and health</h2>
      {% if w.sources|default([]) is empty %}
        <section class="cos-panel"><p>No market-data sources configured.</p></section>
      {% endif %}
      {% for source in w.sources|default([]) %}
        <section class="cos-panel">
          <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
              <small>{{ source.adapter_type }}</small>
              <h3>{{ source.id }}</h3>
              <p>
                {% if source.enabled %}
                  <span class="badge text-bg-success">ENABLED</span>
                {% else %}
                  <span class="badge text-bg-secondary">DISABLED</span>
                {% endif %}
                {% for role in source.roles %}<span class="badge text-bg-light me-1">{{ role }}</span>{% endfor %}
              </p>
              <p>Venue: <strong>{{ source.venue_id|default('reference / none') }}</strong> · Priority: {{ source.priority }} · License: {{ source.license_profile }}</p>
              <p>Capabilities: {% if source.capabilities is empty %}—{% else %}{{ source.capabilities|join(', ') }}{% endif %}</p>
              {% if source.credentials_configured %}<p>Credentials: <strong>configured</strong> via Platform Credential Vault.</p>{% endif %}
            </div>
            {% if canManageMarketDataSources or canManageMarketData %}
              <div class="d-flex gap-2 flex-wrap">
                {% if canManageMarketDataSources %}
                  {% if source.enabled %}
                    <form method="post" action="/capital-markets/market-data/sources/{{ source.id|url_encode }}/disable">
                      <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                      <button class="btn btn-outline-danger">Disable</button>
                    </form>
                  {% else %}
                    <form method="post" action="/capital-markets/market-data/sources/{{ source.id|url_encode }}/enable">
                      <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                      <button class="btn btn-outline-success">Enable</button>
                    </form>
                  {% endif %}
                {% endif %}
                {% if canManageMarketData %}
                  <form method="post" action="/capital-markets/market-data/sources/{{ source.id|url_encode }}/poll">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="hidden" name="limit" value="100">
                    <button class="btn btn-primary" {% if not source.enabled %}disabled{% endif %}>Poll now</button>
                  </form>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <hr>
          <h4>Health</h4>
          {% if source.health %}
            <p>
              State: <strong>{{ source.health.connection_state }}</strong> ·
              Last event: {{ source.health.last_event_at|default('—') }} ·
              Failures: {{ source.health.failure_count }} ·
              Errors: {{ source.health.error_count }} ·
              Queue lag: {{ source.health.queue_lag }}
            </p>
            {% if source.health.last_error %}<div class="alert alert-warning">{{ source.health.last_error }}</div>{% endif %}
          {% else %}
            <p>No runtime health yet. The source has not produced a successful or failed poll.</p>
          {% endif %}

          <h4>Subscriptions</h4>
          {% if source.subscriptions is empty %}
            <p>No subscriptions configured.</p>
          {% else %}
            <div class="table-responsive"><table class="table">
              <thead><tr><th>Instrument</th><th>Data type</th><th>Status</th><th>Last event</th></tr></thead>
              <tbody>
              {% for subscription in source.subscriptions %}
                <tr>
                  <td>{{ subscription.instrument_id }}</td>
                  <td>{{ subscription.data_type }}</td>
                  <td>{{ subscription.status }}</td>
                  <td>{{ subscription.last_event_at|default('—') }}</td>
                </tr>
              {% endfor %}
              </tbody>
            </table></div>
          {% endif %}

          {% if canManageMarketData %}
            <form method="post" action="/capital-markets/market-data/sources/{{ source.id|url_encode }}/subscriptions" class="row g-2">
              <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
              <div class="col-md-7">
                <select class="form-select" name="instrument_id" required>
                  <option value="">Instrument</option>
                  {% for instrument in w.instruments|default([]) %}
                    <option value="{{ instrument.id }}">{{ instrument.symbol }} · {{ instrument.name }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="col-md-3">
                <select class="form-select" name="data_type" required>
                  <option value="BBO">BBO</option>
                  <option value="VOLUME">VOLUME</option>
                </select>
              </div>
              <div class="col-md-2"><button class="btn btn-outline-primary w-100">Subscribe</button></div>
            </form>
          {% endif %}
        </section>
      {% endfor %}
    </section>

    <section class="cos-panel">
      <h2>Current trading MarketState</h2>
      {% if w.states|default([]) is empty %}
        <p>No trading state yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Venue</th><th>Instrument</th><th>Mid</th><th>Spread bps</th><th>Trust</th><th>Updated</th></tr></thead>
          <tbody>
          {% for state in w.states %}
            <tr>
              <td>{{ state.venue_id }}</td>
              <td>{{ state.instrument_id }}</td>
              <td>{{ state.mid_price|default('—') }}</td>
              <td>{{ state.spread_bps|default('—') }}</td>
              <td><strong>{{ state.trust_status }}</strong></td>
              <td>{{ state.updated_at }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

    <section class="cos-panel">
      <h2>Reference MarketState</h2>
      {% if w.reference_states|default([]) is empty %}
        <p>No reference state yet.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Source</th><th>Instrument</th><th>Session</th><th>Reference</th><th>Trust</th><th>Updated</th></tr></thead>
          <tbody>
          {% for state in w.reference_states %}
            <tr>
              <td>{{ state.source_id }}</td>
              <td>{{ state.instrument_id }}</td>
              <td>{{ state.session }}</td>
              <td>
                {% if state.current_quote %}
                  {{ state.current_quote.bid_price.value }} / {{ state.current_quote.ask_price.value }}
                {% else %}—{% endif %}
              </td>
              <td><strong>{{ state.quality.status }}</strong></td>
              <td>{{ state.updated_at }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

  {% elseif cmView == 'relationships' %}
    {% if canManageRelationships %}
      <section class="cos-panel">
        <h2>Create relationship</h2>
        <form method="post" action="/capital-markets/relationships" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-3">
            <select class="form-select" name="source_instrument" required>
              <option value="">Source instrument</option>
              {% for item in w.instruments|default([]) %}<option value="{{ item.id }}">{{ item.symbol }} · {{ item.name }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-3">
            <select class="form-select" name="type" required>
              {% for type in ['UNDERLYING_OF','REPRESENTS','REFERENCES','DERIVES_VALUE_FROM','SYNTHETIC_EXPOSURE_TO','HEDGES','REDEEMABLE_INTO','COLLATERALIZED_BY','SETTLED_IN','QUOTED_IN','CORRELATED_WITH'] %}
                <option value="{{ type }}">{{ type }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-3">
            <select class="form-select" name="target_instrument" required>
              <option value="">Target instrument</option>
              {% for item in w.instruments|default([]) %}<option value="{{ item.id }}">{{ item.symbol }} · {{ item.name }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="strength">
              {% for strength in ['EXACT','DIRECT','DERIVED','STATISTICAL'] %}<option value="{{ strength }}">{{ strength }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-1"><button class="btn btn-primary w-100">Add</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-panel">
      <h2>Economic Relationship Graph</h2>
      {% if w.relationships|default([]) is empty %}
        <p>No directed relationships have been registered.</p>
      {% else %}
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Source</th><th>Type</th><th>Target</th><th>Strength</th><th>Status</th></tr></thead>
          <tbody>
          {% for rel in w.relationships %}
            <tr>
              <td><a href="/capital-markets/instruments/{{ rel.source_instrument.id|url_encode }}">{{ rel.source_instrument.symbol|default(rel.source_instrument.id) }}</a></td>
              <td><strong>{{ rel.type }}</strong></td>
              <td><a href="/capital-markets/instruments/{{ rel.target_instrument.id|url_encode }}">{{ rel.target_instrument.symbol|default(rel.target_instrument.id) }}</a></td>
              <td>{{ rel.strength }}</td>
              <td>{{ rel.status }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
    </section>

  {% elseif cmView == 'venues' %}
    {% if canManageVenues %}
      <section class="cos-panel">
        <h2>Create venue</h2>
        <form method="post" action="/capital-markets/venues" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <div class="col-md-3"><input class="form-control" name="name" placeholder="Tokenized Venue A" required></div>
          <div class="col-md-2"><input class="form-control" name="code" placeholder="VENUE_A" required></div>
          <div class="col-md-3">
            <select class="form-select" name="type">
              {% for type in ['broker','stock_exchange','cex','dex','amm','perpetual_dex','tokenized_securities_venue','rwa_platform','data_provider'] %}
                <option value="{{ type }}">{{ type|upper }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" name="jurisdiction" placeholder="Jurisdiction"></div>
          <div class="col-md-2"><input class="form-control" name="timezone" value="UTC" placeholder="Timezone"></div>
          <div class="col-md-12">
            {% for cap in ['MARKET_DATA','ORDER_BOOK','TRADING','HISTORICAL_DATA','STREAMING','FUNDING_DATA','MARGIN','DEPOSIT','WITHDRAWAL','SETTLEMENT'] %}
              <label class="me-3"><input type="checkbox" name="capabilities[]" value="{{ cap }}"> {{ cap }}</label>
            {% endfor %}
          </div>
          <div class="col-md-12"><button class="btn btn-primary">Create venue</button></div>
        </form>
      </section>
    {% endif %}

    <section class="cos-page__stack">
      {% if w.venues|default([]) is empty %}
        <section class="cos-panel"><p>No venues registered.</p></section>
      {% endif %}
      {% for venue in w.venues|default([]) %}
        <section class="cos-panel">
          <div class="d-flex justify-content-between gap-3">
            <div>
              <small>{{ venue.type|upper }}</small>
              <h2>{{ venue.name }} · {{ venue.code }}</h2>
              <p>{{ venue.status }} · {{ venue.jurisdiction|default('No jurisdiction') }} · {{ venue.timezone }}</p>
              <p>
                {% if venue.capabilities is empty %}<em>No capabilities declared.</em>{% endif %}
                {% for cap in venue.capabilities %}<span class="badge text-bg-secondary me-1">{{ cap }}</span>{% endfor %}
              </p>
              <p>Supported instruments: <strong>{{ venue.supported_instrument_count }}</strong></p>
            </div>
          </div>

          {% if canManageVenues %}
            <details>
              <summary>Register instrument on this venue</summary>
              <form method="post" action="/capital-markets/venues/{{ venue.id|url_encode }}/instruments" class="row g-2 mt-2">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <div class="col-md-4">
                  <select class="form-select" name="instrument_id" required>
                    <option value="">Instrument</option>
                    {% for item in w.instruments|default([]) %}<option value="{{ item.id }}">{{ item.symbol }} · {{ item.name }}</option>{% endfor %}
                  </select>
                </div>
                <div class="col-md-3"><input class="form-control" name="venue_symbol" placeholder="AAPLx" required></div>
                <div class="col-md-2"><input class="form-control" type="number" min="0" max="30" name="price_precision" value="2"></div>
                <div class="col-md-2"><input class="form-control" type="number" min="0" max="30" name="quantity_precision" value="8"></div>
                <div class="col-md-1"><button class="btn btn-primary w-100">Add</button></div>
              </form>
            </details>
          {% endif %}
        </section>
      {% endfor %}
    </section>
  {% endif %}
</div>
{% endblock %}
