{% extends 'experience/workspace_shell.html.twig' %}

{% block title %}Engineering | COS{% endblock %}

{% block workspace_content %}
<section
    class="cos-page__stack"
    data-cos-engineering="index"
    data-cos-archetype="{{ page.archetypeId() }}"
    data-cos-page-state="{{ page.state }}"
    data-cos-page-density="compact"
>
    <style>
        .engineering-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
        .engineering-pulse{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
        .engineering-pulse strong{font-size:.9rem}
        .engineering-table-wrap{overflow:auto;border:1px solid var(--cos-border, #dfe3ea);border-radius:12px;background:var(--cos-surface, #fff)}
        .engineering-table{width:100%;border-collapse:collapse;min-width:1180px;font-size:.88rem}
        .engineering-table th,.engineering-table td{padding:9px 10px;border-bottom:1px solid var(--cos-border, #e7e9ee);vertical-align:middle;text-align:left;white-space:nowrap}
        .engineering-table th{font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:var(--cos-text-secondary,#667085);background:var(--cos-surface-subtle,#f7f8fa);position:sticky;top:0;z-index:1}
        .engineering-table tr:last-child td{border-bottom:0}
        .engineering-table__title{min-width:260px;white-space:normal}
        .engineering-table__meta{display:block;color:var(--cos-text-secondary,#667085);font-size:.75rem;margin-top:2px}
        .engineering-actions{display:flex;gap:6px;justify-content:flex-end;align-items:center}
        .engineering-actions form{margin:0}
        .engineering-actions .cos-button{padding:6px 9px;min-height:32px}
        .engineering-create summary,.engineering-filter summary{cursor:pointer;font-weight:700}
        .engineering-create[open]{padding-bottom:12px}
        .engineering-create__body{margin-top:12px}
        .engineering-warning{font-weight:700}
        .engineering-muted{color:var(--cos-text-secondary,#667085)}
    </style>

    <div class="engineering-toolbar">
        <div>
            <p class="cos-card__eyebrow">COS · Engineering</p>
            <h1 class="cos-page-title" style="margin:2px 0 4px">Агентська розробка</h1>
            <div class="engineering-pulse" aria-label="Стан Engineering">
                <strong>{{ workspaceStats.running }} виконується</strong>
                <span>·</span>
                <strong>{{ workspaceStats.queued }} у черзі</strong>
                <span>·</span>
                <strong class="{{ workspaceStats.attention > 0 ? 'engineering-warning' : '' }}">{{ workspaceStats.attention }} потребує уваги</strong>
                <span>·</span>
                <span class="engineering-muted">{{ workspaceStats.completed }} завершено</span>
            </div>
        </div>
        <details class="engineering-create cos-card" style="padding:10px 14px;min-width:180px">
            <summary>+ Нове завдання</summary>
            <div class="engineering-create__body">
                <form class="cos-form" method="post" action="/admin/engineering/create" data-engineering-create>
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <div class="cos-form__grid">
                        <label class="cos-field">
                            <span>Назва</span>
                            <input class="cos-input" name="title" maxlength="255" placeholder="Наприклад: Закрити UI cutover">
                        </label>
                        <label class="cos-field">
                            <span>Пріоритет</span>
                            <select class="cos-select" name="priority">
                                {% for priority in ['P0','P1','P2','P3'] %}
                                    <option value="{{ priority }}" {{ priority == 'P2' ? 'selected' : '' }}>{{ priority }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="cos-field">
                            <span>Після створення</span>
                            <select class="cos-select" name="execution_mode">
                                <option value="queue" selected>Додати в чергу</option>
                                <option value="immediate">Запустити зараз</option>
                                <option value="draft">Зберегти чернеткою</option>
                            </select>
                        </label>
                        <label class="cos-field" style="grid-column:1/-1">
                            <span>Вимоги та критерії приймання</span>
                            <textarea class="cos-textarea" name="description" rows="6" required placeholder="Результат, обмеження, критерії приймання."></textarea>
                        </label>
                    </div>
                    <button class="cos-button cos-button--primary" type="submit">Створити</button>
                </form>
            </div>
        </details>
    </div>

    {% if statusMessage %}
        <twig:CosAlert
            title="{{ statusMessage starts with 'ERROR:' ? 'Помилка Engineering' : 'Engineering оновлено' }}"
            copy="{{ statusMessage }}"
            tone="{{ statusMessage starts with 'ERROR:' ? 'danger' : 'positive' }}"
        />
    {% endif %}

    <section class="cos-page__section" aria-labelledby="engineering-workspace-list">
        <div class="engineering-toolbar" style="margin-bottom:8px">
            <div>
                <h2 id="engineering-workspace-list" class="cos-section-title" style="margin:0">Процеси</h2>
                <p class="cos-card__copy" style="margin:2px 0 0">Один список для черги, активних, проблемних і завершених workflow. Стан береться з runtime, а не з декоративної картки.</p>
            </div>
            <div class="engineering-pulse">
                <span class="cos-badge">P0 → P1 → P2 → P3</span>
                <span class="cos-badge">FIFO в межах пріоритету</span>
            </div>
        </div>

        {% if workspaceRows is empty %}
            <twig:CosEmptyState title="Engineering завдань ще немає" copy="Створіть перше завдання кнопкою у верхній частині сторінки." />
        {% else %}
            <div class="engineering-table-wrap">
                <table class="engineering-table" data-engineering-workspace-list>
                    <thead>
                    <tr>
                        <th>Завдання</th>
                        <th>Стан</th>
                        <th>Стан runtime</th>
                        <th>Етап</th>
                        <th>Агент</th>
                        <th>Задачі</th>
                        <th>Запуски</th>
                        <th>Використання</th>
                        <th>Активність</th>
                        <th>Черга</th>
                        <th style="text-align:right">Дії</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for feature in workspaceRows %}
                        {% set isDraft = not feature.workflow_id and feature.status == 'NEW' %}
                        {% set terminal = feature.workflow_state in ['DONE','CANCELLED','FAILED'] or feature.workflow_status in ['COMPLETED','CANCELLED','FAILED'] %}
                        {% set waitsForHuman = feature.workflow_state in ['READY_FOR_HUMAN_APPROVAL','HUMAN_DECISION_REQUIRED','BLOCKED','ESCALATED'] %}
                        {% set usage = feature.usage|default({}) %}
                        <tr data-engineering-feature-row="{{ feature.id }}">
                            <td class="engineering-table__title">
                                <a href="/admin/engineering/{{ feature.id }}"><strong>{{ feature.title }}</strong></a>
                                <span class="engineering-table__meta">{{ feature.priority }}{% if feature.workflow_type %} · {{ feature.workflow_type == 'ENGINEERING_IMMEDIATE' ? 'негайний запуск' : 'черга' }}{% endif %}</span>
                            </td>
                            <td><span class="cos-badge">{{ feature.display_status }}</span></td>
                            <td>
                                {% if feature.health in ['STALLED','STALE'] %}
                                    <span class="cos-badge engineering-warning">⚠ {{ feature.health }}</span>
                                    {% if feature.runtime_reason %}<span class="engineering-table__meta">{{ feature.runtime_reason }}</span>{% endif %}
                                    {% if feature.stalled_at %}<span class="engineering-table__meta">since {{ feature.stalled_at }}</span>{% endif %}
                                {% else %}
                                    <span class="engineering-muted">{{ feature.health }}</span>
                                    {% if feature.runtime_reason %}<span class="engineering-table__meta">{{ feature.runtime_reason }}</span>{% endif %}
                                {% endif %}
                            </td>
                            <td>{{ feature.workflow_state|default('—') }}</td>
                            <td>
                                {{ feature.latest_agent_role|default('—') }}
                                {% if feature.latest_agent_status %}<span class="engineering-table__meta">{{ feature.latest_agent_status }}</span>{% endif %}
                            </td>
                            <td>{{ feature.tasks_completed }}/{{ feature.tasks_total }}</td>
                            <td>{{ feature.agent_runs }}</td>
                            <td>
                                {% if usage.total_tokens is not null %}
                                    {{ usage.total_tokens|number_format(0, '.', ' ') }} tok
                                    <span class="engineering-table__meta">
                                        {% if usage.cost_amount is not null %}
                                            {{ usage.cost_currency|default('USD') }} {{ usage.cost_amount|number_format(4, '.', '') }}
                                        {% else %}
                                            вартість невідома
                                        {% endif %}
                                    </span>
                                {% else %}
                                    <span class="engineering-muted">облік недоступний</span>
                                {% endif %}
                            </td>
                            <td>{{ feature.workflow_last_activity_at|default(feature.updated_at|default('—')) }}</td>
                            <td>{{ feature.queue_position ? ('#' ~ feature.queue_position) : '—' }}</td>
                            <td>
                                <div class="engineering-actions">
                                    <a class="cos-button cos-button--ghost" href="/admin/engineering/{{ feature.id }}">Відкрити</a>
                                    {% if isDraft %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/queue">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--primary" type="submit">У чергу</button>
                                        </form>
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/run">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--ghost" type="submit">Запустити</button>
                                        </form>
                                    {% elseif waitsForHuman %}
                                        <span class="cos-badge">Потрібне рішення</span>
                                    {% elseif feature.workflow_state in ['CANCELLED','FAILED'] or feature.workflow_status in ['CANCELLED','FAILED'] %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/run">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--primary" type="submit">Повторити</button>
                                        </form>
                                    {% elseif not terminal %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/run">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--primary" type="submit">{{ feature.health == 'STALLED' ? 'Відновити' : 'Продовжити' }}</button>
                                        </form>
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/cancel">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <input type="hidden" name="reason" value="Скасовано з Engineering Workspace.">
                                            <button class="cos-button cos-button--danger" type="submit">Скасувати</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</section>
{% endblock %}
