{% extends 'experience/workspace_shell.html.twig' %}

{% block title %}{{ 'Engineering'|trans }} | {{ 'COS'|trans }}{% endblock %}

{% block workspace_content %}
<section
    class="cos-page__stack"
    data-cos-engineering="index"
    data-cos-archetype="{{ page.archetypeId() }}"
    data-cos-page-state="{{ page.state }}"
    data-cos-page-density="compact"
>
    <style>
        .engineering-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
        .engineering-pulse{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
        .engineering-pulse strong{font-size:.9rem}
        .engineering-table-wrap{overflow:auto;border:1px solid var(--cos-border, #dfe3ea);border-radius:12px;background:var(--cos-surface, #fff)}
        .engineering-table{width:100%;border-collapse:collapse;min-width:1180px;font-size:.88rem}
        .engineering-table th,.engineering-table td{padding:9px 10px;border-bottom:1px solid var(--cos-border, #e7e9ee);vertical-align:middle;text-align:left;white-space:nowrap}
        .engineering-table th{font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:var(--cos-text-secondary,#667085);background:var(--cos-surface-subtle,#f7f8fa);position:sticky;top:0;z-index:1}
        .engineering-table tr:last-child td{border-bottom:0}
        .engineering-table__title{min-width:260px;white-space:normal}
        .engineering-table__meta{display:block;color:var(--cos-text-secondary,#667085);font-size:.75rem;margin-top:2px}
        .engineering-actions{display:flex;gap:6px;justify-content:flex-end;align-items:center}
        .engineering-actions form{margin:0}
        .engineering-actions .cos-button{padding:6px 9px;min-height:32px}
        .engineering-create summary,.engineering-filter summary{cursor:pointer;font-weight:700}
        .engineering-create[open]{padding-bottom:12px}
        .engineering-create__body{margin-top:12px}
        .engineering-warning{font-weight:700}
        .engineering-muted{color:var(--cos-text-secondary,#667085)}
        .engineering-views{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
        .engineering-view{display:inline-flex;align-items:center;gap:5px;padding:6px 9px;border:1px solid var(--cos-border,#dfe3ea);border-radius:8px;text-decoration:none;color:inherit;background:var(--cos-surface,#fff);font-size:.8rem}
        .engineering-view[aria-current="page"]{font-weight:700;border-color:currentColor}
        .engineering-search{display:flex;gap:6px;align-items:center}
        .engineering-search .cos-input{min-width:220px;height:34px;padding:6px 9px}
    </style>

    <div class="engineering-toolbar">
        <div>
            <p class="cos-card__eyebrow">{{ 'COS'|trans }} · {{ 'Engineering'|trans }}</p>
            <h1 class="cos-page-title" style="margin:2px 0 4px">{{ 'Агентська розробка'|trans }}</h1>
            <div class="engineering-pulse" aria-label="{{ 'Стан Engineering'|trans }}">
                <strong>{{ workspaceStats.running }} {{ 'виконується'|trans }}</strong>
                <span>·</span>
                <strong>{{ workspaceStats.queued }} {{ 'у черзі'|trans }}</strong>
                <span>·</span>
                <strong class="{{ workspaceStats.attention > 0 ? 'engineering-warning' : '' }}">{{ workspaceStats.attention }} {{ 'потребує уваги'|trans }}</strong>
                <span>·</span>
                <span class="engineering-muted">{{ workspaceStats.completed }} {{ 'завершено'|trans }}</span>
            </div>
        </div>
        <details class="engineering-create cos-card" style="padding:10px 14px;min-width:180px">
            <summary>{{ '+ Нове завдання'|trans }}</summary>
            <div class="engineering-create__body">
                <form class="cos-form" method="post" action="/admin/engineering/create" data-engineering-create>
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <div class="cos-form__grid">
                        <label class="cos-field">
                            <span>{{ 'Назва'|trans }}</span>
                            <input class="cos-input" name="title" maxlength="255" placeholder="{{ 'Наприклад: Закрити UI cutover'|trans }}">
                        </label>
                        <label class="cos-field">
                            <span>{{ 'Пріоритет'|trans }}</span>
                            <select class="cos-select" name="priority">
                                {% for priority in ['P0','P1','P2','P3'] %}
                                    <option value="{{ priority }}" {{ priority == 'P2' ? 'selected' : '' }}>{{ priority }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="cos-field">
                            <span>{{ 'Після створення'|trans }}</span>
                            <select class="cos-select" name="execution_mode">
                                <option value="queue" selected>{{ 'Додати в чергу'|trans }}</option>
                                <option value="immediate">{{ 'Запустити зараз'|trans }}</option>
                                <option value="draft">{{ 'Зберегти чернеткою'|trans }}</option>
                            </select>
                        </label>
                        <label class="cos-field" style="grid-column:1/-1">
                            <span>{{ 'Вимоги та критерії приймання'|trans }}</span>
                            <textarea class="cos-textarea" name="description" rows="6" required placeholder="{{ 'Результат, обмеження, критерії приймання.'|trans }}"></textarea>
                        </label>
                    </div>
                    <button class="cos-button cos-button--primary" type="submit">{{ 'Створити'|trans }}</button>
                </form>
            </div>
        </details>
    </div>

    {% if statusMessage %}
        <twig:CosAlert
            title="{{ statusMessage starts with 'ERROR:' ? ('Помилка Engineering'|trans) : ('Engineering оновлено'|trans) }}"
            copy="{{ statusMessage }}"
            tone="{{ statusMessage starts with 'ERROR:' ? 'danger' : 'positive' }}"
        />
    {% endif %}

    <section class="cos-page__section" aria-labelledby="engineering-workspace-list" data-engineering-workspace-list>
        <div class="engineering-toolbar" style="margin-bottom:8px">
            <div>
                <h2 id="engineering-workspace-list" class="cos-section-title" style="margin:0">{{ 'Процеси'|trans }}</h2>
                <p class="cos-card__copy" style="margin:2px 0 0">{{ 'Один список для черги, активних, проблемних і завершених workflow. Стан береться з runtime, а не з декоративної картки.'|trans }}</p>
            </div>
            <div class="engineering-pulse">
                <span class="cos-badge">P0 → P1 → P2 → P3</span>
                <span class="cos-badge">{{ 'FIFO в межах пріоритету'|trans }}</span>
            </div>
        </div>

        <div class="engineering-toolbar" style="margin-bottom:10px">
            <nav class="engineering-views" aria-label="{{ 'Фільтри Engineering'|trans }}">
                {% set views = {
                    'all': ['Усі'|trans, workspaceStats.total],
                    'running': ['Активні'|trans, workspaceStats.running],
                    'queued': ['Черга'|trans, workspaceStats.queued],
                    'attention': ['Потребують уваги'|trans, workspaceStats.attention],
                    'completed': ['Завершені'|trans, workspaceStats.completed],
                    'cancelled': ['Скасовані'|trans, workspaceStats.cancelled]
                } %}
                {% for key, item in views %}
                    <a
                        class="engineering-view"
                        href="/admin/engineering?view={{ key }}{% if workspaceQuery %}&q={{ workspaceQuery|url_encode }}{% endif %}"
                        {% if workspaceView == key %}aria-current="page"{% endif %}
                    >{{ item[0] }}{% if item[1] is not null %} <span class="engineering-muted">{{ item[1] }}</span>{% endif %}</a>
                {% endfor %}
            </nav>
            <form class="engineering-search" method="get" action="/admin/engineering">
                <input type="hidden" name="view" value="{{ workspaceView }}">
                <input class="cos-input" type="search" name="q" value="{{ workspaceQuery }}" placeholder="{{ 'Пошук за назвою, етапом, агентом'|trans }}">
                <button class="cos-button cos-button--ghost" type="submit">{{ 'Знайти'|trans }}</button>
                {% if workspaceQuery %}
                    <a class="cos-button cos-button--ghost" href="/admin/engineering?view={{ workspaceView }}">{{ 'Очистити'|trans }}</a>
                {% endif %}
            </form>
        </div>

        {% if workspaceRows is empty %}
            <twig:CosEmptyState
                title="{{ workspaceView == 'all' and not workspaceQuery ? 'Engineering завдань ще немає' : 'Нічого не знайдено' }}"
                copy="{{ workspaceView == 'all' and not workspaceQuery ? 'Створіть перше завдання кнопкою у верхній частині сторінки.' : 'Змініть фільтр або пошуковий запит.' }}"
            />
        {% else %}
            <div class="engineering-table-wrap">
                <table class="engineering-table">
                    <thead>
                    <tr>
                        <th>{{ 'Завдання'|trans }}</th>
                        <th>{{ 'Стан'|trans }}</th>
                        <th>{{ 'Стан runtime'|trans }}</th>
                        <th>{{ 'Етап'|trans }}</th>
                        <th>{{ 'Агент'|trans }}</th>
                        <th>{{ 'Задачі'|trans }}</th>
                        <th>{{ 'Запуски'|trans }}</th>
                        <th>{{ 'Використання'|trans }}</th>
                        <th>{{ 'Активність'|trans }}</th>
                        <th>{{ 'Черга'|trans }}</th>
                        <th style="text-align:right">{{ 'Дії'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for feature in workspaceRows %}
                        {% set actions = feature.actions|default({}) %}
                        {% set usage = feature.usage|default({}) %}
                        <tr data-engineering-feature-row="{{ feature.id }}">
                            <td class="engineering-table__title">
                                <a href="/admin/engineering/{{ feature.id }}"><strong>{{ feature.title }}</strong></a>
                                <span class="engineering-table__meta">{{ feature.priority }}{% if feature.workflow_type %} · {{ feature.workflow_type == 'ENGINEERING_IMMEDIATE' ? ('негайний запуск'|trans) : ('черга'|trans) }}{% endif %}</span>
                            </td>
                            <td><span class="cos-badge">{{ ('engineering.status.' ~ (feature.display_status|lower))|trans }}</span></td>
                            <td>
                                {% if feature.health in ['STALLED','STALE'] %}
                                    <span class="cos-badge engineering-warning">⚠ {{ ('engineering.status.' ~ (feature.health|lower))|trans }}</span>
                                    {% if feature.runtime_reason %}<span class="engineering-table__meta">{{ feature.runtime_reason }}</span>{% endif %}
                                    {% if feature.stalled_at %}<span class="engineering-table__meta">{{ 'since'|trans }} {{ feature.stalled_at }}</span>{% endif %}
                                {% else %}
                                    <span class="engineering-muted">{{ ('engineering.status.' ~ (feature.health|lower))|trans }}</span>
                                    {% if feature.runtime_reason %}<span class="engineering-table__meta">{{ feature.runtime_reason }}</span>{% endif %}
                                {% endif %}
                            </td>
                            <td>{% if feature.workflow_state|default('') %}{{ ('engineering.status.' ~ (feature.workflow_state|lower))|trans }}{% else %}—{% endif %}</td>
                            <td>
                                {% if feature.latest_agent_role|default('') %}{{ ('engineering.role.' ~ (feature.latest_agent_role|lower))|trans }}{% else %}—{% endif %}
                                {% if feature.latest_agent_status %}<span class="engineering-table__meta">{{ ('engineering.status.' ~ (feature.latest_agent_status|lower))|trans }}</span>{% endif %}
                            </td>
                            <td>{{ feature.tasks_completed }}/{{ feature.tasks_total }}</td>
                            <td>{{ feature.agent_runs }}</td>
                            <td>
                                {% if usage.total_tokens is not null %}
                                    {{ usage.total_tokens|number_format(0, '.', ' ') }} {{ 'tok'|trans }}
                                    <span class="engineering-table__meta">
                                        {% if usage.cost_amount is not null %}
                                            {{ usage.cost_currency|default('USD') }} {{ usage.cost_amount|number_format(4, '.', '') }}
                                        {% else %}
                                            {{ 'вартість невідома'|trans }}
                                        {% endif %}
                                    </span>
                                {% else %}
                                    <span class="engineering-muted">{{ 'облік недоступний'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>{{ feature.workflow_last_activity_at|default(feature.updated_at|default('—')) }}</td>
                            <td>{{ feature.queue_position ? ('#' ~ feature.queue_position) : '—' }}</td>
                            <td>
                                <div class="engineering-actions">
                                    <a class="cos-button cos-button--ghost" href="/admin/engineering/{{ feature.id }}">{{ 'Відкрити'|trans }}</a>
                                    {% if actions.queue|default(false) %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/queue">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--primary" type="submit">{{ 'У чергу'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    {% if actions.run|default(false) %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/run">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--ghost" type="submit">{{ 'Запустити'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    {% if actions.resolve_human|default(false) %}
                                        <span class="cos-badge">{{ 'Потрібне рішення'|trans }}</span>
                                    {% endif %}
                                    {% if actions.finalize|default(false) %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/finalize">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--primary" type="submit">{{ 'Перевірити merge'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    {% if actions.retry|default(false) %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/run">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--primary" type="submit">{{ 'Повторити'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    {% if actions.resume|default(false) or actions.continue|default(false) %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/run">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <button class="cos-button cos-button--primary" type="submit">{{ actions.resume|default(false) ? 'Відновити' : 'Продовжити' }}</button>
                                        </form>
                                    {% endif %}
                                    {% if actions.cancel|default(false) %}
                                        <form method="post" action="/admin/engineering/{{ feature.id }}/cancel">
                                            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                            <input type="hidden" name="reason" value="{{ 'Скасовано з Engineering Workspace.'|trans }}">
                                            <button class="cos-button cos-button--danger" type="submit">{{ 'Скасувати'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</section>
{% endblock %}
