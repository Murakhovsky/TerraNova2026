{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}Lead Workspace | COS{% endblock %}
{% block workspace_content %}
<twig:CosWorkspace :workspace="workspace">
    <section
        class="cos-primitive-stack"
        data-sales-surface="lead-workspace"
        data-controller="sales-lead"
        data-sales-lead-lead-id-value="{{ lead.id }}"
        data-sales-lead-csrf-value="{{ csrfToken }}"
        data-lead-id="{{ lead.id }}"
    >
        <twig:CosEntityHeader
            eyebrow="Lead Workspace"
            title="{{ lead.name ?? 'Lead #' ~ lead.id }}"
            subtitle="{{ lead.message ?? 'Sales lead' }}"
            identity="Lead #{{ lead.id }}"
            statusLabel="{{ lead.status ?? 'new' }}"
            statusTone="{{ (lead.status ?? '') == 'qualified' ? 'positive' : ((lead.status ?? '') == 'disqualified' ? 'danger' : 'neutral') }}"
            :meta="[
                {label: 'Source', value: lead.source ?? 'Direct'},
                {label: 'Owner', value: lead.owner_name ?? 'Unassigned'},
                {label: 'Created', value: lead.created_at ?? '—'}
            ]"
        />

        <section class="cos-card cos-primitive-stack">
            <p class="cos-card__eyebrow">Operations</p>
            <h2>Lead actions</h2>
            <twig:CosActionBar label="Lead operations">
                {% if (lead.status ?? 'new') == 'new' %}
                    <button class="cos-button cos-button--ghost" type="button" data-sales-lead-status data-status="contacted" data-action="sales-lead#status">Contacted</button>
                {% endif %}
                <button class="cos-button cos-button--primary" type="button" data-sales-lead-status data-status="qualified" data-action="sales-lead#status">Qualify</button>
                <button class="cos-button cos-button--ghost" type="button" data-sales-lead-status data-status="disqualified" data-action="sales-lead#status">Disqualify</button>
                {% if lead.deal_id ?? false %}
                    <a class="cos-button cos-button--primary" href="/sales/deals/{{ lead.deal_id }}">Open Deal</a>
                {% else %}
                    <button class="cos-button cos-button--primary" type="button" data-sales-lead-deal data-action="sales-lead#convert">Create Deal</button>
                {% endif %}
                <button class="cos-button cos-button--ghost" type="button" data-sales-lead-followup data-action="sales-lead#followup">Follow-up</button>
            </twig:CosActionBar>

            <label class="cos-field">
                <span>Owner</span>
                <select class="cos-select" data-sales-lead-owner data-action="change->sales-lead#owner">
                    <option value="">Оберіть</option>
                    {% for owner in owners %}
                        <option value="{{ owner.id }}" {% if (lead.owner_id ?? 0) == owner.id %}selected{% endif %}>{{ owner.full_name ?? owner.email ?? ('#' ~ owner.id) }}</option>
                    {% endfor %}
                </select>
            </label>
            <p class="cos-card__copy" data-sales-lead-status-text aria-live="polite"></p>
        </section>

        <div class="cos-primitive-stack">
            <section class="cos-card">
                <p class="cos-card__eyebrow">Contact</p>
                <h2>Контактні дані</h2>
                <dl class="cos-entity-summary">
                    <div><dt>Phone</dt><dd>{{ lead.phone ?? '—' }}</dd></div>
                    <div><dt>Email</dt><dd>{{ lead.email ?? '—' }}</dd></div>
                    <div><dt>Source</dt><dd>{{ lead.source ?? 'Direct' }}</dd></div>
                </dl>
            </section>

            <section class="cos-card">
                <p class="cos-card__eyebrow">Next step</p>
                <h2>Наступна дія</h2>
                <twig:CosNextAction
                    title="{{ lead.attention_reason ?? 'Create follow-up' }}"
                    copy="{{ lead.manager_note ?? 'Зафіксуйте наступний контакт для цього ліда.' }}"
                    due="{{ lead.next_action_at ?? 'Не заплановано' }}"
                    tone="{{ lead.attention_reason ? 'warning' : 'neutral' }}"
                />
            </section>
        </div>

        <section class="cos-card">
            <p class="cos-card__eyebrow">Context</p>
            <h2>Повідомлення ліда</h2>
            <p class="cos-card__copy">{{ lead.message ?? 'Немає додаткового повідомлення.' }}</p>
        </section>
    </section>
</twig:CosWorkspace>
{% endblock %}
