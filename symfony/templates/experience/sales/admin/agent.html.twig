{% extends 'experience/workspace_shell.html.twig' %}
{% block title %}Sales Intelligence Agent | COS{% endblock %}
{% block workspace_content %}
{% set agent = admin.data.agent ?? {} %}{% set catalog = admin.data.catalog ?? {} %}{% set code = agent.code_owned ?? {} %}
<section class="cos-page__stack" data-controller="sales-admin-agent" data-sales-admin-agent-name-value="{{ agent.agent_name ?? '' }}" data-sales-admin-agent-csrf-value="{{ csrfToken }}" data-cos-archetype="{{ page.archetypeId() }}" data-cos-page-state="{{ page.state }}" data-cos-page-density="{{ page.density }}">
  <twig:CosPageHeader eyebrow="Sales · Administration · Intelligence" title="{{ agent.agent_name ?? 'Sales Intelligence Agent' }}" subtitle="Tune business behavior without changing immutable schema, safety contract or Kernel execution controls." metaValue="{{ (agent.enabled ?? false) ? 'Enabled' : 'Disabled' }}" metaLabel="runtime state"><twig:CosButton label="All agents" href="/sales/admin/agents" variant="ghost" /></twig:CosPageHeader>
  <twig:CosToolbar label="Agent configuration">{% block start %}<span class="cos-card__copy">{{ agent.ownership ?? 'SYSTEM' }} · cfg v{{ agent.configuration_version ?? 1 }}</span>{% endblock %}</twig:CosToolbar>
  {% if admin.error %}<twig:CosAlert title="Agent unavailable" copy="{{ admin.error }}" tone="danger" />{% else %}
    <article class="cos-card"><p class="cos-card__eyebrow">Admin-owned runtime configuration</p><h2 class="cos-card__title">Business behavior</h2>
      <form class="cos-pattern-stack" data-action="submit->sales-admin-agent#save"><input type="hidden" name="configuration_version" value="{{ agent.configuration_version ?? 1 }}">
        <label class="cos-field"><span>Enabled</span><select class="cos-select" name="enabled"><option value="1" {% if agent.enabled ?? false %}selected{% endif %}>Enabled</option><option value="0" {% if not (agent.enabled ?? false) %}selected{% endif %}>Disabled</option></select></label>
        <label class="cos-field"><span>Profile</span><select class="cos-select" name="profile">{% for profile in catalog.profiles ?? [] %}<option value="{{ profile }}" {% if (agent.profile ?? '') == profile %}selected{% endif %}>{{ profile }}</option>{% endfor %}</select></label>
        <label class="cos-field"><span>Model override</span><input class="cos-input" name="model" maxlength="160" value="{{ agent.model ?? '' }}"></label>
        <label class="cos-field"><span>Confidence threshold</span><input class="cos-input" name="confidence_threshold" type="number" min="0" max="1" step="0.01" value="{{ agent.confidence_threshold ?? 0.65 }}"></label>
        <label class="cos-field"><span>Business instructions</span><textarea class="cos-textarea" name="business_instructions" rows="6" maxlength="10000">{{ agent.business_instructions ?? '' }}</textarea></label>
        <fieldset class="cos-field"><legend>Context sources</legend>{% for source in catalog.context_sources ?? [] %}<label class="cos-choice"><input type="checkbox" name="context_sources" value="{{ source }}" {% if source in (agent.context_sources ?? []) %}checked{% endif %}><span>{{ source }}</span></label>{% endfor %}</fieldset>
        <fieldset class="cos-field"><legend>Allowed actions</legend>{% for action in catalog.hard_allowed_actions ?? [] %}<label class="cos-choice"><input type="checkbox" name="allowed_actions" value="{{ action }}" {% if action in (agent.allowed_actions ?? []) %}checked{% endif %}><span>{{ action }}</span></label>{% endfor %}</fieldset>
        <button class="cos-button cos-button--primary" type="submit">Save configuration</button><span class="cos-card__copy" data-sales-admin-agent-target="status" aria-live="polite"></span>
      </form>
    </article>
    <article class="cos-card"><p class="cos-card__eyebrow">Code-owned boundary</p><h2 class="cos-card__title">Immutable safety contract</h2><dl class="cos-entity-summary">
      <div class="cos-entity-summary__item"><span>Agent version</span><strong>{{ code.agent_version ?? '—' }}</strong></div><div class="cos-entity-summary__item"><span>Schema</span><strong>{{ code.schema_version ?? '—' }}</strong></div><div class="cos-entity-summary__item"><span>Prompt</span><strong>{{ code.prompt_version ?? '—' }}</strong></div><div class="cos-entity-summary__item"><span>Max actions / run</span><strong>{{ code.max_actions_per_run ?? 0 }}</strong></div><div class="cos-entity-summary__item"><span>Execution mode</span><strong>{{ code.default_execution_mode ?? '—' }}</strong></div><div class="cos-entity-summary__item"><span>Risk level</span><strong>{{ code.default_risk_level ?? '—' }}</strong></div>
    </dl></article>
    <article class="cos-card"><p class="cos-card__eyebrow">Read-only runtime test</p><h2 class="cos-card__title">Test against a real subject</h2>
      <form class="cos-pattern-stack" data-action="submit->sales-admin-agent#test"><label class="cos-field"><span>Subject</span><select class="cos-select" name="subject_type"><option value="deal">deal</option><option value="client_case">client_case</option></select></label><label class="cos-field"><span>Subject ID</span><input class="cos-input" name="subject_id" required maxlength="100"></label><label class="cos-field"><span>Question</span><textarea class="cos-textarea" name="question" rows="3">Analyze this Sales case and return the current assessment.</textarea></label><button class="cos-button cos-button--ghost" type="submit">Run read-only test</button><span class="cos-card__copy" data-sales-admin-agent-target="testStatus"></span></form><pre class="cos-card__copy" data-sales-admin-agent-target="result" hidden></pre>
    </article>
    <article class="cos-card"><p class="cos-card__eyebrow">Configuration history</p><h2 class="cos-card__title">Revisions · {{ (admin.data.revisions ?? [])|length }}</h2><div class="cos-pattern-stack">{% for revision in admin.data.revisions ?? [] %}<p class="cos-card__copy"><strong>{{ revision.action ?? 'UPDATE' }}</strong> · v{{ revision.entity_version ?? 0 }} · {{ revision.actor_type ?? '' }}:{{ revision.actor_id ?? '' }} · {{ revision.created_at ?? '' }}</p>{% else %}<twig:CosEmptyState title="Revision history is empty" copy="Changes will appear here after configuration updates." />{% endfor %}</div></article>
  {% endif %}
</section>
{% endblock %}
