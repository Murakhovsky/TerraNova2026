{% set reason = adaptive.composition.disclosureReasons[sectionId]|default('unavailable') %}
{% if adaptive.available and reason in ['collapsed_by_mode','explicit_expansion'] %}
  <form action="{{ adaptive.url }}" method="post" data-turbo="false" class="cos-adaptive-toggle">
    <input type="hidden" name="csrf_token" value="{{ adaptive.csrf }}">
    <input type="hidden" name="section" value="{{ sectionId }}">
    <button type="submit" name="expand" value="{{ reason == 'collapsed_by_mode' ? '1' : '0' }}"
            class="cos-button cos-button--ghost" aria-expanded="{{ reason == 'explicit_expansion' ? 'true' : 'false' }}"
            id="cos-adaptive-section-{{ sectionId }}" data-cos-section-toggle="{{ sectionId }}">{{ (reason == 'collapsed_by_mode' ? 'uw.adaptive.expand' : 'uw.adaptive.collapse')|trans }} · {{ sectionLabel|trans }}</button>
  </form>
{% endif %}
