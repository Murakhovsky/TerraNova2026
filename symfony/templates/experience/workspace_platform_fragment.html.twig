<twig:CosWorkspace :workspace="workspace">
    <section class="cos-workspace-reference">
        <div class="cos-workspace-reference__metrics">
            <twig:CosCard eyebrow="Pipeline" title="$148k" copy="Reference metric from the product read model." />
            <twig:CosCard eyebrow="Stage" title="Proposal" copy="Core content belongs to the product surface." />
            <twig:CosCard eyebrow="Attention" title="2 items" copy="Workspace composition does not invent business state." />
        </div>

        <section class="cos-card">
            <p class="cos-card__eyebrow">Product-owned main content</p>
            <h2>Deal execution surface</h2>
            <p class="cos-card__copy">
                The Workspace Platform composes shell, actions and extension slots around this server-rendered product content.
            </p>
        </section>
    </section>
</twig:CosWorkspace>
