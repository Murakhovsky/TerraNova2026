<!DOCTYPE html>
<html lang="uk" data-cos-theme="light" data-cos-density="comfortable">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#17191d">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="COS">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/icons/cos-192.svg" type="image/svg+xml">
    {% block meta %}{% endblock %}
    <title>{% block title %}COS{% endblock %}</title>

    {% block stylesheets %}
        {{ ux_controller_link_tags() }}
        <link rel="stylesheet" href="{{ asset('bootstrap/dist/css/bootstrap.min.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    {% block javascripts %}
        {{ importmap('app', {'nonce': app.request.attributes.get('cos_csp_nonce')}) }}
    {% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
</body>
</html>
