APP_ENV=production
MYSQL_DATABASE=cos
MYSQL_USER=cos
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
COS_ORGANIZATION_ID=default
LLM_ENDPOINT=
LLM_TOKEN=
LLM_MODEL=
LLM_PROVIDER=http
COS_SECRET_MASTER_KEY=replace_with_base64_32_byte_key
COS_SECRET_MASTER_KEY_ID=env-v1
COS_ENGINEERING_MANAGER_MODEL=
COS_ENGINEERING_ARCHITECT_MODEL=
COS_ENGINEERING_DEVELOPER_MODEL=
COS_ENGINEERING_REVIEWER_MODEL=
COS_ENGINEERING_QA_MODEL=
# Required for Engineering stages that need authoritative repository reads/writes.
COS_ENGINEERING_GITHUB_REPOSITORY=Murakhovsky/TerraNova2026
COS_ENGINEERING_GITHUB_TOKEN=
COS_ENGINEERING_GITHUB_BASE_BRANCH=main
COS_ENGINEERING_RUNTIME_WATCHDOG_ENABLED=1
COS_ENGINEERING_RUNTIME_WATCHDOG_INTERVAL_MINUTES=2
COS_ENGINEERING_RUNTIME_STALE_SECONDS=600
COS_ENGINEERING_RUNTIME_STALLED_SECONDS=1800
# Optional fallback pricing catalog; tenant Platform Settings namespace llm_pricing overrides it.
# Example shape: {"openai.model-name":{"input_per_million":0,"cached_input_per_million":0,"output_per_million":0,"currency":"USD","version":"YYYY-MM-DD"}}
COS_LLM_PRICING_JSON=
AGENT_INPUT_RETENTION_DAYS=30
CRM_WEBHOOK_SECRET_DEFAULT_AIDA=replace_with_a_long_random_webhook_secret

# L2 market-data worker remains disabled until explicitly started via Symfony CLI.
FOS_L2_ENABLED=0
# Alerts use Platform Notification -> durable n8n outbox -> integration worker.
FOS_L2_ALERT_ENABLED=0
FOS_L2_ALERT_EMAIL=
FOS_L2_ALERT_LOCALE=uk

# Opt-in supervised L2 stream (profile: l2); all identities must be provisioned.
FOS_L2_ORGANIZATION=
FOS_L2_SOURCE_ID=
FOS_L2_VENUE=BINANCE_SPOT
FOS_L2_SYMBOL=BTCUSDT
FOS_L2_BASE=BTC
FOS_L2_QUOTE=USDT
FOS_L2_DEPTH=50
FOS_L2_MESSAGE_BUDGET=1000000
FOS_L2_MAX_ATTEMPTS=20
FOS_L2_STALE_SECONDS=30


# Selected OpenAI commercial partner ChatGPT Plan Usage (disabled until approved).
COS_SIWC_ENABLED=0
COS_SIWC_CLIENT_ID=
COS_SIWC_CLIENT_SECRET=
COS_SIWC_REDIRECT_URI=https://company-os.shop/admin/settings/llm/chatgpt/callback

# Personal OpenCode V2 test bridge (admin-only; never select as a global LLM provider).
# The HTTP server must be reachable FROM THE PHP RUNTIME, not only from the SSH host.
# In Docker use an internal service DNS name with no published ports, not 127.0.0.1.
COS_OPENCODE_ENABLED=0
COS_OPENCODE_ENDPOINT=http://127.0.0.1:4096
COS_OPENCODE_ALLOWED_HOST=127.0.0.1
COS_OPENCODE_SERVER_USERNAME=opencode
COS_OPENCODE_SERVER_PASSWORD=
COS_OPENCODE_ALLOWED_ORGANIZATION_ID=
COS_OPENCODE_ALLOWED_ACTOR_ID=
