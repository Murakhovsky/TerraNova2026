{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "marketing_campaign"
    },
    "target_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "plan_id",
        "source_kind",
        "window_start",
        "window_end",
        "after"
      ],
      "properties": {
        "plan_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^mkpl-[a-f0-9]{24}$"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "lead",
            "order"
          ]
        },
        "window_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "window_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([1-9][0-9]{0,17}|[a-f0-9]{32})$"
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
