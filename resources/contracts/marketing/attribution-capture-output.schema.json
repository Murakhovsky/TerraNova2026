{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "results",
    "financial_mutation"
  ],
  "properties": {
    "model": {
      "type": "string",
      "const": "utm-exact-v1"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lead_id",
          "state",
          "evidence_id"
        ],
        "properties": {
          "lead_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "RECORDED",
              "REJECTED"
            ]
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^mkat-[a-f0-9]{24}$"
          }
        }
      }
    },
    "financial_mutation": {
      "type": "boolean",
      "const": false
    }
  }
}
