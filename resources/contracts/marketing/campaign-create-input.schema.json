{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "objective"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 190
    },
    "objective": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]{2,64}$"
    },
    "brief": {
      "type": "object"
    },
    "audience": {
      "type": "object"
    },
    "creative": {
      "type": "object"
    },
    "planned_budget_minor": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}
