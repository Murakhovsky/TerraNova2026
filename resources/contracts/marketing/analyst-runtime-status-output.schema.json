{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "NOT_CONFIGURED",
        "CONFIGURATION_BLOCKED",
        "BUDGET_REQUIRED",
        "APPROVAL_BINDING_REQUIRED"
      ]
    },
    "configuration_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "max_cost_usd": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]{4}$"
    },
    "daily_run_limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 100
    },
    "budget_configured": {
      "type": "boolean"
    },
    "live_verified": {
      "type": "boolean",
      "const": false
    },
    "launch_available": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "status",
    "configuration_hash",
    "max_cost_usd",
    "daily_run_limit",
    "budget_configured",
    "live_verified",
    "launch_available"
  ],
  "additionalProperties": false
}
