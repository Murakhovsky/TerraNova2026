{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "account_id",
    "account_revision",
    "grain",
    "window_start",
    "window_end",
    "currency",
    "timezone",
    "attribution_hash",
    "rows",
    "totals",
    "comparison",
    "state",
    "recognized_revenue_confirmed",
    "provider_default_attribution_not_causal",
    "payment_confirmed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^mkar-[a-f0-9]{24}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^mads-[a-f0-9]{24}$"
    },
    "grain": {
      "type": "string",
      "enum": [
        "account",
        "campaign",
        "adset",
        "ad"
      ]
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "account_revision": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "timezone": {
      "type": "string"
    },
    "attribution_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object"
      }
    },
    "totals": {
      "type": "object"
    },
    "comparison": {
      "type": [
        "object",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "const": "PROVIDER_REPORTED"
    },
    "recognized_revenue_confirmed": {
      "type": "boolean",
      "const": false
    },
    "provider_default_attribution_not_causal": {
      "type": "boolean",
      "const": true
    },
    "payment_confirmed": {
      "type": "boolean",
      "const": false
    }
  }
}
