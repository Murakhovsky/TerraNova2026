{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "const": "marketing_paid_account"
    },
    "target_id": {
      "type": "string",
      "pattern": "^mads-[a-f0-9]{24}$"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "review_run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_:-]{0,63}$"
        },
        "review_evaluation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_:-]{0,63}$"
        },
        "review_id": {
          "type": "string",
          "pattern": "^mkor-[a-f0-9]{24}$"
        },
        "followup_run_id": {
          "type": "string",
          "pattern": "^mkar-[a-f0-9]{24}$"
        },
        "followup_window_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "followup_window_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "learning_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "review_run_id",
        "review_evaluation_id",
        "review_id",
        "followup_run_id",
        "followup_window_start",
        "followup_window_end",
        "learning_hash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "additionalProperties": false
}
