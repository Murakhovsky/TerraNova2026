{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "audience_id": {
      "type": "string",
      "pattern": "^mkau-[a-f0-9]{24}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "target_spec": {
      "type": "object",
      "properties": {
        "market_countries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "audience_hypothesis": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        }
      },
      "required": [
        "market_countries",
        "audience_hypothesis"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "target_spec"
  ],
  "additionalProperties": false
}
