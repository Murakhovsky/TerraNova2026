{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "campaign_id",
    "plan_id",
    "source_kind",
    "window_start",
    "window_end",
    "after",
    "next_after",
    "scanned",
    "recorded_or_already_present",
    "unresolved",
    "page_exhausted",
    "complete_coverage",
    "financial_mutation"
  ],
  "properties": {
    "model": {
      "type": "string",
      "const": "attribution-sweep-v1"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mkpl-[a-f0-9]{24}$"
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "lead",
        "order"
      ]
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "after": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([1-9][0-9]{0,17}|[a-f0-9]{32})$"
    },
    "next_after": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([1-9][0-9]{0,17}|[a-f0-9]{32})$"
    },
    "scanned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "recorded_or_already_present": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "unresolved": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "page_exhausted": {
      "type": "boolean"
    },
    "complete_coverage": {
      "type": "boolean",
      "const": false
    },
    "financial_mutation": {
      "type": "boolean",
      "const": false
    }
  },
  "additionalProperties": false
}
