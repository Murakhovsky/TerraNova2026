{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "learning_id": {
      "type": "string",
      "pattern": "^mkol-[a-f0-9]{24}$"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{6}$"
    },
    "learning": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "const": "optimization-learning-v1"
        },
        "review_id": {
          "type": "string",
          "pattern": "^mkor-[a-f0-9]{24}$"
        },
        "review_receipt_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_:-]{0,63}$"
        },
        "review_evaluation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_:-]{0,63}$"
        },
        "review_recorded_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{6}$"
        },
        "account_id": {
          "type": "string",
          "pattern": "^mads-[a-f0-9]{24}$"
        },
        "external_id": {
          "type": "string",
          "pattern": "^[0-9]{1,30}$"
        },
        "window_relation": {
          "type": "string",
          "enum": [
            "AFTER_REVIEW",
            "RETROSPECTIVE_ONLY"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "INSUFFICIENT_EVIDENCE",
            "IMPROVED_OBSERVED",
            "DEGRADED_OBSERVED",
            "UNCHANGED_OBSERVED"
          ]
        },
        "followup_evaluation": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "const": "optimization-rule-v1"
            },
            "rule": {
              "type": "string",
              "enum": [
                "CTR_DECLINE",
                "CPC_INCREASE",
                "CPM_INCREASE"
              ]
            },
            "threshold_percent": {
              "type": "integer",
              "minimum": 20,
              "maximum": 200
            },
            "metric": {
              "type": "string",
              "enum": [
                "CTR_PERCENT",
                "CPC",
                "CPM"
              ]
            },
            "minimum_impressions": {
              "type": "integer",
              "const": 1000
            },
            "minimum_clicks_for_cpc": {
              "type": "integer",
              "const": 20
            },
            "status": {
              "type": "string",
              "enum": [
                "INSUFFICIENT_EVIDENCE",
                "NOT_TRIGGERED",
                "TRIGGERED_REVIEW_REQUIRED"
              ]
            },
            "account_id": {
              "type": "string",
              "pattern": "^mads-[a-f0-9]{24}$"
            },
            "external_id": {
              "type": "string",
              "pattern": "^[0-9]{1,30}$"
            },
            "current_run_id": {
              "type": "string",
              "pattern": "^mkar-[a-f0-9]{24}$"
            },
            "baseline_run_id": {
              "type": "string",
              "pattern": "^mkar-[a-f0-9]{24}$"
            },
            "window_start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "window_end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "baseline_start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "baseline_end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "account_revision": {
              "type": "integer",
              "minimum": 1
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "grain": {
              "type": "string",
              "const": "campaign"
            },
            "attribution_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "current_source": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "snapshot_ref": {
                  "type": "string",
                  "pattern": "^mis-[a-f0-9]{24}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "snapshot_ref",
                "revision",
                "source_hash"
              ],
              "additionalProperties": false
            },
            "baseline_source": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "snapshot_ref": {
                  "type": "string",
                  "pattern": "^mis-[a-f0-9]{24}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "snapshot_ref",
                "revision",
                "source_hash"
              ],
              "additionalProperties": false
            },
            "current_value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "baseline_value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "change_percent": {
              "type": [
                "number",
                "null"
              ]
            },
            "review_recommended": {
              "type": "boolean"
            },
            "action_created": {
              "type": "boolean",
              "const": false
            },
            "provider_mutation": {
              "type": "boolean",
              "const": false
            },
            "financial_mutation": {
              "type": "boolean",
              "const": false
            },
            "causal_attribution": {
              "type": "boolean",
              "const": false
            },
            "approval_required_for_execution": {
              "type": "boolean",
              "const": true
            },
            "evaluation_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "model",
            "rule",
            "threshold_percent",
            "metric",
            "minimum_impressions",
            "minimum_clicks_for_cpc",
            "status",
            "account_id",
            "external_id",
            "current_run_id",
            "baseline_run_id",
            "window_start",
            "window_end",
            "baseline_start",
            "baseline_end",
            "account_revision",
            "currency",
            "grain",
            "attribution_hash",
            "current_source",
            "baseline_source",
            "current_value",
            "baseline_value",
            "change_percent",
            "review_recommended",
            "action_created",
            "provider_mutation",
            "financial_mutation",
            "causal_attribution",
            "approval_required_for_execution",
            "evaluation_hash"
          ],
          "additionalProperties": false
        },
        "next_step": {
          "type": "string",
          "enum": [
            "REVIEW_AGAIN",
            "COLLECT_EVIDENCE",
            "KEEP_OBSERVING"
          ]
        },
        "effect_confirmed": {
          "type": "boolean",
          "const": false
        },
        "causal_attribution": {
          "type": "boolean",
          "const": false
        },
        "rule_change_authorized": {
          "type": "boolean",
          "const": false
        },
        "provider_mutation": {
          "type": "boolean",
          "const": false
        },
        "financial_mutation": {
          "type": "boolean",
          "const": false
        },
        "learning_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "model",
        "review_id",
        "review_receipt_hash",
        "review_run_id",
        "review_evaluation_id",
        "review_recorded_at",
        "account_id",
        "external_id",
        "window_relation",
        "status",
        "followup_evaluation",
        "next_step",
        "effect_confirmed",
        "causal_attribution",
        "rule_change_authorized",
        "provider_mutation",
        "financial_mutation",
        "learning_hash"
      ],
      "additionalProperties": false
    },
    "learning_recorded": {
      "type": "boolean",
      "const": true
    },
    "effect_confirmed": {
      "type": "boolean",
      "const": false
    },
    "rule_change_authorized": {
      "type": "boolean",
      "const": false
    },
    "provider_mutation": {
      "type": "boolean",
      "const": false
    },
    "financial_mutation": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "learning_id",
    "receipt_hash",
    "recorded_at",
    "learning",
    "learning_recorded",
    "effect_confirmed",
    "rule_change_authorized",
    "provider_mutation",
    "financial_mutation"
  ],
  "additionalProperties": false
}
