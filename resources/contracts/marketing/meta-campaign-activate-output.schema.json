{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^mkpl-[a-f0-9]{24}$"
    },
    "operation": {
      "type": "string",
      "const": "ACTIVATE"
    },
    "state": {
      "type": "string",
      "const": "ACTIVE_CONFIGURED"
    },
    "provider_campaign_id": {
      "type": "string",
      "pattern": "^[0-9]{1,30}$"
    },
    "spend_confirmed": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "plan_id",
    "operation",
    "state",
    "provider_campaign_id",
    "spend_confirmed"
  ],
  "additionalProperties": false
}
