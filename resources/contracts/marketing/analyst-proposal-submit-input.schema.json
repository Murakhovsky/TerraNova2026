{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "campaign_id",
    "creative_id",
    "campaign_revision",
    "creative_revision",
    "recommendation",
    "rationale",
    "evidence"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "creative_id": {
      "type": "string",
      "pattern": "^mkcr-[a-f0-9]{24}$"
    },
    "campaign_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "creative_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "recommendation": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4000
    },
    "rationale": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "source_type",
          "reference",
          "note"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "MANUAL_NOTE",
              "MARKETING_INSIGHT",
              "PRODUCT_REFERENCE"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 190
          },
          "note": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
