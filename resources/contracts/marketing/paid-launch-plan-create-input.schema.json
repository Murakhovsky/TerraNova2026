{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "campaign_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "adset_id": {
      "type": "string",
      "pattern": "^mkas-[a-f0-9]{24}$"
    },
    "adset_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "account_id": {
      "type": "string",
      "pattern": "^mads-[a-f0-9]{24}$"
    },
    "account_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "period_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "period_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "required": [
    "campaign_id",
    "campaign_revision",
    "adset_id",
    "adset_revision",
    "account_id",
    "account_revision",
    "period_start",
    "period_end"
  ],
  "additionalProperties": false
}
