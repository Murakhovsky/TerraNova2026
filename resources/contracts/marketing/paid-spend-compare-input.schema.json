{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^mkpl-[a-f0-9]{24}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^mis-[a-f0-9]{24}$"
    }
  },
  "required": [
    "plan_id",
    "snapshot_id"
  ],
  "additionalProperties": false
}
