{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^mkpl-[a-f0-9]{24}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "coverage": {
      "type": "string",
      "const": "CAPTURED_COHORT_ONLY"
    },
    "spend_basis": {
      "type": "string",
      "enum": [
        "UNAVAILABLE",
        "FINANCE_SETTLED_MEDIA_BUDGET"
      ]
    },
    "settlement_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^finr-[a-f0-9]{24}$"
    },
    "settled_media_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "captured_leads": {
      "type": "integer",
      "minimum": 0
    },
    "qualified_leads": {
      "type": "integer",
      "minimum": 0
    },
    "won_deals": {
      "type": "integer",
      "minimum": 0
    },
    "placed_orders": {
      "type": "integer",
      "minimum": 0
    },
    "lead_evidence_clean": {
      "type": "boolean"
    },
    "order_evidence_clean": {
      "type": "boolean"
    },
    "cost_per_captured_lead": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_per_captured_qualified_lead": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_per_captured_won_deal": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_per_captured_placed_order": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "confirmed_collection_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "collection_scope_complete": {
      "type": "boolean"
    },
    "net_collected_to_settled_media_spend": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "collection_basis": {
      "type": "string",
      "const": "CURRENT_READBACK_OF_PLACEMENT_COHORT"
    },
    "cac": {
      "type": "null"
    },
    "roas": {
      "type": "null"
    },
    "romi": {
      "type": "null"
    },
    "profit": {
      "type": "null"
    },
    "recognized_revenue": {
      "type": "null"
    },
    "causal_attribution": {
      "type": "boolean",
      "const": false
    },
    "complete_coverage": {
      "type": "boolean",
      "const": false
    },
    "conversion_through": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "captured_unique_outcomes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cost_per_captured_unique_outcome": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "campaign_id",
    "plan_id",
    "window_start",
    "window_end",
    "currency",
    "coverage",
    "spend_basis",
    "settlement_ref",
    "settled_media_minor",
    "captured_leads",
    "qualified_leads",
    "won_deals",
    "placed_orders",
    "lead_evidence_clean",
    "order_evidence_clean",
    "cost_per_captured_lead",
    "cost_per_captured_qualified_lead",
    "cost_per_captured_won_deal",
    "cost_per_captured_placed_order",
    "confirmed_collection_minor",
    "collection_scope_complete",
    "net_collected_to_settled_media_spend",
    "collection_basis",
    "cac",
    "roas",
    "romi",
    "profit",
    "recognized_revenue",
    "causal_attribution",
    "complete_coverage",
    "conversion_through",
    "captured_unique_outcomes",
    "cost_per_captured_unique_outcome"
  ],
  "additionalProperties": false
}
