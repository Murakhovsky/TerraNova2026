{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^mkar-[a-f0-9]{24}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "REJECT"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300
    }
  },
  "required": [
    "campaign_id",
    "run_id",
    "decision",
    "reason"
  ],
  "additionalProperties": false
}
