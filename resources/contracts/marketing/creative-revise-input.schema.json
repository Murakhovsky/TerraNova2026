{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "creative_id",
    "expected_revision",
    "headline",
    "primary_text",
    "call_to_action",
    "destination_url",
    "language"
  ],
  "properties": {
    "creative_id": {
      "type": "string",
      "pattern": "^mkcr-[a-f0-9]{24}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "headline": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "primary_text": {
      "type": "string",
      "minLength": 5,
      "maxLength": 2500
    },
    "call_to_action": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "destination_url": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 1200
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "product_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "media_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_spec": {
      "type": "object",
      "required": [
        "market_countries",
        "audience_hypothesis"
      ],
      "properties": {
        "market_countries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "audience_hypothesis": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "variant_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "location_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    }
  },
  "additionalProperties": false
}
