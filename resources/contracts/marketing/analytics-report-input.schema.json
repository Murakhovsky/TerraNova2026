{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "plan_id",
    "window_start",
    "window_end",
    "snapshot_ref",
    "reservation_id"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mkpl-[a-f0-9]{24}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "snapshot_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mis-[a-f0-9]{24}$"
    },
    "reservation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^finr-[a-f0-9]{24}$"
    }
  }
}
