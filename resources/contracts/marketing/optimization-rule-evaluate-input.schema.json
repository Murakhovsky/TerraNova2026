{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^mads-[a-f0-9]{24}$"
    },
    "external_id": {
      "type": "string",
      "pattern": "^[0-9]{1,30}$"
    },
    "current_run_id": {
      "type": "string",
      "pattern": "^mkar-[a-f0-9]{24}$"
    },
    "baseline_run_id": {
      "type": "string",
      "pattern": "^mkar-[a-f0-9]{24}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "baseline_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "baseline_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rule": {
      "type": "string",
      "enum": [
        "CTR_DECLINE",
        "CPC_INCREASE",
        "CPM_INCREASE"
      ]
    },
    "threshold_percent": {
      "type": "integer",
      "minimum": 20,
      "maximum": 200
    }
  },
  "required": [
    "account_id",
    "external_id",
    "current_run_id",
    "baseline_run_id",
    "window_start",
    "window_end",
    "baseline_start",
    "baseline_end",
    "rule",
    "threshold_percent"
  ],
  "additionalProperties": false
}
