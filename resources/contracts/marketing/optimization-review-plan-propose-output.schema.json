{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "pattern": "^goal-[a-f0-9]{24}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan-[a-f0-9]{24}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "existing",
        "proposed"
      ]
    },
    "evaluation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_recorded": {
      "type": "boolean",
      "const": false
    },
    "provider_mutation": {
      "type": "boolean",
      "const": false
    },
    "financial_mutation": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "goal_id",
    "plan_id",
    "state",
    "evaluation_hash",
    "review_recorded",
    "provider_mutation",
    "financial_mutation"
  ],
  "additionalProperties": false
}
