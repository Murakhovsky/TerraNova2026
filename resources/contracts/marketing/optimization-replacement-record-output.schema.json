{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^mkod-[a-f0-9]{24}$"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^mads-[a-f0-9]{24}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "BUDGET",
        "AUDIENCE"
      ]
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "source_plan_id": {
            "type": "string",
            "pattern": "^mkpl-[a-f0-9]{24}$"
          },
          "plan_id": {
            "type": "string",
            "pattern": "^mkpl-[a-f0-9]{24}$"
          },
          "plan_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "adset_id": {
            "type": "string",
            "pattern": "^mkas-[a-f0-9]{24}$"
          },
          "daily_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000000
          },
          "lifetime_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000000
          },
          "period_start": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "period_end": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "audience_id": {
            "type": "string",
            "pattern": "^mkau-[a-f0-9]{24}$"
          },
          "audience_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "source_plan_id",
          "plan_id",
          "plan_hash",
          "adset_id",
          "daily_minor",
          "lifetime_minor",
          "period_start",
          "period_end",
          "audience_id",
          "audience_revision"
        ],
        "additionalProperties": false
      }
    },
    "drafts_recorded": {
      "type": "boolean",
      "const": true
    },
    "provider_mutation": {
      "type": "boolean",
      "const": false
    },
    "financial_mutation": {
      "type": "boolean",
      "const": false
    },
    "paid_activation_approved": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "receipt_id",
    "receipt_hash",
    "decision_hash",
    "account_id",
    "mode",
    "plans",
    "drafts_recorded",
    "provider_mutation",
    "financial_mutation",
    "paid_activation_approved"
  ],
  "additionalProperties": false
}
