{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "const": "marketing_campaign"
    },
    "target_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "campaign_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000000
        },
        "creative_id": {
          "type": "string",
          "pattern": "^mkcr-[a-f0-9]{24}$"
        },
        "creative_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000000
        },
        "adset_id": {
          "type": "string",
          "pattern": "^mkas-[a-f0-9]{24}$"
        },
        "adset_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000000
        },
        "configuration_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "paid_plan_id": {
          "type": "string",
          "pattern": "^mkpl-[a-f0-9]{24}$"
        },
        "snapshot_ref": {
          "type": "string",
          "pattern": "^mis-[a-f0-9]{24}$"
        }
      },
      "required": [
        "campaign_revision",
        "creative_id",
        "creative_revision",
        "configuration_hash",
        "context_hash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "additionalProperties": false
}
