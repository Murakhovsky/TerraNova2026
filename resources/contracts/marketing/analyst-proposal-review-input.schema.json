{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "proposal_id",
    "expected_revision",
    "decision",
    "reason"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "pattern": "^mkpr-[a-f0-9]{24}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "decision": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "REJECT"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300
    }
  },
  "additionalProperties": false
}
