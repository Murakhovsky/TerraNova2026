{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^mkau-[a-f0-9]{24}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000000
          },
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 190
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 180
              },
              "target_spec": {
                "type": "object",
                "properties": {
                  "market_countries": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z]{2}$"
                    }
                  },
                  "audience_hypothesis": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 500
                  },
                  "verification_status": {
                    "type": "string",
                    "const": "UNVERIFIED"
                  },
                  "provider_eligible": {
                    "type": "boolean",
                    "const": false
                  }
                },
                "required": [
                  "market_countries",
                  "audience_hypothesis",
                  "verification_status",
                  "provider_eligible"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "target_spec"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "const": "DRAFT"
          },
          "launch_eligible": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "id",
          "revision",
          "actor_id",
          "content_hash",
          "content",
          "status",
          "launch_eligible"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
