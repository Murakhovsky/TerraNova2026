{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "plan_id",
    "window_start",
    "window_end",
    "offset"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^mkt-[a-f0-9]{24}$"
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mkpl-[a-f0-9]{24}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99900
    }
  }
}
