{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "status",
    "revision"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "status": {
      "const": "DRAFT"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
