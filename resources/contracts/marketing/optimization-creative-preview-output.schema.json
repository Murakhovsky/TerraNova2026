{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^mkex-[a-f0-9]{24}$"
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "const": "creative-observation-v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "INSUFFICIENT_EVIDENCE",
        "NO_MATERIAL_OBSERVED_DIFFERENCE",
        "REVIEW_OBSERVED_DIFFERENCE"
      ]
    },
    "factor": {
      "type": "string",
      "enum": [
        "HEADLINE",
        "PRIMARY_TEXT"
      ]
    },
    "metric": {
      "type": "string",
      "const": "TRAFFIC_CPC"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "control": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^mkpl-[a-f0-9]{24}$"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^mkt-[a-f0-9]{24}$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_ref": {
          "type": "string",
          "pattern": "^mis-[a-f0-9]{24}$"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_impressions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observed_clicks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reported_spend_decimal": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,6})?$"
        },
        "observed_cpc": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "current_daily_minor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "plan_id",
        "campaign_id",
        "plan_hash",
        "snapshot_ref",
        "source_revision",
        "source_hash",
        "observed_impressions",
        "observed_clicks",
        "reported_spend_decimal",
        "observed_cpc",
        "current_daily_minor"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^mkpl-[a-f0-9]{24}$"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^mkt-[a-f0-9]{24}$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_ref": {
          "type": "string",
          "pattern": "^mis-[a-f0-9]{24}$"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_impressions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observed_clicks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reported_spend_decimal": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,6})?$"
        },
        "observed_cpc": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "current_daily_minor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "plan_id",
        "campaign_id",
        "plan_hash",
        "snapshot_ref",
        "source_revision",
        "source_hash",
        "observed_impressions",
        "observed_clicks",
        "reported_spend_decimal",
        "observed_cpc",
        "current_daily_minor"
      ],
      "additionalProperties": false
    },
    "lower_observed_cpc_plan_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mkpl-[a-f0-9]{24}$"
    },
    "randomization_verified": {
      "type": "boolean",
      "const": false
    },
    "statistical_significance_confirmed": {
      "type": "boolean",
      "const": false
    },
    "causal_attribution": {
      "type": "boolean",
      "const": false
    },
    "winning_creative_confirmed": {
      "type": "boolean",
      "const": false
    },
    "provider_mutation": {
      "type": "boolean",
      "const": false
    },
    "financial_mutation": {
      "type": "boolean",
      "const": false
    },
    "paid_activation_approved": {
      "type": "boolean",
      "const": false
    },
    "approval_required_for_execution": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "experiment_id",
    "protocol_hash",
    "model",
    "status",
    "factor",
    "metric",
    "currency",
    "window_start",
    "window_end",
    "control",
    "candidate",
    "lower_observed_cpc_plan_id",
    "randomization_verified",
    "statistical_significance_confirmed",
    "causal_attribution",
    "winning_creative_confirmed",
    "provider_mutation",
    "financial_mutation",
    "paid_activation_approved",
    "approval_required_for_execution"
  ],
  "additionalProperties": false
}
