  "type": "object",
  "additionalProperties": false,
  "properties": {
    "q": {
      "type": "string",
      "maxLength": 120
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
