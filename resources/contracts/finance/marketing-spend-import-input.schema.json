{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "marketing_spend_snapshot"
    },
    "target_id": {
      "type": "string",
      "pattern": "^mis-[a-f0-9]{24}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "ad_account_ref",
        "source_snapshot_ref",
        "expected_source_revision",
        "expected_source_hash"
      ],
      "properties": {
        "ad_account_ref": {
          "type": "string",
          "pattern": "^mads-[a-f0-9]{24}$"
        },
        "source_snapshot_ref": {
          "type": "string",
          "pattern": "^mis-[a-f0-9]{24}$"
        },
        "expected_source_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000000
        },
        "expected_source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
