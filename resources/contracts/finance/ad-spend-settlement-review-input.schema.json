{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reservation_id",
    "document_ref",
    "snapshot_ref",
    "document_hash",
    "source_hash",
    "source_revision",
    "provider_document_id",
    "settlement_minor",
    "confirm_review"
  ],
  "properties": {
    "reservation_id": {
      "type": "string",
      "pattern": "^finr-[a-f0-9]{24}$"
    },
    "document_ref": {
      "type": "string",
      "pattern": "^DOC-[A-Za-z0-9_-]{8,76}$"
    },
    "snapshot_ref": {
      "type": "string",
      "pattern": "^mis-[a-f0-9]{24}$"
    },
    "document_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "provider_document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{3,190}$"
    },
    "settlement_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "confirm_review": {
      "type": "boolean",
      "const": true
    }
  }
}
