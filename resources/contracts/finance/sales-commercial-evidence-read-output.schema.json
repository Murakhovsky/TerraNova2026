{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "found": {
      "type": "boolean"
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "deal_id": {
          "type": "integer",
          "minimum": 1
        },
        "terms_version": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD",
            "EUR",
            "UAH"
          ]
        },
        "accepted_at": {
          "type": "string"
        },
        "terms_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "operator_recorded_accepted_offer"
          ]
        },
        "settled": {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      },
      "required": [
        "offer_id",
        "deal_id",
        "terms_version",
        "total",
        "currency",
        "accepted_at",
        "terms_hash",
        "evidence_kind",
        "settled"
      ]
    }
  },
  "required": [
    "found",
    "evidence"
  ]
}
