{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ad_account_ref",
    "window_start",
    "window_end",
    "timezone",
    "currency",
    "attribution_hash"
  ],
  "properties": {
    "ad_account_ref": {
      "type": "string",
      "pattern": "^mads-[a-f0-9]{24}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "attribution_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
