{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "operations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "capture",
              "refund",
              "chargeback",
              "chargeback_reversal"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{32}$"
          },
          "source_account": {
            "type": "string"
          },
          "source_reference": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "reconciliation_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{32}$"
          },
          "statement_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "reconciled_revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending_registration",
              "reconciled"
            ]
          }
        },
        "required": [
          "operation_id",
          "kind",
          "parent_id",
          "source_account",
          "source_reference",
          "created_at",
          "reconciliation_id",
          "statement_reference",
          "reconciled_revision",
          "amount",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "order_id",
    "revision",
    "operations",
    "has_more",
    "offset",
    "limit"
  ],
  "additionalProperties": false
}
