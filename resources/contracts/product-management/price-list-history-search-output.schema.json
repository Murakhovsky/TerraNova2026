{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagement price-list-history-search output V1",
  "type": "object",
  "required": [
    "items",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "revision",
          "old_amount",
          "new_amount",
          "actor_ref",
          "created_at"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "old_amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+\\.[0-9]{4}$"
          },
          "new_amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+\\.[0-9]{4}$"
          },
          "actor_ref": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "additionalProperties": false
}
