{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagement price-list-archive input V1",
  "type": "object",
  "required": [
    "list_id",
    "expected_revision"
  ],
  "properties": {
    "list_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
