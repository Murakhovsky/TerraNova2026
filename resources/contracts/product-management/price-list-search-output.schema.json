{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagement price-list-search output V1",
  "type": "object",
  "required": [
    "items",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "list_id",
          "code",
          "name",
          "kind",
          "currency"
        ],
        "properties": {
          "list_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "kind": {
            "type": "string",
            "enum": [
              "retail",
              "wholesale",
              "partner"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "additionalProperties": false
}
