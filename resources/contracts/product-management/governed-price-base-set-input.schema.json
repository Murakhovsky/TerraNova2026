{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed price-base-set input",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "product_governed_operation"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "variant_id",
        "currency",
        "amount",
        "expected_revision"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Za-z]{3}$"
        },
        "amount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 21,
          "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional optimistic revision; 0 means no existing price for this currency."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
