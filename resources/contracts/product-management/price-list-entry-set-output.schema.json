{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagement price-list-entry-set output V1",
  "type": "object",
  "required": [
    "list_id",
    "variant_id",
    "found",
    "currency",
    "price",
    "revision"
  ],
  "properties": {
    "list_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "found": {
      "type": "boolean"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "price": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]{4}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
