{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attribute-define input",
  "type": "object",
  "required": [
    "code",
    "name",
    "value_type"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 190
    },
    "value_type": {
      "type": "string",
      "enum": [
        "text",
        "decimal",
        "boolean",
        "enum"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
      },
      "maxItems": 50,
      "minItems": 0
    }
  },
  "additionalProperties": false
}
