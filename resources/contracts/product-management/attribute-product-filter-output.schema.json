{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attribute-product-filter output",
  "type": "object",
  "required": [
    "items",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "name",
          "status"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "additionalProperties": false
}
