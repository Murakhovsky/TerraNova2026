{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagementTranslationUpsertInputV1",
  "type": "object",
  "required": [
    "product_id",
    "locale",
    "name"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    }
  },
  "additionalProperties": false
}
