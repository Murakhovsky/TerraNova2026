{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Management price-resolve input V1",
  "type": "object",
  "required": [
    "variant_id",
    "currency",
    "quantity"
  ],
  "properties": {
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Za-z]{3}$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$"
    },
    "list_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    }
  },
  "additionalProperties": false
}
