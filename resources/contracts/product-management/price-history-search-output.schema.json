{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagementPriceHistorySearchOutputV1",
  "type": "object",
  "required": [
    "items",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "price_event_id",
          "old_amount",
          "new_amount",
          "actor_ref",
          "created_at"
        ],
        "properties": {
          "price_event_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "old_amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+\\.[0-9]{4}$"
          },
          "new_amount": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{4}$"
          },
          "actor_ref": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "limit": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
