{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attribute-product-set output",
  "type": "object",
  "required": [
    "found",
    "product_id",
    "revision",
    "items"
  ],
  "properties": {
    "found": {
      "type": "boolean"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "value_type",
          "unit",
          "choices",
          "is_required",
          "is_axis",
          "value",
          "missing_required"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 190
          },
          "value_type": {
            "type": "string",
            "enum": [
              "text",
              "decimal",
              "boolean",
              "enum"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
            },
            "maxItems": 50,
            "minItems": 0
          },
          "is_required": {
            "type": "boolean"
          },
          "is_axis": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "string",
              "boolean",
              "null"
            ]
          },
          "missing_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0
    }
  },
  "additionalProperties": false
}
