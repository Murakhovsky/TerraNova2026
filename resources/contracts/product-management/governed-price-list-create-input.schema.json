{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed price-list-create input",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "product_governed_operation"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "code",
        "name",
        "kind",
        "currency"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "kind": {
          "type": "string",
          "enum": [
            "retail",
            "wholesale",
            "partner"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Za-z]{3}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
