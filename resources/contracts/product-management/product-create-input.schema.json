{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMProductCreateV1",
  "type": "object",
  "required": [
    "name",
    "sku"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "sku": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "enum": [
        "stock",
        "material",
        "service",
        "digital"
      ]
    },
    "uom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "track_inventory": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
