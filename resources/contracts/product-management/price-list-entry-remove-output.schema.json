{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Management price-list-entry-remove output V1",
  "type": "object",
  "required": [
    "list_id",
    "variant_id",
    "found",
    "currency",
    "price",
    "revision"
  ],
  "properties": {
    "list_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "found": {
      "type": "boolean"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z]{3}$"
    },
    "price": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,4})?$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
