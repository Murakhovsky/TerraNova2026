{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attribute-product-set input",
  "type": "object",
  "required": [
    "product_id",
    "expected_revision",
    "values"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "value"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "value": {
            "type": [
              "string",
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 50,
      "minItems": 1
    }
  },
  "additionalProperties": false
}
