{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagementproduct-archiveInputV1",
  "type": "object",
  "required": [
    "product_id",
    "expected_revision"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
