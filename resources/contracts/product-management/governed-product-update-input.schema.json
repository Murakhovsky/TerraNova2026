{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed product-update input",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "product_governed_operation"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "product_id",
        "expected_revision"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "brand": {
          "type": "string",
          "maxLength": 190
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
