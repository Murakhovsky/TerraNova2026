{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "variant-matrix-create input",
  "type": "object",
  "required": [
    "product_id",
    "axes",
    "sku_prefix",
    "expected_revision"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "choices"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
            },
            "maxItems": 50,
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "maxItems": 4,
      "minItems": 1
    },
    "sku_prefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,59}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "uom": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
    },
    "track_inventory": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
