{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed category-create input",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "product_governed_operation"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "name",
        "slug"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 190,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "parent_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
