{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_id",
    "variant_id",
    "sku",
    "variants",
    "media_ids",
    "status"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "sku": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku",
          "variant_id"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "variant_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "additionalProperties": false
      }
    },
    "media_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$"
      }
    },
    "status": {
      "const": "draft"
    }
  },
  "additionalProperties": false
}
