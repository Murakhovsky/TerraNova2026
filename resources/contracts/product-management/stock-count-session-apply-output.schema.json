{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock count session apply-output",
  "type": "object",
  "required": [
    "session_id",
    "location_id",
    "source_ref",
    "action_key",
    "actor_ref",
    "row_count",
    "created_at",
    "rows"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "location_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^count:[A-Za-z0-9._:/-]{1,150}$"
    },
    "action_key": {
      "type": "string",
      "pattern": "^wf:[a-f0-9]{64}$"
    },
    "actor_ref": {
      "type": "string"
    },
    "row_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "created_at": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "count_id",
          "variant_id",
          "location_id",
          "source_ref",
          "counted",
          "previous_on_hand",
          "reserved",
          "delta",
          "expected_revision",
          "result_revision",
          "movement_id",
          "action_key",
          "actor_ref",
          "created_at"
        ],
        "properties": {
          "count_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "variant_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "location_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "source_ref": {
            "type": "string",
            "pattern": "^count:[A-Za-z0-9._:/-]{1,150}$"
          },
          "counted": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{6}$"
          },
          "previous_on_hand": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{6}$"
          },
          "reserved": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{6}$"
          },
          "delta": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{6}$"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "result_revision": {
            "type": "integer",
            "minimum": 0
          },
          "movement_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{32}$"
          },
          "action_key": {
            "type": "string",
            "pattern": "^wf:[a-f0-9]{64}$"
          },
          "actor_ref": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
