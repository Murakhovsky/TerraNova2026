{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed location-create input",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "product_governed_operation"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
