{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Management variant.update Input",
  "type": "object",
  "required": [
    "variant_id",
    "expected_revision"
  ],
  "properties": {
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "sku": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "barcode": {
      "type": "string",
      "maxLength": 128
    },
    "uom": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
    },
    "options": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 190
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
