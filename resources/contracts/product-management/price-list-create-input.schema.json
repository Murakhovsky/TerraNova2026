{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagement price-list-create input V1",
  "type": "object",
  "required": [
    "code",
    "name",
    "kind",
    "currency"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "kind": {
      "type": "string",
      "enum": [
        "retail",
        "wholesale",
        "partner"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Za-z]{3}$"
    }
  },
  "additionalProperties": false
}
