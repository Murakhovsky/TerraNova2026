{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analytics-quality-search input",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "missing_required",
        "no_media",
        "no_price",
        "no_category"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "required": [
    "currency",
    "kind"
  ],
  "additionalProperties": false
}
