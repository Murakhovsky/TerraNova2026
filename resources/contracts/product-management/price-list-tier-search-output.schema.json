{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Management price-list-tier-search output V1",
  "type": "object",
  "required": [
    "items",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "list_id",
          "variant_id",
          "currency",
          "min_quantity",
          "price",
          "revision"
        ],
        "properties": {
          "list_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "variant_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          },
          "min_quantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$"
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,4})?$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "additionalProperties": false
}
