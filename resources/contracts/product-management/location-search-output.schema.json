          "location_id",
          "code",
          "name",
          "status"
        ],
        "properties": {
          "location_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "limit": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
