{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed variant-create input",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "product_governed_operation"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "product_id",
        "sku"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "uom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "track_inventory": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
