{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product bulk attribute output",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "value": {
                  "type": [
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "code",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "product_id",
          "revision",
          "values"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
