{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagement media.attach InputV1",
  "type": "object",
  "required": [
    "product_id",
    "file_id"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "file_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "cover",
        "gallery"
      ]
    },
    "sort_order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    }
  },
  "additionalProperties": false
}
