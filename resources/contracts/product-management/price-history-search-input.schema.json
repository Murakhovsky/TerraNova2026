{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagementPriceHistorySearchInputV1",
  "type": "object",
  "required": [
    "variant_id",
    "currency"
  ],
  "properties": {
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Za-z]{3}$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "additionalProperties": false
}
