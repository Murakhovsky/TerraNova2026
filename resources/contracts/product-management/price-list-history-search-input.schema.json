{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagement price-list-history-search input V1",
  "type": "object",
  "required": [
    "list_id",
    "variant_id"
  ],
  "properties": {
    "list_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "additionalProperties": false
}
