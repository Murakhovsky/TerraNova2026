{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Count candidates output",
  "type": "object",
  "required": [
    "items",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "variant_id",
          "sku",
          "name",
          "on_hand",
          "reserved",
          "revision"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "on_hand": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{6}$"
          },
          "reserved": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{6}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "additionalProperties": false
}
