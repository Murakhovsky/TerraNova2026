{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Shopify draft writeback",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "shopify_draft_writeback"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "required": [
        "connection_id",
        "payload_digest"
      ],
      "properties": {
        "connection_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "collection_gids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^gid://shopify/Collection/[0-9]+$"
          }
        },
        "resync_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
