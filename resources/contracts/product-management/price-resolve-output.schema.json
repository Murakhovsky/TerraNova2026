{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Management price-resolve output V1",
  "type": "object",
  "required": [
    "variant_id",
    "list_id",
    "currency",
    "quantity",
    "source",
    "price",
    "min_quantity",
    "revision"
  ],
  "properties": {
    "variant_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "list_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{32}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Za-z]{3}$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$"
    },
    "source": {
      "type": "string",
      "enum": [
        "base",
        "list",
        "tier",
        "none"
      ]
    },
    "price": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,4})?$"
    },
    "min_quantity": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
