{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductManagementvariant-createInputV1",
  "type": "object",
  "required": [
    "product_id",
    "sku"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$"
    },
    "sku": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "uom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "track_inventory": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
