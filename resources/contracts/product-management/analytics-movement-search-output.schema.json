{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analytics-movement-search output",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "to": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "basis": {
      "type": "string",
      "enum": [
        "native_ledger_nontransfer_issues_over_endpoint_average"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variant_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "sku": {
            "type": "string"
          },
          "uom": {
            "type": "string"
          },
          "product_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "name": {
            "type": "string"
          },
          "opening_qty": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{6}$"
          },
          "closing_qty": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{6}$"
          },
          "receipts": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{6}$"
          },
          "issues": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{6}$"
          },
          "adjustments": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{6}$"
          },
          "transferred": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{6}$"
          },
          "movement_count": {
            "type": "integer",
            "minimum": 0
          },
          "physical_turnover": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+\\.[0-9]{6}$"
          }
        },
        "required": [
          "variant_id",
          "sku",
          "uom",
          "product_id",
          "name",
          "opening_qty",
          "closing_qty",
          "receipts",
          "issues",
          "adjustments",
          "transferred",
          "movement_count",
          "physical_turnover"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  },
  "required": [
    "from",
    "to",
    "basis",
    "items",
    "limit",
    "offset"
  ],
  "additionalProperties": false
}
