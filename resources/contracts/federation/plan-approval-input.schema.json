{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Federation Plan Approval Action Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id",
    "plan_id",
    "specification_version",
    "plan_hash"
  ],
  "properties": {
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "specification_version": {
      "type": "integer",
      "minimum": 1
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
