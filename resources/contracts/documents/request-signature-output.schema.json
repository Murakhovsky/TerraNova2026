{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requested signature receipt, not a signed document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signature_id",
    "status",
    "document_id",
    "signature_verified"
  ],
  "properties": {
    "signature_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "const": "requested"
    },
    "document_id": {
      "type": "string"
    },
    "signature_verified": {
      "type": "boolean",
      "const": false
    }
  }
}
