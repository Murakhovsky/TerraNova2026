{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native prepared proposal attachment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "relation_id",
    "sales_lead_id",
    "candidate_id",
    "status",
    "goal_outcome_verified"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "relation_id": {
      "type": "string"
    },
    "sales_lead_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "status": {
      "const": "prepared_not_sent"
    },
    "goal_outcome_verified": {
      "const": false
    }
  }
}
