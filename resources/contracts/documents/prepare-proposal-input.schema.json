{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Growth-to-Sales proposal draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "const": "sales_lead"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 18
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "template_id",
        "variables"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "template_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  }
}
