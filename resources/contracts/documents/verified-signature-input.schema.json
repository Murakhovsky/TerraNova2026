{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record provider verified human document signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "document_signature"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id"
      ],
      "properties": {
        "proof_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9:_-]+$"
        }
      }
    }
  }
}
