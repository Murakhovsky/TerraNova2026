{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticReportSummaryOutputV1",
  "type": "object",
  "required": [
    "session_id",
    "status",
    "report_version",
    "state_revision"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed"
      ]
    },
    "report_version": {
      "type": "integer",
      "minimum": 1
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
