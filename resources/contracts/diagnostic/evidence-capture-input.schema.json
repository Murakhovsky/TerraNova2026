{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticEvidenceCaptureInputV1",
  "type": "object",
  "required": [
    "session_id",
    "type",
    "title",
    "source"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "document",
        "interview",
        "system_data",
        "observation",
        "survey",
        "external_source"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "source_reference": {
      "type": "string",
      "maxLength": 512
    },
    "scope": {
      "type": "string",
      "maxLength": 191
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "reliability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "directness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "facts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "value": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 1024
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "value": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
