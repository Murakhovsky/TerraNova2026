{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sales.deal.outcome.record input v1",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "integer",
      "minimum": 1
    },
    "expected_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_stage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "won",
        "lost"
      ]
    },
    "lost_reason_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  },
  "required": [
    "deal_id",
    "expected_revision",
    "target_stage_id",
    "outcome"
  ],
  "additionalProperties": false
}
