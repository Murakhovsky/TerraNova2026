{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sales.deal.commercial.set input v1",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "integer",
      "minimum": 1
    },
    "expected_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deal_value": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "UAH"
      ]
    }
  },
  "required": [
    "deal_id",
    "expected_revision",
    "deal_value",
    "currency"
  ],
  "additionalProperties": false
}
