{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "shopify"
      ]
    },
    "connection_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "backfill",
        "webhooks"
      ]
    }
  },
  "required": [
    "channel",
    "connection_id",
    "mode"
  ],
  "additionalProperties": false
}
