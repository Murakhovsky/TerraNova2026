{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "self",
        "owner",
        "tenant"
      ]
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1
    },
    "pipeline_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,79}$"
    }
  },
  "required": [],
  "additionalProperties": false
}
