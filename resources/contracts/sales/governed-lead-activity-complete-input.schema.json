{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_type": {
      "type": "string",
      "const": "lead"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "lead_id": {
          "type": "integer",
          "minimum": 1
        },
        "activity_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "lead_id",
        "activity_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ]
}
