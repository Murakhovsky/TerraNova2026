{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_type": {
      "type": "string",
      "const": "sales_team_intent"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "title": "sales.team.manage input v1",
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "member_set"
          ]
        },
        "team_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,40}$"
        },
        "configuration_version": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{2,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DISABLED",
            "ARCHIVED"
          ]
        },
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "LEAD",
            "MEMBER"
          ]
        },
        "member_status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "INACTIVE"
          ]
        },
        "assignment_enabled": {
          "type": "boolean"
        },
        "approval_enabled": {
          "type": "boolean"
        },
        "assignment_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ]
}
