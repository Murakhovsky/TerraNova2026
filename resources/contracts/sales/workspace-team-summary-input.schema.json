{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,40}$"
    },
    "pipeline_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,79}$"
    }
  },
  "required": [
    "team_id"
  ],
  "additionalProperties": false
}
