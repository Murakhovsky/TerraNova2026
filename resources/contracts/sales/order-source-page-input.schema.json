{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "shopify"
      ]
    },
    "connection_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "channel",
    "connection_id"
  ],
  "additionalProperties": false
}
