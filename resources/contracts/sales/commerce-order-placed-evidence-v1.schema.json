{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "sales.commerce.order.placed"
      ]
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "order_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "deal_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "store_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "external_order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "UAH"
      ]
    },
    "order_total": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
    },
    "financial_evidence_reference": {
      "type": "null"
    },
    "realized_revenue": {
      "type": "null"
    },
    "attribution_observations": {
      "type": "object",
      "properties": {
        "touchpoint_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_medium": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_campaign": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_content": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_term": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "click_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "attribution_status": {
      "type": "string",
      "enum": [
        "unresolved"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "native_operator",
        "shopify_admin_read"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "organization_id",
    "order_id",
    "deal_id",
    "revision",
    "occurred_at",
    "channel",
    "store_reference",
    "external_order_id",
    "currency",
    "order_total",
    "financial_evidence_reference",
    "realized_revenue",
    "attribution_observations",
    "attribution_status",
    "provenance",
    "correlation_id"
  ],
  "additionalProperties": false
}
