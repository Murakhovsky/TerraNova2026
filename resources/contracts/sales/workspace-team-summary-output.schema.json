{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "object",
      "properties": {
        "team_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,40}$"
        },
        "member_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "pipeline_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "team_id",
        "member_count",
        "pipeline_id"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "active_deals": {
          "type": "integer",
          "minimum": 0
        },
        "followups_overdue": {
          "type": "integer",
          "minimum": 0
        },
        "deals_at_risk": {
          "type": "integer",
          "minimum": 0
        },
        "without_next_action": {
          "type": "integer",
          "minimum": 0
        },
        "monetary_deals": {
          "type": "integer",
          "minimum": 0
        },
        "weighted_deals": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "active_deals",
        "followups_overdue",
        "deals_at_risk",
        "without_next_action",
        "monetary_deals",
        "weighted_deals"
      ],
      "additionalProperties": false
    },
    "money_by_currency": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "UAH"
            ]
          },
          "deal_count": {
            "type": "integer",
            "minimum": 0
          },
          "pipeline_value": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "weighted_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "weighted_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "currency",
          "deal_count",
          "pipeline_value",
          "weighted_value",
          "weighted_count"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pipeline_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "deal_count": {
            "type": "integer",
            "minimum": 0
          },
          "monetary_deals": {
            "type": "integer",
            "minimum": 0
          },
          "money_by_currency": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string",
                  "enum": [
                    "USD",
                    "EUR",
                    "UAH"
                  ]
                },
                "deal_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "pipeline_value": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                },
                "weighted_value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "weighted_count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "currency",
                "deal_count",
                "pipeline_value",
                "weighted_value",
                "weighted_count"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "pipeline_id",
          "stage_id",
          "deal_count",
          "monetary_deals",
          "money_by_currency"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scope",
    "counts",
    "money_by_currency",
    "stages"
  ],
  "additionalProperties": false
}
