{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "deal_id": {
      "type": "integer",
      "minimum": 1
    },
    "offer_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "target_status": {
      "type": "string",
      "enum": [
        "presented",
        "accepted",
        "rejected",
        "withdrawn",
        "expired"
      ]
    },
    "evidence_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "deal_id",
    "offer_id",
    "expected_revision",
    "target_status"
  ]
}
