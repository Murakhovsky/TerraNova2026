{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "self",
        "owner",
        "tenant"
      ]
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1
    },
    "deal_id": {
      "type": "integer",
      "minimum": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "deal_id"
  ],
  "additionalProperties": false
}
