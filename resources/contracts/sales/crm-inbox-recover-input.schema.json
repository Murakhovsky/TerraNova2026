{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SalesCrmInboxRecoverInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inbox_id",
    "revision",
    "reason"
  ],
  "properties": {
    "inbox_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "mapping_repaired",
        "configuration_repaired",
        "transient_failure_resolved"
      ]
    }
  }
}
