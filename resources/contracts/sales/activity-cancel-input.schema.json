{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "integer",
      "minimum": 1
    },
    "activity_id": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "deal_id",
    "activity_id",
    "reason"
  ],
  "additionalProperties": false
}
