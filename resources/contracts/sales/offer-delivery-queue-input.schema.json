{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "offer"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "terms_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "document_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipient_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "expected_revision",
        "terms_hash",
        "document_hash",
        "recipient_hash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "additionalProperties": false
}
