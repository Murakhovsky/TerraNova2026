{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "has_more",
    "scope"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_id",
          "owner_id",
          "deal_id",
          "status",
          "channel",
          "currency",
          "total",
          "placed_at"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "owner_id": {
            "type": "integer",
            "minimum": 1
          },
          "deal_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "total": {
            "type": "string"
          },
          "placed_at": {
            "type": "string"
          }
        }
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "enum": [
        "self",
        "owner",
        "tenant",
        "team"
      ]
    }
  }
}
