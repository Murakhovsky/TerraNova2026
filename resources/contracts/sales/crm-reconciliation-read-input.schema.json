{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "integer",
      "minimum": 1
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "task",
        "followup",
        "message"
      ]
    },
    "operation_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    }
  },
  "required": [
    "deal_id",
    "provider",
    "kind",
    "operation_key"
  ],
  "additionalProperties": false
}
