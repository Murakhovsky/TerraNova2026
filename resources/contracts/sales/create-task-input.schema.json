{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sales Create Task Action Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "const": "deal"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "body": {
          "type": "string"
        },
        "due_at": {
          "type": "string",
          "format": "date-time"
        },
        "due_in_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
