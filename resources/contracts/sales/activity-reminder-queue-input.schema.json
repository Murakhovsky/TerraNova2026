{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "lead",
        "deal"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "activity_id": {
          "type": "integer",
          "minimum": 1
        },
        "expected_due_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
        },
        "expected_owner_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "activity_id",
        "expected_due_at",
        "expected_owner_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "additionalProperties": false
}
