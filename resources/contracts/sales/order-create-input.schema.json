{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "UAH"
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "unit_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
          },
          "product_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
          },
          "variant_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
          }
        },
        "required": [
          "sku",
          "title",
          "quantity",
          "unit_price"
        ],
        "additionalProperties": false
      }
    },
    "discount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
    },
    "tax": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
    },
    "shipping": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
    },
    "total": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
    },
    "deal_id": {
      "type": "integer",
      "minimum": 1
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1
    },
    "attribution": {
      "type": "object",
      "properties": {
        "touchpoint_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_medium": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_campaign": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_content": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "utm_term": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        },
        "click_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~%+-]{0,190}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "tax_included": {
      "type": "boolean"
    },
    "customer_id": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "currency",
    "lines",
    "total"
  ],
  "additionalProperties": false
}
