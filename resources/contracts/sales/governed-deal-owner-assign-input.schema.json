{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_type": {
      "type": "string",
      "const": "deal"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "parameters": {
      "title": "sales.deal.owner.assign input v1",
      "type": "object",
      "properties": {
        "deal_id": {
          "type": "integer",
          "minimum": 1
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owner_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "deal_id",
        "expected_revision",
        "owner_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ]
}
