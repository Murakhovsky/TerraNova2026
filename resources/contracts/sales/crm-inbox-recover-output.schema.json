{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SalesCrmInboxRecoverOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inbox_id",
    "requeued",
    "replayed"
  ],
  "properties": {
    "inbox_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "requeued": {
      "type": "boolean",
      "const": true
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
