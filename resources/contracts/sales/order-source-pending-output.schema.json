{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deliveries": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "delivery_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 190
          },
          "external_order_id": {
            "type": "string",
            "pattern": "^gid://shopify/Order/[1-9][0-9]{0,18}$"
          },
          "topic": {
            "type": "string",
            "pattern": "^orders/"
          }
        },
        "required": [
          "delivery_id",
          "external_order_id",
          "topic"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "deliveries"
  ],
  "additionalProperties": false
}
