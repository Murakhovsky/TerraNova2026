{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "self",
        "owner",
        "tenant"
      ]
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "viewing_planned",
        "viewing",
        "negotiation",
        "won",
        "lost",
        "disqualified",
        "spam",
        "closed"
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
