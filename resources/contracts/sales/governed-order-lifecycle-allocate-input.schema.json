{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "const": "sales_order"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,119}$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "line_no": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "location_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{32}$"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "line_no",
              "location_id",
              "quantity"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "order_id",
        "expected_revision",
        "reference",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "additionalProperties": false
}
