{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "found": {
      "type": "boolean"
    },
    "offer": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "deal_id": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "presented",
            "accepted",
            "rejected",
            "withdrawn",
            "expired"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "terms_version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD",
            "EUR",
            "UAH"
          ]
        },
        "total": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
        },
        "valid_until": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "service",
                  "product",
                  "property"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "unit_price": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              },
              "product_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "variant_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "inventory_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "line_total": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              },
              "reference_snapshot": {
                "type": "object"
              }
            },
            "required": [
              "kind",
              "title",
              "quantity",
              "unit_price",
              "line_total",
              "reference_snapshot"
            ]
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "sales",
            "customer"
          ]
        },
        "terms_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "offer_id",
        "deal_id",
        "status",
        "revision",
        "terms_version",
        "title",
        "currency",
        "total",
        "valid_until",
        "lines",
        "direction",
        "terms_hash",
        "accepted_at"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "terms_version": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string"
          },
          "from_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_status": {
            "type": "string",
            "enum": [
              "draft",
              "presented",
              "accepted",
              "rejected",
              "withdrawn",
              "expired"
            ]
          },
          "has_evidence": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_id": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "revision",
          "terms_version",
          "kind",
          "from_status",
          "to_status",
          "has_evidence",
          "note",
          "actor_id",
          "created_at"
        ]
      }
    },
    "terms_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "terms_version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "UAH"
            ]
          },
          "total": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
          },
          "valid_until": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "service",
                    "product",
                    "property"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "unit_price": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
                },
                "product_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "variant_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "inventory_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "line_total": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
                },
                "reference_snapshot": {
                  "type": "object"
                }
              },
              "required": [
                "kind",
                "title",
                "quantity",
                "unit_price",
                "line_total",
                "reference_snapshot"
              ]
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "sales",
              "customer"
            ]
          },
          "terms_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "terms_version",
          "title",
          "currency",
          "total",
          "valid_until",
          "lines",
          "direction",
          "terms_hash"
        ]
      }
    }
  },
  "required": [
    "found",
    "offer",
    "history",
    "terms_history"
  ]
}
