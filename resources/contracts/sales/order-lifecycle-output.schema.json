{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "placed",
        "confirmed",
        "cancelled",
        "completed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "inventory_authority": {
      "type": "string",
      "enum": [
        "local",
        "external_review"
      ]
    },
    "ordered_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "allocated_pending_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "fulfilled_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "returned_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "cancelled_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "unallocated_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "fulfillment_state": {
      "type": "string",
      "enum": [
        "unfulfilled",
        "partial",
        "fulfilled",
        "external_review"
      ]
    },
    "return_state": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "returned"
      ]
    },
    "allocations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "allocation_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "line_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "location_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{32}$"
          },
          "reservation_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{32}$"
          },
          "stock_mode": {
            "type": "string",
            "enum": [
              "local",
              "nonstock"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "fulfilled": {
            "type": "integer",
            "minimum": 0
          },
          "cancelled": {
            "type": "integer",
            "minimum": 0
          },
          "returned": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "allocation_id",
          "line_no",
          "location_id",
          "reservation_id",
          "stock_mode",
          "quantity",
          "fulfilled",
          "cancelled",
          "returned"
        ],
        "additionalProperties": false
      }
    },
    "replayed": {
      "type": "boolean"
    },
    "external_observation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "provider_fulfillment_status": {
          "type": "string"
        },
        "provider_financial_status": {
          "type": "string"
        },
        "provider_cancelled_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "reconciliation_outcome": {
          "type": "string"
        },
        "review_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "fulfillment_evidence": {
          "type": "object",
          "properties": {
            "provider_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provider_updated_at": {
              "type": "string",
              "format": "date-time"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "current_order_revision": {
              "type": "boolean"
            },
            "assignment_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "unmapped_locations": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^gid://shopify/Location/[1-9][0-9]{0,18}$"
              }
            },
            "inventory_authority": {
              "const": "external_review"
            },
            "physical_commitment_verified": {
              "const": false
            },
            "local_stock_write_allowed": {
              "const": false
            }
          },
          "required": [
            "provider_hash",
            "provider_updated_at",
            "observed_at",
            "current_order_revision",
            "assignment_count",
            "unmapped_locations",
            "inventory_authority",
            "physical_commitment_verified",
            "local_stock_write_allowed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source_id",
        "provider_updated_at",
        "provider_fulfillment_status",
        "provider_financial_status",
        "provider_cancelled_at",
        "reconciliation_outcome",
        "review_reason"
      ],
      "additionalProperties": false
    },
    "financial_review": {
      "type": "object",
      "properties": {
        "collection_state": {
          "type": "string",
          "enum": [
            "unverified",
            "zero_net",
            "partial",
            "equal_to_placed",
            "above_placed"
          ]
        },
        "currency": {
          "type": "string",
          "enum": [
            "EUR",
            "USD",
            "UAH"
          ]
        },
        "placed_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
        },
        "net_collected_amount": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
        },
        "finance_evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{32}$"
        },
        "finance_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "review_required": {
          "type": "boolean"
        },
        "review_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "cancelled_order",
              "returned_items",
              "external_order",
              "chargeback",
              "excess_collection"
            ]
          }
        }
      },
      "required": [
        "collection_state",
        "currency",
        "placed_amount",
        "net_collected_amount",
        "finance_evidence_reference",
        "finance_revision",
        "review_required",
        "review_reasons"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "order_id",
    "status",
    "revision",
    "inventory_authority",
    "ordered_quantity",
    "allocated_pending_quantity",
    "fulfilled_quantity",
    "returned_quantity",
    "cancelled_quantity",
    "unallocated_quantity",
    "fulfillment_state",
    "return_state",
    "allocations",
    "replayed",
    "external_observation"
  ],
  "additionalProperties": false
}
