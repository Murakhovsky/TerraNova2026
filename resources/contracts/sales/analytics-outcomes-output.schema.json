{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "from": {
      "type": "string"
    },
    "to_exclusive": {
      "type": "string"
    },
    "owner_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pipeline_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "basis": {
      "type": "string",
      "enum": [
        "first_recorded_terminal_event"
      ]
    },
    "won_count": {
      "type": "integer",
      "minimum": 0
    },
    "lost_count": {
      "type": "integer",
      "minimum": 0
    },
    "win_rate_percent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]{2}$"
    },
    "unattributed_count": {
      "type": "integer",
      "minimum": 0
    },
    "won_without_booked_value": {
      "type": "integer",
      "minimum": 0
    },
    "booked_by_currency": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "UAH"
            ]
          },
          "deal_count": {
            "type": "integer",
            "minimum": 0
          },
          "booked_value": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          }
        },
        "required": [
          "currency",
          "deal_count",
          "booked_value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "from",
    "to_exclusive",
    "owner_id",
    "pipeline_id",
    "basis",
    "won_count",
    "lost_count",
    "win_rate_percent",
    "unattributed_count",
    "won_without_booked_value",
    "booked_by_currency"
  ],
  "additionalProperties": false
}
