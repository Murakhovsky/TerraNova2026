{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_type": {
      "type": "string",
      "const": "deal"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deal_id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD",
            "EUR",
            "UAH"
          ]
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "service",
                  "product",
                  "property"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "unit_price": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              },
              "product_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "variant_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "inventory_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              }
            },
            "required": [
              "kind",
              "title",
              "quantity",
              "unit_price"
            ]
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "deal_id",
        "title",
        "currency",
        "valid_until",
        "lines"
      ]
    }
  },
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ]
}
