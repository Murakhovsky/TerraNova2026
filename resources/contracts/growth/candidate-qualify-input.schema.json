{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Federation Growth policy evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "const": "growth_candidate"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_revision"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
