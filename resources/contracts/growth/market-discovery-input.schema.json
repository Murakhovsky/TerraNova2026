{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Federation Growth market discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "const": "growth_market_universe",
      "type": "string"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    }
  }
}
