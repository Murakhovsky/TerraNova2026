{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyBulkCreateActionInputV1",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "parameters"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "const": "property_bulk_batch"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "parameters": {
      "type": "object",
      "required": [
        "batch_digest"
      ],
      "properties": {
        "batch_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
