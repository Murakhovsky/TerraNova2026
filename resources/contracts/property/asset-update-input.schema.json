{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyAssetUpdateInputV1",
  "type": "object",
  "required": [
    "reference",
    "patch"
  ],
  "properties": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "patch": {
      "type": "object",
      "properties": {
        "type_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type_reference_id": {
          "type": "integer"
        },
        "country_code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "region": {
          "type": "string",
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "maxLength": 200
        },
        "district": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 400
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "lifecycle": {
          "type": "string"
        },
        "area_total": {
          "type": "number",
          "minimum": 0
        },
        "area_living": {
          "type": "number",
          "minimum": 0
        },
        "land_area": {
          "type": "number",
          "minimum": 0
        },
        "rooms": {
          "type": "number",
          "minimum": 0
        },
        "floor": {
          "type": "integer"
        },
        "floors": {
          "type": "integer",
          "minimum": 0
        },
        "built_year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
