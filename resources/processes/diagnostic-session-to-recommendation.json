{
  "schema_version": 4,
  "id": "diagnostic.session-to-recommendation",
  "title": "Diagnostic Session → Recommendation",
  "domain": "diagnostic",
  "state": "as-is",
  "workflow": "02-workflows/diagnostic-session-to-recommendation.md",
  "trigger": "A published methodology version is selected for a diagnostic target",
  "outcomes": [
    "Version-pinned diagnostic session is completed or canceled",
    "Evidence-backed findings and recommendations are recorded",
    "Recommendation decision remains traceable to the session"
  ],
  "actors": [
    "methodology author",
    "diagnostic operator / interviewer",
    "respondent",
    "Diagnostic AI boundary",
    "deterministic evaluation engine",
    "reviewer / decision maker"
  ],
  "steps": [
    {
      "id": "methodology",
      "label": "Draft and publish methodology version",
      "kind": "operation",
      "owner": "methodology author",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": true,
      "runtime": [
        { "type": "use_case", "ref": "DraftDiagnosticPack" },
        { "type": "use_case", "ref": "PublishDiagnosticPack" }
      ]
    },
    {
      "id": "revision",
      "label": "Revise published methodology into a new draft",
      "kind": "operation",
      "owner": "methodology author",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": false,
      "runtime": [
        { "type": "use_case", "ref": "ReviseDiagnosticPack" }
      ]
    },
    {
      "id": "session",
      "label": "Start version-pinned session",
      "kind": "operation",
      "owner": "diagnostic operator / interviewer",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": true,
      "runtime": [
        { "type": "use_case", "ref": "StartDiagnosticSession" }
      ]
    },
    {
      "id": "evidence",
      "label": "Capture evidence",
      "kind": "operation",
      "owner": "diagnostic operator / interviewer",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": true,
      "runtime": [
        { "type": "use_case", "ref": "CaptureDiagnosticEvidence" }
      ]
    },
    {
      "id": "evaluation",
      "label": "Evaluate structured evidence",
      "kind": "operation",
      "owner": "deterministic evaluation engine",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": true,
      "runtime": [
        { "type": "use_case", "ref": "EvaluateDiagnosticSession" }
      ]
    },
    {
      "id": "result",
      "label": "Record findings and recommendation",
      "kind": "state",
      "owner": "deterministic evaluation engine",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": true,
      "runtime": [
        { "type": "use_case", "ref": "RecordDiagnosticResult" }
      ]
    },
    {
      "id": "complete",
      "label": "Complete coherent session",
      "kind": "operation",
      "owner": "diagnostic operator / interviewer",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": true,
      "runtime": [
        { "type": "use_case", "ref": "CompleteDiagnosticSession" }
      ]
    },
    {
      "id": "cancelled",
      "label": "Cancel non-terminal session",
      "kind": "outcome",
      "owner": "diagnostic operator / interviewer",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": true,
      "runtime": [
        { "type": "use_case", "ref": "CancelDiagnosticSession" }
      ]
    },
    {
      "id": "decision",
      "label": "Review / accept recommendation",
      "kind": "decision",
      "owner": "reviewer / decision maker",
      "domain": "diagnostic",
      "capability": null,
      "capability_gap": "missing-domain-capability",
      "critical": true,
      "runtime": [
        { "type": "use_case", "ref": "AcceptDiagnosticRecommendation" }
      ]
    }
  ],
  "edges": [
    { "from": "methodology", "to": "revision", "label": "revision required" },
    { "from": "revision", "to": "methodology", "label": "publish new version" },
    { "from": "methodology", "to": "session", "label": "select published version" },
    { "from": "session", "to": "evidence" },
    { "from": "session", "to": "cancelled", "label": "cancel" },
    { "from": "evidence", "to": "evaluation" },
    { "from": "evidence", "to": "cancelled", "label": "cancel" },
    { "from": "evaluation", "to": "evidence", "label": "insufficient evidence" },
    { "from": "evaluation", "to": "result", "label": "sufficient" },
    { "from": "evaluation", "to": "cancelled", "label": "cancel" },
    { "from": "result", "to": "complete" },
    { "from": "result", "to": "cancelled", "label": "cancel before terminal" },
    { "from": "complete", "to": "decision" }
  ]
}
