      "kind": "operation",
      "owner": "Approved Product Action worker",
      "domain": "product_management",
      "capability": "product_management.governed.variant.matrix.create",
      "critical": true,
      "runtime": [
        {
          "type": "source",
          "path": "app/Domains/ProductManagement/Automation/Action/ProductGovernedOperationHandler.php",
          "symbol": "'variant.matrix.create'=>$this->products->createMatrix"
        }
      ]
    },
    {
      "id": "bulk",
      "label": "Patch known Product attributes",
      "kind": "operation",
      "owner": "Approved Product Action worker",
      "domain": "product_management",
      "capability": "product_management.governed.attribute.product.bulk_set",
      "critical": true,
      "runtime": [
        {
          "type": "source",
          "path": "app/Domains/ProductManagement/Automation/Action/ProductGovernedOperationHandler.php",
          "symbol": "'attribute.product.bulk_set'=>$this->products->bulkSetAttributes"
