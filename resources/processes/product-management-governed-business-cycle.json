  "edges": [
    {
      "from": "receive",
      "to": "price"
    },
    {
      "from": "price",
      "to": "reserve"
    },
    {
      "from": "reserve",
      "to": "issue"
    },
    {
      "from": "issue",
      "to": "create"
    },
    {
      "from": "create",
      "to": "matrix"
    },
    {
      "from": "matrix",
      "to": "bulk"
    },
    {
      "from": "bulk",
      "to": "release"
    },
    {
      "from": "release",
      "to": "assemble"
    }
  ]
