    {
      "id": "assemble",
      "label": "Assemble a complete draft Product",
      "kind": "operation",
      "owner": "Approved Product Action worker",
      "domain": "product_management",
      "capability": "product_management.governed.product.assemble",
      "critical": true,
      "runtime": [
        {
          "type": "source",
          "path": "app/Domains/ProductManagement/Application/Service/ProductAssemblyService.php",
          "symbol": "public function assemble"
        }
      ]
    }
