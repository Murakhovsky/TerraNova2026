$managerAgent = $managerWorkspace['agent'] ?? null;
$attentionProperties = (array) ($managerWorkspace['attention_properties'] ?? []);
$recentProperties = (array) ($managerWorkspace['recent_properties'] ?? []);
$managerPath = static function (array $params = []) use ($managerScope): string {
    $query = array_merge($managerScope, $params);
    foreach ($query as $key => $value) {
        if ($value === '' || $value === 0 || $value === '0' || $value === null) {
            unset($query[$key]);
        }
    }

    return 'property/manage' . ($query ? '?' . http_build_query($query) : '');
};
