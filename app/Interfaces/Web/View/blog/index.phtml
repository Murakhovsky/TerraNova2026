<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$blog = $blog ?? ['items' => [], 'page' => 1, 'pages' => 1, 'total' => 0];
?>

<?php $this->partial('shared/public_header', ['active' => 'blog', 'actions' => [
    ['href' => 'property/catalog', 'label' => 'Каталог', 'class' => 'tn-btn--ghost'],
    ['href' => 'contacts', 'label' => 'Залишити запит', 'class' => 'tn-btn--dark'],
]]); ?>

<main class="tn-page tn-blog-page">
  <nav class="tn-breadcrumbs"><a href="<?php echo $this->url->get(); ?>">Головна</a><span>/</span><span>Блог</span></nav>
  <section class="tn-page-hero">
    <div><p class="tn-kicker">Terra Nova Journal</p><h1>Блог про нерухомість</h1><p>Практичні матеріали про вибір, продаж, підготовку та управління об’єктами.</p></div>
    <div class="tn-page-hero__meta"><strong><?php echo (int) $blog['total']; ?></strong><span>опублікованих матеріалів</span></div>
  </section>

  <?php if (!$blog['items']): ?>
    <section class="tn-empty-state"><h2>Матеріали готуються</h2><p>Нові статті з’являться після редакційної перевірки.</p></section>
  <?php else: ?>
    <section class="tn-blog-grid">
      <?php foreach ($blog['items'] as $article): ?>
        <article class="tn-blog-card">
          <a class="tn-blog-card__media" href="<?php echo $this->url->get('blog/' . $article['slug']); ?>">
            <?php if (!empty($article['featured_image_url'])): ?><img src="<?php echo $h($article['featured_image_url']); ?>" alt="<?php echo $h($article['featured_image_alt'] ?: $article['title']); ?>" loading="lazy"><?php else: ?><span>Terra Nova</span><?php endif; ?>
          </a>
          <div>
            <p class="tn-kicker"><?php echo $h($article['category'] ?: 'Нерухомість'); ?></p>
            <h2><a href="<?php echo $this->url->get('blog/' . $article['slug']); ?>"><?php echo $h($article['title']); ?></a></h2>
            <p><?php echo $h($article['excerpt']); ?></p>
            <span><?php echo $h(date('d.m.Y', strtotime((string) $article['published_at']))); ?></span>
          </div>
        </article>
      <?php endforeach; ?>
    </section>
  <?php endif; ?>

  <?php if ((int) $blog['pages'] > 1): ?>
    <nav class="tn-pagination" aria-label="Сторінки блогу">
      <?php for ($page = 1; $page <= (int) $blog['pages']; $page++): ?><a class="<?php echo $page === (int) $blog['page'] ? 'is-active' : ''; ?>" href="<?php echo $this->url->get('blog?page=' . $page); ?>"><?php echo $page; ?></a><?php endfor; ?>
    </nav>
  <?php endif; ?>
</main>

<?php $this->partial('shared/public_footer'); ?>
