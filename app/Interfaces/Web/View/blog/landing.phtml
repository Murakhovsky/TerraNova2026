      <div><p class="tn-ui-eyebrow">Запит</p><h2>Отримайте актуальну добірку від менеджера</h2></div>
      <?php $this->partial('components/ui/action_bar', [
          'actions' => [['label' => 'Залишити контакт', 'href' => 'contacts', 'variant' => 'primary']],
          'align' => 'end',
          'ariaLabel' => 'Запит менеджеру',
      ]); ?>
    </div>
  </section>
</main>

<script type="application/ld+json"><?php echo json_encode($schema, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?></script>
