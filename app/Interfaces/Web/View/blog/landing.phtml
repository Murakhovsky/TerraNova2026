$schema = !empty($landing['schema_json']) ? json_decode((string) $landing['schema_json'], true) : [
    '@context' => 'https://schema.org', '@type' => 'WebPage', 'name' => $landing['title'] ?? '',
    'description' => $landing['meta_description'] ?: $landing['excerpt'],
];
?>

<?php $this->partial('shared/public_header', ['active' => 'catalog', 'actions' => [
    ['href' => 'property/catalog', 'label' => 'Каталог', 'class' => 'tn-btn--ghost'],
    ['href' => 'contacts', 'label' => 'Отримати добірку', 'class' => 'tn-btn--dark'],
]]); ?>

<main class="tn-page tn-seo-landing">
  <?php $this->partial('components/ui/page_header', [
      'eyebrow' => $landing['category'] ?: 'Нерухомість',
      'title' => $landing['title'],
      'description' => $landing['excerpt'],
      'actions' => [
          ['label' => 'Переглянути об’єкти', 'href' => 'property/catalog', 'variant' => 'primary'],
          ['label' => 'Підібрати варіанти', 'href' => 'contacts', 'variant' => 'ghost'],
      ],
  ]); ?>

  <?php if (!empty($landing['featured_image_url'])): ?>
    <figure class="tn-seo-landing__media">
      <img src="<?php echo $h($landing['featured_image_url']); ?>" alt="<?php echo $h($landing['featured_image_alt'] ?: $landing['title']); ?>">
    </figure>
  <?php endif; ?>

  <article class="tn-article"><div class="tn-article__body"><?php echo $landing['body_html']; ?></div></article>

  <section class="tn-ui-panel">
