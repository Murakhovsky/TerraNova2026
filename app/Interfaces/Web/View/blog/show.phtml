<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$article = $article ?? [];
$related = $related ?? [];
$schema = !empty($article['schema_json']) ? json_decode((string) $article['schema_json'], true) : [
    '@context' => 'https://schema.org', '@type' => 'Article',
    'headline' => $article['title'] ?? '', 'description' => $article['meta_description'] ?: $article['excerpt'],
    'image' => array_values(array_filter([$article['featured_image_url'] ?? null])),
    'datePublished' => $article['published_at'] ?? null, 'dateModified' => $article['updated_at'] ?? null,
    'author' => ['@type' => 'Organization', 'name' => 'Terra Nova CLUB'],
    'publisher' => ['@type' => 'Organization', 'name' => 'Terra Nova CLUB'],
];
?>

<?php $this->partial('shared/public_header', ['active' => 'blog', 'actions' => [
    ['href' => 'property/catalog', 'label' => 'Каталог', 'class' => 'tn-btn--ghost'],
    ['href' => 'contacts', 'label' => 'Консультація', 'class' => 'tn-btn--dark'],
]]); ?>

<main class="tn-page tn-article-page">
  <article class="tn-article">
    <header class="tn-article__header">
      <p class="tn-kicker"><?php echo $h($article['category'] ?: 'Нерухомість'); ?></p>
      <h1><?php echo $h($article['title']); ?></h1>
      <p><?php echo $h($article['excerpt']); ?></p>
      <span><?php echo $h(date('d.m.Y', strtotime((string) $article['published_at']))); ?><?php if (!empty($article['author_name'])): ?> / <?php echo $h($article['author_name']); ?><?php endif; ?></span>
    </header>
    <?php if (!empty($article['featured_image_url'])): ?><figure class="tn-article__cover"><img src="<?php echo $h($article['featured_image_url']); ?>" alt="<?php echo $h($article['featured_image_alt'] ?: $article['title']); ?>"></figure><?php endif; ?>
    <div class="tn-article__body"><?php echo $article['body_html']; ?></div>
    <?php if (!empty($article['tags'])): ?><footer class="tn-article__tags"><?php foreach ($article['tags'] as $tag): ?><span><?php echo $h($tag); ?></span><?php endforeach; ?></footer><?php endif; ?>
  </article>

  <section class="tn-ui-panel">
    <div class="tn-ui-panel__head">
      <div>
        <p class="tn-ui-eyebrow">Практичний крок</p>
        <h2>Потрібна нерухомість або консультація?</h2>
      </div>
      <?php $this->partial('components/ui/action_bar', [
        'actions' => [
          ['label' => 'Каталог', 'href' => 'property/catalog', 'variant' => 'primary'],
          ['label' => 'Залишити запит', 'href' => 'contacts', 'variant' => 'ghost'],
        ],
        'align' => 'end',
        'ariaLabel' => 'Наступний крок',
      ]); ?>
    </div>
  </section>

  <?php if ($related): ?>
    <section class="tn-ui-panel tn-related-content">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Далі</p><h2>Останні матеріали</h2></div></div>
      <div class="tn-ui-panel__body">
        <div class="tn-blog-grid"><?php foreach ($related as $item): ?><article class="tn-blog-card"><div><p class="tn-kicker"><?php echo $h($item['category'] ?: 'Нерухомість'); ?></p><h3><a href="<?php echo $this->url->get('blog/' . $item['slug']); ?>"><?php echo $h($item['title']); ?></a></h3><p><?php echo $h($item['excerpt']); ?></p></div></article><?php endforeach; ?></div>
      </div>
    </section>
  <?php endif; ?>
</main>

<script type="application/ld+json"><?php echo json_encode($schema, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?></script>
<?php $this->partial('shared/public_footer'); ?>
