<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$items = is_array($items ?? null) ? $items : [];
$stats = is_array($stats ?? null) ? $stats : [];
$integrationStats = is_array($integrationStats ?? null) ? $integrationStats : [];
$deliveries = is_array($deliveries ?? null) ? $deliveries : [];
$filters = is_array($filters ?? null) ? $filters : [];
$pageStatus = $pageStatus ?? null;
$typeLabels = ['blog_post' => 'Стаття', 'seo_landing' => 'SEO-лендінг'];
$statusLabels = ['draft' => 'Чернетка', 'review' => 'На перевірці', 'published' => 'Опубліковано', 'archived' => 'Архів'];
$typeOptions = ['' => 'Усі'] + $typeLabels;
$statusOptions = ['' => 'Усі'] + $statusLabels;

$rows = [];
foreach ($items as $item) {
    if (!is_array($item)) continue;
    $status = (string) ($item['status'] ?? '');
    $score = (int) ($item['seo_score'] ?? 0);
    $rows[] = [
        '_href' => 'admin/content/edit/' . (int) ($item['id'] ?? 0),
        'material' => [
            'primary' => (string) ($item['title'] ?? ''),
            'secondary' => (string) ($item['slug'] ?? ''),
        ],
        'type' => (string) ($typeLabels[$item['content_type'] ?? ''] ?? ($item['content_type'] ?? '')),
        'status' => [
            'label' => $statusLabels[$status] ?? $status,
            'tone' => match ($status) {
                'published' => 'positive',
                'review' => 'warning',
                'archived' => 'neutral',
                default => 'neutral',
            },
        ],
        'seo' => [
            'label' => $score . '%',
            'tone' => $score >= 80 ? 'positive' : ($score >= 50 ? 'warning' : 'neutral'),
        ],
        'source' => (string) ($item['source'] ?? ''),
        'updated' => (string) ($item['updated_at'] ?? ''),
        'actions' => [
            'kind' => 'actions',
            'ariaLabel' => 'Дії матеріалу',
            'items' => [[
                'label' => 'Редагувати',
                'href' => 'admin/content/edit/' . (int) ($item['id'] ?? 0),
                'variant' => 'ghost',
            ]],
        ],
    ];
}
?>

