        'action' => 'admin/content',
        'fields' => [
            ['name' => 'q', 'type' => 'search', 'label' => 'Пошук', 'value' => $filters['q'] ?? '', 'placeholder' => 'Назва, slug, ключове слово', 'grow' => true],
