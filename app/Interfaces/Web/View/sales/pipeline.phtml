<?php
$h = fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$pipelines = $workspace['pipelines'] ?? [];
$deals = $workspace['deals'] ?? [];
$selectedPipelineId = trim((string)($this->request->getQuery('pipeline_id') ?? ''));
$pipeline = null;
foreach ($pipelines as $candidate) {
    if ($selectedPipelineId !== '' && (string)($candidate['id'] ?? '') === $selectedPipelineId) { $pipeline = $candidate; break; }
}
$pipeline ??= $pipelines[0] ?? ['stages'=>[]];
$byStage = [];
foreach ($deals as $deal) {
    if ((string)($deal['pipeline_id'] ?? '') !== (string)($pipeline['id'] ?? '')) continue;
    $byStage[$deal['stage_id'] ?? $deal['stage_code']][] = $deal;
}
?>
<?php $this->partial('shared/manager_header', ['active' => 'pipeline']); ?>
<main class="tn-page tn-admin-page tn-sales-workspace">
  <section class="tn-listing-hero"><div><p class="tn-kicker">Pipeline</p><h1><?php echo $h($pipeline['name'] ?? 'Sales Pipeline'); ?></h1><p>Конфігурована воронка з ризиками, value і наступною дією.</p></div><div><a class="tn-btn tn-btn--ghost" href="<?php echo $this->url->get('sales/leads'); ?>">Leads</a> <a class="tn-btn tn-btn--ghost" href="<?php echo $this->url->get('sales/dashboard'); ?>">Dashboard</a></div></section>
  <?php if (count($pipelines) > 1): ?><nav class="tn-sales-tabs"><?php foreach ($pipelines as $item): ?><a href="<?php echo $this->url->get('sales/pipeline?pipeline_id=' . urlencode((string)$item['id'])); ?>"><?php echo $h($item['name'] ?? $item['code']); ?></a><?php endforeach; ?></nav><?php endif; ?>
  <?php if ($pageStatus ?? null): ?><p class="tn-form-status is-visible"><?php echo $h($pageStatus); ?></p><?php endif; ?>
  <div class="tn-sales-kanban">
    <?php foreach ($pipeline['stages'] ?? [] as $stage): $items=$byStage[$stage['id']]??[]; ?>
      <section class="tn-sales-stage"><header><span><?php echo $h($stage['name']); ?></span><b><?php echo count($items); ?></b></header>
        <?php foreach ($items as $deal): ?><a class="tn-sales-card" href="<?php echo $this->url->get('sales/deals/' . (int)$deal['id']); ?>"><div><strong><?php echo $h($deal['customer']); ?></strong><em class="is-<?php echo strtolower($h($deal['risk_level'])); ?>"><?php echo $h($deal['risk_level']); ?></em></div><p><?php echo $h($deal['title']); ?></p><dl><dt>Value</dt><dd><?php echo $h(number_format((float)$deal['deal_value'],0,'.',' ') . ' ' . $deal['currency']); ?></dd><dt>Next</dt><dd><?php echo $h($deal['next_action_at'] ?: 'Not set'); ?></dd></dl></a><?php endforeach; ?>
        <?php if (!$items): ?><p class="tn-muted">Порожньо</p><?php endif; ?>
      </section>
    <?php endforeach; ?>
  </div>
</main>
