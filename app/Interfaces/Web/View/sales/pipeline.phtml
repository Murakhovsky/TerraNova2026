<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$pipelines = $workspace['pipelines'] ?? [];
$deals = $workspace['deals'] ?? [];
$selectedPipelineId = trim((string)($this->request->getQuery('pipeline_id') ?? ''));
$pipeline = null;
foreach ($pipelines as $candidate) {
    if ($selectedPipelineId !== '' && (string)($candidate['id'] ?? '') === $selectedPipelineId) { $pipeline = $candidate; break; }
}
$pipeline ??= $pipelines[0] ?? ['stages' => []];
$byStage = [];
foreach ($deals as $deal) {
    if ((string)($deal['pipeline_id'] ?? '') !== (string)($pipeline['id'] ?? '')) continue;
    $byStage[(string)($deal['stage_id'] ?? $deal['stage_code'] ?? '')][] = $deal;
}
$money = static fn($v, $currency = 'USD') => number_format((float)$v, 0, '.', ' ') . ' ' . ($currency ?: 'USD');
?>
<main class="tn-page tn-workspace-page tn-workspace-page--wide tn-sales-workspace" data-sales-workspace>
  <?php $this->partial('components/sales/navigation', ['active' => 'pipeline']); ?>
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Sales · Pipeline',
    'title' => $pipeline['name'] ?? 'Sales Pipeline',
    'description' => 'Конфігурована воронка з value, risk та наступною дією. Stage definitions приходять із Sales V0.4.',
    'actions' => [['label' => 'Deals', 'href' => 'sales/deals', 'variant' => 'ghost'], ['label' => 'Today', 'href' => 'sales/today', 'variant' => 'primary']],
  ]); ?>
  <?php if ($pageStatus ?? null): ?><?php $this->partial('components/ui/state', ['kind' => 'error', 'title' => 'Pipeline недоступний', 'message' => $pageStatus]); ?><?php endif; ?>

  <?php if (count($pipelines) > 1): ?>
    <form class="tn-ui-filter-bar tn-workspace-section" method="get" action="<?php echo $this->url->get('sales/pipeline'); ?>">
      <label class="tn-ui-field"><span>Pipeline</span><select class="tn-ui-select" name="pipeline_id" onchange="this.form.submit()"><?php foreach ($pipelines as $item): ?><option value="<?php echo $h($item['id'] ?? ''); ?>" <?php echo (string)($pipeline['id'] ?? '') === (string)($item['id'] ?? '') ? 'selected' : ''; ?>><?php echo $h($item['name'] ?? $item['code'] ?? 'Pipeline'); ?></option><?php endforeach; ?></select></label>
    </form>
  <?php endif; ?>

  <?php if (!empty($pipeline['stages'])): ?>
    <section class="tn-sales-kanban tn-workspace-section" aria-label="Sales pipeline">
      <?php foreach ($pipeline['stages'] as $stage): $items = $byStage[(string)($stage['id'] ?? '')] ?? []; ?>
        <section class="tn-sales-stage">
          <header><span><?php echo $h($stage['name'] ?? $stage['code'] ?? 'Stage'); ?></span><b><?php echo count($items); ?></b></header>
          <div class="tn-sales-stage__body">
            <?php foreach ($items as $deal): ?>
              <a class="tn-sales-card" href="<?php echo $this->url->get('sales/deals/' . (int)$deal['id']); ?>">
                <div><strong><?php echo $h($deal['customer'] ?? '—'); ?></strong><?php $this->partial('components/ui/status_badge', ['label' => $deal['risk_level'] ?? 'NORMAL', 'tone' => ($deal['risk_level'] ?? '') === 'HIGH' ? 'danger' : 'neutral']); ?></div>
                <p><?php echo $h($deal['title'] ?? $deal['public_id'] ?? 'Deal'); ?></p>
                <dl><dt>Value</dt><dd><?php echo $h($money($deal['deal_value'] ?? 0, $deal['currency'] ?? 'USD')); ?></dd><dt>Probability</dt><dd><?php echo $h(($deal['probability'] ?? 0) . '%'); ?></dd><dt>Next</dt><dd><?php echo $h($deal['next_action_at'] ?: 'Not set'); ?></dd></dl>
              </a>
            <?php endforeach; ?>
            <?php if (!$items): ?><p class="tn-sales-empty">Порожньо</p><?php endif; ?>
          </div>
        </section>
      <?php endforeach; ?>
    </section>
  <?php else: ?>
    <?php $this->partial('components/ui/state', ['kind' => 'empty', 'title' => 'Pipeline не налаштований', 'message' => 'Sales Domain не повернув активної воронки або етапів.']); ?>
  <?php endif; ?>
</main>
