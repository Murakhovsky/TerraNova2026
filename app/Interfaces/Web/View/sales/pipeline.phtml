<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$pipelines = $workspace['pipelines'] ?? [];
$deals = $workspace['deals'] ?? [];
$owners = $workspace['owners'] ?? [];
$selectedPipelineId = trim((string) ($this->request->getQuery('pipeline_id') ?? ''));
$pipeline = null;
foreach ($pipelines as $candidate) {
    if ($selectedPipelineId !== '' && (string) ($candidate['id'] ?? '') === $selectedPipelineId) {
        $pipeline = $candidate;
        break;
    }
}
$pipeline ??= $pipelines[0] ?? ['stages' => []];
$byStage = [];
foreach ($deals as $deal) {
    if ((string) ($deal['pipeline_id'] ?? '') !== (string) ($pipeline['id'] ?? '')) continue;
    $byStage[(string) ($deal['stage_id'] ?? '')][] = $deal;
}
$money = static fn($v, $c = 'USD') => number_format((float) $v, 0, '.', ' ') . ' ' . ($c ?: 'USD');
$ownerId = (int) $this->request->getQuery('owner_id', 'int', 0);
$risk = trim((string) $this->request->getQuery('risk', 'string', ''));
$priority = trim((string) $this->request->getQuery('priority', 'string', ''));
$source = trim((string) $this->request->getQuery('source', 'string', ''));
$q = trim((string) $this->request->getQuery('q', 'string', ''));
$valueMin = trim((string) $this->request->getQuery('value_min', 'string', ''));
$valueMax = trim((string) $this->request->getQuery('value_max', 'string', ''));
$pipelineOptions = [];
foreach ($pipelines as $p) {
    $pipelineOptions[(string) ($p['id'] ?? '')] = (string) ($p['name'] ?? $p['code'] ?? 'Pipeline');
}
$ownerOptions = ['' => 'All'];
foreach ($owners as $o) {
    $ownerOptions[(string) (int) $o['id']] = (string) ($o['full_name'] ?? $o['email'] ?? ('#' . $o['id']));
}
$pipelineFilterFields = [
    ['name' => 'pipeline_id', 'type' => 'select', 'label' => 'Pipeline', 'value' => (string) ($pipeline['id'] ?? ''), 'options' => $pipelineOptions],
    ['name' => 'owner_id', 'type' => 'select', 'label' => 'Owner', 'value' => $ownerId > 0 ? (string) $ownerId : '', 'options' => $ownerOptions],
    ['name' => 'risk', 'type' => 'select', 'label' => 'Risk', 'value' => $risk, 'options' => ['' => 'All', 'high' => 'High']],
    ['name' => 'priority', 'type' => 'select', 'label' => 'Priority', 'value' => $priority, 'options' => ['' => 'All', 'low' => 'Low', 'normal' => 'Normal', 'high' => 'High', 'urgent' => 'Urgent']],
    ['name' => 'value_min', 'type' => 'number', 'label' => 'Value min', 'value' => $valueMin, 'min' => 0, 'step' => 100],
    ['name' => 'value_max', 'type' => 'number', 'label' => 'Value max', 'value' => $valueMax, 'min' => 0, 'step' => 100],
    ['name' => 'source', 'type' => 'text', 'label' => 'Source', 'value' => $source],
    ['name' => 'q', 'type' => 'search', 'label' => 'Search', 'value' => $q, 'grow' => true],
];
?>
<main class="tn-page tn-workspace-page tn-workspace-page--wide tn-sales-workspace" data-sales-workspace data-sales-pipeline-root data-csrf="<?php echo $h($csrfToken ?? ''); ?>">
  <?php $this->partial('components/sales/navigation', ['active' => 'pipeline']); ?>
  <?php $this->partial('components/ui/page_header', [
      'eyebrow' => 'Sales · Pipeline',
      'title' => $pipeline['name'] ?? 'Sales Pipeline',
      'description' => 'Kanban із value, weighted value, exact stage age та attention reasons. Stage mutation лишається canonical ChangeDealStage.',
      'actions' => [['label' => 'Deals', 'href' => 'sales/deals', 'variant' => 'ghost'], ['label' => 'Today', 'href' => 'sales/today', 'variant' => 'primary']],
  ]); ?>

  <div class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar', [
      'method' => 'GET',
      'fields' => $pipelineFilterFields,
      'actions' => [['label' => 'Apply', 'type' => 'submit', 'variant' => 'primary']],
    ]); ?>
  </div>

  <div class="tn-sales-pipeline-status" data-sales-pipeline-status></div>
  <?php if (!empty($pipeline['stages'])): ?>
  <section class="tn-sales-kanban tn-workspace-section">
    <?php foreach ($pipeline['stages'] as $stage): $stageId = (string) ($stage['id'] ?? ''); $items = $byStage[$stageId] ?? []; ?>
      <section class="tn-sales-stage" data-sales-stage data-stage-id="<?php echo $h($stageId); ?>">
        <header><div><strong><?php echo $h($stage['name'] ?? $stage['code'] ?? 'Stage'); ?></strong><small><?php echo $h(($stage['deal_count'] ?? count($items)) . ' deals · ' . $money($stage['pipeline_value'] ?? 0) . ' · weighted ' . $money($stage['weighted_value'] ?? 0) . ' · avg ' . ($stage['avg_days_in_stage'] ?? 0) . 'd'); ?></small></div><b><?php echo count($items); ?></b></header>
        <div class="tn-sales-stage__body" data-sales-stage-dropzone data-stage-id="<?php echo $h($stageId); ?>">
          <?php foreach ($items as $deal): ?>
            <a class="tn-sales-card" draggable="true" data-sales-deal-card data-deal-id="<?php echo (int) $deal['id']; ?>" data-stage-id="<?php echo $h((string) ($deal['stage_id'] ?? '')); ?>" href="<?php echo $this->url->get('sales/deals/' . (int) $deal['id']); ?>">
              <div><strong><?php echo $h($deal['customer'] ?? '—'); ?></strong><?php $this->partial('components/ui/status_badge', ['label' => $deal['risk_level'] ?? 'NORMAL', 'tone' => ($deal['risk_level'] ?? '') === 'HIGH' ? 'danger' : 'neutral']); ?></div>
              <p><?php echo $h($deal['title'] ?? $deal['public_id'] ?? 'Deal'); ?></p>
              <small><?php echo $h(($deal['owner_name'] ?: 'Unassigned') . ' · ' . (!empty($deal['stage_age_estimated']) ? '~' : '') . ($deal['days_in_stage'] ?? 0) . 'd in stage'); ?></small>
              <dl>
                <dt>Value</dt><dd><?php echo $h($money($deal['deal_value'] ?? 0, $deal['currency'] ?? 'USD')); ?></dd>
                <dt>Weighted</dt><dd><?php echo $h($money($deal['weighted_value'] ?? 0, $deal['currency'] ?? 'USD')); ?></dd>
                <dt>Next</dt><dd><?php echo $h($deal['next_action_at'] ?: 'Not set'); ?></dd>
                <dt>Attention</dt><dd><?php echo $h($deal['attention_reason'] ?: '—'); ?></dd>
                <dt>AI recommendation</dt><dd><?php echo $h($deal['ai_recommendation'] ?? 'Continue planned next action'); ?></dd>
              </dl>
            </a>
          <?php endforeach; ?>
          <?php if (!$items): ?><p class="tn-sales-empty">Порожньо</p><?php endif; ?>
        </div>
      </section>
    <?php endforeach; ?>
  </section>
  <?php endif; ?>
</main>
