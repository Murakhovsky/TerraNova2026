<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$deals = $workspace['deals'] ?? [];
$pipelines = $workspace['pipelines'] ?? [];
$q = trim((string) $this->request->getQuery('q', 'string', ''));
$status = trim((string) $this->request->getQuery('status', 'string', ''));
$risk = trim((string) $this->request->getQuery('risk', 'string', ''));
$pipelineId = trim((string) $this->request->getQuery('pipeline_id', 'string', ''));
$stageId = trim((string) $this->request->getQuery('stage_id', 'string', ''));
$stages = [];
foreach ($pipelines as $pipeline) {
    if ($pipelineId === '' || (string)($pipeline['id'] ?? '') === $pipelineId) {
        foreach ($pipeline['stages'] ?? [] as $stage) $stages[] = $stage;
    }
}
$money = static fn($v, $currency = 'USD') => number_format((float) $v, 0, '.', ' ') . ' ' . ($currency ?: 'USD');
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace>
  <?php $this->partial('components/sales/navigation', ['active' => 'deals']); ?>
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Sales · Deals',
    'title' => 'Угоди',
    'description' => 'Єдиний список активних і завершених угод із stage, value, next action та risk.',
    'actions' => [['label' => 'Pipeline', 'href' => 'sales/pipeline', 'variant' => 'primary']],
    'meta' => ['value' => count($deals), 'label' => 'у вибірці'],
  ]); ?>
  <?php if ($pageStatus ?? null): ?><?php $this->partial('components/ui/state', ['kind' => 'error', 'title' => 'Deals недоступні', 'message' => $pageStatus]); ?><?php endif; ?>

  <form class="tn-ui-filter-bar tn-workspace-section" method="get" action="<?php echo $this->url->get('sales/deals'); ?>">
    <label class="tn-ui-field tn-sales-filter-grow"><span>Пошук</span><input class="tn-ui-input" type="search" name="q" value="<?php echo $h($q); ?>" placeholder="Клієнт, назва або ID"></label>
    <label class="tn-ui-field"><span>Status</span><select class="tn-ui-select" name="status"><option value="">Усі</option><?php foreach (['active'=>'Active','paused'=>'Paused','won'=>'Won','lost'=>'Lost'] as $value=>$label): ?><option value="<?php echo $value; ?>" <?php echo $status === $value ? 'selected' : ''; ?>><?php echo $label; ?></option><?php endforeach; ?></select></label>
    <label class="tn-ui-field"><span>Pipeline</span><select class="tn-ui-select" name="pipeline_id"><option value="">Усі</option><?php foreach ($pipelines as $pipeline): ?><option value="<?php echo $h($pipeline['id'] ?? ''); ?>" <?php echo $pipelineId === (string)($pipeline['id'] ?? '') ? 'selected' : ''; ?>><?php echo $h($pipeline['name'] ?? $pipeline['code'] ?? 'Pipeline'); ?></option><?php endforeach; ?></select></label>
    <label class="tn-ui-field"><span>Stage</span><select class="tn-ui-select" name="stage_id"><option value="">Усі</option><?php foreach ($stages as $stage): ?><option value="<?php echo $h($stage['id'] ?? ''); ?>" <?php echo $stageId === (string)($stage['id'] ?? '') ? 'selected' : ''; ?>><?php echo $h($stage['name'] ?? $stage['code'] ?? 'Stage'); ?></option><?php endforeach; ?></select></label>
    <label class="tn-ui-field"><span>Risk</span><select class="tn-ui-select" name="risk"><option value="">Усі</option><option value="high" <?php echo $risk === 'high' ? 'selected' : ''; ?>>High</option></select></label>
    <button class="tn-ui-button tn-ui-button--primary" type="submit">Фільтрувати</button>
    <?php if ($q !== '' || $status !== '' || $risk !== '' || $pipelineId !== '' || $stageId !== ''): ?><a class="tn-ui-button tn-ui-button--ghost" href="<?php echo $this->url->get('sales/deals'); ?>">Скинути</a><?php endif; ?>
  </form>

  <?php if ($deals): ?>
    <section class="tn-ui-table-wrap tn-workspace-section"><table class="tn-ui-table"><thead><tr><th>Deal / Client</th><th>Stage</th><th>Value</th><th>Probability</th><th>Owner</th><th>Last activity</th><th>Next action</th><th>Risk</th></tr></thead><tbody>
    <?php foreach ($deals as $deal): ?><tr class="tn-sales-click-row" data-href="<?php echo $this->url->get('sales/deals/' . (int)$deal['id']); ?>">
      <td><a href="<?php echo $this->url->get('sales/deals/' . (int)$deal['id']); ?>"><strong><?php echo $h($deal['customer'] ?? '—'); ?></strong></a><small class="tn-sales-cell-sub"><?php echo $h(($deal['public_id'] ?? '') . ' · ' . ($deal['title'] ?? '')); ?></small></td>
      <td><?php echo $h($deal['stage_name'] ?? $deal['stage_code'] ?? '—'); ?></td>
      <td><?php echo $h($money($deal['deal_value'] ?? 0, $deal['currency'] ?? 'USD')); ?></td>
      <td><?php echo $h(($deal['probability'] ?? 0) . '%'); ?></td><td><?php echo $h($deal['owner_name'] ?: 'Unassigned'); ?></td>
      <td><?php echo $h($deal['last_activity_at'] ?: '—'); ?></td><td><?php echo $h($deal['next_action_at'] ?: '—'); ?></td>
      <td><?php $this->partial('components/ui/status_badge', ['label' => $deal['risk_level'] ?? 'NORMAL', 'tone' => ($deal['risk_level'] ?? '') === 'HIGH' ? 'danger' : 'neutral']); ?></td>
    </tr><?php endforeach; ?>
    </tbody></table></section>
  <?php else: ?>
    <?php $this->partial('components/ui/state', ['kind' => 'empty', 'title' => 'Угод не знайдено', 'message' => 'Зміни фільтри або відкрий Pipeline для огляду воронки.']); ?>
  <?php endif; ?>
</main>
