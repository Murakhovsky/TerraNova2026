<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$deals = $workspace['deals'] ?? [];
$pipelines = $workspace['pipelines'] ?? [];
$owners = $workspace['owners'] ?? [];
$get = fn($key) => trim((string) $this->request->getQuery($key, 'string', ''));
$q = $get('q');
$risk = $get('risk');
$pipelineId = $get('pipeline_id');
$stageId = $get('stage_id');
$priority = $get('priority');
$source = $get('source');
$ownerId = (int) $this->request->getQuery('owner_id', 'int', 0);
$stages = [];
foreach ($pipelines as $pipeline) {
    if ($pipelineId !== '' && (string) ($pipeline['id'] ?? '') !== $pipelineId) continue;
    foreach ($pipeline['stages'] ?? [] as $stage) $stages[] = $stage;
}
$money = static fn($value, $currency = 'USD') => number_format((float) $value, 0, '.', ' ') . ' ' . ($currency ?: 'USD');
$ownerOptions = ['' => 'All'];
foreach ($owners as $owner) $ownerOptions[(string) (int) ($owner['id'] ?? 0)] = (string) ($owner['full_name'] ?? $owner['email'] ?? ('#' . ($owner['id'] ?? '')));
$pipelineOptions = ['' => 'All'];
foreach ($pipelines as $pipeline) $pipelineOptions[(string) ($pipeline['id'] ?? '')] = (string) ($pipeline['name'] ?? $pipeline['code'] ?? 'Pipeline');
$stageOptions = ['' => 'All'];
foreach ($stages as $stage) $stageOptions[(string) ($stage['id'] ?? '')] = (string) ($stage['name'] ?? $stage['code'] ?? 'Stage');
$rows = [];
foreach ($deals as $deal) {
    $riskLevel = strtoupper((string) ($deal['risk_level'] ?? 'NORMAL'));
    $rows[] = [
        '_href' => 'sales/deals/' . (int) ($deal['id'] ?? 0),
        'deal' => ['primary' => $deal['customer'] ?? '—', 'secondary' => trim((string) ($deal['public_id'] ?? '') . ' · ' . (string) ($deal['source'] ?? ''), ' ·')],
        'stage' => ['label' => $deal['stage_name'] ?? $deal['stage_code'] ?? '—', 'kind' => 'stage', 'tone' => 'neutral'],
        'owner' => $deal['owner_name'] ?: 'Unassigned',
        'value' => $money($deal['deal_value'] ?? 0, $deal['currency'] ?? 'USD'),
        'next_action' => $deal['next_action_at'] ?: '—',
        'attention' => $deal['attention_reason'] ?: '—',
        'risk' => ['label' => $riskLevel, 'tone' => $riskLevel === 'HIGH' ? 'danger' : 'neutral'],
    ];
}
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace>
  <?php $this->partial('components/sales/navigation', ['active' => 'deals']); ?>
  <?php $this->partial('components/ui/page_header', [
      'eyebrow' => 'Sales · Deals',
      'title' => 'Угоди',
      'description' => 'Список угод з operational attention, owner, source та next action.',
      'actions' => [['label' => 'Pipeline', 'href' => 'sales/pipeline', 'variant' => 'primary']],
      'meta' => ['value' => count($deals), 'label' => 'у вибірці'],
  ]); ?>

  <section class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar', [
        'fields' => [
            ['name' => 'q', 'type' => 'search', 'label' => 'Search', 'value' => $q, 'grow' => true],
            ['name' => 'owner_id', 'type' => 'select', 'label' => 'Owner', 'value' => $ownerId > 0 ? (string) $ownerId : '', 'options' => $ownerOptions],
            ['name' => 'priority', 'type' => 'select', 'label' => 'Priority', 'value' => $priority, 'options' => ['' => 'All', 'low' => 'Low', 'normal' => 'Normal', 'high' => 'High', 'urgent' => 'Urgent']],
            ['name' => 'source', 'type' => 'text', 'label' => 'Source', 'value' => $source],
            ['name' => 'pipeline_id', 'type' => 'select', 'label' => 'Pipeline', 'value' => $pipelineId, 'options' => $pipelineOptions],
            ['name' => 'stage_id', 'type' => 'select', 'label' => 'Stage', 'value' => $stageId, 'options' => $stageOptions],
            ['name' => 'risk', 'type' => 'select', 'label' => 'Risk', 'value' => $risk, 'options' => ['' => 'All', 'high' => 'High']],
        ],
        'actions' => [['label' => 'Apply', 'type' => 'submit', 'variant' => 'primary']],
    ]); ?>
  </section>

  <section class="tn-workspace-section">
    <?php $this->partial('components/ui/data_table', [
        'columns' => [
            ['key' => 'deal', 'label' => 'Deal / Client'],
            ['key' => 'stage', 'label' => 'Stage'],
            ['key' => 'owner', 'label' => 'Owner'],
            ['key' => 'value', 'label' => 'Value'],
            ['key' => 'next_action', 'label' => 'Next action'],
            ['key' => 'attention', 'label' => 'Attention'],
            ['key' => 'risk', 'label' => 'Risk'],
        ],
        'rows' => $rows,
        'responsive' => 'cards',
        'emptyMessage' => 'Угод для вибраних фільтрів немає.',
    ]); ?>
  </section>
</main>
