<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$sections = [
  'must_do' => ['Must Do', 'Що потрібно зробити сьогодні'],
  'ai_recommended' => ['AI Recommended', 'Пропозиції COS, які потребують уваги'],
  'overdue' => ['Overdue', 'Прострочені наступні контакти'],
  'new_replies' => ['New Replies', 'Нові вхідні відповіді'],
  'meetings' => ['Meetings', 'Зустрічі на сьогодні'],
  'followups' => ['Follow-ups', 'Заплановані follow-up'],
  'waiting_for_client' => ['Waiting for Client', 'Угоди без активного next action'],
];
$total = array_sum(array_map(static fn($key) => count($workspace[$key] ?? []), array_keys($sections)));
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace>
  <?php $this->partial('components/sales/navigation', ['active' => 'today']); ?>
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Sales · Operational inbox',
    'title' => 'Today',
    'description' => 'Тільки те, що потребує рішення або дії зараз. Не ще один список усіх справ у Всесвіті.',
    'actions' => [['label' => 'Pipeline', 'href' => 'sales/pipeline', 'variant' => 'ghost'], ['label' => 'Deals', 'href' => 'sales/deals', 'variant' => 'primary']],
    'meta' => ['value' => $total, 'label' => 'операційних сигналів'],
  ]); ?>
  <?php if ($pageStatus ?? null): ?><?php $this->partial('components/ui/state', ['kind' => 'error', 'title' => 'Today недоступний', 'message' => $pageStatus]); ?><?php endif; ?>

  <div class="tn-sales-today-grid tn-workspace-section">
    <?php foreach ($sections as $key => [$label, $description]): $items = $workspace[$key] ?? []; ?>
      <section class="tn-ui-panel tn-sales-today-card">
        <div class="tn-ui-panel__head"><div><h2><?php echo $h($label); ?></h2><p><?php echo $h($description); ?></p></div><span class="tn-sales-count"><?php echo count($items); ?></span></div>
        <div class="tn-sales-list">
          <?php foreach ($items as $item): $dealId = (int)($item['id'] ?? $item['deal_id'] ?? 0); ?>
            <?php $tag = $dealId > 0 ? 'a' : 'div'; $href = $dealId > 0 ? ' href="' . $this->url->get('sales/deals/' . $dealId) . '"' : ''; ?>
            <<?php echo $tag; ?> class="tn-sales-list-row"<?php echo $href; ?>>
              <span><strong><?php echo $h($item['customer'] ?? $item['type'] ?? 'Action'); ?></strong><small><?php echo $h($item['activity_title'] ?? $item['title'] ?? $item['reason'] ?? $item['detail'] ?? $item['status'] ?? ''); ?></small></span>
              <?php if (!empty($item['risk_level']) || !empty($item['priority'])): ?><em><?php echo $h($item['risk_level'] ?? $item['priority']); ?></em><?php endif; ?>
              <?php if (!empty($item['due_at']) || !empty($item['next_contact_at']) || !empty($item['occurred_at'])): ?><time><?php echo $h($item['due_at'] ?? $item['next_contact_at'] ?? $item['occurred_at']); ?></time><?php endif; ?>
            </<?php echo $tag; ?>>
          <?php endforeach; ?>
          <?php if (!$items): ?><p class="tn-sales-empty">Немає елементів.</p><?php endif; ?>
        </div>
      </section>
    <?php endforeach; ?>
  </div>
</main>
