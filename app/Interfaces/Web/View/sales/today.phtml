    'new_replies' => ['New Replies', 'Нові вхідні відповіді', 'communications'],
    'meetings' => ['Meetings', 'Зустрічі на сьогодні', 'work'],
    'followups' => ['Follow-ups', 'Заплановані follow-up', 'work'],
    'waiting_for_client' => ['Waiting for Client', 'Угоди без активного next action', 'work'],
