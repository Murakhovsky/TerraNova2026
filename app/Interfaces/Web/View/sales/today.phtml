    'HIGH_PRIORITY' => 'Високий пріоритет',
    'NO_ACTIVITY', 'NO_ACTIVITY_48H' => 'Немає активності',
    'NO_NEXT_ACTION' => 'Не задана наступна дія',
    'UNASSIGNED' => 'Без відповідального',
    'NEW_LEAD' => 'Новий lead',
    default => (string) $v,
};
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace data-sales-today-root data-csrf="<?php echo $h($csrfToken ?? ''); ?>">
