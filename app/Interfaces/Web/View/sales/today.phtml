  <?php $this->partial('components/ui/page_header', [
      'eyebrow' => 'Sales · Operational inbox',
      'title' => 'Today',
      'description' => 'Сигнал → рішення → дія. Без походів по трьох екранах заради одного follow-up.',
      'actions' => [
          ['label' => 'Pipeline', 'href' => 'sales/pipeline', 'variant' => 'ghost'],
          ['label' => 'Deals', 'href' => 'sales/deals', 'variant' => 'primary'],
      ],
      'meta' => ['value' => $total, 'label' => 'операційних сигналів'],
  ]); ?>

  <nav class="tn-ui-tabs tn-sales-scope-tabs" aria-label="Sales work scope">
