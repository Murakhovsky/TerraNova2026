$sections = [
    'needs_approval' => ['Needs My Approval', 'Дії COS, які чекають рішення', 'intelligence'],
    'must_do' => ['Must Do', 'Що потрібно зробити сьогодні', 'work'],
    'ai_recommended' => ['AI Recommended', 'Пропозиції COS, які потребують уваги', 'intelligence'],
