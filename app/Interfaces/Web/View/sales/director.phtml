      'title' => 'Historical Sales Intelligence',
      'description' => 'Єдиний director contract: історичний funnel, операційна дисципліна, forecast, risk та explainability без змішування валют і без вигаданих timestamp.',
      'actions' => [['label' => 'Pipeline', 'href' => 'sales/pipeline', 'variant' => 'primary']],
  ]); ?>

  <section class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar', [
        'fields' => [
            ['name' => 'history_days', 'type' => 'number', 'label' => 'History days', 'value' => (string) (int) ($filters['history_days'] ?? 30), 'min' => 1, 'max' => 366],
            ['name' => 'forecast_days', 'type' => 'number', 'label' => 'Forecast days', 'value' => (string) (int) ($filters['forecast_days'] ?? 30), 'min' => 1, 'max' => 366],
            ['name' => 'pipeline_id', 'type' => 'text', 'label' => 'Pipeline', 'value' => $filters['pipeline_id'] ?? '', 'placeholder' => 'all'],
        ],
        'actions' => [['label' => 'Apply', 'type' => 'submit', 'variant' => 'primary']],
    ]); ?>
  </section>

  <section class="tn-workspace-section">
    <?php $this->partial('components/ui/panel', [
        'eyebrow' => 'Executive picture',
        'title' => 'Pipeline and forecast by currency',
        'description' => 'Currencies remain isolated by contract; monetary facts are never mixed.',
        'bodyPartial' => 'components/ui/data_table',
        'bodyParams' => [
            'columns' => [
                ['key' => 'currency', 'label' => 'Currency'],
                ['key' => 'pipeline', 'label' => 'Pipeline'],
                ['key' => 'weighted', 'label' => 'Weighted pipeline'],
                ['key' => 'forecast', 'label' => 'Forecast'],
                ['key' => 'risk', 'label' => 'Current at risk'],
            ],
            'rows' => $executiveRows,
            'responsive' => 'cards',
            'emptyMessage' => 'No monetary facts for the selected scope.',
        ],
    ]); ?>
  </section>

  <section class="tn-ui-kpi-grid tn-workspace-section">
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Closed win rate', 'value' => $percent($headline['closed_win_rate']['rate'] ?? null), 'tone' => 'positive']); ?>
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Created cohort win rate', 'value' => $percent($headline['created_cohort_win_rate']['rate'] ?? null)]); ?>
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Stuck deals', 'value' => (int) ($headline['stuck_deal_count'] ?? 0), 'tone' => 'warning']); ?>
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Forecast coverage', 'value' => $percent($forecast['coverage']['expected_close_rate'] ?? null)]); ?>
  </section>

  <div class="tn-ui-split tn-workspace-section">
    <?php $this->partial('components/ui/panel', [
        'eyebrow' => 'Historical funnel',
        'title' => 'Actual transitions',
        'bodyPartial' => 'components/ui/data_table',
        'bodyParams' => [
            'columns' => [
                ['key' => 'pipeline', 'label' => 'Pipeline'],
                ['key' => 'from', 'label' => 'From'],
                ['key' => 'to', 'label' => 'To'],
                ['key' => 'transitions', 'label' => 'Transitions'],
                ['key' => 'conversion', 'label' => 'Conversion'],
            ],
            'rows' => $transitionRows,
            'responsive' => 'cards',
            'emptyMessage' => 'No historical transitions for the selected scope.',
        ],
    ]); ?>
    <?php $this->partial('components/ui/panel', [
        'eyebrow' => 'Velocity',
        'title' => 'Cycle and stage duration',
        'bodyPartial' => 'components/sales/director_velocity',
        'bodyParams' => ['historical' => $historical, 'quality' => $quality],
    ]); ?>
  </div>

  <section class="tn-workspace-section">
    <?php $this->partial('components/ui/panel', [
        'eyebrow' => 'Manager performance',
        'title' => 'Attributed facts only',
        'description' => 'Поточний owner не отримує заднім числом чужі response, follow-up чи outcomes.',
        'bodyPartial' => 'components/ui/data_table',
        'bodyParams' => [
            'columns' => [
                ['key' => 'owner', 'label' => 'Owner'],
                ['key' => 'response', 'label' => 'Response'],
                ['key' => 'median_response', 'label' => 'Median response'],
                ['key' => 'followup', 'label' => 'Follow-up'],
                ['key' => 'on_time', 'label' => 'On time'],
                ['key' => 'won_closed', 'label' => 'Won / closed'],
            ],
            'rows' => $managerRows,
            'responsive' => 'cards',
            'emptyMessage' => 'No attributed manager facts for the selected scope.',
        ],
        'footerPartial' => 'components/sales/director_attribution',
        'footerParams' => ['quality' => $quality],
    ]); ?>
  </section>

  <section class="tn-workspace-section">
    <?php $this->partial('components/ui/panel', [
        'eyebrow' => 'Risk & explainability',
        'title' => 'Deals requiring attention',
        'description' => 'Кожен ризик має observable evidence; opaque risk score тут не використовується.',
        'bodyPartial' => 'components/ui/data_table',
        'bodyParams' => [
            'columns' => [
                ['key' => 'deal', 'label' => 'Deal'],
                ['key' => 'stage', 'label' => 'Stage'],
                ['key' => 'expected_close', 'label' => 'Expected close'],
                ['key' => 'reasons', 'label' => 'Risk reasons'],
