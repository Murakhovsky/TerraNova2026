<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$headline = $workspace['headline'] ?? [];
$historical = $workspace['historical'] ?? [];
$operations = $workspace['operations'] ?? [];
$forecast = $workspace['forecast'] ?? [];
$filters = $workspace['filters'] ?? [];
$quality = $workspace['quality'] ?? [];
$percent = static fn($value) => $value === null ? '—' : number_format((float) $value * 100, 1, '.', ' ') . '%';
$duration = static fn($seconds) => $seconds === null ? '—' : number_format((float) $seconds / 3600, 1, '.', ' ') . ' h';
$money = static fn($value, $currency) => number_format((float) $value, 0, '.', ' ') . ' ' . (string) $currency;

$pipelineRows = (array) ($headline['pipeline_by_currency'] ?? []);
$forecastRows = (array) ($headline['forecast_by_currency'] ?? []);
$riskRows = (array) ($headline['at_risk_by_currency'] ?? []);
$managers = (array) ($operations['manager_performance']['managers'] ?? []);
$atRiskDeals = array_values(array_filter((array) ($forecast['deals'] ?? []), static fn($deal) => is_array($deal) && !empty($deal['risk']['at_risk'])));

$currencies = [];
foreach ([$pipelineRows, $forecastRows, $riskRows] as $sourceRows) {
    foreach ($sourceRows as $row) if (is_array($row) && !empty($row['currency'])) $currencies[(string) $row['currency']] = true;
}
ksort($currencies);
$findCurrency = static function (array $rows, string $currency): array {
    foreach ($rows as $row) if (is_array($row) && (string) ($row['currency'] ?? '') === $currency) return $row;
    return [];
};

$executiveRows = [];
foreach (array_keys($currencies) as $currency) {
    $pipeline = $findCurrency($pipelineRows, $currency);
    $forecastRow = $findCurrency($forecastRows, $currency);
    $risk = $findCurrency($riskRows, $currency);
    $executiveRows[] = [
        'currency' => $currency,
        'pipeline' => $money($pipeline['pipeline_value'] ?? 0, $currency),
        'weighted' => $money($pipeline['weighted_pipeline'] ?? 0, $currency),
        'forecast' => $money($forecastRow['value'] ?? 0, $currency),
        'risk' => $money($risk['value'] ?? 0, $currency),
    ];
}

$transitionRows = [];
foreach ((array) ($historical['stage_conversion'] ?? []) as $row) {
    $transitionRows[] = [
        'pipeline' => $row['pipeline_id'] ?? '',
        'from' => $row['from_stage_code'] ?? '',
        'to' => $row['to_stage_code'] ?? '',
        'transitions' => (int) ($row['transition_count'] ?? 0),
        'conversion' => $percent($row['conversion_rate'] ?? null),
    ];
}

$managerRows = [];
foreach ($managers as $manager) {
    $managerRows[] = [
        'owner' => '#' . (int) ($manager['owner_id'] ?? 0),
        'response' => $percent($manager['response']['response_rate'] ?? null),
        'median_response' => $duration($manager['response']['median_seconds'] ?? null),
        'followup' => $percent($manager['followup']['completion_rate'] ?? null),
        'on_time' => $percent($manager['followup']['on_time_rate'] ?? null),
        'won_closed' => $percent($manager['outcomes']['win_rate_closed'] ?? null),
    ];
}

$riskDealRows = [];
foreach ($atRiskDeals as $deal) {
    $codes = array_map(static fn($reason) => is_array($reason) ? (string) ($reason['code'] ?? '') : '', (array) ($deal['risk']['reasons'] ?? []));
    $riskDealRows[] = [
        'deal' => $deal['title'] ?? $deal['deal_id'] ?? 'Deal',
        'stage' => ['label' => $deal['stage_code'] ?? '—', 'kind' => 'stage', 'tone' => 'warning'],
        'expected_close' => $deal['expected_close_at'] ?? '—',
        'reasons' => implode(', ', array_filter($codes)),
        'money' => !empty($deal['money']['available']) ? $money($deal['money']['value'] ?? 0, $deal['money']['currency'] ?? '') : '—',
    ];
}
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace>
