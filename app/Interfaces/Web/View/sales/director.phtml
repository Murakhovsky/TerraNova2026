<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$headline = $workspace['headline'] ?? [];
$historical = $workspace['historical'] ?? [];
$operations = $workspace['operations'] ?? [];
$forecast = $workspace['forecast'] ?? [];
$filters = $workspace['filters'] ?? [];
$quality = $workspace['quality'] ?? [];
$percent = static fn($value) => $value === null ? '—' : number_format((float) $value * 100, 1, '.', ' ') . '%';
$duration = static fn($seconds) => $seconds === null ? '—' : number_format((float) $seconds / 3600, 1, '.', ' ') . ' h';
$money = static fn($value, $currency) => number_format((float) $value, 0, '.', ' ') . ' ' . (string) $currency;
$pipelineRows = (array) ($headline['pipeline_by_currency'] ?? []);
$forecastRows = (array) ($headline['forecast_by_currency'] ?? []);
$riskRows = (array) ($headline['at_risk_by_currency'] ?? []);
$managers = (array) ($operations['manager_performance']['managers'] ?? []);
$atRiskDeals = array_values(array_filter((array) ($forecast['deals'] ?? []), static fn($deal) => is_array($deal) && !empty($deal['risk']['at_risk'])));
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace>
  <?php $this->partial('components/sales/navigation', ['active' => 'director']); ?>
  <?php $this->partial('components/ui/page_header', [
      'eyebrow' => 'Sales · Director Workspace',
      'title' => 'Historical Sales Intelligence',
      'description' => 'Єдиний director contract: історичний funnel, операційна дисципліна, forecast, risk та explainability без змішування валют і без вигаданих timestamp.',
      'actions' => [['label' => 'Pipeline', 'href' => 'sales/pipeline', 'variant' => 'primary']],
  ]); ?>

  <section class="tn-ui-panel tn-workspace-section">
    <form method="get" class="tn-ui-toolbar">
      <label>History days <input type="number" name="history_days" min="1" max="366" value="<?php echo (int) ($filters['history_days'] ?? 30); ?>"></label>
      <label>Forecast days <input type="number" name="forecast_days" min="1" max="366" value="<?php echo (int) ($filters['forecast_days'] ?? 30); ?>"></label>
      <label>Pipeline <input type="text" name="pipeline_id" value="<?php echo $h($filters['pipeline_id'] ?? ''); ?>" placeholder="all"></label>
      <button class="tn-ui-button tn-ui-button--primary" type="submit">Apply</button>
    </form>
  </section>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Executive picture</p><h2>Pipeline and forecast by currency</h2></div></div>
    <div class="tn-ui-table-wrap"><table class="tn-ui-table"><thead><tr><th>Currency</th><th>Pipeline</th><th>Weighted pipeline</th><th>Forecast</th><th>Current at risk</th></tr></thead><tbody>
      <?php
      $currencies = [];
      foreach ([$pipelineRows, $forecastRows, $riskRows] as $rows) foreach ($rows as $row) if (is_array($row) && !empty($row['currency'])) $currencies[(string) $row['currency']] = true;
      ksort($currencies);
      $find = static function (array $rows, string $currency): array { foreach ($rows as $row) if (is_array($row) && (string) ($row['currency'] ?? '') === $currency) return $row; return []; };
      foreach (array_keys($currencies) as $currency):
          $pipeline = $find($pipelineRows, $currency);
          $forecastRow = $find($forecastRows, $currency);
          $risk = $find($riskRows, $currency);
      ?>
      <tr><td><?php echo $h($currency); ?></td><td><?php echo $h($money($pipeline['pipeline_value'] ?? 0, $currency)); ?></td><td><?php echo $h($money($pipeline['weighted_pipeline'] ?? 0, $currency)); ?></td><td><?php echo $h($money($forecastRow['value'] ?? 0, $currency)); ?></td><td><?php echo $h($money($risk['value'] ?? 0, $currency)); ?></td></tr>
      <?php endforeach; ?>
    </tbody></table></div>
    <?php if ($currencies === []): ?><p class="tn-sales-note">No monetary facts for the selected scope.</p><?php endif; ?>
  </section>

  <section class="tn-ui-kpi-grid tn-workspace-section">
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Closed win rate', 'value' => $percent($headline['closed_win_rate']['rate'] ?? null), 'tone' => 'positive']); ?>
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Created cohort win rate', 'value' => $percent($headline['created_cohort_win_rate']['rate'] ?? null)]); ?>
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Stuck deals', 'value' => (int) ($headline['stuck_deal_count'] ?? 0), 'tone' => 'warning']); ?>
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Forecast coverage', 'value' => $percent($forecast['coverage']['expected_close_rate'] ?? null)]); ?>
  </section>

  <div class="tn-ui-split tn-workspace-section">
    <section class="tn-ui-panel">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Historical funnel</p><h2>Actual transitions</h2></div></div>
      <div class="tn-ui-table-wrap"><table class="tn-ui-table"><thead><tr><th>Pipeline</th><th>From</th><th>To</th><th>Transitions</th><th>Conversion</th></tr></thead><tbody>
        <?php foreach ((array) ($historical['stage_conversion'] ?? []) as $row): ?><tr><td><?php echo $h($row['pipeline_id'] ?? ''); ?></td><td><?php echo $h($row['from_stage_code'] ?? ''); ?></td><td><?php echo $h($row['to_stage_code'] ?? ''); ?></td><td><?php echo (int) ($row['transition_count'] ?? 0); ?></td><td><?php echo $h($percent($row['conversion_rate'] ?? null)); ?></td></tr><?php endforeach; ?>
      </tbody></table></div>
    </section>
    <section class="tn-ui-panel">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Velocity</p><h2>Cycle and stage duration</h2></div></div>
      <dl class="tn-sales-definition-list">
        <div><dt>Sales cycle median</dt><dd><?php echo $h($duration($historical['sales_cycle']['median_seconds'] ?? null)); ?></dd></div>
        <div><dt>Sales cycle p75</dt><dd><?php echo $h($duration($historical['sales_cycle']['p75_seconds'] ?? null)); ?></dd></div>
        <div><dt>Cycle samples</dt><dd><?php echo (int) ($historical['sales_cycle']['sample_count'] ?? 0); ?></dd></div>
      </dl>
      <p class="tn-sales-note"><?php echo $h($quality['historical_policy'] ?? ''); ?></p>
    </section>
  </div>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Manager performance</p><h2>Attributed facts only</h2><p>Поточний owner не отримує заднім числом чужі response, follow-up чи outcomes.</p></div></div>
    <div class="tn-ui-table-wrap"><table class="tn-ui-table"><thead><tr><th>Owner</th><th>Response</th><th>Median response</th><th>Follow-up</th><th>On time</th><th>Won / closed</th></tr></thead><tbody>
      <?php foreach ($managers as $manager): ?><tr><td>#<?php echo (int) ($manager['owner_id'] ?? 0); ?></td><td><?php echo $h($percent($manager['response']['response_rate'] ?? null)); ?></td><td><?php echo $h($duration($manager['response']['median_seconds'] ?? null)); ?></td><td><?php echo $h($percent($manager['followup']['completion_rate'] ?? null)); ?></td><td><?php echo $h($percent($manager['followup']['on_time_rate'] ?? null)); ?></td><td><?php echo $h($percent($manager['outcomes']['win_rate_closed'] ?? null)); ?></td></tr><?php endforeach; ?>
    </tbody></table></div>
    <p class="tn-sales-note">Attribution coverage: response <?php echo $h($percent($quality['performance_attribution']['response']['rate'] ?? null)); ?> · follow-up <?php echo $h($percent($quality['performance_attribution']['followup']['rate'] ?? null)); ?> · outcome <?php echo $h($percent($quality['performance_attribution']['outcome']['rate'] ?? null)); ?>.</p>
  </section>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Risk & explainability</p><h2>Deals requiring attention</h2><p>Ніяких магічних risk score. Кожен ризик має observable evidence.</p></div></div>
    <div class="tn-ui-table-wrap"><table class="tn-ui-table"><thead><tr><th>Deal</th><th>Stage</th><th>Expected close</th><th>Risk reasons</th><th>Money</th></tr></thead><tbody>
      <?php foreach ($atRiskDeals as $deal): $codes = array_map(static fn($reason) => is_array($reason) ? (string) ($reason['code'] ?? '') : '', (array) ($deal['risk']['reasons'] ?? [])); ?><tr><td><?php echo $h($deal['title'] ?? $deal['deal_id'] ?? 'Deal'); ?></td><td><?php echo $h($deal['stage_code'] ?? ''); ?></td><td><?php echo $h($deal['expected_close_at'] ?? '—'); ?></td><td><?php echo $h(implode(', ', array_filter($codes))); ?></td><td><?php echo !empty($deal['money']['available']) ? $h($money($deal['money']['value'] ?? 0, $deal['money']['currency'] ?? '')) : '—'; ?></td></tr><?php endforeach; ?>
    </tbody></table></div>
    <p class="tn-sales-note"><?php echo $h($quality['currency_policy'] ?? ''); ?> Currencies are never mixed.</p>
  </section>
</main>
