<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$leads = $workspace['leads'] ?? [];
$q = trim((string) $this->request->getQuery('q', 'string', ''));
$status = trim((string) $this->request->getQuery('status', 'string', ''));
$source = trim((string) $this->request->getQuery('source', 'string', ''));
$tone = static fn(string $value): string => match (strtolower($value)) { 'new' => 'info', 'qualified' => 'positive', 'lost', 'disqualified' => 'danger', 'contacted' => 'warning', default => 'neutral' };
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace>
  <?php $this->partial('components/sales/navigation', ['active' => 'leads']); ?>
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Sales · Leads',
    'title' => 'Вхідні ліди',
    'description' => 'Черга звернень, контактів і кваліфікації. Бізнесовий стан без технічної телеметрії.',
    'actions' => [['label' => 'Today', 'href' => 'sales/today', 'variant' => 'primary']],
    'meta' => ['value' => count($leads), 'label' => 'у вибірці'],
  ]); ?>
  <?php if ($pageStatus ?? null): ?><?php $this->partial('components/ui/state', ['kind' => 'error', 'title' => 'Leads недоступні', 'message' => $pageStatus]); ?><?php endif; ?>

  <form class="tn-ui-filter-bar tn-workspace-section" method="get" action="<?php echo $this->url->get('sales/leads'); ?>">
    <label class="tn-ui-field tn-sales-filter-grow"><span>Пошук</span><input class="tn-ui-input" type="search" name="q" value="<?php echo $h($q); ?>" placeholder="Імʼя, телефон або email"></label>
    <label class="tn-ui-field"><span>Status</span><select class="tn-ui-select" name="status"><option value="">Усі</option><?php foreach (['new'=>'New','contacted'=>'Contacted','qualified'=>'Qualified','lost'=>'Lost'] as $value=>$label): ?><option value="<?php echo $value; ?>" <?php echo $status === $value ? 'selected' : ''; ?>><?php echo $label; ?></option><?php endforeach; ?></select></label>
    <label class="tn-ui-field"><span>Source</span><input class="tn-ui-input" name="source" value="<?php echo $h($source); ?>" placeholder="/listing"></label>
    <button class="tn-ui-button tn-ui-button--primary" type="submit">Фільтрувати</button>
    <?php if ($q !== '' || $status !== '' || $source !== ''): ?><a class="tn-ui-button tn-ui-button--ghost" href="<?php echo $this->url->get('sales/leads'); ?>">Скинути</a><?php endif; ?>
  </form>

  <?php if ($leads): ?>
    <section class="tn-ui-table-wrap tn-workspace-section"><table class="tn-ui-table"><thead><tr><th>Lead</th><th>Source</th><th>Status</th><th>Owner</th><th>Priority</th><th>Last contact</th><th>Next action</th><th>Deal</th></tr></thead><tbody>
    <?php foreach ($leads as $lead): ?><tr>
      <td><strong><?php echo $h($lead['name'] ?? '—'); ?></strong><small class="tn-sales-cell-sub"><?php echo $h($lead['created_at'] ?? ''); ?></small></td>
      <td><?php echo $h($lead['source'] ?: '—'); ?></td>
      <td><?php $this->partial('components/ui/status_badge', ['label' => $lead['status'] ?? '—', 'tone' => $tone((string)($lead['status'] ?? ''))]); ?></td>
      <td><?php echo $h($lead['owner_name'] ?: 'Unassigned'); ?></td>
      <td><?php $this->partial('components/ui/status_badge', ['label' => $lead['ai_priority'] ?? 'NORMAL', 'tone' => ($lead['ai_priority'] ?? '') === 'HIGH' ? 'danger' : (($lead['ai_priority'] ?? '') === 'MEDIUM' ? 'warning' : 'neutral')]); ?></td>
      <td><?php echo $h($lead['last_contact_at'] ?: '—'); ?></td><td><?php echo $h($lead['next_action_at'] ?: '—'); ?></td>
      <td><?php if (!empty($lead['deal_id'])): ?><a href="<?php echo $this->url->get('sales/deals/' . (int)$lead['deal_id']); ?>">Відкрити</a><?php else: ?>—<?php endif; ?></td>
    </tr><?php endforeach; ?>
    </tbody></table></section>
  <?php else: ?>
    <?php $this->partial('components/ui/state', ['kind' => 'empty', 'title' => 'Лідів не знайдено', 'message' => 'Зміни фільтри або дочекайся нових звернень.']); ?>
  <?php endif; ?>
</main>
