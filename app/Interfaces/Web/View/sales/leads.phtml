<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$leads = $workspace['leads'] ?? [];
$owners = $workspace['owners'] ?? [];
$q = trim((string) $this->request->getQuery('q', 'string', ''));
$status = trim((string) $this->request->getQuery('status', 'string', ''));
$source = trim((string) $this->request->getQuery('source', 'string', ''));
$ownerId = (int) $this->request->getQuery('owner_id', 'int', 0);
$unassigned = (int) $this->request->getQuery('unassigned', 'int', 0) === 1;
$tabs = [['All',''], ['New','new'], ['Contacted','contacted'], ['Qualified','qualified'], ['Disqualified','disqualified']];
$ownerOptions = ['' => 'Усі'];
foreach ($owners as $owner) {
    $ownerOptions[(string) (int) $owner['id']] = (string) ($owner['full_name'] ?? $owner['email'] ?? ('#' . $owner['id']));
}
$leadFilterFields = [
    ['name' => 'q', 'type' => 'search', 'label' => 'Пошук', 'value' => $q, 'grow' => true],
    ['name' => 'source', 'type' => 'text', 'label' => 'Source', 'value' => $source],
    ['name' => 'owner_id', 'type' => 'select', 'label' => 'Owner', 'value' => $ownerId > 0 ? (string) $ownerId : '', 'options' => $ownerOptions],
];
$leadFilterHidden = [
    'status' => $status,
    'unassigned' => $unassigned ? '1' : '',
];
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace data-sales-lead-inbox data-csrf="<?php echo $h($csrfToken ?? ''); ?>">
  <?php $this->partial('components/sales/navigation', ['active' => 'leads']); ?>
  <?php $this->partial('components/ui/page_header', ['eyebrow' => 'Sales · Lead Inbox', 'title' => 'Вхідні ліди', 'description' => 'Кваліфікуй, призначай і створюй Deal прямо з черги.', 'actions' => [['label' => 'Today', 'href' => 'sales/today', 'variant' => 'primary']], 'meta' => ['value' => count($leads), 'label' => 'у вибірці']]); ?>
  <nav class="tn-ui-tabs tn-sales-lead-tabs">
    <?php foreach ($tabs as [$label, $value]): ?><a class="<?php echo !$unassigned && $status === $value ? 'is-active' : ''; ?>" href="<?php echo $this->url->get('sales/leads' . ($value !== '' ? '?status=' . $value : '')); ?>"><?php echo $h($label); ?></a><?php endforeach; ?>
    <a class="<?php echo $unassigned ? 'is-active' : ''; ?>" href="<?php echo $this->url->get('sales/leads?unassigned=1'); ?>">Unassigned</a>
  </nav>
  <div class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar', [
      'action' => 'sales/leads',
      'method' => 'GET',
      'fields' => $leadFilterFields,
      'hidden' => $leadFilterHidden,
      'actions' => [['label' => 'Filter', 'type' => 'submit', 'variant' => 'primary']],
    ]); ?>
  </div>

  <?php if ($leads): ?><section class="tn-sales-lead-list tn-workspace-section">
    <?php foreach ($leads as $lead): $drawerId = 'lead-drawer-' . (int) $lead['id']; ?>
      <article class="tn-ui-panel tn-sales-lead-card" data-lead-id="<?php echo (int) $lead['id']; ?>">
        <header><div><strong><?php echo $h($lead['name'] ?? '—'); ?></strong><small><?php echo $h(($lead['source'] ?: 'Direct') . ' · ' . ($lead['created_at'] ?? '')); ?></small></div><?php
          $leadStatus = strtolower((string) ($lead['status'] ?? 'new'));
          $leadTone = match ($leadStatus) {
              'qualified' => 'positive',
              'disqualified' => 'danger',
              'contacted' => 'info',
              default => 'neutral',
          };
          $this->partial('components/ui/status_badge', ['label' => strtoupper($leadStatus), 'tone' => $leadTone]);
        ?></header>
        <div class="tn-sales-lead-summary"><span><?php echo $h($lead['phone'] ?: '—'); ?></span><span><?php echo $h($lead['email'] ?: '—'); ?></span><span><?php echo $h($lead['attention_reason'] ?: ''); ?></span></div>
        <div class="tn-sales-quick-actions">
          <?php if (($lead['status'] ?? '') === 'new'): ?><button type="button" class="tn-ui-button tn-ui-button--ghost tn-ui-button--sm" data-sales-lead-status data-status="contacted">Contacted</button><?php endif; ?>
          <button type="button" class="tn-ui-button tn-ui-button--primary tn-ui-button--sm" data-sales-lead-status data-status="qualified">Qualify</button>
          <button type="button" class="tn-ui-button tn-ui-button--ghost tn-ui-button--sm" data-sales-lead-status data-status="disqualified">Disqualify</button>
          <?php if (!empty($lead['deal_id'])): ?><a class="tn-ui-button tn-ui-button--primary tn-ui-button--sm" href="<?php echo $this->url->get('sales/deals/' . (int) $lead['deal_id']); ?>">Open Deal</a><?php else: ?><button type="button" class="tn-ui-button tn-ui-button--primary tn-ui-button--sm" data-sales-lead-deal>Create Deal</button><?php endif; ?>
          <button type="button" class="tn-ui-button tn-ui-button--ghost tn-ui-button--sm" data-sales-lead-followup>Follow-up</button>
          <a class="tn-ui-button tn-ui-button--ghost tn-ui-button--sm" href="#<?php echo $h($drawerId); ?>">Lead details</a>
        </div>
        <p class="tn-sales-inline-status" data-sales-lead-status-text></p>
        <aside id="<?php echo $h($drawerId); ?>" class="tn-sales-lead-drawer" aria-label="Lead details">
          <a class="tn-sales-lead-drawer__backdrop" href="#" aria-label="Close"></a>
          <section class="tn-sales-lead-drawer__panel">
            <header class="tn-sales-lead-drawer__head"><div><p class="tn-ui-eyebrow">Lead</p><h2><?php echo $h($lead['name'] ?? 'Lead'); ?></h2></div><a class="tn-sales-lead-drawer__close" href="#" aria-label="Close">×</a></header>
            <div class="tn-sales-lead-drawer__body tn-sales-lead-detail">
              <p><?php echo nl2br($h($lead['message'] ?? '')); ?></p>
              <small><?php echo $h($lead['manager_note'] ?? ''); ?></small>
              <div><strong>Phone</strong><p><?php echo $h($lead['phone'] ?: '—'); ?></p></div>
              <div><strong>Email</strong><p><?php echo $h($lead['email'] ?: '—'); ?></p></div>
              <div><strong>Source</strong><p><?php echo $h($lead['source'] ?: 'Direct'); ?></p></div>
              <label class="tn-ui-field"><span>Owner</span><select class="tn-ui-select" data-sales-lead-owner><option value="">Оберіть</option><?php foreach ($owners as $owner): ?><option value="<?php echo (int) $owner['id']; ?>" <?php echo (int) ($lead['owner_id'] ?? 0) === (int) $owner['id'] ? 'selected' : ''; ?>><?php echo $h($owner['full_name'] ?? $owner['email'] ?? ('#' . $owner['id'])); ?></option><?php endforeach; ?></select></label>
            </div>
          </section>
        </aside>
      </article>
    <?php endforeach; ?>
  </section><?php else: ?><?php $this->partial('components/ui/state', ['kind' => 'empty', 'title' => 'Лідів не знайдено', 'message' => 'Зміни фільтри або дочекайся нових звернень.']); ?><?php endif; ?>
</main>
