        'description' => ($deal['pipeline_name'] ?? 'Pipeline') . ' · ' . ($deal['stage_name'] ?? $deal['stage_code'] ?? ''),
        'actions' => [['label' => 'Pipeline', 'href' => 'sales/pipeline?pipeline_id=' . urlencode((string)($deal['pipeline_id'] ?? '')), 'variant' => 'ghost'], ['label' => 'All deals', 'href' => 'sales/deals', 'variant' => 'primary']],
      ]); ?>
      <?php if ($pageStatus ?? null): ?><?php $this->partial('components/ui/state', ['kind' => 'error', 'title' => 'Deal workspace недоступний', 'message' => $pageStatus]); ?><?php endif; ?>

