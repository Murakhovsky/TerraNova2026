        <div data-sales-intelligence><div class="tn-sales-intelligence-loading"><span class="tn-ui-skeleton"></span><span class="tn-ui-skeleton"></span><span class="tn-ui-skeleton"></span></div></div>
      </section>

      <section id="timeline" class="tn-ui-panel tn-workspace-section">
        <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Timeline</p><h2>Історія угоди</h2><p>Activities, communications, domain events та COS actions в одному chronological view (хронологічному вигляді).</p></div><span><?php echo count($timeline); ?></span></div>
        <div class="tn-sales-timeline">
          <?php foreach ($timeline as $item): ?><article class="tn-sales-timeline-item"><span class="tn-sales-timeline-type"><?php echo $h($item['item_type'] ?? 'EVENT'); ?></span><div><strong><?php echo $h($item['title'] ?? $item['subtype'] ?? $item['item_type'] ?? 'Event'); ?></strong><p><?php echo $h($item['detail'] ?? ''); ?></p></div><div class="tn-sales-timeline-meta"><?php if (!empty($item['status'])): ?><span><?php echo $h($item['status']); ?></span><?php endif; ?><time><?php echo $h($item['occurred_at'] ?? ''); ?></time></div></article><?php endforeach; ?>
          <?php if (!$timeline): ?><p class="tn-sales-empty">Історія ще порожня.</p><?php endif; ?>
