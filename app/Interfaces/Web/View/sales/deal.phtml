            <form class="tn-sales-stage-form" data-sales-stage-form>
              <label class="tn-ui-field"><span>Stage</span><select class="tn-ui-select" name="stage_id" data-sales-stage-select><?php foreach ($stages as $stage): ?><option value="<?php echo $h($stage['id'] ?? ''); ?>" <?php echo (string)($stage['id'] ?? '') === (string)($deal['stage_id'] ?? '') ? 'selected' : ''; ?>><?php echo $h($stage['name'] ?? $stage['code'] ?? 'Stage'); ?> · <?php echo $h($stage['probability_default'] ?? 0); ?>%</option><?php endforeach; ?></select></label>
              <button class="tn-ui-button tn-ui-button--primary" type="submit">Змінити stage</button>
              <span class="tn-sales-inline-status" data-sales-stage-status aria-live="polite"></span>
            </form>
          <?php else: ?><p class="tn-sales-empty">Stage configuration недоступна для цієї угоди.</p><?php endif; ?>
