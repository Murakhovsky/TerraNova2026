<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$deal = $workspace['deal'] ?? null;
$timeline = $workspace['timeline'] ?? [];
$communications = $workspace['communications'] ?? [];
$approvals = $workspace['approvals'] ?? [];
$pipelines = $workspace['pipelines'] ?? [];
$owners = $workspace['owners'] ?? [];
$intelligence = $workspace['intelligence'] ?? [];
$money = static fn($v, $c = 'USD') => number_format((float) $v, 0, '.', ' ') . ' ' . ($c ?: 'USD');
$dt = static function ($v) { if (!$v) return ''; $t = strtotime((string) $v); return $t ? date('Y-m-d\TH:i', $t) : ''; };
$renderIntelligence = static function ($value): string {
    if ($value === null || $value === '' || $value === []) return '—';
    if (is_bool($value)) return $value ? 'Yes' : 'No';
    if (is_array($value)) {
        $parts = [];
        foreach ($value as $key => $item) {
            if (is_array($item)) $item = json_encode($item, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
            if ($item === null || $item === '') continue;
            $parts[] = is_string($key) ? $key . ': ' . (string) $item : (string) $item;
        }
        return $parts ? implode(' · ', $parts) : '—';
    }
    return (string) $value;
};
$decision = is_array($intelligence['decision'] ?? null) ? $intelligence['decision'] : [];
$actions = is_array($intelligence['actions'] ?? null) ? $intelligence['actions'] : [];
$firstAction = [];
foreach ($actions as $candidateAction) { if (is_array($candidateAction)) { $firstAction = $candidateAction; break; } }
$analysis = is_array($intelligence['analysis'] ?? null) ? $intelligence['analysis'] : [];
$signals = is_array($intelligence['signals'] ?? null) ? $intelligence['signals'] : [];
$pick = static function (...$values) {
    foreach ($values as $value) if ($value !== null && $value !== '' && $value !== []) return $value;
    return null;
};
$dealHealth = $pick($intelligence['deal_health'] ?? null, $analysis['deal_health'] ?? null, $decision['deal_health'] ?? null, $intelligence['health'] ?? null, $decision['risk_level'] ?? null);
$customerIntent = $pick($intelligence['customer_intent'] ?? null, $analysis['customer_intent'] ?? null, $signals['customer_intent'] ?? null, $decision['customer_intent'] ?? null);
$objections = $pick($intelligence['objections'] ?? null, $analysis['objections'] ?? null, $signals['objections'] ?? null);
$missingInformation = $pick($intelligence['missing_information'] ?? null, $analysis['missing_information'] ?? null, $signals['missing_information'] ?? null, $intelligence['missing_info'] ?? null);
$nextBestAction = $pick($intelligence['next_best_action'] ?? null, $analysis['next_best_action'] ?? null, $decision['next_best_action'] ?? null, $firstAction['reason'] ?? null, $firstAction['description'] ?? null, $firstAction['type'] ?? null);
$recommendedTiming = $pick($intelligence['recommended_timing'] ?? null, $analysis['recommended_timing'] ?? null, $decision['recommended_timing'] ?? null, $firstAction['recommended_at'] ?? null, $firstAction['execute_at'] ?? null);
$confidence = $pick($intelligence['confidence'] ?? null, $analysis['confidence'] ?? null, $decision['confidence'] ?? null);
$confidenceLabel = '—';
if (is_numeric($confidence)) {
    $confidenceValue = (float) $confidence;
    if ($confidenceValue <= 1) $confidenceValue *= 100;
    $confidenceLabel = number_format($confidenceValue, 0) . '%';
} elseif ($confidence !== null && $confidence !== '') $confidenceLabel = (string) $confidence;
$stages = [];
if ($deal) foreach ($pipelines as $p) if ((string) ($p['id'] ?? '') === (string) ($deal['pipeline_id'] ?? '')) { $stages = $p['stages'] ?? []; break; }
?>
<main class="tn-page tn-workspace-page tn-sales-workspace" data-sales-workspace>
  <?php $this->partial('components/sales/navigation', ['active' => 'deals']); ?>
  <?php if (!$deal): ?>
    <?php $this->partial('components/ui/state', ['kind' => 'empty', 'title' => 'Угоду не знайдено', 'message' => 'Угода не існує або недоступна в поточній організації.']); ?>
  <?php else: ?>
  <section data-sales-deal-workspace data-deal-id="<?php echo (int) $deal['id']; ?>" data-csrf="<?php echo $h($csrfToken ?? ''); ?>">
    <?php $this->partial('components/ui/page_header', [
        'eyebrow' => 'Deal workspace · ' . ($deal['public_id'] ?? ''),
        'title' => $deal['customer'] ?? $deal['title'] ?? 'Deal',
        'description' => ($deal['pipeline_name'] ?? 'Pipeline') . ' · ' . ($deal['stage_name'] ?? $deal['stage_code'] ?? ''),
        'actions' => [['label' => 'Pipeline', 'href' => 'sales/pipeline?pipeline_id=' . urlencode((string) ($deal['pipeline_id'] ?? '')), 'variant' => 'ghost'], ['label' => 'All deals', 'href' => 'sales/deals', 'variant' => 'primary']],
    ]); ?>
    <nav class="tn-ui-tabs tn-sales-anchor-tabs"><a href="#overview" class="is-active">Overview</a><a href="#work">Work</a><a href="#communications">Communications</a><a href="#intelligence">Intelligence</a><a href="#timeline">Timeline</a></nav>

    <section id="overview" class="tn-ui-kpi-grid tn-workspace-section tn-sales-deal-kpis">
      <?php $this->partial('components/ui/kpi_card', ['label' => 'Value', 'value' => $money($deal['value'] ?? 0, $deal['currency'] ?? 'USD')]); ?>
      <?php $this->partial('components/ui/kpi_card', ['label' => 'Weighted', 'value' => $money($deal['weighted_value'] ?? 0, $deal['currency'] ?? 'USD')]); ?>
      <?php $this->partial('components/ui/kpi_card', ['label' => 'Probability', 'value' => ($deal['probability'] ?? 0) . '%']); ?>
      <?php $this->partial('components/ui/kpi_card', ['label' => 'Owner', 'value' => $deal['owner_name'] ?: 'Unassigned']); ?>
      <?php $this->partial('components/ui/kpi_card', ['label' => !empty($deal['stage_age_estimated']) ? 'Days in stage (estimated legacy)' : 'Days in stage', 'value' => ($deal['days_in_stage'] ?? 0) . ' d']); ?>
    </section>

    <div class="tn-ui-split tn-workspace-section">
      <section class="tn-ui-panel"><div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Next Action</p><h2><?php echo $h($deal['next_contact_at'] ?: 'Not set'); ?></h2><p><?php echo $h($deal['attention_reason'] ?: 'No attention signal'); ?></p></div></div></section>
      <section class="tn-ui-panel"><div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Customer</p><h2><?php echo $h($deal['customer'] ?? ''); ?></h2></div></div><div class="tn-sales-contact"><span><?php echo $h($deal['phone'] ?: 'Телефон не вказано'); ?></span><span><?php echo $h($deal['email'] ?: 'Email не вказано'); ?></span><span><?php echo $h($deal['telegram'] ?: 'Telegram не вказано'); ?></span></div></section>
    </div>

    <section id="work" class="tn-workspace-section">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Manager operations</p><h2>Що робимо далі</h2></div></div>
      <div class="tn-ui-split">
        <section class="tn-ui-panel"><h3>Stage</h3><form class="tn-sales-stage-form" data-sales-stage-form><label class="tn-ui-field"><span>Stage</span><select class="tn-ui-select" name="stage_id" data-sales-stage-select><?php foreach ($stages as $s): ?><option value="<?php echo $h($s['id'] ?? ''); ?>" <?php echo (string) ($s['id'] ?? '') === (string) ($deal['stage_id'] ?? '') ? 'selected' : ''; ?>><?php echo $h($s['name'] ?? $s['code'] ?? 'Stage'); ?></option><?php endforeach; ?></select></label><button class="tn-ui-button tn-ui-button--primary">Change stage</button><span data-sales-stage-status class="tn-sales-inline-status"></span></form></section>
        <section class="tn-ui-panel"><h3>Owner</h3><form data-sales-operation-form data-operation="owner" class="tn-sales-operation-form"><select class="tn-ui-select" name="owner_id"><option value="">Choose</option><?php foreach ($owners as $o): ?><option value="<?php echo (int) $o['id']; ?>" <?php echo (int) ($deal['assigned_user_id'] ?? 0) === (int) $o['id'] ? 'selected' : ''; ?>><?php echo $h($o['full_name'] ?? $o['email'] ?? ('#' . $o['id'])); ?></option><?php endforeach; ?></select><button class="tn-ui-button tn-ui-button--primary">Assign</button><span data-sales-operation-status class="tn-sales-inline-status"></span></form></section>
      </div>
      <div class="tn-ui-split">
        <section class="tn-ui-panel"><h3>Priority & next contact</h3><form data-sales-operation-form data-operation="quick" class="tn-sales-operation-form"><select class="tn-ui-select" name="priority"><?php foreach (['low','normal','high','urgent'] as $v): ?><option value="<?php echo $v; ?>" <?php echo ($deal['priority'] ?? 'normal') === $v ? 'selected' : ''; ?>><?php echo ucfirst($v); ?></option><?php endforeach; ?></select><input class="tn-ui-input" type="datetime-local" name="next_contact_at" value="<?php echo $h($dt($deal['next_contact_at'] ?? null)); ?>"><button class="tn-ui-button tn-ui-button--primary">Save</button><span data-sales-operation-status></span></form></section>
        <section class="tn-ui-panel"><h3>Follow-up</h3><form data-sales-operation-form data-operation="followup" class="tn-sales-operation-form"><input class="tn-ui-input" name="title" value="Follow-up"><input class="tn-ui-input" type="datetime-local" name="due_at" required><textarea class="tn-ui-input" name="body" rows="2"></textarea><button class="tn-ui-button tn-ui-button--primary">Schedule</button><span data-sales-operation-status></span></form></section>
      </div>
      <div class="tn-ui-split">
        <section class="tn-ui-panel"><h3>Meeting</h3><form data-sales-operation-form data-operation="meeting" class="tn-sales-operation-form"><input class="tn-ui-input" name="title" value="Sales meeting"><input class="tn-ui-input" type="datetime-local" name="scheduled_at" required><input class="tn-ui-input" name="location" placeholder="Location / link"><button class="tn-ui-button tn-ui-button--primary">Schedule</button><span data-sales-operation-status></span></form></section>
        <section class="tn-ui-panel"><h3>Log contact</h3><form data-sales-operation-form data-operation="activity" class="tn-sales-operation-form"><select class="tn-ui-select" name="activity_type"><option value="note">Note</option><option value="call">Completed call</option></select><input class="tn-ui-input" name="title" value="Нотатка"><textarea class="tn-ui-input" name="body" rows="2"></textarea><button class="tn-ui-button tn-ui-button--primary">Add</button><span data-sales-operation-status></span></form></section>
      </div>
    </section>

    <section id="communications" class="tn-ui-panel tn-workspace-section">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Communications</p><h2>Діалог з клієнтом</h2></div><span><?php echo count($communications); ?></span></div>
      <form data-sales-operation-form data-operation="message" class="tn-sales-operation-form tn-sales-message-form"><select class="tn-ui-select" name="channel"><option>WEB</option><option>EMAIL</option><option>TELEGRAM</option><option>WHATSAPP</option><option>VIBER</option></select><textarea class="tn-ui-input" name="body" rows="3" required></textarea><button class="tn-ui-button tn-ui-button--primary">Send Message</button><span data-sales-operation-status></span></form>
      <div class="tn-sales-communications"><?php foreach ($communications as $c): ?><article class="tn-sales-message tn-sales-message--<?php echo strtolower($h($c['direction'] ?? 'inbound')); ?>"><header><strong><?php echo $h(($c['direction'] ?? '') . ' · ' . ($c['channel'] ?? '')); ?></strong><time><?php echo $h($c['occurred_at'] ?? ''); ?></time></header><p><?php echo nl2br($h($c['body'] ?? '')); ?></p></article><?php endforeach; ?></div>
    </section>

    <?php if ($approvals): ?><section class="tn-ui-panel tn-workspace-section"><div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Approvals</p><h2>Потрібне рішення менеджера</h2></div></div><div class="tn-sales-approval-list"><?php foreach ($approvals as $a): ?><article data-sales-approval data-approval-id="<?php echo $h($a['approval_id'] ?? ''); ?>"><div><strong><?php echo $h($a['action_type'] ?? 'Action'); ?></strong><p><?php echo $h($a['approval_reason'] ?? 'Approval required'); ?></p></div><div class="tn-sales-quick-actions"><button type="button" class="tn-ui-button tn-ui-button--primary tn-ui-button--sm" data-decision="approve">Approve</button><button type="button" class="tn-ui-button tn-ui-button--ghost tn-ui-button--sm" data-decision="reject">Reject</button></div></article><?php endforeach; ?></div></section><?php endif; ?>

    <section id="intelligence" class="tn-ui-panel tn-workspace-section tn-sales-intelligence">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">COS Intelligence</p><h2>Deal intelligence cockpit</h2><p>Структурований контекст для рішення менеджера. COS actions нижче лишаються Kernel-controlled.</p></div><button type="button" class="tn-ui-button tn-ui-button--ghost" data-sales-intelligence-refresh>Оновити actions</button></div>
      <div class="tn-ui-kpi-grid tn-sales-mini-kpis">
        <?php foreach ([
            ['Deal Health', $renderIntelligence($dealHealth)],
            ['Customer Intent', $renderIntelligence($customerIntent)],
            ['Objections', $renderIntelligence($objections)],
            ['Missing Information', $renderIntelligence($missingInformation)],
            ['Next Best Action', $renderIntelligence($nextBestAction)],
            ['Recommended Timing', $renderIntelligence($recommendedTiming)],
            ['Confidence', $confidenceLabel],
        ] as [$label, $value]) $this->partial('components/ui/kpi_card', ['label' => $label, 'value' => $value]); ?>
      </div>
      <div data-sales-intelligence></div>
    </section>

    <section id="timeline" class="tn-ui-panel tn-workspace-section"><div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Timeline</p><h2>Історія угоди</h2></div></div><div class="tn-sales-timeline"><?php foreach ($timeline as $item): ?><article class="tn-sales-timeline-item"><span class="tn-sales-timeline-type"><?php echo $h($item['item_type'] ?? 'EVENT'); ?></span><div><strong><?php echo $h($item['title'] ?? $item['subtype'] ?? 'Event'); ?></strong><p><?php echo $h($item['detail'] ?? ''); ?></p></div><div class="tn-sales-timeline-meta"><span><?php echo $h($item['status'] ?? ''); ?></span><time><?php echo $h($item['occurred_at'] ?? ''); ?></time></div></article><?php endforeach; ?></div></section>
  </section>
