<?php
$h = static fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$workspace = $workspace ?? [];
$deal = $workspace['deal'] ?? null;
$timeline = $workspace['timeline'] ?? [];
$pipelines = $workspace['pipelines'] ?? [];
$money = static fn($v, $currency = 'USD') => number_format((float) $v, 0, '.', ' ') . ' ' . ($currency ?: 'USD');
$stages = [];
if ($deal) {
    foreach ($pipelines as $pipeline) {
        if ((string)($pipeline['id'] ?? '') === (string)($deal['pipeline_id'] ?? '')) { $stages = $pipeline['stages'] ?? []; break; }
    }
}
?>
