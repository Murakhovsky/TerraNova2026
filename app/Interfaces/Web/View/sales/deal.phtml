      <section id="overview" class="tn-ui-kpi-grid tn-workspace-section tn-sales-deal-kpis">
        <?php $this->partial('components/ui/kpi_card', ['label' => 'Value', 'value' => $money($deal['value'] ?? 0, $deal['currency'] ?? 'USD')]); ?>
        <?php $this->partial('components/ui/kpi_card', ['label' => 'Probability', 'value' => ($deal['probability'] ?? 0) . '%']); ?>
        <?php $this->partial('components/ui/kpi_card', ['label' => 'Owner', 'value' => $deal['owner_name'] ?: 'Unassigned']); ?>
        <?php $this->partial('components/ui/kpi_card', ['label' => 'Priority', 'value' => $deal['priority'] ?? 'normal', 'tone' => in_array(($deal['priority'] ?? ''), ['high','urgent'], true) ? 'danger' : 'neutral']); ?>
        <?php $this->partial('components/ui/kpi_card', ['label' => 'Next action', 'value' => $deal['next_contact_at'] ?: '—', 'tone' => !empty($deal['next_contact_at']) && strtotime((string)$deal['next_contact_at']) < time() ? 'warning' : 'neutral']); ?>
      </section>

      <div class="tn-ui-split tn-workspace-section">
        <section class="tn-ui-panel">
          <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Customer</p><h2>Контакт</h2></div></div>
          <div class="tn-sales-contact"><strong><?php echo $h($deal['customer'] ?? ''); ?></strong><span><?php echo $h($deal['phone'] ?: 'Телефон не вказано'); ?></span><span><?php echo $h($deal['email'] ?: 'Email не вказано'); ?></span><span><?php echo $h($deal['telegram'] ?: 'Telegram не вказано'); ?></span></div>
