<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$overview = $overview ?? [];
$stats = $overview['stats'] ?? [];
$events = $overview['events'] ?? [];
$decisions = $overview['decisions'] ?? [];
$actions = $overview['actions'] ?? [];
$approvals = $overview['approvals'] ?? [];
$results = $overview['results'] ?? [];
$audit = $overview['audit'] ?? [];
$agentRuns = $overview['agent_runs'] ?? [];
$rules = $overview['rules'] ?? [];
$policies = $overview['policies'] ?? [];
$integrations = $overview['integrations'] ?? [];
$json = static function ($value): string {
    if ($value === null || $value === '') return '—';
    $decoded = is_string($value) ? json_decode($value, true) : $value;
    return json_last_error() === JSON_ERROR_NONE || !is_string($value)
        ? (string) json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)
        : (string) $value;
};
$shortId = static fn($value) => substr((string) $value, 0, 8);
$statusTone = static function ($status): string {
    $value = strtoupper(str_replace('-', '_', trim((string) $status)));
    if (in_array($value, ['ACTIVE', 'ENABLED', 'ALLOW', 'APPROVED', 'EXECUTED', 'COMPLETED', 'SUCCESS', 'SUCCEEDED', 'WON', 'CONNECTED'], true)) return 'positive';
    if (in_array($value, ['FAILED', 'ERROR', 'REJECTED', 'DENY', 'DENIED', 'DEAD', 'BLOCKED', 'CANCELLED'], true)) return 'danger';
    if (in_array($value, ['PENDING', 'PENDING_APPROVAL', 'QUEUED', 'RETRY', 'WARNING'], true)) return 'warning';
    if (in_array($value, ['RUNNING', 'PROPOSED', 'PROCESSING', 'INFO'], true)) return 'info';
    return 'neutral';
};
$actionStatus = $actionStatus ?? null;
$pageStatus = $pageStatus ?? null;
$csrfToken = $csrfToken ?? '';
$kpis = [
    ['label' => 'Events', 'value' => $stats['events'] ?? 0],
    ['label' => 'Decisions', 'value' => $stats['decisions'] ?? 0],
    ['label' => 'Open Actions', 'value' => $stats['open_actions'] ?? 0, 'tone' => 'brand'],
    ['label' => 'Approvals', 'value' => $stats['pending_approvals'] ?? 0, 'tone' => ((int) ($stats['pending_approvals'] ?? 0)) > 0 ? 'warning' : 'neutral'],
    ['label' => 'Results', 'value' => $stats['completed_results'] ?? 0, 'tone' => 'positive'],
    ['label' => 'Dead jobs', 'value' => $stats['dead_jobs'] ?? 0, 'tone' => ((int) ($stats['dead_jobs'] ?? 0)) > 0 ? 'danger' : 'neutral'],
    ['label' => 'Active Rules', 'value' => $stats['active_rules'] ?? 0],
    ['label' => 'Agent runs 24h', 'value' => $stats['agent_runs_24h'] ?? 0],
];
$tabs = [
    ['key' => 'events', 'label' => 'Events', 'href' => '#events'],
    ['key' => 'rules', 'label' => 'Rules', 'href' => '#rules'],
    ['key' => 'agents', 'label' => 'Agents', 'href' => '#agents'],
    ['key' => 'policies', 'label' => 'Policies', 'href' => '#policies'],
    ['key' => 'integrations', 'label' => 'Integrations', 'href' => '#integrations'],
    ['key' => 'decisions', 'label' => 'Decisions', 'href' => '#decisions'],
    ['key' => 'actions', 'label' => 'Proposed Actions', 'href' => '#actions'],
    ['key' => 'approvals', 'label' => 'Approvals', 'href' => '#approvals'],
    ['key' => 'results', 'label' => 'Results', 'href' => '#results'],
    ['key' => 'audit', 'label' => 'Audit', 'href' => '#audit'],
];

$eventRows = [];
foreach ($events as $event) {
    $eventRows[] = [
        'event' => ['primary' => (string) ($event['type'] ?? ''), 'secondary' => $shortId($event['id'] ?? '')],
        'aggregate' => (string) (($event['aggregate_type'] ?? '') . ' #' . ($event['aggregate_id'] ?? '')),
        'payload' => ['kind' => 'details', 'summary' => 'JSON', 'content' => $json($event['payload'] ?? null)],
        'occurred' => (string) ($event['occurred_at'] ?? ''),
        'correlation' => $shortId($event['correlation_id'] ?? ''),
    ];
}

$ruleRows = [];
foreach ($rules as $rule) {
    $ruleRows[] = [
        'rule' => ['primary' => (string) ($rule['name'] ?? ''), 'secondary' => (string) ($rule['code'] ?? '')],
        'trigger' => (string) ($rule['trigger_type'] ?? ''),
        'status' => ['label' => (string) ($rule['status'] ?? ''), 'tone' => $statusTone($rule['status'] ?? '')],
        'priority' => (string) (int) ($rule['priority'] ?? 0),
        'effect' => ['kind' => 'details', 'summary' => 'Configuration', 'content' => $json($rule['effect'] ?? null)],
    ];
}

$agentRows = [];
foreach ($agentRuns as $run) {
    $confidence = $run['confidence'] ?? null;
    $agentRows[] = [
        'agent' => ['primary' => (string) ($run['agent_name'] ?? ''), 'secondary' => trim((string) ($run['agent_version'] ?? '') . ' · ' . (string) ($run['model'] ?? ''), ' ·')],
        'subject' => (string) (($run['subject_type'] ?? '') ?: '—') . ' #' . (string) (($run['subject_id'] ?? '') ?: '—'),
        'status' => ['label' => (string) ($run['status'] ?? ''), 'tone' => $statusTone($run['status'] ?? '')],
        'confidence' => $confidence !== null ? (string) round((float) $confidence * 100) . '%' : '—',
        'runtime' => (string) ((int) ($run['duration_ms'] ?? 0)) . ' ms',
    ];
}

$policyRows = [];
foreach ($policies as $policy) {
    $policyRows[] = [
        'policy' => ['primary' => (string) ($policy['name'] ?? ''), 'secondary' => (string) ($policy['code'] ?? '')],
        'action' => (string) ($policy['action_type'] ?? ''),
        'decision' => ['label' => (string) ($policy['decision'] ?? ''), 'tone' => $statusTone($policy['decision'] ?? '')],
        'status' => ['label' => (string) ($policy['status'] ?? ''), 'tone' => $statusTone($policy['status'] ?? '')],
    ];
}

$integrationRows = [];
foreach ($integrations as $integration) {
    $integrationRows[] = [
        'name' => (string) ($integration['name'] ?? ''),
        'provider' => (string) ($integration['provider'] ?? ''),
        'type' => (string) ($integration['type'] ?? ''),
        'status' => ['label' => (string) ($integration['status'] ?? ''), 'tone' => $statusTone($integration['status'] ?? '')],
    ];
}

$resultRows = [];
foreach ($results as $result) {
    $error = (string) ($result['error'] ?? '');
    $resultRows[] = [
        'action' => ['primary' => (string) ($result['action_type'] ?? ''), 'secondary' => (string) ((($result['target_type'] ?? '') ?: '—') . ' #' . (($result['target_id'] ?? '') ?: '—'))],
        'attempt' => '#' . (string) (int) ($result['attempt'] ?? 0),
        'status' => ['label' => (string) ($result['status'] ?? ''), 'tone' => $statusTone($result['status'] ?? '')],
        'output' => ['kind' => 'details', 'summary' => $error !== '' ? 'Error' : 'Output', 'content' => $error !== '' ? $error : $json($result['result'] ?? null)],
        'finished' => (string) ($result['finished_at'] ?? ''),
    ];
}
?>

