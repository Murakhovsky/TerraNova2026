    ['key' => 'events', 'label' => 'Events', 'href' => '#events'],
    ['key' => 'rules', 'label' => 'Rules', 'href' => '#rules'],
    ['key' => 'agents', 'label' => 'Agents', 'href' => '#agents'],
    ['key' => 'policies', 'label' => 'Policies', 'href' => '#policies'],
    ['key' => 'integrations', 'label' => 'Integrations', 'href' => '#integrations'],
    ['key' => 'decisions', 'label' => 'Decisions', 'href' => '#decisions'],
    ['key' => 'actions', 'label' => 'Proposed Actions', 'href' => '#actions'],
    ['key' => 'approvals', 'label' => 'Approvals', 'href' => '#approvals'],
    ['key' => 'results', 'label' => 'Results', 'href' => '#results'],
    ['key' => 'audit', 'label' => 'Audit', 'href' => '#audit'],
];
