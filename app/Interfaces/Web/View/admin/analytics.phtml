<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$report = is_array($report ?? null) ? $report : [];
$summary = is_array($report['summary'] ?? null) ? $report['summary'] : [];
$daily = is_array($report['daily'] ?? null) ? $report['daily'] : [];
$topProperties = is_array($report['top_properties'] ?? null) ? $report['top_properties'] : [];
$sources = is_array($report['sources'] ?? null) ? $report['sources'] : [];
$pageStatus = $pageStatus ?? null;
$days = (int) ($report['days'] ?? 30);

$dailyRows = array_map(static fn(array $row): array => [
    'date' => (string) ($row['event_date'] ?? ''),
    'views' => (int) ($row['property_views'] ?? 0),
    'cta' => (int) ($row['cta'] ?? 0),
    'leads' => (int) ($row['leads'] ?? 0),
], array_values(array_filter($daily, 'is_array')));

$propertyRows = [];
foreach ($topProperties as $row) {
    if (!is_array($row)) continue;
    $views = (int) ($row['property_views'] ?? 0);
    $leads = (int) ($row['leads'] ?? 0);
    $propertyRows[] = [
        '_href' => 'property/show/' . (string) ($row['slug'] ?? ''),
        'property' => [
            'primary' => trim((string) ($row['public_id'] ?? '') . ' / ' . (string) ($row['title'] ?? ''), ' /'),
            'secondary' => (string) ($row['slug'] ?? ''),
        ],
        'views' => $views,
        'cta' => (int) ($row['cta'] ?? 0),
        'pdf' => (int) ($row['presentation_downloads'] ?? 0),
        'shares' => (int) ($row['presentation_shares'] ?? 0),
        'leads' => $leads,
        'conversion' => $views > 0 ? round($leads * 100 / $views, 1) . '%' : '—',
    ];
}
?>

<?php $this->partial('shared/manager_header', ['active' => 'analytics']); ?>

<main class="tn-page tn-workspace-page tn-workspace-page--wide tn-analytics-workspace">
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Аналітика',
    'title' => 'Попит і конверсії',
    'description' => 'Перегляди об’єктів, контактні дії та заявки за вибраний період.',
    'meta' => ['value' => $days, 'label' => 'днів у звіті'],
  ]); ?>

  <section class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar', [
      'method' => 'GET',
      'action' => 'admin/analytics',
      'fields' => [[
        'name' => 'days',
        'type' => 'select',
        'label' => 'Період',
        'value' => (string) $days,
        'options' => ['7' => '7 днів', '30' => '30 днів', '90' => '90 днів', '365' => '365 днів'],
      ]],
      'actions' => [[
        'label' => 'Оновити',
        'variant' => 'primary',
        'type' => 'submit',
      ]],
    ]); ?>
  </section>

  <?php if ($pageStatus): ?>
    <?php $this->partial('components/ui/state', [
      'kind' => 'error',
      'title' => 'Звіт недоступний',
      'message' => (string) $pageStatus,
    ]); ?>
  <?php else: ?>
    <section class="tn-ui-kpi-grid tn-workspace-section" aria-label="Ключові показники аналітики">
      <?php $this->partial('components/ui/kpi_card', [
        'label' => 'Перегляди карток',
        'value' => (int) ($summary['property_views'] ?? 0),
        'hint' => 'за період',
      ]); ?>
      <?php $this->partial('components/ui/kpi_card', [
        'label' => 'Контактні CTA',
        'value' => (int) ($summary['cta'] ?? 0),
        'hint' => (string) ($summary['view_to_cta'] ?? 0) . '% від переглядів',
      ]); ?>
      <?php $this->partial('components/ui/kpi_card', [
        'label' => 'Заявки',
        'value' => (int) ($summary['leads'] ?? 0),
        'hint' => (string) ($summary['view_to_lead'] ?? 0) . '% від переглядів',
        'href' => 'client-case/inbox',
        'tone' => 'brand',
      ]); ?>
      <?php $this->partial('components/ui/kpi_card', [
        'label' => 'Презентації',
        'value' => (int) ($summary['presentation_downloads'] ?? 0),
        'hint' => (int) ($summary['presentation_shares'] ?? 0) . ' підготовлено до надсилання',
      ]); ?>
    </section>

    <div class="tn-ui-split tn-workspace-section">
      <section class="tn-ui-panel tn-ui-panel--flush" id="daily">
        <div class="tn-ui-panel__head">
          <div><p class="tn-ui-eyebrow">Динаміка</p><h2>Останні дні</h2></div>
        </div>
        <?php $this->partial('components/ui/data_table', [
          'columns' => [
            ['key' => 'date', 'label' => 'Дата'],
            ['key' => 'views', 'label' => 'Перегляди'],
            ['key' => 'cta', 'label' => 'CTA'],
            ['key' => 'leads', 'label' => 'Заявки'],
          ],
          'rows' => $dailyRows,
          'responsive' => 'cards',
          'emptyMessage' => 'Подій за цей період ще немає.',
        ]); ?>
      </section>

      <section class="tn-ui-panel" id="sources">
        <div class="tn-ui-panel__head">
          <div><p class="tn-ui-eyebrow">Джерела</p><h2>UTM та прямі переходи</h2></div>
        </div>
        <div class="tn-dashboard-bars">
          <?php foreach ($sources as $row): if (!is_array($row)) continue; ?>
            <div><span><?php echo $h($row['source'] ?? ''); ?></span><strong><?php echo (int) ($row['events'] ?? 0); ?> / <?php echo (int) ($row['leads'] ?? 0); ?> лідів</strong></div>
          <?php endforeach; ?>
          <?php if ($sources === []): ?><p class="tn-muted">Джерела ще не зафіксовані.</p><?php endif; ?>
        </div>
      </section>
    </div>

    <section class="tn-ui-panel tn-ui-panel--flush tn-workspace-section" id="properties">
      <div class="tn-ui-panel__head">
        <div><p class="tn-ui-eyebrow">Об’єкти</p><h2>Попит за картками</h2></div>
      </div>
      <?php $this->partial('components/ui/data_table', [
        'columns' => [
          ['key' => 'property', 'label' => 'Об’єкт'],
          ['key' => 'views', 'label' => 'Перегляди'],
          ['key' => 'cta', 'label' => 'CTA'],
          ['key' => 'pdf', 'label' => 'PDF'],
          ['key' => 'shares', 'label' => 'Надіслано'],
          ['key' => 'leads', 'label' => 'Заявки'],
          ['key' => 'conversion', 'label' => 'Конверсія'],
        ],
        'rows' => $propertyRows,
        'responsive' => 'cards',
        'emptyMessage' => 'Даних по об’єктах ще немає.',
      ]); ?>
    </section>
  <?php endif; ?>
</main>
