<?php
$h=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');
$workspace=is_array($workspace??null)?$workspace:[];
$candidates=is_array($workspace['candidates']??null)?$workspace['candidates']:[];
$q=trim((string)$this->request->getQuery('q','string',''));
$status=trim((string)$this->request->getQuery('status','string',''));
$mode=trim((string)$this->request->getQuery('growth_mode','string',''));
$target=trim((string)$this->request->getQuery('target_domain','string',''));
$rows=[];
foreach($candidates as $candidate){
    $candidateStatus=strtolower((string)($candidate['status']??''));
    $tone=match($candidateStatus){
        'qualified','handed_off'=>'positive',
        'ready_for_handoff','handoff_pending'=>'info',
        'monitoring'=>'warning',
        'disqualified','rejected_by_target_domain'=>'danger',
        default=>'neutral',
    };
    $rows[]=[
        'opportunity'=>[
            'primary'=>$candidate['account_name']??$candidate['subject_id']??'Opportunity',
            'secondary'=>$candidate['candidate_id']??'',
        ],
        'type'=>$candidate['opportunity_type']??'—',
        'mode'=>$candidate['growth_mode']??'—',
        'status'=>['label'=>strtoupper($candidateStatus?:'unknown'),'tone'=>$tone],
        'signals'=>(int)($candidate['signal_count']??0),
        'target'=>$candidate['target_domain']??'—',
        'updated'=>$candidate['updated_at']??'—',
        '_href'=>'growth/candidates/'.rawurlencode((string)($candidate['candidate_id']??'')),
    ];
}
$statusOptions=[''=>'All statuses'];
foreach(['detected','enriching','researched','scored','qualified','ready_for_handoff','handoff_pending','handed_off','monitoring','disqualified','rejected_by_target_domain'] as $value)$statusOptions[$value]=ucwords(str_replace('_',' ',$value));
?>
<main class="tn-page tn-workspace-page tn-growth-workspace" data-growth-workspace>
  <?php $this->partial('components/ui/page_header',[
    'eyebrow'=>'Growth · Opportunity queue',
    'title'=>'Opportunity Candidates',
    'description'=>'Business opportunities stay candidates until evidence and policy justify a real handoff.',
    'actions'=>[['label'=>'Overview','href'=>'growth','variant'=>'ghost']],
    'meta'=>['value'=>count($candidates),'label'=>'in selection'],
  ]); ?>

  <div class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar',[
      'action'=>'growth/candidates',
      'method'=>'GET',
      'fields'=>[
        ['name'=>'q','type'=>'search','label'=>'Search','value'=>$q,'grow'=>true],
        ['name'=>'status','type'=>'select','label'=>'Status','value'=>$status,'options'=>$statusOptions],
        ['name'=>'growth_mode','type'=>'text','label'=>'Mode','value'=>$mode],
        ['name'=>'target_domain','type'=>'text','label'=>'Target Domain','value'=>$target],
      ],
      'actions'=>[['label'=>'Filter','type'=>'submit','variant'=>'primary']],
    ]); ?>
  </div>

  <section class="tn-ui-panel tn-workspace-section">
    <?php $this->partial('components/ui/data_table',[
      'columns'=>[
        ['key'=>'opportunity','label'=>'Opportunity'],
        ['key'=>'type','label'=>'Type'],
        ['key'=>'mode','label'=>'Mode'],
        ['key'=>'status','label'=>'Status'],
        ['key'=>'signals','label'=>'Signals'],
        ['key'=>'target','label'=>'Target'],
        ['key'=>'updated','label'=>'Updated'],
      ],
      'rows'=>$rows,
      'responsive'=>'cards',
      'emptyMessage'=>'No candidates match these filters.',
    ]); ?>
  </section>
</main>
