<?php
$h=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');
$workspace=is_array($workspace??null)?$workspace:[];
$signals=is_array($workspace['signals']??null)?$workspace['signals']:[];
$q=trim((string)$this->request->getQuery('q','string',''));
$signalType=trim((string)$this->request->getQuery('signal_type','string',''));
$subjectType=trim((string)$this->request->getQuery('subject_type','string',''));
$rows=[];
foreach($signals as $signal){
    $confidence=(float)($signal['confidence']??0);
    $rows[]=[
        'signal'=>[
            'primary'=>$signal['signal_type']??'Signal',
            'secondary'=>$signal['signal_id']??'',
        ],
        'subject'=>[
            'primary'=>$signal['subject_id']??'—',
            'secondary'=>$signal['subject_type']??'',
        ],
        'source'=>[
            'primary'=>$signal['collector_name']??'manual',
            'secondary'=>$signal['external_key']??($signal['source_reference']??''),
        ],
        'confidence'=>round($confidence*100).'%',
        'candidates'=>(int)($signal['candidate_count']??0),
        'occurred'=>$signal['occurred_at']??'—',
        'detected'=>$signal['detected_at']??'—',
    ];
}
?>
<main class="tn-page tn-workspace-page tn-growth-workspace">
  <?php $this->partial('components/ui/page_header',[
    'eyebrow'=>'Growth · Evidence stream',
    'title'=>'Signals',
    'description'=>'Observable facts only. Interpretation belongs to Research and Rationale, not to the signal record.',
    'actions'=>[
      ['label'=>'Collectors','href'=>'growth/collectors','variant'=>'primary'],
      ['label'=>'Overview','href'=>'growth','variant'=>'ghost'],
    ],
    'meta'=>['value'=>count($signals),'label'=>'in selection'],
  ]); ?>

  <div class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar',[
      'action'=>'growth/signals',
      'method'=>'GET',
      'fields'=>[
        ['name'=>'q','type'=>'search','label'=>'Search id / subject / source','value'=>$q,'grow'=>true],
        ['name'=>'signal_type','type'=>'text','label'=>'Signal type','value'=>$signalType],
        ['name'=>'subject_type','type'=>'text','label'=>'Subject type','value'=>$subjectType],
      ],
      'actions'=>[['label'=>'Filter','type'=>'submit','variant'=>'primary']],
    ]); ?>
  </div>

  <section class="tn-ui-panel tn-workspace-section">
    <?php $this->partial('components/ui/data_table',[
      'columns'=>[
        ['key'=>'signal','label'=>'Signal'],
        ['key'=>'subject','label'=>'Subject'],
        ['key'=>'source','label'=>'Source'],
        ['key'=>'confidence','label'=>'Confidence'],
        ['key'=>'candidates','label'=>'Candidates'],
        ['key'=>'occurred','label'=>'Occurred'],
        ['key'=>'detected','label'=>'Detected'],
      ],
      'rows'=>$rows,
      'responsive'=>'cards',
      'emptyMessage'=>'No signals match these filters.',
    ]); ?>
  </section>
</main>
