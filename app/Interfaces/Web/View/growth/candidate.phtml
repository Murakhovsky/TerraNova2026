      <?php if(!empty($attempt['reason'])): ?><p><?php echo $h($attempt['reason']); ?></p><?php endif; ?>
      <?php if(!empty($attempt['error_summary'])): ?><p class="tn-growth-error"><?php echo $h($attempt['error_summary']); ?></p><?php endif; ?>
    <?php endif; ?>

    <?php if(!empty($canManageGrowth)&&$status==='qualified'): ?>
      <form data-growth-handoff-prepare class="tn-growth-action-form">
        <label class="tn-ui-field"><span>Expected value</span><input class="tn-ui-input" name="expected_value" required value="<?php echo $h($candidate['expected_value']??''); ?>"></label>
        <label class="tn-ui-field"><span>Recommended play</span><input class="tn-ui-input" name="recommended_play" required value="<?php echo $h($candidate['recommended_play']??''); ?>"></label>
        <label class="tn-ui-field"><span>Recommended action</span><textarea class="tn-ui-input" name="recommended_action" rows="3" required><?php echo $h($candidate['recommended_action']??''); ?></textarea></label>
        <button class="tn-ui-button tn-ui-button--primary" type="submit">Prepare handoff</button>
        <span data-growth-form-status></span>
      </form>
    <?php elseif(!empty($canManageGrowth)&&$status==='ready_for_handoff'): ?>
      <button class="tn-ui-button tn-ui-button--primary" type="button" data-growth-action="handoff-dispatch">Dispatch to <?php echo $h($candidate['target_domain']??'target'); ?></button>
      <p class="tn-growth-action-status" data-growth-action-status></p>
    <?php elseif($status==='handoff_pending'): ?>
      <p class="tn-growth-muted">Handoff is in progress. Re-dispatch with the same operation identity is resumable through the API runtime.</p>
    <?php endif; ?>
  </section>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Learning</p><h2>Observed outcomes</h2></div><a href="<?php echo $this->url->get('growth/learning'); ?>">Open Growth Learning</a></div>
    <section class="tn-ui-kpi-grid">
      <?php foreach([
        ['Contacted',$learningCounts['contacted']??0,'neutral'],
        ['Qualified',$learningCounts['qualified']??0,'info'],
        ['Replies',$learningCounts['reply_received']??0,'info'],
        ['Meetings',$learningCounts['meeting_completed']??0,'info'],
        ['Won',$learningCounts['won']??0,'positive'],
        ['Lost',$learningCounts['lost']??0,'danger'],
      ] as [$label,$value,$tone]): ?>
        <?php $this->partial('components/ui/kpi_card',['label'=>$label,'value'=>$value,'tone'=>$tone]); ?>
      <?php endforeach; ?>
    </section>
    <?php if($learningOutcomes): ?>
      <div class="tn-growth-signal-list">
        <?php foreach(array_slice($learningOutcomes,0,8) as $outcome): ?>
          <article>
            <div><strong><?php echo $h(strtoupper((string)($outcome['outcome_type']??'outcome'))); ?></strong><small><?php echo $h($outcome['observed_at']??''); ?></small></div>
            <p><?php echo $h(($outcome['reference_type']??'').' : '.($outcome['reference_id']??'')); ?></p>
            <?php if(!empty($outcome['reason_code'])): ?><small><?php echo $h($outcome['reason_code']); ?><?php if(!empty($outcome['reason_text'])): ?> · <?php echo $h($outcome['reason_text']); ?><?php endif; ?></small><?php endif; ?>
            <?php if(array_key_exists('economic_value',$outcome)&&$outcome['economic_value']!==null): ?><small><?php echo $h($outcome['economic_value'].' '.($outcome['currency']??'')); ?></small><?php endif; ?>
          </article>
        <?php endforeach; ?>
      </div>
    <?php else: ?>
      <p class="tn-growth-muted">No downstream outcomes observed yet.</p>
    <?php endif; ?>
  </section>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Evidence</p><h2>Signals</h2></div><span><?php echo count($signals); ?></span></div>
    <div class="tn-growth-signal-list">
      <?php foreach($signals as $signal): ?>
        <article>
          <div><strong><?php echo $h($signal['signal_type']??'Signal'); ?></strong><small><?php echo $h($signal['occurred_at']??''); ?></small></div>
          <p><?php echo $h($signal['source_reference']??''); ?></p>
          <small>Confidence <?php echo round((float)($signal['confidence']??0)*100); ?>%</small>
        </article>
      <?php endforeach; ?>
      <?php if(!$signals): ?><p class="tn-growth-muted">No readable signals.</p><?php endif; ?>
    </div>
  </section>
</main>
