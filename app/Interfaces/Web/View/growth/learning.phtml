<?php
$h=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');
$workspace=is_array($workspace??null)?$workspace:[];
$learning=is_array($workspace['learning']??null)?$workspace['learning']:[];
$outcomes=is_array($workspace['outcomes']??null)?$workspace['outcomes']:[];
$counts=is_array($learning['counts']??null)?$learning['counts']:[];
$wonValues=is_array($learning['won_value_by_currency']??null)?$learning['won_value_by_currency']:[];
$topReasons=is_array($learning['top_reasons']??null)?$learning['top_reasons']:[];
$q=trim((string)$this->request->getQuery('q','string',''));
$outcomeType=trim((string)$this->request->getQuery('outcome_type','string',''));
$currency=strtoupper(trim((string)$this->request->getQuery('currency','string','')));
$outcomeOptions=[
  ''=>'All outcomes','contacted'=>'Contacted','qualified'=>'Qualified','disqualified'=>'Disqualified',
  'reply_received'=>'Reply received','meeting_completed'=>'Meeting completed','won'=>'Won','lost'=>'Lost',
];
$rows=[];
foreach($outcomes as $outcome){
    $type=strtolower((string)($outcome['outcome_type']??''));
    $tone=match($type){
        'won'=>'positive',
        'lost','disqualified'=>'danger',
        'qualified','reply_received','meeting_completed'=>'info',
        default=>'neutral',
    };
    $value=$outcome['economic_value']===null?'—':trim((string)$outcome['economic_value'].' '.(string)($outcome['currency']??''));
    $rows[]=[
        'outcome'=>[
            'primary'=>strtoupper($type?:'outcome'),
            'secondary'=>$outcome['outcome_id']??'',
        ],
        'opportunity'=>[
            'primary'=>$outcome['account_name']??$outcome['subject_id']??$outcome['candidate_id']??'Opportunity',
            'secondary'=>$outcome['candidate_id']??'',
        ],
        'status'=>['label'=>strtoupper($type?:'unknown'),'tone'=>$tone],
        'reference'=>[
            'primary'=>$outcome['reference_type']??'—',
            'secondary'=>$outcome['reference_id']??'',
        ],
        'reason'=>[
            'primary'=>$outcome['reason_code']??'—',
            'secondary'=>$outcome['reason_text']??'',
        ],
        'value'=>$value,
        'observed'=>$outcome['observed_at']??'—',
        '_href'=>'growth/candidates/'.rawurlencode((string)($outcome['candidate_id']??'')),
    ];
}
$valueSummary=$wonValues
  ? implode(' · ',array_map(static fn($currency,$value)=>$currency.' '.number_format((float)$value,0,'.',' '),array_keys($wonValues),array_values($wonValues)))
  : '—';
?>
<main class="tn-page tn-workspace-page tn-growth-workspace">
  <?php $this->partial('components/ui/page_header',[
    'eyebrow'=>'Growth · Closed-loop learning',
    'title'=>'Outcomes, not vanity metrics',
    'description'=>'Downstream Sales outcomes linked back to the Opportunity Candidate that created them. This is feedback evidence, not duplicated Sales state.',
    'actions'=>[
      ['label'=>'Opportunities','href'=>'growth/candidates','variant'=>'primary'],
      ['label'=>'Overview','href'=>'growth','variant'=>'ghost'],
    ],
    'meta'=>['value'=>$learning['outcome_total']??0,'label'=>'observed outcomes'],
  ]); ?>

  <section class="tn-ui-kpi-grid tn-workspace-section">
    <?php foreach([
      ['Candidates with feedback',$learning['candidate_total']??0,'neutral'],
      ['Contacted',$counts['contacted']??0,'neutral'],
      ['Qualified',$counts['qualified']??0,'info'],
      ['Replies',$counts['reply_received']??0,'info'],
      ['Meetings',$counts['meeting_completed']??0,'info'],
      ['Won',$counts['won']??0,'positive'],
      ['Lost',$counts['lost']??0,'danger'],
      ['Won value',$valueSummary,'positive'],
    ] as [$label,$value,$tone]): ?>
      <?php $this->partial('components/ui/kpi_card',['label'=>$label,'value'=>$value,'tone'=>$tone]); ?>
    <?php endforeach; ?>
  </section>

  <div class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar',[
      'action'=>'growth/learning',
      'method'=>'GET',
      'fields'=>[
        ['name'=>'q','type'=>'search','label'=>'Candidate / account / reference / reason','value'=>$q,'grow'=>true],
        ['name'=>'outcome_type','type'=>'select','label'=>'Outcome','value'=>$outcomeType,'options'=>$outcomeOptions],
        ['name'=>'currency','type'=>'text','label'=>'Currency','value'=>$currency],
      ],
      'actions'=>[['label'=>'Filter','type'=>'submit','variant'=>'primary']],
    ]); ?>
  </div>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Outcome stream</p><h2>Observed feedback</h2></div><span><?php echo count($outcomes); ?></span></div>
    <?php $this->partial('components/ui/data_table',[
      'columns'=>[
        ['key'=>'opportunity','label'=>'Opportunity'],
        ['key'=>'status','label'=>'Outcome'],
        ['key'=>'reference','label'=>'Sales reference'],
        ['key'=>'reason','label'=>'Reason'],
        ['key'=>'value','label'=>'Economic value'],
        ['key'=>'observed','label'=>'Observed'],
      ],
      'rows'=>$rows,
      'responsive'=>'cards',
      'emptyMessage'=>'No downstream outcomes match these filters.',
    ]); ?>
  </section>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Reason evidence</p><h2>Lost / disqualified reasons</h2></div></div>
    <?php if($topReasons): ?>
      <?php
      $reasonRows=[];
      foreach($topReasons as $reason){
          $reasonRows[]=[
              'outcome'=>strtoupper((string)($reason['outcome_type']??'')),
              'reason'=>$reason['reason_code']??'—',
              'count'=>(int)($reason['total']??0),
          ];
      }
      $this->partial('components/ui/data_table',[
        'columns'=>[
          ['key'=>'outcome','label'=>'Outcome'],
          ['key'=>'reason','label'=>'Reason code'],
          ['key'=>'count','label'=>'Count'],
        ],
        'rows'=>$reasonRows,
        'responsive'=>'cards',
      ]);
      ?>
    <?php else: ?>
      <p class="tn-growth-muted">No explicit lost or disqualified reason codes observed yet.</p>
    <?php endif; ?>
  </section>
</main>
