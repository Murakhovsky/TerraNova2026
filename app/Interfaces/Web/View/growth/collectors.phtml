<?php
$h=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');
$workspace=is_array($workspace??null)?$workspace:[];
$collectors=is_array($workspace['collectors']??null)?$workspace['collectors']:[];
$runs=is_array($workspace['runs']??null)?$workspace['runs']:[];
$collectorFilter=trim((string)$this->request->getQuery('collector_name','string',''));
$statusFilter=trim((string)$this->request->getQuery('status','string',''));
$collectorOptions=[''=>'All collectors'];
foreach($collectors as $collector)$collectorOptions[(string)$collector]=(string)$collector;
$statusOptions=[''=>'All statuses','running'=>'Running','completed'=>'Completed','partial'=>'Partial','failed'=>'Failed'];
$rows=[];
foreach($runs as $run){
    $status=strtolower((string)($run['status']??''));
    $tone=match($status){
        'completed'=>'positive',
        'partial'=>'warning',
        'failed'=>'danger',
        'running'=>'info',
        default=>'neutral',
    };
    $rows[]=[
        'run'=>[
            'primary'=>$run['collector_name']??'Collector',
            'secondary'=>$run['run_id']??'',
        ],
        'status'=>['label'=>strtoupper($status?:'unknown'),'tone'=>$tone],
        'accepted'=>(int)($run['accepted_count']??0),
        'duplicates'=>(int)($run['duplicate_count']??0),
        'failed'=>(int)($run['failed_count']??0),
        'cursor'=>$run['next_cursor']??'—',
        'started'=>$run['started_at']??'—',
        'finished'=>$run['finished_at']??'—',
    ];
}
?>
<main class="tn-page tn-workspace-page tn-growth-workspace" data-growth-collectors data-csrf="<?php echo $h($csrfToken??''); ?>">
  <?php $this->partial('components/ui/page_header',[
    'eyebrow'=>'Growth · Signal ingestion',
    'title'=>'Collectors',
    'description'=>'Provider-agnostic ingestion runtime with per-run accounting, dedupe, cursoring and explicit partial/failure states.',
    'actions'=>[
      ['label'=>'Signals','href'=>'growth/signals','variant'=>'ghost'],
      ['label'=>'Overview','href'=>'growth','variant'=>'ghost'],
    ],
  ]); ?>

  <?php if($collectors): ?>
    <section class="tn-growth-collector-grid tn-workspace-section">
      <?php foreach($collectors as $collector): ?>
        <article class="tn-ui-panel">
          <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Registered collector</p><h2><?php echo $h($collector); ?></h2></div></div>
          <?php if(!empty($canManageGrowth)): ?>
            <form data-growth-collector-run data-collector-name="<?php echo $h($collector); ?>" class="tn-growth-action-form">
              <label class="tn-ui-field"><span>Cursor</span><input class="tn-ui-input" name="cursor" placeholder="optional"></label>
              <label class="tn-ui-field"><span>Limit</span><input class="tn-ui-input" type="number" min="1" max="500" name="limit" value="100"></label>
              <button class="tn-ui-button tn-ui-button--primary" type="submit">Run collector</button>
              <span data-growth-form-status></span>
            </form>
          <?php else: ?>
            <p class="tn-growth-muted">Read-only access. MANAGE permission is required to run collectors.</p>
          <?php endif; ?>
        </article>
      <?php endforeach; ?>
    </section>
  <?php else: ?>
    <?php $this->partial('components/ui/state',[
      'kind'=>'empty',
      'title'=>'No collectors registered',
      'message'=>'The provider-agnostic runtime is ready, but no concrete SignalCollectorInterface adapter is registered yet.',
    ]); ?>
  <?php endif; ?>

  <div class="tn-workspace-section">
    <?php $this->partial('components/ui/filter_bar',[
      'action'=>'growth/collectors',
      'method'=>'GET',
      'fields'=>[
        ['name'=>'collector_name','type'=>'select','label'=>'Collector','value'=>$collectorFilter,'options'=>$collectorOptions],
        ['name'=>'status','type'=>'select','label'=>'Status','value'=>$statusFilter,'options'=>$statusOptions],
      ],
      'actions'=>[['label'=>'Filter','type'=>'submit','variant'=>'primary']],
    ]); ?>
  </div>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Run history</p><h2>Signal Collector Runs</h2></div><span><?php echo count($runs); ?></span></div>
    <?php $this->partial('components/ui/data_table',[
      'columns'=>[
        ['key'=>'run','label'=>'Run'],
        ['key'=>'status','label'=>'Status'],
        ['key'=>'accepted','label'=>'Accepted'],
        ['key'=>'duplicates','label'=>'Duplicates'],
        ['key'=>'failed','label'=>'Failed'],
        ['key'=>'cursor','label'=>'Next cursor'],
        ['key'=>'started','label'=>'Started'],
        ['key'=>'finished','label'=>'Finished'],
      ],
      'rows'=>$rows,
      'responsive'=>'cards',
      'emptyMessage'=>'No collector runs match these filters.',
    ]); ?>

    <?php foreach($runs as $run): ?>
      <?php if(!empty($run['error_summary'])): ?>
        <div class="tn-ui-alert tn-ui-alert--warning tn-growth-run-error">
          <strong><?php echo $h($run['collector_name']??'Collector'); ?>:</strong>
          <span><?php echo $h($run['error_summary']); ?></span>
        </div>
      <?php endif; ?>
    <?php endforeach; ?>
  </section>
</main>
