<script>(()=>{const r=document.querySelector('[data-sales-policy-admin]');if(!r)return;const c=r.dataset.csrf||'',read=f=>Object.fromEntries([...new FormData(f)].map(([k,v])=>[k,typeof v==='string'?v.trim():v])),post=async(u,p)=>{const x=await fetch(u,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-CSRF-Token':c,Accept:'application/json'},body:JSON.stringify(p)}),j=await x.json();if(!x.ok||!j.ok)throw new Error(j.error||'Policy request failed.');return j.data};r.querySelector('[data-create]')?.addEventListener('submit',async e=>{e.preventDefault();const s=r.querySelector('[data-create-status]');try{const p=read(e.currentTarget);p.enabled=p.enabled==='1';p.allowed_roles=p.allowed_roles?p.allowed_roles.split(/[ ,;]+/):[];p.conditions=JSON.parse(p.conditions||'[]');await post('/api/sales/admin/policies',p);location.reload()}catch(x){s.textContent=x.message}});r.querySelectorAll('[data-policy-row]').forEach(row=>{const f=row.querySelector('[data-edit]'),s=row.querySelector('[data-status]');f.addEventListener('submit',async e=>{e.preventDefault();try{const p=read(f);p.enabled=p.enabled==='1';p.conditions=JSON.parse(p.conditions||'[]');await post('/api/sales/admin/policies/'+encodeURIComponent(row.dataset.id),p);location.reload()}catch(x){s.textContent=x.message}});row.querySelector('[data-archive]').addEventListener('click',async()=>{try{await post('/api/sales/admin/policies/'+encodeURIComponent(row.dataset.id)+'/archive',{configuration_version:Number(f.configuration_version.value)});location.reload()}catch(x){s.textContent=x.message}})});r.querySelector('[data-preview]')?.addEventListener('submit',async e=>{e.preventDefault();const o=r.querySelector('[data-preview-result]');try{const x=await post('/api/sales/admin/policies/preview',read(e.currentTarget));o.textContent=`Decision: ${x.decision}\nMatched policy: ${x.matched_policy_name||x.matched_policy||'none'}\nReason: ${x.reason}\nExecuted: ${x.executed?'yes':'no'}`;}catch(x){o.textContent=x.message}})})();</script>
