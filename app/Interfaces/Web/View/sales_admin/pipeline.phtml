<script>(()=>{const send=async(u,c,d)=>{const r=await fetch(u,{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':c},body:JSON.stringify(d)}),j=await r.json();if(!r.ok)throw new Error(j.error||'Save failed');location.reload()};for(const f of document.querySelectorAll('[data-admin-json]'))f.addEventListener('submit',e=>{e.preventDefault();const d=Object.fromEntries(new FormData(f)),c=d.csrf_token;delete d.csrf_token;for(const k of ['version','pipeline_version','sort_order','probability_default'])if(k in d)d[k]=Number(d[k]);d.is_default=d.is_default==='1';send(f.dataset.url,c,d).catch(x=>{const s=f.querySelector('[data-admin-status]');if(s)s.textContent=x.message})});const r=document.querySelector('[data-reorder]');if(r)r.addEventListener('submit',e=>{e.preventDefault();send(r.dataset.url,r.dataset.csrf,{version:Number(r.dataset.version),stages:[...r.querySelectorAll('[data-stage-id]')].map(x=>({id:x.dataset.stageId,sort_order:Number(x.value)}))}).catch(x=>r.querySelector('[data-admin-status]').textContent=x.message)});const t=document.querySelector('[data-transitions]');if(t)t.addEventListener('submit',e=>{e.preventDefault();const z=[...t.querySelectorAll('[data-edge]:checked')].map(x=>{const k=x.dataset.from+':'+x.dataset.to,a=t.querySelector('[data-approval-for="'+k+'"]');return{from_stage_id:x.dataset.from,to_stage_id:x.dataset.to,requires_approval:!!a?.checked,conditions:[]}});send(t.dataset.url,t.dataset.csrf,{version:Number(t.dataset.version),transitions:z}).catch(x=>t.querySelector('[data-admin-status]').textContent=x.message)})})();</script>
