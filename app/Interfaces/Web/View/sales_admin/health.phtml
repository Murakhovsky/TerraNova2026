<?php
$health = is_array($administrationHealth ?? null) ? $administrationHealth : [];
$summary = is_array($health['summary'] ?? null) ? $health['summary'] : [];
$subsystems = is_array($health['subsystems'] ?? null) ? $health['subsystems'] : [];
$issues = is_array($health['issues'] ?? null) ? $health['issues'] : [];
$runtime = is_array($health['runtime'] ?? null) ? $health['runtime'] : [];
$e = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$status = strtoupper((string) ($health['status'] ?? 'UNKNOWN'));
$statusTone = $status === 'HEALTHY' ? 'positive' : ($status === 'ERROR' || $status === 'FAILED' ? 'danger' : 'warning');
$runtimeSections = [
    'failed_actions' => 'Failed actions',
    'problem_jobs' => 'Problem jobs',
    'pending_approvals' => 'Pending approvals',
    'agent_failures' => 'Agent failures',
    'crm_failures' => 'CRM inbox failures',
];
?>
<main class="tn-page tn-workspace-page tn-sales-workspace">
  <?php $this->partial('components/sales/navigation', ['active' => 'sales-admin']); ?>
  <?php $this->partial('components/ui/page_header', [
      'eyebrow' => 'Sales · Administration · Health',
      'title' => 'Health & Audit',
      'description' => 'Read-only operational control center over canonical Kernel and Platform runtime data.',
      'actions' => [
          ['label' => 'Integrations', 'href' => 'sales/admin/integrations', 'variant' => 'ghost'],
          ['label' => 'Sales Admin', 'href' => 'sales/admin', 'variant' => 'ghost'],
      ],
      'meta' => ['value' => $status, 'label' => 'overall status'],
  ]); ?>
  <?php if (!empty($pageStatus)): ?>
    <?php $this->partial('components/ui/state', ['kind' => 'error', 'title' => 'Sales health unavailable', 'message' => $pageStatus]); ?>
  <?php endif; ?>

  <section class="tn-ui-kpi-grid tn-workspace-section">
    <?php $this->partial('components/ui/kpi_card', ['label' => 'Overall status', 'value' => $status, 'tone' => $statusTone, 'hint' => $health['generated_at'] ?? '']); ?>
    <?php foreach ($subsystems as $name => $subsystemStatus): ?>
      <?php $sub = strtoupper((string) $subsystemStatus); ?>
      <?php $this->partial('components/ui/kpi_card', [
          'label' => ucfirst((string) $name),
          'value' => $sub,
          'tone' => $sub === 'HEALTHY' ? 'positive' : ($sub === 'ERROR' || $sub === 'FAILED' ? 'danger' : 'warning'),
      ]); ?>
    <?php endforeach; ?>
  </section>

  <?php if (!empty($issues['critical']) || !empty($issues['warnings'])): ?>
    <section class="tn-ui-panel tn-workspace-section">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Attention</p><h2>Issues</h2></div></div>
      <?php foreach (($issues['critical'] ?? []) as $issue): ?><p><?php $this->partial('components/ui/status_badge', ['label' => 'ERROR', 'tone' => 'danger']); ?> <?php echo $e($issue['message'] ?? ''); ?> · <?php echo $e($issue['count'] ?? 0); ?></p><?php endforeach; ?>
      <?php foreach (($issues['warnings'] ?? []) as $issue): ?><p><?php $this->partial('components/ui/status_badge', ['label' => 'DEGRADED', 'tone' => 'warning']); ?> <?php echo $e($issue['message'] ?? ''); ?> · <?php echo $e($issue['count'] ?? 0); ?></p><?php endforeach; ?>
    </section>
  <?php endif; ?>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Runtime</p><h2>Summary</h2></div></div>
    <dl class="tn-sales-summary-grid">
      <?php foreach ($summary as $key => $value): ?><div><dt><?php echo $e(str_replace('_', ' ', (string) $key)); ?></dt><dd><?php echo $e($value); ?></dd></div><?php endforeach; ?>
    </dl>
  </section>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Providers</p><h2>Integrations</h2></div><span><?php echo count((array) ($health['integrations'] ?? [])); ?></span></div>
    <div class="tn-sales-rule-list">
      <?php foreach (($health['integrations'] ?? []) as $integration): ?>
        <article class="tn-sales-rule-card">
          <div><strong><?php echo $e($integration['name'] ?? $integration['integration_key'] ?? ''); ?></strong><small><?php echo $e($integration['integration_key'] ?? ''); ?> · <?php echo $e($integration['provider'] ?? ''); ?></small></div>
          <div><?php $this->partial('components/ui/status_badge', [
              'label' => ($integration['status'] ?? '') . ' · ' . ($integration['health_status'] ?? 'UNKNOWN'),
              'tone' => ($integration['health_status'] ?? '') === 'HEALTHY' ? 'positive' : (($integration['health_status'] ?? '') === 'ERROR' ? 'danger' : 'warning'),
          ]); ?><small>Checked <?php echo $e($integration['last_health_check_at'] ?? 'never'); ?> · last success <?php echo $e($integration['last_success_at'] ?? 'never'); ?></small></div>
          <?php if (!empty($integration['last_error'])): ?><p class="tn-sales-note"><?php echo $e($integration['last_error']); ?></p><?php endif; ?>
        </article>
      <?php endforeach; ?>
      <?php if (empty($health['integrations'])): ?><p class="tn-sales-empty">No integrations configured.</p><?php endif; ?>
    </div>
  </section>

  <?php foreach ($runtimeSections as $key => $label): ?>
    <section class="tn-ui-panel tn-workspace-section">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Operational queue</p><h2><?php echo $e($label); ?></h2></div><span><?php echo count((array) ($runtime[$key] ?? [])); ?></span></div>
      <div class="tn-sales-rule-list">
        <?php foreach (($runtime[$key] ?? []) as $row): ?>
          <article class="tn-sales-rule-card">
            <div><strong><?php echo $e($row['type'] ?? $row['action_type'] ?? $row['agent_name'] ?? $row['event_type'] ?? $row['id'] ?? ''); ?></strong><small>correlation <?php echo $e($row['correlation_id'] ?? ''); ?></small></div>
            <div><?php if (!empty($row['status'])) $this->partial('components/ui/status_badge', ['label' => $row['status'], 'tone' => in_array(strtoupper((string) $row['status']), ['FAILED','ERROR'], true) ? 'danger' : 'warning']); ?><small><?php if (isset($row['target_type']) || isset($row['target_id'])): ?>target <?php echo $e($row['target_type'] ?? ''); ?>:<?php echo $e($row['target_id'] ?? ''); ?><?php endif; ?><?php if (isset($row['provider'])): ?> · provider <?php echo $e($row['provider']); ?><?php endif; ?></small></div>
            <?php foreach (['last_error', 'error', 'reason'] as $errorField): ?><?php if (!empty($row[$errorField])): ?><p class="tn-sales-note"><?php echo $e($row[$errorField]); ?></p><?php endif; ?><?php endforeach; ?>
          </article>
        <?php endforeach; ?>
        <?php if (empty($runtime[$key])): ?><p class="tn-sales-empty">No current items.</p><?php endif; ?>
      </div>
    </section>
  <?php endforeach; ?>

  <div class="tn-ui-split tn-workspace-section">
    <section class="tn-ui-panel">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Audit</p><h2>Audit timeline</h2></div></div>
      <?php foreach (($health['audit'] ?? []) as $row): ?><p><strong><?php echo $e($row['category'] ?? ''); ?></strong> · <?php echo $e($row['action'] ?? ''); ?><br><?php echo $e($row['actor_type'] ?? ''); ?>:<?php echo $e($row['actor_id'] ?? ''); ?> → <?php echo $e($row['subject_type'] ?? ''); ?>:<?php echo $e($row['subject_id'] ?? ''); ?><br><small><?php echo $e($row['created_at'] ?? ''); ?> · <?php echo $e($row['correlation_id'] ?? ''); ?></small><?php if (!empty($row['reason'])): ?><br><?php echo $e($row['reason']); ?><?php endif; ?></p><?php endforeach; ?>
      <?php if (empty($health['audit'])): ?><p class="tn-sales-empty">No audit records.</p><?php endif; ?>
    </section>

    <section class="tn-ui-panel">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Configuration</p><h2>Revisions</h2></div></div>
      <?php foreach (($health['configuration_revisions'] ?? []) as $row): ?><p><strong><?php echo $e($row['configuration_type'] ?? ''); ?></strong> · <?php echo $e($row['action'] ?? ''); ?> · v<?php echo $e($row['entity_version'] ?? ''); ?><br><code><?php echo $e($row['entity_id'] ?? ''); ?></code><br><small><?php echo $e($row['actor_type'] ?? ''); ?>:<?php echo $e($row['actor_id'] ?? ''); ?> · <?php echo $e($row['created_at'] ?? ''); ?></small></p><?php endforeach; ?>
      <?php if (empty($health['configuration_revisions'])): ?><p class="tn-sales-empty">No Sales configuration revisions.</p><?php endif; ?>
    </section>
  </div>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Observability</p><h2>Operational metrics</h2></div></div>
    <?php foreach (($health['metrics'] ?? []) as $metric): ?><p><code><?php echo $e($metric['metric'] ?? ''); ?></code> · <strong><?php echo $e($metric['value'] ?? ''); ?></strong> · <?php echo $e($metric['recorded_at'] ?? ''); ?></p><?php endforeach; ?>
    <?php if (empty($health['metrics'])): ?><p class="tn-sales-empty">No operational metrics recorded.</p><?php endif; ?>
  </section>
</main>
