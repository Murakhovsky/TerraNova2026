<?php
$agents = is_array($agents ?? null) ? $agents : [];
$rows = [];
foreach ($agents as $agent) {
    $name = (string) ($agent['agent_name'] ?? 'Agent');
    $profile = (string) ($agent['profile'] ?? 'default');
    $model = !empty($agent['model']) ? (string) $agent['model'] : 'platform model';
    $rows[] = [
        '_href' => 'sales/admin/agents/' . rawurlencode($name),
        'agent' => ['primary' => $name, 'secondary' => $profile . ' · ' . $model],
        'status' => ['label' => !empty($agent['enabled']) ? 'Enabled' : 'Disabled', 'tone' => !empty($agent['enabled']) ? 'positive' : 'neutral'],
        'confidence' => '≥ ' . (string) ($agent['confidence_threshold'] ?? '0'),
        'ownership' => (string) ($agent['ownership'] ?? 'SYSTEM'),
        'version' => 'v' . (int) ($agent['configuration_version'] ?? 1),
        'update' => !empty($agent['system_update_available']) ? 'Available' : 'Current',
    ];
}
?>
<main class="tn-page tn-workspace-page tn-sales-workspace tn-sales-agent-admin">
  <?php $this->partial('components/sales/navigation', ['active' => 'sales-agents']); ?>
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Sales · Administration · Intelligence',
    'title' => 'Sales Intelligence Agents',
    'description' => 'Business-facing configuration for Sales AI. Schema, safety boundaries and Agent Runtime stay Kernel/code-owned.',
    'actions' => [
      ['label' => 'Rules', 'href' => 'sales/admin/rules', 'variant' => 'ghost'],
      ['label' => 'Pipelines', 'href' => 'sales/admin/pipelines', 'variant' => 'ghost'],
    ],
  ]); ?>
  <?php if ($pageStatus ?? null): ?><?php $this->partial('components/ui/state', ['kind'=>'error','title'=>'Agents unavailable','message'=>$pageStatus]); ?><?php endif; ?>

  <section class="tn-ui-panel tn-ui-panel--flush tn-workspace-section">
    <div class="tn-ui-panel__head" style="padding:16px 18px 0"><div><p class="tn-ui-eyebrow">Configured agents</p><h2>Runtime profiles</h2></div><span><?php echo count($agents); ?></span></div>
    <?php $this->partial('components/ui/data_table', [
      'columns' => [
        ['key' => 'agent', 'label' => 'Agent'],
        ['key' => 'status', 'label' => 'Status'],
        ['key' => 'confidence', 'label' => 'Confidence'],
        ['key' => 'ownership', 'label' => 'Ownership'],
        ['key' => 'version', 'label' => 'Config'],
        ['key' => 'update', 'label' => 'System'],
      ],
      'rows' => $rows,
      'responsive' => 'cards',
      'emptyMessage' => 'Sales Intelligence agent configuration is not available.',
    ]); ?>
  </section>
</main>
