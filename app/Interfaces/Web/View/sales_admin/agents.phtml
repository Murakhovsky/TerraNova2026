<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$agents = is_array($agents ?? null) ? $agents : [];
?>
<main class="tn-page tn-workspace-page tn-sales-workspace tn-sales-agent-admin">
  <?php $this->partial('components/sales/navigation', ['active' => 'sales-agents']); ?>
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Sales · Administration · Intelligence',
    'title' => 'Sales Intelligence Agents',
    'description' => 'Business-facing configuration for Sales AI. Schema, safety boundaries and Agent Runtime stay Kernel/code-owned.',
    'actions' => [
      ['label' => 'Rules', 'href' => 'sales/admin/rules', 'variant' => 'ghost'],
      ['label' => 'Pipelines', 'href' => 'sales/admin/pipelines', 'variant' => 'ghost'],
    ],
  ]); ?>
  <?php if ($pageStatus ?? null): ?><?php $this->partial('components/ui/state', ['kind'=>'error','title'=>'Agents unavailable','message'=>$pageStatus]); ?><?php endif; ?>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Configured agents</p><h2>Runtime profiles</h2></div><span><?php echo count($agents); ?></span></div>
    <div class="tn-sales-rule-list">
      <?php foreach ($agents as $agent): ?>
        <a class="tn-sales-rule-card" href="<?php echo $this->url->get('sales/admin/agents/' . rawurlencode((string) ($agent['agent_name'] ?? ''))); ?>">
          <div><strong><?php echo $h($agent['agent_name'] ?? 'Agent'); ?></strong><small><?php echo $h($agent['profile'] ?? 'default'); ?><?php echo !empty($agent['model']) ? ' · ' . $h($agent['model']) : ' · platform model'; ?></small></div>
          <div><span class="tn-sales-rule-status" data-status="<?php echo !empty($agent['enabled']) ? 'ACTIVE' : 'DISABLED'; ?>"><?php echo !empty($agent['enabled']) ? 'ENABLED' : 'DISABLED'; ?></span><small>confidence ≥ <?php echo $h($agent['confidence_threshold'] ?? '0'); ?></small></div>
          <div><small><?php echo $h($agent['ownership'] ?? 'SYSTEM'); ?> · cfg v<?php echo (int) ($agent['configuration_version'] ?? 1); ?></small><?php if (!empty($agent['system_update_available'])): ?><span>System update available</span><?php endif; ?></div>
        </a>
      <?php endforeach; ?>
      <?php if ($agents === []): ?><p class="tn-sales-empty">Sales Intelligence agent configuration is not available.</p><?php endif; ?>
    </div>
  </section>
</main>
