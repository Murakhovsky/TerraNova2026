<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$rules = is_array($rules ?? null) ? $rules : [];
$catalog = is_array($ruleCatalog ?? null) ? $ruleCatalog : [];
$triggers = [];
foreach (($catalog['triggers'] ?? []) as $trigger) if (is_array($trigger)) $triggers[(string) ($trigger['canonical'] ?? '')] = (string) ($trigger['label'] ?? $trigger['canonical'] ?? 'Trigger');
$draftActions = array_values(array_filter((array) ($catalog['actions'] ?? []), static fn ($action): bool => is_array($action) && empty($action['required'])));
?>
<main class="tn-page tn-workspace-page tn-sales-workspace tn-sales-rule-admin" data-sales-rule-list data-csrf="<?php echo $h($csrfToken ?? ''); ?>">
  <?php $this->partial('components/sales/navigation', ['active' => 'sales-rules']); ?>
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Sales · Administration · Rules',
    'title' => 'Business Rule Editor',
    'description' => 'Керуйте Sales automation як бізнес-правилами. Runtime execution, policy та approvals залишаються Kernel-owned.',
    'actions' => [
      ['label' => 'Pipelines', 'href' => 'sales/admin/pipelines', 'variant' => 'ghost'],
      ['label' => 'Sales Admin', 'href' => 'sales/admin', 'variant' => 'ghost'],
    ],
  ]); ?>
  <?php if ($pageStatus ?? null): ?><?php $this->partial('components/ui/state', ['kind'=>'error','title'=>'Rules unavailable','message'=>$pageStatus]); ?><?php endif; ?>

  <script type="application/json" data-sales-rule-catalog><?php echo json_encode($catalog, JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES); ?></script>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">New automation</p><h2>Create draft rule</h2></div><span>DRAFT</span></div>
    <form class="tn-sales-rule-create" data-sales-rule-create>
      <label class="tn-ui-field"><span>Name</span><input class="tn-ui-input" name="name" required maxlength="220" placeholder="No activity 48h → Intelligence → Follow-up"></label>
      <label class="tn-ui-field"><span>Code</span><input class="tn-ui-input" name="code" pattern="sales\.[a-z0-9_.-]{3,140}" placeholder="sales.admin.no_activity_48h"></label>
      <label class="tn-ui-field"><span>WHEN</span><select class="tn-ui-input" name="trigger_key" required><?php foreach (($catalog['triggers'] ?? []) as $trigger): ?><option value="<?php echo $h($trigger['key'] ?? ''); ?>"><?php echo $h($trigger['label'] ?? 'Trigger'); ?></option><?php endforeach; ?></select></label>
      <label class="tn-ui-field"><span>Initial THEN</span><select class="tn-ui-input" name="action_type" required><?php foreach ($draftActions as $action): ?><option value="<?php echo $h($action['type'] ?? ''); ?>"><?php echo $h($action['label'] ?? $action['type'] ?? 'Action'); ?></option><?php endforeach; ?></select><small>Actions that require parameters can be added in the full editor.</small></label>
      <div class="tn-ui-actions"><button class="tn-ui-button tn-ui-button--primary" type="submit">Create draft</button><span data-sales-rule-create-status aria-live="polite"></span></div>
    </form>
  </section>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Configured rules</p><h2>Sales automation</h2></div><span><?php echo count($rules); ?></span></div>
    <div class="tn-sales-rule-list">
      <?php foreach ($rules as $rule): ?>
        <a class="tn-sales-rule-card" href="<?php echo $this->url->get('sales/admin/rules/' . rawurlencode((string) ($rule['id'] ?? ''))); ?>">
          <div><strong><?php echo $h($rule['name'] ?? $rule['code'] ?? 'Rule'); ?></strong><small><?php echo $h($rule['code'] ?? ''); ?></small></div>
          <div><span class="tn-sales-rule-status" data-status="<?php echo $h($rule['status'] ?? 'DRAFT'); ?>"><?php echo $h($rule['status'] ?? 'DRAFT'); ?></span><small><?php echo $h($triggers[(string) ($rule['trigger_type'] ?? '')] ?? $rule['trigger_type'] ?? ''); ?></small></div>
          <div><small><?php echo $h($rule['ownership'] ?? 'SYSTEM'); ?> · cfg v<?php echo (int) ($rule['configuration_version'] ?? 1); ?></small><?php if (!empty($rule['system_update_available'])): ?><span>System update available</span><?php endif; ?></div>
        </a>
      <?php endforeach; ?>
      <?php if ($rules === []): ?><p class="tn-sales-empty">Sales rules ще не provisioned.</p><?php endif; ?>
    </div>
  </section>
</main>
