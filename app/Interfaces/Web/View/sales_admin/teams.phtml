<script>
(() => {
    const root = document.querySelector('[data-sales-team-admin]');
    if (!root) return;
    const csrf = root.dataset.csrf || '';
    const request = async (url, payload) => {
        const response = await fetch(url, {
            method: 'POST',
            headers: {'Content-Type':'application/json','X-CSRF-Token':csrf},
            body: JSON.stringify({...payload, csrf_token: csrf})
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok || body.ok !== true) throw new Error(body.error || 'Request failed.');
        return body.data;
    };
    root.querySelector('[data-create-team]')?.addEventListener('submit', async event => {
        event.preventDefault();
        const form = event.currentTarget;
        try {
            await request('/api/sales/admin/teams', Object.fromEntries(new FormData(form).entries()));
            location.reload();
        } catch (error) { alert(error.message); }
    });
    root.querySelectorAll('[data-membership-form]').forEach(form => form.addEventListener('submit', async event => {
        event.preventDefault();
        const card = form.closest('[data-user-id]');
        const data = Object.fromEntries(new FormData(form).entries());
        if (!data.team_id) return;
        data.assignment_enabled = form.querySelector('[name="assignment_enabled"]').checked;
        data.approval_enabled = form.querySelector('[name="approval_enabled"]').checked;
        const teamId = data.team_id;
        delete data.team_id;
        try {
            await request(`/api/sales/admin/teams/${teamId}/members/${card.dataset.userId}`, data);
            location.reload();
        } catch (error) { alert(error.message); }
    }));
    root.querySelectorAll('[data-capabilities-form]').forEach(form => form.addEventListener('submit', async event => {
        event.preventDefault();
        const card = form.closest('[data-user-id]');
        const capabilities = [...form.querySelectorAll('input[name="capabilities[]"]:checked')].map(input => input.value);
        try {
            await request(`/api/sales/admin/users/${card.dataset.userId}/capabilities`, {capabilities});
        } catch (error) { alert(error.message); }
    }));
})();
</script>
