<?php
$h=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');
$workspace=is_array($workspace??null)?$workspace:[];
$experiments=is_array($workspace['experiments']??null)?$workspace['experiments']:[];
$dimensions=is_array($workspace['dimensions']??null)?$workspace['dimensions']:[];
$outcomes=is_array($workspace['outcomes']??null)?$workspace['outcomes']:[];
$statuses=is_array($workspace['statuses']??null)?$workspace['statuses']:[];
$q=trim((string)$this->request->getQuery('q','string',''));
$status=trim((string)$this->request->getQuery('status','string',''));
$dimension=trim((string)$this->request->getQuery('dimension','string',''));

$statusOptions=[''=>'All statuses'];
foreach($statuses as $value)$statusOptions[(string)$value]=ucwords(str_replace('_',' ',(string)$value));
$dimensionOptions=[''=>'All dimensions'];
foreach($dimensions as $value)$dimensionOptions[(string)$value]=ucwords(str_replace('_',' ',(string)$value));
$outcomeOptions=[];
foreach($outcomes as $value)$outcomeOptions[(string)$value]=ucwords(str_replace('_',' ',(string)$value));

$rows=[];
foreach($experiments as $experiment){
    $experimentStatus=strtolower((string)($experiment['status']??''));
    $tone=match($experimentStatus){
        'running'=>'positive',
        'paused'=>'warning',
        'completed'=>'info',
        'archived'=>'neutral',
        default=>'neutral',
    };
    $rows[]=[
        'experiment'=>[
            'primary'=>$experiment['name']??'Experiment',
            'secondary'=>$experiment['experiment_id']??'',
        ],
        'dimension'=>ucwords(str_replace('_',' ',(string)($experiment['dimension']??'—'))),
        'outcome'=>ucwords(str_replace('_',' ',(string)($experiment['primary_outcome']??'—'))),
        'variants'=>count(is_array($experiment['variants']??null)?$experiment['variants']:[]),
        'status'=>['label'=>strtoupper($experimentStatus?:'unknown'),'tone'=>$tone],
        'started'=>$experiment['started_at']??'—',
        '_href'=>'growth/experiments/'.rawurlencode((string)($experiment['experiment_id']??'')),
    ];
}
?>
