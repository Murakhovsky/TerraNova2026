<?php
$h=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');
$workspace=is_array($workspace??null)?$workspace:[];
$statusCounts=is_array($workspace['status_counts']??null)?$workspace['status_counts']:[];
$candidateRows=[];
foreach($workspace['recent_candidates']??[] as $candidate){
    $status=strtolower((string)($candidate['status']??''));
    $tone=match($status){
        'qualified','handed_off'=>'positive',
        'ready_for_handoff','handoff_pending'=>'info',
        'monitoring'=>'warning',
        'disqualified','rejected_by_target_domain'=>'danger',
        default=>'neutral',
    };
    $candidateRows[]=[
        'opportunity'=>[
            'primary'=>$candidate['account_name']??$candidate['subject_id']??$candidate['candidate_id']??'Opportunity',
            'secondary'=>$candidate['candidate_id']??'',
        ],
        'mode'=>$candidate['growth_mode']??'—',
        'status'=>['label'=>strtoupper($status?:'unknown'),'tone'=>$tone],
        'target'=>$candidate['target_domain']??'—',
        'updated'=>$candidate['updated_at']??'—',
        '_href'=>'growth/candidates/'.rawurlencode((string)($candidate['candidate_id']??'')),
    ];
}
$accountRows=[];
foreach($workspace['recent_accounts']??[] as $account){
    $accountRows[]=[
        'account'=>['primary'=>$account['name']??'Account','secondary'=>$account['canonical_domain']??''],
        'fit'=>$account['latest_fit_score']===null?'—':((int)$account['latest_fit_score']).'%',
        'candidates'=>(int)($account['candidate_count']??0),
        'contacts'=>(int)($account['contact_count']??0),
        '_href'=>'growth/accounts/'.rawurlencode((string)($account['account_id']??'')),
    ];
}
?>
<main class="tn-page tn-workspace-page tn-growth-workspace" data-growth-workspace>
  <?php $this->partial('components/ui/page_header',[
    'eyebrow'=>'Growth · Opportunity Intelligence',
    'title'=>'Find value before it becomes a lead',
    'description'=>'Signals, accounts, research, qualification and handoff in one evidence-backed operating surface.',
    'actions'=>[
      ['label'=>'Opportunities','href'=>'growth/candidates','variant'=>'primary'],
      ['label'=>'Accounts','href'=>'growth/accounts','variant'=>'ghost'],
    ],
  ]); ?>

  <section class="tn-ui-kpi-grid tn-workspace-section">
    <?php foreach([
      ['Opportunity Candidates',$workspace['candidate_total']??0,'neutral'],
      ['Qualified',$workspace['qualified_total']??0,'positive'],
      ['Ready for handoff',$workspace['ready_total']??0,'info'],
      ['Monitoring',$workspace['monitoring_total']??0,'warning'],
      ['Accounts',$workspace['account_total']??0,'neutral'],
      ['Signals',$workspace['signal_total']??0,'neutral'],
    ] as [$label,$value,$tone]): ?>
      <?php $this->partial('components/ui/kpi_card',['label'=>$label,'value'=>$value,'tone'=>$tone]); ?>
    <?php endforeach; ?>
  </section>

  <?php if(($workspace['research_running']??0)>0||($workspace['handoff_running']??0)>0): ?>
    <section class="tn-ui-alert tn-ui-alert--info tn-workspace-section">
      <span>Active runtime: <?php echo (int)($workspace['research_running']??0); ?> research · <?php echo (int)($workspace['handoff_running']??0); ?> handoff.</span>
    </section>
  <?php endif; ?>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Opportunity queue</p><h2>Recently updated</h2></div><a href="<?php echo $this->url->get('growth/candidates'); ?>">Open queue</a></div>
    <?php $this->partial('components/ui/data_table',[
      'columns'=>[
        ['key'=>'opportunity','label'=>'Opportunity'],
        ['key'=>'mode','label'=>'Mode'],
        ['key'=>'status','label'=>'Status'],
        ['key'=>'target','label'=>'Target'],
        ['key'=>'updated','label'=>'Updated'],
      ],
      'rows'=>$candidateRows,
      'responsive'=>'cards',
      'emptyMessage'=>'No Growth opportunities yet.',
    ]); ?>
  </section>

  <section class="tn-ui-panel tn-workspace-section">
    <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Account Intelligence</p><h2>Recently updated accounts</h2></div><a href="<?php echo $this->url->get('growth/accounts'); ?>">Open accounts</a></div>
    <?php $this->partial('components/ui/data_table',[
      'columns'=>[
        ['key'=>'account','label'=>'Account'],
        ['key'=>'fit','label'=>'ICP fit'],
        ['key'=>'candidates','label'=>'Candidates'],
        ['key'=>'contacts','label'=>'Contacts'],
      ],
      'rows'=>$accountRows,
      'responsive'=>'cards',
      'emptyMessage'=>'No Growth accounts yet.',
    ]); ?>
  </section>
