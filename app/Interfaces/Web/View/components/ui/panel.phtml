<?php
$eyebrow = trim((string) ($eyebrow ?? ''));
$title = trim((string) ($title ?? ''));
$description = trim((string) ($description ?? ''));
$variant = in_array(($variant ?? 'default'), ['default', 'compact', 'flush'], true) ? $variant : 'default';
$actions = is_array($actions ?? null) ? $actions : [];
$bodyPartial = trim((string) ($bodyPartial ?? ''));
$bodyParams = is_array($bodyParams ?? null) ? $bodyParams : [];
$footerPartial = trim((string) ($footerPartial ?? ''));
$footerParams = is_array($footerParams ?? null) ? $footerParams : [];
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$class = 'tn-ui-panel' . ($variant !== 'default' ? ' tn-ui-panel--' . $variant : '');
?>
<section class="<?php echo $h($class); ?>">
  <?php if ($title !== '' || $eyebrow !== '' || $description !== '' || $actions): ?>
    <div class="tn-ui-panel__head">
      <div>
        <?php if ($eyebrow !== ''): ?><p class="tn-ui-eyebrow"><?php echo $h($eyebrow); ?></p><?php endif; ?>
        <?php if ($title !== ''): ?><h2><?php echo $h($title); ?></h2><?php endif; ?>
        <?php if ($description !== ''): ?><p><?php echo $h($description); ?></p><?php endif; ?>
      </div>
      <?php if ($actions): ?><?php $this->partial('components/ui/action_bar', ['actions' => $actions, 'align' => 'end', 'ariaLabel' => $title !== '' ? $title . ' actions' : 'Panel actions']); ?><?php endif; ?>
    </div>
  <?php endif; ?>
  <?php if ($bodyPartial !== ''): ?><div class="tn-ui-panel__body"><?php $this->partial($bodyPartial, $bodyParams); ?></div><?php endif; ?>
  <?php if ($footerPartial !== ''): ?><div class="tn-ui-panel__foot"><?php $this->partial($footerPartial, $footerParams); ?></div><?php endif; ?>
</section>
