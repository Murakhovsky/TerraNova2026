<?php
$method = strtoupper((string) ($method ?? 'GET'));
$action = trim((string) ($action ?? ''));
$fields = is_array($fields ?? null) ? $fields : [];
$actions = is_array($actions ?? null) ? $actions : [];
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$actionUrl = $action === '' ? '' : $this->url->get($action);
?>
<form class="tn-ui-filter-bar" method="<?php echo $h($method); ?>" action="<?php echo $h($actionUrl); ?>">
  <div class="tn-ui-filter-bar__group">
    <?php foreach ($fields as $field): if (!is_array($field)) continue;
      $name = trim((string) ($field['name'] ?? ''));
      if ($name === '') continue;
      $type = in_array(($field['type'] ?? 'text'), ['text', 'search', 'date', 'select'], true) ? $field['type'] : 'text';
      $label = trim((string) ($field['label'] ?? ''));
      $value = (string) ($field['value'] ?? '');
      $grow = !empty($field['grow']);
    ?>
      <label class="tn-ui-field<?php echo $grow ? ' tn-ui-field--grow' : ''; ?>">
        <?php if ($label !== ''): ?><span><?php echo $h($label); ?></span><?php endif; ?>
        <?php if ($type === 'select'): ?>
          <select class="tn-ui-select" name="<?php echo $h($name); ?>">
            <?php foreach ((array) ($field['options'] ?? []) as $optionValue => $optionLabel): ?>
              <option value="<?php echo $h($optionValue); ?>"<?php echo (string) $optionValue === $value ? ' selected' : ''; ?>><?php echo $h($optionLabel); ?></option>
            <?php endforeach; ?>
          </select>
        <?php else: ?>
          <input class="tn-ui-input" type="<?php echo $h($type); ?>" name="<?php echo $h($name); ?>" value="<?php echo $h($value); ?>"<?php if (!empty($field['placeholder'])): ?> placeholder="<?php echo $h($field['placeholder']); ?>"<?php endif; ?>>
        <?php endif; ?>
      </label>
    <?php endforeach; ?>
  </div>
  <?php if ($actions): ?><div class="tn-ui-filter-bar__actions"><?php $this->partial('components/ui/action_bar', ['actions' => $actions, 'align' => 'end', 'ariaLabel' => 'Filter actions']); ?></div><?php endif; ?>
</form>
