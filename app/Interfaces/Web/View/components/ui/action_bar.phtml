<?php
$actions = is_array($actions ?? null) ? $actions : [];
$align = in_array(($align ?? 'end'), ['start', 'between', 'end'], true) ? $align : 'end';
$sticky = !empty($sticky);
$ariaLabel = trim((string) ($ariaLabel ?? 'Actions'));
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$href = static function ($view, string $path): string {
    if ($path === '' || str_starts_with($path, '#') || preg_match('#^(https?:|mailto:|tel:)#', $path)) return $path ?: '#';
    return $view->url->get($path);
};
$classes = ['tn-ui-action-bar', 'tn-ui-action-bar--' . $align];
if ($sticky) $classes[] = 'tn-ui-action-bar--sticky';
?>
<div class="<?php echo $h(implode(' ', $classes)); ?>" role="group" aria-label="<?php echo $h($ariaLabel); ?>">
  <div class="tn-ui-action-bar__group">
    <?php foreach ($actions as $action):
      if (!is_array($action)) continue;
      $label = trim((string) ($action['label'] ?? ''));
      if ($label === '') continue;
      $variant = preg_replace('/[^a-z0-9-]/', '', strtolower((string) ($action['variant'] ?? 'default')));
      $class = 'tn-ui-button' . ($variant !== 'default' ? ' tn-ui-button--' . $variant : '');
      $disabled = !empty($action['disabled']);
      $attributes = is_array($action['attributes'] ?? null) ? $action['attributes'] : [];
    ?>
      <?php if (!empty($action['href'])): ?>
        <a class="<?php echo $h($class); ?>" href="<?php echo $h($href($this, (string) $action['href'])); ?>"<?php echo $disabled ? ' aria-disabled="true" tabindex="-1"' : ''; ?>><?php echo $h($label); ?></a>
      <?php else: ?>
        <button class="<?php echo $h($class); ?>" type="<?php echo $h($action['type'] ?? 'button'); ?>"<?php echo $disabled ? ' disabled' : ''; ?><?php foreach ($attributes as $name => $value): ?> <?php echo $h($name); ?>="<?php echo $h($value); ?>"<?php endforeach; ?>><?php echo $h($label); ?></button>
      <?php endif; ?>
    <?php endforeach; ?>
  </div>
</div>
