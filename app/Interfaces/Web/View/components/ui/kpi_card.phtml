<?php
$label = trim((string) ($label ?? ''));
$value = $value ?? '—';
$hint = trim((string) ($hint ?? ''));
$href = trim((string) ($href ?? ''));
$tone = strtolower((string) ($tone ?? 'neutral'));
$tone = in_array($tone, ['neutral', 'brand', 'positive', 'warning', 'danger'], true) ? $tone : 'neutral';
$valueAttributes = is_array($valueAttributes ?? null) ? $valueAttributes : [];
$h = static fn ($v): string => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$classes = 'tn-ui-card tn-ui-kpi tn-ui-kpi--' . $tone;
$valueAttributesHtml = '';
foreach ($valueAttributes as $name => $attributeValue) {
    $valueAttributesHtml .= ' ' . $h($name) . '=\"' . $h($attributeValue) . '\"';
}
$content = '<span>' . $h($label) . '</span><strong' . $valueAttributesHtml . '>' . $h($value) . '</strong>' . ($hint !== '' ? '<small>' . $h($hint) . '</small>' : '');
?>
<?php if ($href !== ''): ?>
  <a class="<?php echo $classes; ?>" href="<?php echo $h($this->url->get($href)); ?>"><?php echo $content; ?></a>
<?php else: ?>
  <article class="<?php echo $classes; ?>"><?php echo $content; ?></article>
<?php endif; ?>
