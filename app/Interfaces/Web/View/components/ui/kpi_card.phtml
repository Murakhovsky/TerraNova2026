<?php
$label = trim((string) ($label ?? ''));
$value = $value ?? '—';
$hint = trim((string) ($hint ?? ''));
$href = trim((string) ($href ?? ''));
$tone = preg_replace('/[^a-z0-9-]/', '', strtolower((string) ($tone ?? 'neutral')));
$h = static fn ($v): string => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$classes = 'tn-ui-card tn-ui-kpi tn-ui-kpi--' . ($tone ?: 'neutral');
$content = '<span>' . $h($label) . '</span><strong>' . $h($value) . '</strong>' . ($hint !== '' ? '<small>' . $h($hint) . '</small>' : '');
?>
<?php if ($href !== ''): ?>
  <a class="<?php echo $classes; ?>" href="<?php echo $h($this->url->get($href)); ?>"><?php echo $content; ?></a>
<?php else: ?>
  <article class="<?php echo $classes; ?>"><?php echo $content; ?></article>
<?php endif; ?>
