<?php
$label = trim((string) ($label ?? ''));
$tone = strtolower((string) ($tone ?? 'neutral'));
$allowed = ['neutral', 'accent', 'positive', 'warning', 'danger'];
if (!in_array($tone, $allowed, true)) $tone = 'neutral';
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<span class="tn-ui-stage tn-ui-stage--<?php echo $h($tone); ?>"><?php echo $h($label); ?></span>
