<?php
$eyebrow = trim((string) ($eyebrow ?? ''));
$title = trim((string) ($title ?? ''));
$subtitle = trim((string) ($subtitle ?? ''));
$identity = trim((string) ($identity ?? ''));
$status = is_array($status ?? null) ? $status : [];
$meta = is_array($meta ?? null) ? $meta : [];
$actions = is_array($actions ?? null) ? $actions : [];
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<header class="tn-ui-entity-head">
  <div>
    <?php if ($eyebrow !== ''): ?><p class="tn-ui-eyebrow"><?php echo $h($eyebrow); ?></p><?php endif; ?>
    <?php if ($identity !== '' || $status): ?>
      <div class="tn-ui-entity-head__identity">
        <?php if ($identity !== ''): ?><span><?php echo $h($identity); ?></span><?php endif; ?>
        <?php if ($status): ?><?php $this->partial('components/ui/status_badge', $status); ?><?php endif; ?>
      </div>
    <?php endif; ?>
    <h1><?php echo $h($title); ?></h1>
    <?php if ($subtitle !== ''): ?><p class="tn-ui-entity-head__subtitle"><?php echo $h($subtitle); ?></p><?php endif; ?>
    <?php if ($meta): ?>
      <dl class="tn-ui-entity-head__meta">
        <?php foreach ($meta as $item): if (!is_array($item)) continue; ?>
          <div><dt><?php echo $h($item['label'] ?? ''); ?></dt><dd><?php echo $h($item['value'] ?? '—'); ?></dd></div>
        <?php endforeach; ?>
      </dl>
    <?php endif; ?>
  </div>
  <?php if ($actions): ?>
    <div class="tn-ui-entity-head__actions"><?php $this->partial('components/ui/action_bar', ['actions' => $actions, 'align' => 'end', 'ariaLabel' => 'Entity actions']); ?></div>
  <?php endif; ?>
</header>
