<?php
$eyebrow = trim((string) ($eyebrow ?? ''));
$title = trim((string) ($title ?? ''));
$description = trim((string) ($description ?? ''));
$actions = is_array($actions ?? null) ? $actions : [];
$meta = is_array($meta ?? null) ? $meta : [];
$metaAttributes = is_array($metaAttributes ?? null) ? $metaAttributes : [];
$metaValueAttributes = is_array($metaValueAttributes ?? null) ? $metaValueAttributes : [];
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<header class="tn-ui-page-head">
  <div class="tn-ui-page-head__copy">
    <?php if ($eyebrow !== ''): ?><p class="tn-ui-eyebrow"><?php echo $h($eyebrow); ?></p><?php endif; ?>
    <h1><?php echo $h($title); ?></h1>
    <?php if ($description !== ''): ?><p><?php echo $h($description); ?></p><?php endif; ?>
  </div>
  <?php if ($actions || $meta): ?>
    <div class="tn-ui-page-head__side">
      <?php if ($meta): ?>
        <div class="tn-ui-page-meta"<?php foreach ($metaAttributes as $name => $value): ?> <?php echo $h($name); ?>="<?php echo $h($value); ?>"<?php endforeach; ?>>
          <?php if (isset($meta['value'])): ?><strong<?php foreach ($metaValueAttributes as $name => $value): ?> <?php echo $h($name); ?>="<?php echo $h($value); ?>"<?php endforeach; ?>><?php echo $h($meta['value']); ?></strong><?php endif; ?>
          <?php if (isset($meta['label'])): ?><span><?php echo $h($meta['label']); ?></span><?php endif; ?>
        </div>
      <?php endif; ?>
      <?php if ($actions): ?><?php $this->partial('components/ui/action_bar', ['actions' => $actions, 'align' => 'end', 'ariaLabel' => $title !== '' ? $title . ' actions' : 'Page actions']); ?><?php endif; ?>
    </div>
  <?php endif; ?>
</header>
