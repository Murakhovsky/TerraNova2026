<?php
$eyebrow = trim((string) ($eyebrow ?? ''));
$title = trim((string) ($title ?? ''));
$description = trim((string) ($description ?? ''));
$actions = is_array($actions ?? null) ? $actions : [];
$meta = is_array($meta ?? null) ? $meta : [];
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$href = static function ($view, string $path): string {
    if ($path === '' || str_starts_with($path, '#') || preg_match('#^(https?:|mailto:|tel:)#', $path)) return $path ?: '#';
    return $view->url->get($path);
};
?>
<header class="tn-ui-page-head">
  <div class="tn-ui-page-head__copy">
    <?php if ($eyebrow !== ''): ?><p class="tn-ui-eyebrow"><?php echo $h($eyebrow); ?></p><?php endif; ?>
    <h1><?php echo $h($title); ?></h1>
    <?php if ($description !== ''): ?><p><?php echo $h($description); ?></p><?php endif; ?>
  </div>
  <?php if ($actions || $meta): ?>
    <div class="tn-ui-page-head__side">
      <?php if ($meta): ?>
        <div class="tn-ui-page-meta">
          <?php if (isset($meta['value'])): ?><strong><?php echo $h($meta['value']); ?></strong><?php endif; ?>
          <?php if (isset($meta['label'])): ?><span><?php echo $h($meta['label']); ?></span><?php endif; ?>
        </div>
      <?php endif; ?>
      <?php if ($actions): ?>
        <div class="tn-ui-actions">
          <?php foreach ($actions as $action):
            $variant = preg_replace('/[^a-z0-9-]/', '', strtolower((string) ($action['variant'] ?? 'default')));
            $class = 'tn-ui-button' . ($variant !== 'default' ? ' tn-ui-button--' . $variant : '');
          ?>
            <a class="<?php echo $class; ?>" href="<?php echo $h($href($this, (string) ($action['href'] ?? ''))); ?>"><?php echo $h($action['label'] ?? ''); ?></a>
          <?php endforeach; ?>
        </div>
      <?php endif; ?>
    </div>
  <?php endif; ?>
</header>
