<?php
$columns = is_array($columns ?? null) ? $columns : [];
$rows = is_array($rows ?? null) ? $rows : [];
$responsive = in_array(($responsive ?? 'cards'), ['cards', 'scroll'], true) ? $responsive : 'cards';
$emptyMessage = trim((string) ($emptyMessage ?? 'No data available.'));
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$href = static function ($view, string $path): string {
    if ($path === '' || str_starts_with($path, '#') || preg_match('#^(https?:|mailto:|tel:)#', $path)) return $path ?: '#';
    return $view->url->get($path);
};
?>
<div class="tn-ui-table-wrap">
  <table class="tn-ui-data-table" data-responsive="<?php echo $h($responsive); ?>">
    <thead><tr><?php foreach ($columns as $column): if (!is_array($column)) continue; ?><th scope="col"><?php echo $h($column['label'] ?? $column['key'] ?? ''); ?></th><?php endforeach; ?></tr></thead>
    <tbody>
      <?php if ($rows === []): ?>
        <tr><td class="tn-ui-data-table__empty" colspan="<?php echo max(1, count($columns)); ?>"><?php echo $h($emptyMessage); ?></td></tr>
      <?php endif; ?>
      <?php foreach ($rows as $row): if (!is_array($row)) continue; ?>
        <tr>
          <?php foreach ($columns as $column): if (!is_array($column)) continue;
            $key = (string) ($column['key'] ?? '');
            $label = (string) ($column['label'] ?? $key);
            $value = $row[$key] ?? '';
            $rowHref = trim((string) ($row['_href'] ?? ''));
          ?>
            <td data-label="<?php echo $h($label); ?>">
              <?php if (is_array($value) && ($value['kind'] ?? '') === 'actions'): ?>
                <?php $this->partial('components/ui/action_bar', [
                    'actions' => is_array($value['items'] ?? null) ? $value['items'] : [],
                    'align' => $value['align'] ?? 'start',
                    'ariaLabel' => $value['ariaLabel'] ?? ($label . ' actions'),
                ]); ?>
              <?php elseif (is_array($value) && ($value['kind'] ?? '') === 'details'): ?>
                <details class="tn-ui-data-table__details">
                  <summary><?php echo $h($value['summary'] ?? 'Details'); ?></summary>
                  <pre><?php echo $h($value['content'] ?? ''); ?></pre>
                </details>
              <?php elseif (is_array($value) && isset($value['label'])): ?>
                <?php if (($value['kind'] ?? 'status') === 'stage'): ?>
                  <?php $this->partial('components/ui/stage', ['label' => $value['label'], 'tone' => $value['tone'] ?? 'neutral']); ?>
                <?php else: ?>
                  <?php $this->partial('components/ui/status_badge', ['label' => $value['label'], 'tone' => $value['tone'] ?? 'neutral']); ?>
                <?php endif; ?>
              <?php elseif (is_array($value)): ?>
                <?php $primary = trim((string) ($value['primary'] ?? '')); $secondary = trim((string) ($value['secondary'] ?? '')); ?>
                <?php if ($rowHref !== '' && $primary !== ''): ?><a class="tn-ui-data-table__link" href="<?php echo $h($href($this, $rowHref)); ?>"><?php endif; ?>
                  <?php if ($primary !== ''): ?><span class="tn-ui-data-table__primary"><?php echo $h($primary); ?></span><?php endif; ?>
                  <?php if ($secondary !== ''): ?><span class="tn-ui-data-table__secondary"><?php echo $h($secondary); ?></span><?php endif; ?>
                <?php if ($rowHref !== '' && $primary !== ''): ?></a><?php endif; ?>
              <?php else: ?>
                <?php echo $h($value); ?>
              <?php endif; ?>
            </td>
          <?php endforeach; ?>
        </tr>
      <?php endforeach; ?>
    </tbody>
  </table>
</div>
