<?php
$items = is_array($items ?? null) ? $items : [];
$label = trim((string) ($label ?? 'Breadcrumb'));
$h = static fn($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$href = static function ($view, string $path): string {
    if ($path === '' || $path === '#') return $path === '#' ? '#' : $view->url->get();
    if (str_starts_with($path, '#') || preg_match('#^(https?:|mailto:|tel:)#', $path)) return $path;
    return $view->url->get($path);
};
?>
<nav class="tn-ui-breadcrumbs" aria-label="<?php echo $h($label); ?>">
  <ol>
    <?php foreach ($items as $index => $item): if (!is_array($item)) continue;
      $itemLabel = trim((string) ($item['label'] ?? ''));
      if ($itemLabel === '') continue;
      $path = trim((string) ($item['href'] ?? ''));
      $current = !empty($item['current']) || $path === '' || $index === array_key_last($items);
    ?>
      <li<?php echo $current ? ' aria-current="page"' : ''; ?>>
        <?php if (!$current && $path !== ''): ?>
          <a href="<?php echo $h($href($this, $path)); ?>"><?php echo $h($itemLabel); ?></a>
        <?php else: ?>
          <span><?php echo $h($itemLabel); ?></span>
        <?php endif; ?>
      </li>
    <?php endforeach; ?>
  </ol>
</nav>
