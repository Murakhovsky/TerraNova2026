<?php
$label = trim((string) ($label ?? ''));
$tone = preg_replace('/[^a-z0-9-]/', '', strtolower((string) ($tone ?? 'neutral')));
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<span class="tn-ui-status tn-ui-status--<?php echo $h($tone ?: 'neutral'); ?>"><?php echo $h($label); ?></span>
