<?php
$items = is_array($items ?? null) ? $items : [];
$active = (string) ($active ?? '');
$label = trim((string) ($label ?? 'Розділи'));
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<nav class="tn-ui-tabs" aria-label="<?php echo $h($label); ?>">
  <?php foreach ($items as $item):
    $key = (string) ($item['key'] ?? '');
    $path = (string) ($item['href'] ?? '#');
    $href = str_starts_with($path, '#') ? $path : $this->url->get($path);
  ?>
    <a class="<?php echo $key === $active ? 'is-active' : ''; ?>" href="<?php echo $h($href); ?>" <?php echo $key === $active ? 'aria-current="page"' : ''; ?>><?php echo $h($item['label'] ?? $key); ?></a>
  <?php endforeach; ?>
</nav>
