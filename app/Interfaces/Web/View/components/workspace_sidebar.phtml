<?php
/** @var array $navigation */
/** @var string $active */
/** @var string $activeSection */
/** @var Closure $href */
?>
<aside class="tn-workspace-sidebar" id="workspace-navigation" aria-label="Навігація Company Workspace" data-workspace-sidebar>
  <div class="tn-workspace-brand-row">
    <a class="tn-workspace-brand" href="<?php echo $href('admin'); ?>" aria-label="Terra Nova Company Workspace">
      <span class="tn-workspace-brand__mark">TN</span>
      <span class="tn-workspace-brand__copy"><strong>Terra Nova</strong><small>Company OS</small></span>
    </a>
    <button class="tn-workspace-collapse" type="button" aria-label="Згорнути навігацію" title="Згорнути навігацію" data-workspace-collapse>‹</button>
  </div>

  <nav class="tn-workspace-nav" aria-label="Основні розділи">
    <?php foreach ($navigation['primary'] ?? [] as $section): ?>
      <?php $sectionActive = $activeSection === ($section['key'] ?? ''); ?>
      <div class="tn-workspace-nav-group<?php echo $sectionActive ? ' is-active' : ''; ?>" data-workspace-group>
        <a
          class="tn-workspace-nav-item<?php echo $sectionActive ? ' is-active' : ''; ?>"
          href="<?php echo $href((string) ($section['path'] ?? '')); ?>"
          <?php echo $sectionActive ? 'aria-current="page"' : ''; ?>
        >
          <span class="tn-workspace-nav-item__glyph" aria-hidden="true"><?php echo htmlspecialchars((string) ($section['glyph'] ?? '•'), ENT_QUOTES, 'UTF-8'); ?></span>
          <span class="tn-workspace-nav-item__label"><?php echo htmlspecialchars((string) ($section['label'] ?? ''), ENT_QUOTES, 'UTF-8'); ?></span>
        </a>

        <?php if (!empty($section['children'])): ?>
          <div class="tn-workspace-subnav" aria-label="<?php echo htmlspecialchars((string) ($section['label'] ?? ''), ENT_QUOTES, 'UTF-8'); ?>">
            <?php foreach ($section['children'] as $child): ?>
              <?php $childActive = $active === ($child['key'] ?? ''); ?>
              <a class="<?php echo $childActive ? 'is-active' : ''; ?>" href="<?php echo $href((string) ($child['path'] ?? '')); ?>" <?php echo $childActive ? 'aria-current="page"' : ''; ?>>
                <?php echo htmlspecialchars((string) ($child['label'] ?? ''), ENT_QUOTES, 'UTF-8'); ?>
              </a>
            <?php endforeach; ?>
          </div>
        <?php endif; ?>
      </div>
    <?php endforeach; ?>
  </nav>

  <?php if (!empty($navigation['utility'])): ?>
    <nav class="tn-workspace-nav tn-workspace-nav--utility" aria-label="Службові розділи">
      <span class="tn-workspace-nav-caption">Система</span>
      <?php foreach ($navigation['utility'] as $item): ?>
        <?php $itemActive = $active === ($item['key'] ?? ''); ?>
        <a class="tn-workspace-nav-item<?php echo $itemActive ? ' is-active' : ''; ?>" href="<?php echo $href((string) ($item['path'] ?? '')); ?>" <?php echo $itemActive ? 'aria-current="page"' : ''; ?>>
          <span class="tn-workspace-nav-item__glyph" aria-hidden="true"><?php echo htmlspecialchars((string) ($item['glyph'] ?? '•'), ENT_QUOTES, 'UTF-8'); ?></span>
          <span class="tn-workspace-nav-item__label"><?php echo htmlspecialchars((string) ($item['label'] ?? ''), ENT_QUOTES, 'UTF-8'); ?></span>
        </a>
      <?php endforeach; ?>
    </nav>
  <?php endif; ?>
</aside>
