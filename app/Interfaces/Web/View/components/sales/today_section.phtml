<?php
$items = is_array($items ?? null) ? $items : [];
$anchor = (string) ($anchor ?? 'work');
$reasonLabel = is_callable($reasonLabel ?? null) ? $reasonLabel : static fn($value) => (string) $value;
$h = static fn($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<div class="tn-sales-list">
  <?php foreach ($items as $item): $dealId = (int) ($item['id'] ?? $item['deal_id'] ?? 0); ?>
    <article class="tn-sales-list-row tn-sales-list-row--actionable">
      <a class="tn-sales-list-row__main" href="<?php echo $dealId > 0 ? $this->url->get('sales/deals/' . $dealId) . '#' . $h($anchor) : '#'; ?>">
        <span>
          <strong><?php echo $h($item['customer'] ?? $item['type'] ?? $item['action_type'] ?? 'Action'); ?></strong>
          <small><?php echo $h($item['activity_title'] ?? $item['title'] ?? $item['approval_reason'] ?? $item['reason'] ?? $item['detail'] ?? $item['status'] ?? ''); ?></small>
        </span>
        <?php if (!empty($item['attention_reason'])): ?><em><?php echo $h($reasonLabel($item['attention_reason'])); ?></em><?php endif; ?>
        <time><?php echo $h($item['due_at'] ?? $item['next_contact_at'] ?? $item['occurred_at'] ?? $item['created_at'] ?? ''); ?></time>
      </a>
      <?php if (!empty($item['approval_id'])): ?>
        <div class="tn-sales-quick-actions" data-sales-approval data-approval-id="<?php echo $h($item['approval_id']); ?>">
          <button type="button" class="tn-ui-button tn-ui-button--primary tn-ui-button--sm" data-decision="approve">Approve</button>
          <button type="button" class="tn-ui-button tn-ui-button--ghost tn-ui-button--sm" data-decision="reject">Reject</button>
        </div>
      <?php elseif (!empty($item['activity_id']) && $dealId > 0): ?>
        <div class="tn-sales-quick-actions" data-deal-id="<?php echo $dealId; ?>" data-activity-id="<?php echo (int) $item['activity_id']; ?>">
          <button type="button" class="tn-ui-button tn-ui-button--primary tn-ui-button--sm" data-sales-activity-complete>Complete</button>
          <button type="button" class="tn-ui-button tn-ui-button--ghost tn-ui-button--sm" data-sales-activity-reschedule>Reschedule</button>
        </div>
      <?php endif; ?>
    </article>
  <?php endforeach; ?>
  <?php if ($items === []): ?><p class="tn-sales-empty">Немає елементів.</p><?php endif; ?>
</div>
