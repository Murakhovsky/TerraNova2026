<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$money = static function ($amount, $currency = 'USD', $period = 'total') {
    if ($amount === null || $amount === '') return 'за запитом';
    $suffix = $period === 'month' ? ' / міс.' : ($period === 'day' ? ' / день' : '');
    return number_format((float) $amount, 0, '.', ' ') . ' ' . $currency . $suffix;
};
$properties = $properties ?? [];
$catalogStatus = $catalogStatus ?? null;
$rows = [];
foreach ($properties as $property) {
    $publicId = (string) ($property['public_id'] ?? '');
    $rows[] = [
        '_href' => 'property/show/' . (string) ($property['slug'] ?? ''),
        'property' => [
            'primary' => (string) ($property['title'] ?? ''),
            'secondary' => $publicId,
        ],
        'city' => (string) ($property['city'] ?? ''),
        'type' => (string) ($property['type_name'] ?? ''),
        'price' => $money($property['price_amount'] ?? null, $property['price_currency'] ?? 'USD', $property['price_period'] ?? 'total'),
        'area' => !empty($property['area_total']) ? ((float) $property['area_total']) . ' м²' : '—',
        'rooms' => !empty($property['rooms']) ? (string) (float) $property['rooms'] : '—',
        'floor' => !empty($property['floor']) ? ((string) $property['floor'] . ' / ' . (!empty($property['floors']) ? (string) $property['floors'] : '—')) : '—',
        'year' => !empty($property['built_year']) ? (string) $property['built_year'] : '—',
        'tour' => [
            'label' => (int) ($property['has_3d_tour'] ?? 0) === 1 ? '3D' : 'Немає',
            'tone' => (int) ($property['has_3d_tour'] ?? 0) === 1 ? 'positive' : 'neutral',
        ],
        'actions' => [
            'kind' => 'actions',
            'ariaLabel' => 'Дії з ' . ($publicId !== '' ? $publicId : 'об’єктом'),
            'items' => [[
                'label' => 'Вибрати',
                'variant' => 'ghost',
                'attributes' => [
                    'data-save-property' => $publicId,
                    'data-toggle-text' => 'У вибраному',
                ],
            ]],
        ],
    ];
}
?>

