      <h1>Порівняння</h1>
      <p>Ціна, площа, кімнати, поверховість, рік, 3D і перехід у картку.</p>
    </div>
    <div class="tn-page-hero__meta">
      <strong><?php echo count($properties); ?></strong>
      <span>об’єкти для аналізу</span>
    </div>
  </section>

  <section class="tn-compare-workspace">
    <?php $this->partial('shared/catalog_viewbar', ['active' => 'compare']); ?>

    <?php if ($catalogStatus): ?>
      <?php $this->partial('components/ui/state', ['kind' => 'error', 'title' => 'Дані тимчасово недоступні', 'message' => $catalogStatus]); ?>
    <?php elseif (!$properties): ?>
      <?php $this->partial('components/ui/state', ['kind' => 'empty', 'title' => 'Немає об’єктів для порівняння', 'message' => 'Поверніться в каталог або змініть фільтри.']); ?>
    <?php else: ?>
      <?php $this->partial('components/ui/data_table', [
          'columns' => [
              ['key' => 'property', 'label' => 'Об’єкт'],
              ['key' => 'city', 'label' => 'Місто'],
              ['key' => 'type', 'label' => 'Тип'],
              ['key' => 'price', 'label' => 'Ціна'],
              ['key' => 'area', 'label' => 'Площа'],
              ['key' => 'rooms', 'label' => 'Кімнат'],
              ['key' => 'floor', 'label' => 'Поверх'],
              ['key' => 'year', 'label' => 'Рік'],
              ['key' => 'tour', 'label' => '3D'],
              ['key' => 'actions', 'label' => 'Дії'],
          ],
          'rows' => $rows,
          'responsive' => 'cards',
          'emptyMessage' => 'Немає об’єктів для порівняння.',
      ]); ?>
    <?php endif; ?>
  </section>
</main>

