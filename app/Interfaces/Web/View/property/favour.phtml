<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$money = static function ($amount, $currency = 'USD', $period = 'total') {
    if ($amount === null || $amount === '') {
        return 'за запитом';
    }

    $suffix = $period === 'month' ? ' / міс.' : ($period === 'day' ? ' / день' : '');

    return number_format((float) $amount, 0, '.', ' ') . ' ' . $currency . $suffix;
};
$dealLabels = ['sale' => 'Продаж', 'rent' => 'Оренда', 'investment' => 'Інвестиція'];
$properties = $properties ?? [];
$catalogStatus = $catalogStatus ?? null;
?>

<?php $this->partial('shared/public_header', ['active' => 'favour']); ?>

<main class="tn-page">
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Property · Favourites',
    'title' => 'Вибрані об’єкти',
    'description' => 'Збережені варіанти для повернення, порівняння або розмови з менеджером.',
    'meta' => ['value' => 0, 'label' => 'у вибраному'],
    'metaValueAttributes' => ['data-favourite-count' => ''],
    'actions' => [['label' => 'До каталогу', 'href' => 'property/catalog', 'variant' => 'primary']],
  ]); ?>

  <section class="tn-favourite-workspace" data-favourite-list>
    <?php $this->partial('shared/catalog_viewbar', ['active' => 'favour']); ?>

    <?php if ($catalogStatus): ?>
      <?php $this->partial('components/ui/state', ['kind' => 'error', 'title' => 'Дані тимчасово недоступні', 'message' => $catalogStatus]); ?>
    <?php endif; ?>

    <?php $this->partial('components/ui/state', ['kind' => 'empty', 'title' => 'У вибраному поки порожньо', 'message' => 'Відкрийте каталог і збережіть об’єкти, які хочете переглянути, порівняти або обговорити з менеджером.', 'action' => ['label' => 'Перейти в каталог', 'href' => 'property/catalog']]); ?>

    <div class="tn-property-grid tn-property-grid--catalog">
      <?php foreach ($properties as $property): ?>
        <article class="tn-property-card" data-favourite-item="<?php echo $h($property['public_id']); ?>">
          <a class="tn-property-card__image" href="<?php echo $this->url->get('property/show/' . $property['slug']); ?>">
            <img src="<?php echo $h($property['cover_url'] ?: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=900&q=80'); ?>" alt="<?php echo $h($property['title']); ?>">
            <span class="tn-card-price-badge"><?php echo $h($money($property['price_amount'], $property['price_currency'], $property['price_period'])); ?></span>
          </a>
          <div class="tn-property-card__body">
            <div class="tn-card-tags">
              <span><?php echo $h($dealLabels[$property['deal_type']] ?? $property['deal_type']); ?></span>
              <span><?php echo $h($property['type_name']); ?></span>
              <?php if ((int) $property['has_3d_tour'] === 1): ?><span>3D tour</span><?php endif; ?>
            </div>
            <h2><a href="<?php echo $this->url->get('property/show/' . $property['slug']); ?>"><?php echo $h($property['title']); ?></a></h2>
            <p><?php echo $h($property['short_description']); ?></p>
            <div class="tn-property-meta">
              <strong><?php echo $h($money($property['price_amount'], $property['price_currency'], $property['price_period'])); ?></strong>
              <span><?php echo $h($property['city']); ?><?php if ($property['area_total']): ?> / <?php echo $h((float) $property['area_total']); ?> м²<?php endif; ?></span>
            </div>
            <div class="tn-card-actions">
              <a class="tn-btn tn-btn--dark" href="<?php echo $this->url->get('property/show/' . $property['slug']); ?>">Відкрити</a>
              <button type="button" data-save-property="<?php echo $h($property['public_id']); ?>" data-toggle-text="У вибраному">Зберегти</button>
            </div>
          </div>
        </article>
      <?php endforeach; ?>
    </div>
  </section>
</main>

<?php $this->partial('shared/mobile_dock', ['active' => 'favour']); ?>

<?php $this->partial('shared/public_footer', [
    'text' => 'Вибране допомагає швидко повернутись до обʼєктів, які варто переглянути або обговорити з менеджером Terra Nova.',
]); ?>
