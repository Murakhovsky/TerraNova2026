<?php
$h = static fn($value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$items = is_array($items ?? null) ? $items : [];
$stats = is_array($stats ?? null) ? $stats : [];
$filters = is_array($filters ?? null) ? $filters : [];
$mode = (string)($mode ?? 'manage');
$pageStatus = $pageStatus ?? null;
$statusLabels = [
  'available'=>'Available','reserved'=>'Reserved','under_offer'=>'Under offer','on_hold'=>'On hold',
  'sold'=>'Sold','rented'=>'Rented','off_market'=>'Off market','withdrawn'=>'Withdrawn',
];
?>
<main class="tn-page tn-workspace-page tn-property-workspace">
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Property / Canonical runtime',
    'title' => $mode === 'listing' ? 'Listing' : 'Inventory',
    'description' => 'Canonical PropertyAsset → Inventory → Listing projection. Read surface no longer depends on retired Property management persistence.',
    'meta' => ['value'=>(int)($stats['all']??count($items)),'label'=>'inventory items'],
  ]); ?>

  <section class="tn-ui-panel tn-workspace-section">
    <form class="tn-ui-filter-bar" method="get">
      <label><span>Пошук</span><input type="search" name="q" value="<?php echo $h($filters['q']??''); ?>" placeholder="Asset, listing, location"></label>
      <label><span>Статус</span><select name="status"><option value="">Усі</option><?php foreach($statusLabels as $code=>$label): ?><option value="<?php echo $h($code); ?>" <?php echo ($filters['status']??'')===$code?'selected':''; ?>><?php echo $h($label); ?></option><?php endforeach; ?></select></label>
      <label><span>Операція</span><select name="transaction_type"><option value="">Усі</option><?php foreach(['sale'=>'Продаж','rent'=>'Оренда','investment'=>'Інвестиція'] as $code=>$label): ?><option value="<?php echo $h($code); ?>" <?php echo ($filters['transaction_type']??'')===$code?'selected':''; ?>><?php echo $h($label); ?></option><?php endforeach; ?></select></label>
      <button class="tn-ui-button tn-ui-button--primary" type="submit">Фільтрувати</button>
    </form>
  </section>

  <?php if($pageStatus): ?>
    <?php $this->partial('components/ui/state',['kind'=>'error','title'=>'Property workspace недоступний','message'=>(string)$pageStatus]); ?>
  <?php elseif($items===[]): ?>
    <?php $this->partial('components/ui/state',['kind'=>'empty','title'=>'Inventory порожній','message'=>'У поточному зрізі canonical inventory немає записів.']); ?>
  <?php else: ?>
    <?php
      $rows=[];
      foreach($items as $item){
        $slug=(string)($item['slug']??'');
        $rows[]=[
          '_href'=>$slug!==''?'property/show/'.$slug:null,
          'asset'=>['primary'=>(string)($item['title']??$item['asset_id']??'Property'),'secondary'=>(string)($item['asset_id']??'')],
          'inventory'=>(string)($item['inventory_id']??''),
          'type'=>(string)($item['type_code']??$item['kind']??''),
          'location'=>(string)(($item['location_name']??'')?:($item['formatted_address']??'')),
          'transaction'=>(string)($item['transaction_type']??''),
          'price'=>($item['price_amount']??null)!==null?number_format((float)$item['price_amount'],0,'.',' ').' '.($item['price_currency']??'USD'):'—',
          'status'=>['kind'=>'status','label'=>$statusLabels[(string)($item['status']??'')]??(string)($item['status']??''),'tone'=>in_array((string)($item['status']??''),['available','under_offer'],true)?'positive':'neutral'],
          'listing'=>(string)($item['listing_status']??'—'),
        ];
      }
      $this->partial('components/ui/data_table',[
        'columns'=>[
          ['key'=>'asset','label'=>'Property'],['key'=>'inventory','label'=>'Inventory ID'],['key'=>'type','label'=>'Type'],
          ['key'=>'location','label'=>'Location'],['key'=>'transaction','label'=>'Transaction'],['key'=>'price','label'=>'Price'],
          ['key'=>'status','label'=>'Inventory'],['key'=>'listing','label'=>'Listing'],
        ],
        'rows'=>$rows,'responsive'=>'cards','emptyMessage'=>'Inventory порожній.',
      ]);
    ?>
  <?php endif; ?>
</main>
