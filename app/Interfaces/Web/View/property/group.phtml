<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$money = static function ($amount, $currency = 'USD', $period = 'total') {
    if ($amount === null || $amount === '') {
        return 'за запитом';
    }

    $suffix = $period === 'month' ? ' / міс.' : ($period === 'day' ? ' / день' : '');

    return number_format((float) $amount, 0, '.', ' ') . ' ' . $currency . $suffix;
};
$absoluteUrl = static function (string $path = '') {
    $scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
    $host = $_SERVER['HTTP_HOST'] ?? '127.0.0.1:8001';

    return $scheme . '://' . $host . '/' . ltrim($path, '/');
};
$group = $group ?? null;
$properties = $properties ?? [];
$locations = $locations ?? [];
$managerClientCases = $managerClientCases ?? [];
$pageStatus = $pageStatus ?? null;
$actionStatus = $actionStatus ?? null;
$selected = static fn($current, $expected) => (string) $current === (string) $expected ? 'selected' : '';
$groupTypes = [
    'address' => 'Адреса',
    'building' => 'Будинок',
    'complex' => 'Комплекс',
    'project' => 'Проєкт',
    'location' => 'Локація',
];
$statusLabels = [
    'active' => 'Активна',
    'archived' => 'Архів',
];
$propertyStatusLabels = [
    'draft' => 'Чернетка',
    'moderation' => 'Модерація',
    'published' => 'Опубліковано',
    'reserved' => 'Резерв',
    'sold' => 'Продано',
    'archived' => 'Архів',
];
$publicPresentationUrl = $group ? $absoluteUrl('property/presentation/' . (string) $group['slug']) : '';
$groupPdfUrl = $group ? $absoluteUrl('property/pdf/' . (string) $group['slug']) : '';
$groupImage = trim((string) ($group['image_url'] ?? ''));
$propertyRows = [];
foreach ($properties as $property) {
    $status = (string) ($property['status'] ?? 'draft');
    $statusTone = match ($status) {
        'published' => 'positive',
        'reserved', 'moderation' => 'warning',
        'sold', 'archived' => 'neutral',
        default => 'neutral',
    };
    $presentationUrl = $absoluteUrl('property/show/' . (string) ($property['slug'] ?? ''));
    $actions = [[
        'label' => 'Редагувати',
        'href' => 'property/edit/' . (int) ($property['id'] ?? 0),
        'variant' => 'ghost',
    ]];
    if ($status === 'published') {
        $actions[] = [
            'label' => 'Перегляд',
            'href' => 'property/show/' . (string) ($property['slug'] ?? ''),
            'variant' => 'primary',
        ];
    }
    $propertyRows[] = [
        '_href' => 'property/edit/' . (int) ($property['id'] ?? 0),
        'property' => [
            'primary' => (string) ($property['title'] ?? ''),
            'secondary' => trim((string) ($property['public_id'] ?? '') . ' · ' . (string) ($property['type_name'] ?? '') . ' · ' . (string) ($property['city'] ?? ''), ' ·'),
        ],
        'status' => [
            'label' => $propertyStatusLabels[$status] ?? $status,
            'tone' => $statusTone,
        ],
        'price' => [
            'primary' => $money($property['price_amount'] ?? null, $property['price_currency'] ?? 'USD', $property['price_period'] ?? 'total'),
            'secondary' => !empty($property['area_total']) ? ((float) $property['area_total']) . ' м²' : 'площа не вказана',
        ],
        'media' => [
            'primary' => (int) ($property['image_count'] ?? 0) . ' фото',
            'secondary' => !empty($property['is_ready_to_publish']) ? 'готовий' : 'не готовий: ' . (int) ($property['readiness_missing_count'] ?? 0),
        ],
        'presentation' => $status === 'published'
            ? ['primary' => 'Публічна картка', 'secondary' => $presentationUrl]
            : ['primary' => 'Не опубліковано', 'secondary' => 'Публічна презентація після публікації'],
        'actions' => [
            'kind' => 'actions',
            'ariaLabel' => 'Дії з об’єктом ' . (string) ($property['public_id'] ?? ''),
            'items' => $actions,
        ],
    ];
}
