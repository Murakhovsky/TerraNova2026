<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$statusLabels = [
    'draft' => 'Чернетки',
    'submitted' => 'Подані',
    'new' => 'Нові',
    'review' => 'В роботі',
    'in_review' => 'На перевірці',
    'needs_changes' => 'Потрібні правки',
    'accepted' => 'Прийняті',
    'approved' => 'Схвалені',
    'published' => 'Опубліковані',
    'rejected' => 'Відхилені',
    'spam' => 'Спам',
];
$statusTones = [
    'draft' => 'neutral',
    'submitted' => 'info',
    'new' => 'info',
    'review' => 'info',
    'in_review' => 'info',
    'needs_changes' => 'warning',
    'accepted' => 'positive',
    'approved' => 'positive',
    'published' => 'positive',
    'rejected' => 'danger',
    'spam' => 'danger',
];
$submissions = is_array($submissions ?? null) ? $submissions : [];
$counts = is_array($counts ?? null) ? $counts : [];
$status = (string) ($status ?? '');
$pageStatus = $pageStatus ?? null;

$tableRows = [];
foreach ($submissions as $submission) {
    if (!is_array($submission)) continue;
    $submissionStatus = (string) ($submission['status'] ?? '');
    $tableRows[] = [
        '_href' => 'property/submission/' . (int) ($submission['id'] ?? 0),
        'ref' => (string) ($submission['submission_ref'] ?? ''),
        'object' => [
            'primary' => (string) ($submission['title'] ?? ''),
            'secondary' => (string) ($submission['property_type'] ?? ''),
        ],
        'contact' => [
            'primary' => (string) ($submission['owner_name'] ?? ''),
            'secondary' => (string) (($submission['owner_phone'] ?? '') ?: ($submission['owner_email'] ?? '')),
        ],
        'deal' => (string) ($submission['deal_type'] ?? ''),
        'city' => (string) ($submission['city'] ?? ''),
        'status' => [
            'kind' => 'status',
            'label' => $statusLabels[$submissionStatus] ?? $submissionStatus,
            'tone' => $statusTones[$submissionStatus] ?? 'neutral',
        ],
        'created' => (string) ($submission['created_at'] ?? ''),
    ];
}
?>

<?php $this->partial('shared/manager_header', ['active' => 'submissions']); ?>

<main class="tn-page tn-workspace-page tn-property-workspace">
  <?php $this->partial('components/ui/page_header', [
    'eyebrow' => 'Модерація',
    'title' => 'Подані об’єкти',
    'description' => 'Перегляд заявок, зміна статусів і публікація в каталог.',
    'meta' => [
      'value' => (int) (($counts['new'] ?? 0) + ($counts['submitted'] ?? 0)),
      'label' => 'нові заявки',
    ],
  ]); ?>

  <nav class="tn-view-switch tn-workspace-section" aria-label="Фільтр заявок">
    <a class="<?php echo $status === '' ? 'is-active' : ''; ?>" href="<?php echo $this->url->get('property/submissions'); ?>">Усі</a>
    <?php foreach ($statusLabels as $code => $label): ?>
      <a class="<?php echo $status === $code ? 'is-active' : ''; ?>" href="<?php echo $this->url->get('property/submissions?status=' . $code); ?>"><?php echo $h($label); ?> · <?php echo (int) ($counts[$code] ?? 0); ?></a>
    <?php endforeach; ?>
  </nav>

  <?php if ($pageStatus): ?>
    <?php $this->partial('components/ui/state', [
      'kind' => 'error',
      'title' => 'Заявки недоступні',
      'message' => (string) $pageStatus,
    ]); ?>
  <?php elseif ($submissions === []): ?>
    <?php $this->partial('components/ui/state', [
      'kind' => 'empty',
      'title' => 'Заявок у цьому статусі немає',
      'message' => 'Нові подані об’єкти з’являться тут після відправки форми.',
    ]); ?>
  <?php else: ?>
    <section class="tn-ui-panel tn-ui-panel--flush tn-workspace-section">
      <div class="tn-ui-panel__head">
        <div>
          <p class="tn-ui-eyebrow">Черга модерації</p>
          <h2>Заявки</h2>
          <p><?php echo count($submissions); ?> записів у поточному представленні.</p>
        </div>
      </div>
      <?php $this->partial('components/ui/data_table', [
        'columns' => [
          ['key' => 'ref', 'label' => 'Ref'],
          ['key' => 'object', 'label' => 'Об’єкт'],
          ['key' => 'contact', 'label' => 'Контакт'],
          ['key' => 'deal', 'label' => 'Операція'],
          ['key' => 'city', 'label' => 'Місто'],
          ['key' => 'status', 'label' => 'Статус'],
          ['key' => 'created', 'label' => 'Дата'],
        ],
        'rows' => $tableRows,
        'responsive' => 'cards',
        'emptyMessage' => 'Заявок немає.',
      ]); ?>
    </section>
  <?php endif; ?>
</main>
