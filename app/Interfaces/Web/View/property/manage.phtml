$properties = $properties ?? [];
$types = $types ?? [];
$locations = $locations ?? [];
$propertyGroups = $propertyGroups ?? [];
$agents = $agents ?? [];
$stageRules = $operationalStageRules ?? [];
if ($stageRules) {
    $stageLabels = [];
    foreach ($stageRules as $code => $rule) {
        $stageLabels[$code] = $rule['label'] ?? $code;
    }
}
$stats = $stats ?? [];
$qualityStats = $qualityStats ?? [];
$pageStatus = $pageStatus ?? null;
$actionStatus = $actionStatus ?? null;
$selected = static fn($current, $expected) => (string) $current === (string) $expected ? 'selected' : '';
$qualityLabels = [
    'not_ready' => 'Не готові',
    'no_agent' => 'Без відповідального',
    'no_photo' => 'Без фото',
    'no_price' => 'Без ціни',
    'no_commission' => 'Без комісії',
    'needs_status_note' => 'Без причини статусу',
    'overdue_action' => 'Прострочена дія',
    'no_next_action' => 'Без наступної дії',
    'ready' => 'Готові',
];
$qualityLabels = array_merge(
    array_slice($qualityLabels, 0, -1, true),
    ['stage_blocked' => 'Етап заблокований'],
    array_slice($qualityLabels, -1, null, true)
);
$qualityPath = static function (string $quality) use ($filters): string {
    $params = $filters;
    if ($quality === '') {
        unset($params['quality']);
    } else {
        $params['quality'] = $quality;
    }

    foreach ($params as $key => $value) {
        if ($value === '' || $value === 0 || $value === '0') {
            unset($params[$key]);
        }
    }

    return 'property/manage' . ($params ? '?' . http_build_query($params) : '');
};
$returnParams = [];
foreach (['q', 'status', 'deal_type', 'type_id', 'location_id', 'property_group_id', 'agent_id', 'source_type', 'visibility', 'sale_priority', 'operational_stage', 'quality', 'sort'] as $filterKey) {
    if (($filters[$filterKey] ?? '') !== '' && ($filters[$filterKey] ?? 0) !== 0) {
        $returnParams[$filterKey] = $filters[$filterKey];
    }
}
$returnUrl = 'property/manage' . ($returnParams ? '?' . http_build_query($returnParams) : '');
$managerCta = static function (array $property): array {
    $editUrl = 'property/edit/' . (int) ($property['id'] ?? 0);

    if ((int) ($property['image_count'] ?? 0) <= 0) {
        return ['href' => $editUrl . '#tn-edit-media', 'label' => 'Додати фото', 'class' => 'is-warning'];
    }

    if ((int) ($property['agent_id'] ?? 0) <= 0) {
        return ['href' => $editUrl . '#tn-edit-main', 'label' => 'Призначити', 'class' => 'is-warning'];
    }

    if (!empty($property['operational_stage_issues'])) {
        return ['href' => $editUrl . '#tn-edit-service', 'label' => 'Етап', 'class' => 'is-warning'];
    }

    if (empty($property['is_ready_to_publish'])) {
        return ['href' => $editUrl . '#tn-edit-public', 'label' => 'Доробити', 'class' => 'is-warning'];
    }

    if (!in_array((string) ($property['status'] ?? ''), ['published', 'active'], true)) {
        return ['href' => $editUrl . '#tn-edit-main', 'label' => 'Публікація', 'class' => 'is-ready'];
    }

    return ['href' => 'property/show/' . (string) ($property['slug'] ?? ''), 'label' => 'Клієнту', 'class' => 'is-ready'];
};
