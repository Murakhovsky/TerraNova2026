                  <a class="tn-manager-row-cta <?php echo $h($cta['class']); ?>" href="<?php echo $this->url->get($cta['href']); ?>"><?php echo $h($cta['label']); ?></a>
                  <a href="<?php echo $this->url->get('property/edit/' . $property['id']); ?>">Редагувати</a>
                  <?php if (!empty($property['property_group_id'])): ?>
                    <a href="<?php echo $this->url->get('property/group/' . (int) $property['property_group_id']); ?>">Група</a>
                  <?php endif; ?>
                  <a href="<?php echo $this->url->get('property/show/' . $property['slug']); ?>">Перегляд</a>
                </td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    <?php endif; ?>
  </section>
</main>
