<?php
$h = static fn($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$money = static function ($amount, string $currency = 'USD', string $period = 'total'): string {
    if ($amount === null || $amount === '') {
        return 'Ціна за запитом';
    }
    $suffix = $period === 'month' ? ' / міс.' : ($period === 'day' ? ' / день' : '');
    return number_format((float) $amount, 0, '.', ' ') . ' ' . $currency . $suffix;
};
$number = static fn($value): string => $value === null || $value === ''
    ? '-'
    : rtrim(rtrim(number_format((float) $value, 1, '.', ' '), '0'), '.');
$commission = static function (array $item) use ($money): string {
    return match ((string) ($item['commission_type'] ?? 'none')) {
        'percent' => rtrim(rtrim(number_format((float) ($item['commission_value'] ?? 0), 2, '.', ''), '0'), '.') . '%',
        'fixed' => $money($item['commission_value'] ?? null, (string) ($item['price_currency'] ?? 'USD')),
        'included' => 'Включена у ціну',
        default => 'Не задана',
    };
};
$dealLabels = ['sale' => 'Продаж', 'rent' => 'Оренда', 'investment' => 'Інвестиція'];
$variantLabel = $variant === 'partner' ? 'Партнерська версія' : 'Презентація для клієнта';
