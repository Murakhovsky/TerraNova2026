<?php
/** @var array $report */
/** @var array $reportEnvelope */
/** @var string $sessionId */
$e = static fn (mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$list = static fn (mixed $value): array => is_array($value) ? $value : [];
$percent = static fn (mixed $value): string => number_format((float) $value * 100, 1) . '%';
$scalar = static function (mixed $value) use ($e): string {
    if (is_scalar($value) || $value === null) return $e($value ?? '');
    return $e(json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
};
?>
<main class="tn-page tn-workspace-page tn-workspace-page--wide tn-diagnostic-report">
    <?php $this->partial('components/ui/page_header', [
        'eyebrow' => 'Diagnostic report',
        'title' => (string) ($report['diagnosticId'] ?? $sessionId),
        'description' => (string) ($report['executiveSummary'] ?? ''),
        'meta' => [
            'value' => (string) ($reportEnvelope['report_version'] ?? '1'),
            'label' => 'версія звіту',
        ],
    ]); ?>

    <section class="tn-ui-kpi-grid tn-workspace-section" aria-label="Diagnostic summary">
        <?php $this->partial('components/ui/kpi_card', [
            'label' => 'Health',
            'value' => number_format((float) ($report['overallHealth'] ?? 0), 1) . '/100',
            'tone' => ((float) ($report['overallHealth'] ?? 0)) >= 70 ? 'positive' : (((float) ($report['overallHealth'] ?? 0)) >= 40 ? 'warning' : 'danger'),
        ]); ?>
        <?php $this->partial('components/ui/kpi_card', [
            'label' => 'Coverage',
            'value' => $percent($report['coverage'] ?? 0),
        ]); ?>
        <?php $this->partial('components/ui/kpi_card', [
            'label' => 'Confidence',
            'value' => $percent($report['confidence'] ?? 0),
        ]); ?>
        <?php $this->partial('components/ui/kpi_card', [
            'label' => 'Report version',
            'value' => (string) ($reportEnvelope['report_version'] ?? '1'),
        ]); ?>
    </section>

    <?php
    $sections = [
        'topProblems' => ['title' => 'Top problems', 'eyebrow' => 'Priority'],
        'criticalRisks' => ['title' => 'Critical risks', 'eyebrow' => 'Risk'],
        'opportunities' => ['title' => 'Opportunities', 'eyebrow' => 'Potential'],
        'strengths' => ['title' => 'Strengths', 'eyebrow' => 'Capability'],
        'quickWins' => ['title' => 'Quick wins', 'eyebrow' => 'Execution'],
        'findings' => ['title' => 'Findings', 'eyebrow' => 'Evidence'],
        'rootCauses' => ['title' => 'Root causes', 'eyebrow' => 'Diagnosis'],
        'recommendations' => ['title' => 'Recommendations', 'eyebrow' => 'Action'],
        'roadmap' => ['title' => 'Roadmap', 'eyebrow' => 'Sequence'],
        'unknowns' => ['title' => 'Unknowns', 'eyebrow' => 'Uncertainty'],
        'contradictions' => ['title' => 'Contradictions', 'eyebrow' => 'Evidence quality'],
    ];
    foreach ($sections as $key => $section):
        $items = $list($report[$key] ?? []);
        if ($items === []) continue;
    ?>
        <section class="tn-ui-panel tn-workspace-section">
            <div class="tn-ui-panel__head">
                <div>
                    <p class="tn-ui-eyebrow"><?php echo $e($section['eyebrow']); ?></p>
                    <h2><?php echo $e($section['title']); ?></h2>
                </div>
            </div>
            <div class="tn-ui-panel__body tn-stack">
                <?php foreach ($items as $item): ?>
                    <article class="tn-list-row">
                        <?php if (is_array($item)): ?>
                            <?php foreach ($item as $field => $value): ?>
                                <div><strong><?php echo $e($field); ?>:</strong> <?php echo $scalar($value); ?></div>
                            <?php endforeach; ?>
                        <?php else: ?>
                            <div><?php echo $scalar($item); ?></div>
                        <?php endif; ?>
                    </article>
                <?php endforeach; ?>
            </div>
        </section>
    <?php endforeach; ?>

    <?php $measurements = $list($reportEnvelope['measurements'] ?? []); ?>
    <?php if ($measurements !== []): ?>
        <section class="tn-ui-panel tn-workspace-section">
            <div class="tn-ui-panel__head">
                <div><p class="tn-ui-eyebrow">Outcomes</p><h2>Measured outcomes</h2></div>
            </div>
            <div class="tn-ui-panel__body tn-stack">
                <?php foreach ($measurements as $measurement): ?>
                    <article class="tn-list-row">
                        <strong><?php echo $e($measurement['metric_code'] ?? 'metric'); ?></strong>
                        <span><?php echo $e($measurement['metric_value'] ?? ''); ?></span>
                        <small><?php echo $e($measurement['measured_at'] ?? ''); ?></small>
                    </article>
                <?php endforeach; ?>
            </div>
        </section>
    <?php endif; ?>
</main>
