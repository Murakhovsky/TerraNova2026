      <p>Канонічний Architecture Graph з server-side projections для system, runtime, domain, dependencies, events, actions, agents, integrations та code surface.</p>
    </div>
    <div class="tn-architecture-hero__stats" aria-label="Active graph summary">
      <span><strong data-architecture-view-label><?php echo $h($viewDescriptions[$defaultView]['label'] ?? $defaultView); ?></strong> view</span>
      <span><strong data-architecture-node-count><?php echo (int) ($summary['nodes'] ?? 0); ?></strong> nodes</span>
      <span><strong data-architecture-edge-count><?php echo (int) ($summary['edges'] ?? 0); ?></strong> edges</span>
      <a class="tn-btn tn-btn--ghost" href="<?php echo $this->url->get('cos/control-center'); ?>">Control Center</a>
    </div>
  </section>

  <?php if ($pageStatus): ?>
    <p class="tn-form-status is-visible"><?php echo $h($pageStatus); ?></p>
  <?php endif; ?>

  <section class="tn-architecture-toolbar" aria-label="Architecture Explorer controls">
    <div class="tn-architecture-mode" role="group" aria-label="Projection">
      <?php foreach ($viewDescriptions as $name => $description): ?>
        <button
          type="button"
          class="<?php echo $name === $defaultView ? 'is-active' : ''; ?>"
          data-architecture-mode="<?php echo $h($name); ?>"
        ><?php echo $h($description['label'] ?? $name); ?></button>
      <?php endforeach; ?>
    </div>
    <label class="tn-architecture-search">
      <span>Search</span>
      <input type="search" placeholder="Sales, event, rule, action…" data-architecture-search autocomplete="off">
    </label>
    <label>
      <span>Domain</span>
      <select data-architecture-domain>
        <?php foreach ($domains as $domain): ?>
          <option value="<?php echo $h($domain['id'] ?? ''); ?>"><?php echo $h($domain['label'] ?? $domain['id'] ?? 'Domain'); ?></option>
        <?php endforeach; ?>
      </select>
    </label>
    <label>
      <span>Depth</span>
      <select data-architecture-depth>
        <option value="all">All</option>
        <option value="1">1 hop</option>
        <option value="2" selected>2 hops</option>
        <option value="3">3 hops</option>
      </select>
    </label>
    <div class="tn-architecture-toolbar__actions">
      <button type="button" data-architecture-fit>Fit</button>
      <button type="button" data-architecture-reset>Reset</button>
    </div>
  </section>

  <section class="tn-architecture-shell">
    <aside class="tn-architecture-sidebar" aria-label="Node type filters">
      <div class="tn-section-heading"><div><p class="tn-kicker">Filters</p><h2>Node types</h2></div></div>
      <div class="tn-architecture-types" data-architecture-types>
        <?php foreach ($nodeTypes as $type => $count): ?>
          <label>
            <input type="checkbox" value="<?php echo $h($type); ?>" checked data-architecture-type>
            <span><?php echo $h($type); ?></span><strong><?php echo (int) $count; ?></strong>
          </label>
        <?php endforeach; ?>
      </div>
      <p class="tn-muted">Projection визначає семантику view на сервері. Domain focus/depth теж проєктується сервером; локальні фільтри лише звужують готовий Graph.</p>
    </aside>

    <div class="tn-architecture-stage-wrap">
      <?php if ($architectureDiagnostic): ?>
        <div class="tn-form-status is-visible" data-architecture-backend-diagnostic>
          <strong>Backend diagnostic</strong><br>
          stage: <?php echo $h($architectureDiagnostic['stage'] ?? 'unknown'); ?><br>
          exception: <?php echo $h($architectureDiagnostic['exception'] ?? 'unknown'); ?><br>
          detail: <?php echo $h($architectureDiagnostic['detail'] ?? 'No details.'); ?>
        </div>
      <?php endif; ?>
      <div class="tn-architecture-stage" data-architecture-stage aria-label="Interactive COS architecture graph"></div>
      <div class="tn-architecture-loading" data-architecture-loading>Loading Architecture Graph…</div>
      <p class="tn-architecture-error" data-architecture-error hidden></p>
