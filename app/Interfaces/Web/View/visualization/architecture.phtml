    <label>
      <span>Domain</span>
      <select data-architecture-domain>
        <?php foreach ($domains as $domain): ?>
          <option value="<?php echo $h($domain['id'] ?? ''); ?>"><?php echo $h($domain['label'] ?? $domain['id'] ?? 'Domain'); ?></option>
        <?php endforeach; ?>
      </select>
    </label>
    <label>
      <span>Depth</span>
      <select data-architecture-depth>
        <option value="all">All</option>
        <option value="1">1 hop</option>
        <option value="2" selected>2 hops</option>
        <option value="3">3 hops</option>
      </select>
