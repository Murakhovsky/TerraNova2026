  </section>

  <section class="tn-architecture-shell">
    <aside class="tn-architecture-sidebar" aria-label="Node type filters">
      <div class="tn-ui-panel__head"><div><p class="tn-ui-eyebrow">Filters</p><h2>Node types</h2></div></div>
      <div class="tn-architecture-types" data-architecture-types>
        <?php foreach ($nodeTypes as $type => $count): ?>
          <label>
            <input type="checkbox" value="<?php echo $h($type); ?>" checked data-architecture-type>
            <span><?php echo $h($type); ?></span><strong><?php echo (int) $count; ?></strong>
          </label>
        <?php endforeach; ?>
      </div>
      <p class="tn-muted">Projection визначає семантику view на сервері. Domain focus/depth теж проєктується сервером; локальні фільтри лише звужують готовий Graph.</p>
    </aside>

    <div class="tn-architecture-stage-wrap">
      <?php if ($architectureDiagnostic): ?>
        <div data-architecture-backend-diagnostic>
          <?php $this->partial('components/ui/state', [
              'kind' => 'error',
              'title' => 'Backend diagnostic',
              'message' => 'stage: ' . (string) ($architectureDiagnostic['stage'] ?? 'unknown')
                  . ' · exception: ' . (string) ($architectureDiagnostic['exception'] ?? 'unknown')
                  . ' · detail: ' . (string) ($architectureDiagnostic['detail'] ?? 'No details.'),
          ]); ?>
        </div>
      <?php endif; ?>
      <div class="tn-architecture-stage" data-architecture-stage aria-label="Interactive COS architecture graph"></div>
      <div class="tn-architecture-loading" data-architecture-loading>Loading Architecture Graph…</div>
      <p class="tn-architecture-error" data-architecture-error hidden></p>
    </div>

    <aside class="tn-architecture-details" data-architecture-details>
      <p class="tn-ui-eyebrow">Selection</p>
      <h2>Node details</h2>
      <p class="tn-muted">Виберіть вузол графа. Тут з’являться ownership, dependencies, runtime relations, source metadata та локальні дії.</p>
    </aside>
  </section>

  <script type="application/json" id="cos-architecture-data"><?php echo $graphJson; ?></script>
</main>
