<?php
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$architectureGraph = is_array($architectureGraph ?? null) ? $architectureGraph : [];
$canonicalSummary = is_array($architectureGraph['summary'] ?? null) ? $architectureGraph['summary'] : [];
$viewDescriptions = is_array($architectureViewDescriptions ?? null) ? $architectureViewDescriptions : [];
$defaultView = (string) ($architectureGraph['default_view'] ?? '');
$defaultPayload = is_array($architectureGraph['views'][$defaultView] ?? null) ? $architectureGraph['views'][$defaultView] : [];
$summary = is_array($defaultPayload['summary'] ?? null) ? $defaultPayload['summary'] : $canonicalSummary;
$nodeTypes = is_array($summary['node_types'] ?? null) ? $summary['node_types'] : [];
$domains = is_array($canonicalSummary['domains'] ?? null) ? $canonicalSummary['domains'] : [];
$pageStatus = $pageStatus ?? null;
$architectureDiagnostic = is_array($architectureDiagnostic ?? null) ? $architectureDiagnostic : null;
$architectureHealth = is_array($architectureHealth ?? null) ? $architectureHealth : null;
$healthStatus = (string) ($architectureHealth['status'] ?? 'unknown');
$healthIssues = is_array($architectureHealth['issues'] ?? null) ? $architectureHealth['issues'] : [];
$graphJson = json_encode(
    $architectureGraph,
    JSON_UNESCAPED_UNICODE
        | JSON_UNESCAPED_SLASHES
        | JSON_HEX_TAG
        | JSON_HEX_AMP
        | JSON_HEX_APOS
        | JSON_HEX_QUOT
        | JSON_INVALID_UTF8_SUBSTITUTE,
);
if (!is_string($graphJson)) {
    $graphJson = '{"views":{},"summary":{},"default_view":""}';
}
?>

<main
  class="tn-page tn-workspace-page tn-workspace-page--wide tn-architecture-explorer"
  data-architecture-explorer
  data-architecture-endpoint="<?php echo $h($this->url->get('cos/architecture/graph')); ?>"
  data-architecture-default-view="<?php echo $h($defaultView); ?>"
>
  <?php $this->partial('components/ui/page_header', [
      'eyebrow' => 'COS Visualization',
      'title' => 'Architecture Explorer',
      'description' => 'Канонічний Architecture Graph з server-side projections для system, runtime, domain, dependencies, events, actions, agents, integrations та code surface.',
      'actions' => [
          ['label' => 'Control Center', 'href' => 'cos/control-center', 'variant' => 'ghost'],
          ['label' => 'JSON health', 'href' => 'cos/architecture/health', 'variant' => 'ghost'],
      ],
  ]); ?>

  <section class="tn-ui-kpi-grid tn-workspace-section" aria-label="Active graph summary">
    <?php $this->partial('components/ui/kpi_card', [
        'label' => 'View',
        'value' => $viewDescriptions[$defaultView]['label'] ?? $defaultView,
        'hint' => 'projection',
    ]); ?>
    <article class="tn-ui-card tn-ui-kpi">
      <span>Nodes</span>
      <strong data-architecture-node-count><?php echo (int) ($summary['nodes'] ?? 0); ?></strong>
      <small>active projection</small>
    </article>
    <article class="tn-ui-card tn-ui-kpi">
      <span>Edges</span>
      <strong data-architecture-edge-count><?php echo (int) ($summary['edges'] ?? 0); ?></strong>
      <small>active projection</small>
    </article>
    <article class="tn-ui-card tn-ui-kpi">
      <span>Health</span>
      <strong><?php echo $h($healthStatus); ?></strong>
      <small>graph state</small>
    </article>
    <span class="tn-architecture-view-label" data-architecture-view-label hidden><?php echo $h($viewDescriptions[$defaultView]['label'] ?? $defaultView); ?></span>
  </section>

  <?php if ($pageStatus): ?>
    <?php $this->partial('components/ui/state', [
        'kind' => 'error',
        'title' => 'Architecture Graph недоступний',
        'message' => (string) $pageStatus,
    ]); ?>
  <?php endif; ?>

  <?php if ($architectureHealth): ?>
    <section class="tn-ui-panel tn-workspace-section" aria-label="Architecture graph health">
      <div class="tn-ui-panel__head">
        <div>
          <p class="tn-ui-eyebrow">Graph Health</p>
          <h2><?php echo $h(strtoupper($healthStatus)); ?></h2>
          <p>
            <?php echo (int) ($architectureHealth['errors'] ?? 0); ?> errors ·
            <?php echo (int) ($architectureHealth['warnings'] ?? 0); ?> warnings ·
            <?php echo (int) ($architectureHealth['info'] ?? 0); ?> info
          </p>
        </div>
        <?php $this->partial('components/ui/action_bar', [
            'actions' => [['label' => 'JSON health', 'href' => 'cos/architecture/health', 'variant' => 'ghost']],
            'align' => 'end',
            'ariaLabel' => 'Architecture graph health actions',
        ]); ?>
      </div>
      <?php if ($healthIssues): ?>
        <div class="tn-ui-panel__body">
          <ul>
            <?php foreach (array_slice($healthIssues, 0, 5) as $issue): ?>
              <li>
                <strong><?php echo $h($issue['severity'] ?? 'info'); ?> / <?php echo $h($issue['code'] ?? 'unknown'); ?></strong>
                <?php echo $h($issue['message'] ?? 'Architecture health issue.'); ?>
              </li>
            <?php endforeach; ?>
          </ul>
        </div>
      <?php else: ?>
        <div class="tn-ui-panel__body">
          <?php $this->partial('components/ui/state', [
              'kind' => 'success',
              'title' => 'Architecture graph health',
              'message' => 'Структурних проблем Architecture Graph не виявлено.',
          ]); ?>
        </div>
      <?php endif; ?>
    </section>
  <?php endif; ?>

  <section class="tn-architecture-toolbar" aria-label="Architecture Explorer controls">
    <div class="tn-architecture-mode" role="group" aria-label="Projection">
      <?php foreach ($viewDescriptions as $name => $description): ?>
        <button
          type="button"
          class="<?php echo $name === $defaultView ? 'is-active' : ''; ?>"
          data-architecture-mode="<?php echo $h($name); ?>"
        ><?php echo $h($description['label'] ?? $name); ?></button>
      <?php endforeach; ?>
    </div>
    <label class="tn-architecture-search">
      <span>Search</span>
      <input type="search" placeholder="Sales, event, rule, action…" data-architecture-search autocomplete="off">
