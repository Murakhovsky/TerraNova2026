   <section class="drawer" hidden data-simulator><div class="panel-title"><h2>Diagnostic Simulator</h2><button data-close>Close</button></div><div class="split"><label>Facts and metrics<textarea rows="12" data-simulation-input>{"facts":{},"metrics":{}}</textarea></label><pre data-simulation-output>Run the compiled draft to inspect scores, findings and recommendations.</pre></div><button class="primary" type="button" data-action="run-simulation">Run simulation</button></section>
   <section class="drawer" hidden data-scenarios><div class="panel-title"><h2>Regression scenarios</h2><button data-close>Close</button></div><form data-scenario-form class="scenario-form"><label>ID<input name="id" required pattern="[a-z][a-z0-9_.-]+"></label><label>Name<input name="name" required></label><label>Inputs<textarea name="input" rows="7">{"facts":{},"metrics":{}}</textarea></label><label>Expected<textarea name="expected" rows="7">{"findings":[],"recommendations":[]}</textarea></label><button class="primary" type="submit">Save scenario</button></form><div data-scenario-list></div></section>
  </section>
 </div>
 <dialog data-pack-dialog><form method="dialog" data-pack-form><h2>New diagnostic pack</h2><label>Slug<input name="slug" required pattern="[a-z][a-z0-9-]+"></label><label>Name<input name="name" required></label><label>Domain<input name="domain" required></label><label>Version<input name="methodology_version" value="0.1.0" required pattern="[0-9]+\.[0-9]+\.[0-9]+"></label><label>Description<textarea name="description"></textarea></label><div class="form-actions"><button value="cancel">Cancel</button><button class="primary" value="default">Create</button></div></form></dialog>
 <div class="menu" data-menu hidden><button data-action="activate">Set active</button><button data-action="archive">Archive</button><button data-action="scenarios">Scenarios</button><button data-action="simulate">Simulator</button></div>
 <div class="toast" data-toast hidden></div>
