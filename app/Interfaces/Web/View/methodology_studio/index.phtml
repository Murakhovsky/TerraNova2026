   <div class="packbar"><div><strong data-pack-title>Select a methodology pack</strong><span data-version-status>No version selected</span></div><select data-version aria-label="Methodology version"></select><button data-action="clone">Clone</button></div>
   <div class="tabs" role="tablist"></div>
   <div class="panel">
    <section class="entity-list"><div class="panel-title"><h2 data-section-title>Areas</h2><button data-action="add">+ Add</button></div><table><thead><tr><th>Name / ID</th><th>Status</th><th>Order</th><th></th></tr></thead><tbody data-entities><tr><td colspan="4">Choose a pack.</td></tr></tbody></table><div class="graph" data-graph hidden></div></section>
    <form class="editor" data-editor><div class="panel-title"><h2>Editor</h2><span data-edit-state>New</span></div><div data-fields></div><label class="toggle"><input type="checkbox" name="enabled" checked> Enabled</label><details><summary>Advanced / developer fields</summary><label>Additional JSON<textarea name="advanced" rows="7">{}</textarea></label></details><div class="form-actions"><button class="primary" type="submit">Save draft</button><button type="button" data-action="delete" class="danger">Delete</button></div></form>
   </div>
