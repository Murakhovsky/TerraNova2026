<style>
.studio{max-width:1500px;margin:0 auto;padding:24px;color:#17202a}.studio-head,.packbar,.panel-title,.actions,.form-actions{display:flex;align-items:center;justify-content:space-between;gap:10px}.studio-head{margin-bottom:18px}.studio-head h1{font-size:30px;margin:4px 0}.studio-head p{margin:0;color:#66717c}.studio button,.studio select,.studio input,.studio textarea{font:inherit}.studio button{border:1px solid #c8d0d8;background:#fff;padding:8px 11px;border-radius:5px;cursor:pointer}.studio button.primary{background:#176b4d;color:#fff;border-color:#176b4d}.studio button.danger{color:#a52d2d}.studio button:disabled{opacity:.45;cursor:not-allowed}.studio-shell{display:grid;grid-template-columns:230px minmax(0,1fr);border:1px solid #d9dfe5;min-height:680px}.studio aside{border-right:1px solid #d9dfe5;padding:14px;background:#f6f8f9}.studio aside button{width:100%;text-align:left;margin-bottom:7px}.studio aside button.selected{border-color:#176b4d;background:#edf7f2}.workspace{min-width:0}.packbar{padding:14px 20px;border-bottom:1px solid #d9dfe5}.packbar span{display:block;color:#66717c;font-size:13px;margin-top:3px}.tabs{display:flex;gap:6px;padding:9px 20px;border-bottom:1px solid #d9dfe5;overflow:auto}.tabs button{white-space:nowrap}.tabs button.active{background:#17202a;color:#fff}.panel{display:grid;grid-template-columns:minmax(0,1fr) 390px}.entity-list,.editor,.drawer{padding:20px}.editor{border-left:1px solid #d9dfe5;background:#fbfcfc}.studio label{display:grid;gap:5px;margin:11px 0;font-size:13px;font-weight:600}.studio input,.studio textarea,.studio select{border:1px solid #b8c1ca;border-radius:4px;padding:8px;background:#fff;box-sizing:border-box;max-width:100%}.studio textarea{resize:vertical}.toggle{display:flex!important;align-items:center}.studio table{width:100%;border-collapse:collapse}.studio th,.studio td{text-align:left;padding:10px;border-bottom:1px solid #e2e6ea;font-size:13px}.status{font-size:11px;font-weight:700;text-transform:uppercase}.drawer{border-top:1px solid #d9dfe5;background:#f8faf9}.split{display:grid;grid-template-columns:1fr 1fr;gap:16px}.studio pre{white-space:pre-wrap;background:#111923;color:#dce8e2;padding:14px;overflow:auto;min-height:150px}.rule-row,.band-row{display:grid;grid-template-columns:1.4fr .8fr 1fr auto;gap:6px;margin:6px 0}.graph{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.graph-edge{border-left:3px solid #176b4d;padding:8px 12px;background:#edf7f2}.scenario-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}.menu{position:fixed;right:28px;top:92px;padding:7px;background:white;border:1px solid #ccd3da;box-shadow:0 8px 24px #0002;z-index:10}.menu button{display:block;width:100%;border:0;text-align:left}.toast{position:fixed;right:24px;bottom:24px;background:#17202a;color:#fff;padding:12px 16px;border-radius:5px;z-index:20}.toast.error{background:#8d2525}dialog{border:1px solid #c8d0d8;border-radius:6px;box-shadow:0 18px 60px #0003;width:min(480px,90vw)}dialog form{display:grid;gap:7px}@media(max-width:900px){.studio-shell,.panel,.split,.scenario-form{grid-template-columns:1fr}.studio aside,.editor{border:0;border-bottom:1px solid #d9dfe5}.studio-head{align-items:flex-start;flex-direction:column}.actions{flex-wrap:wrap}}
</style>
<script>
(()=>{
 const root=document.querySelector('[data-studio]'),csrf=root.dataset.csrf;
 const types=['AREA','CRITERION','FACT','METRIC','QUESTION','EVIDENCE_REQUIREMENT','RULE','DEPENDENCY','RECOMMENDATION','BENCHMARK','SCORING'];
 const schemas={
  AREA:[['id','ID','text'],['name','Name','text'],['description','Description','textarea'],['purpose','Purpose','textarea'],['business_impact','Business impact','textarea'],['weight','Weight','number'],['order','Order','number']],
  CRITERION:[['id','ID','text'],['name','Name','text'],['section','Area ID','text'],['required','Required inputs (comma separated)','list'],['optional','Optional inputs (comma separated)','list'],['weight','Weight','number'],['importance','Importance','select:low|medium|high|critical'],['minimum_coverage','Minimum coverage 0..1','number'],['minimum_confidence','Minimum confidence 0..1','number'],['applicability','Applicability condition JSON','json'],['good_practices','Good practices','list'],['bad_practices','Bad practices','list']],
  FACT:[['id','ID','text'],['name','Name','text'],['description','Description','textarea'],['type','Type','select:boolean|integer|number|percentage|currency|string|enum|date|datetime|duration'],['unit','Unit','text'],['enum_values','Allowed values','list'],['truth_level','Truth level','text'],['sensitivity','Sensitivity','text'],['freshness_policy','Freshness policy','text']],
  METRIC:[['id','ID','text'],['name','Name','text'],['description','Description','textarea'],['type','Type','select:number|integer|percentage|ratio|duration|currency'],['unit','Unit','text'],['formula_expression','Formula','text'],['input_facts','Input facts','list'],['aggregation','Aggregation','select:average|sum|minimum|maximum|latest|count'],['direction','Direction','select:higher_is_better|lower_is_better|target_range|neutral'],['minimum_sample_size','Minimum sample size','number'],['benchmark_reference','Benchmark','text']],
  QUESTION:[['id','ID','text'],['text','Question text','textarea'],['target_facts','Target facts','list'],['target_criteria','Target criteria','list'],['expected_answer_type','Answer type','text'],['priority','Priority','number'],['cost','Estimated cost','number'],['evidence_requirement_id','Evidence requirement','text'],['allowed_diagnostic_modes','Allowed modes','list']],
  EVIDENCE_REQUIREMENT:[['id','ID','text'],['criteria','Criteria','list'],['accepted_source_types','Allowed sources','list'],['hierarchy','Preferred source order','list'],['minimum_sources','Independent sources','number'],['minimum_reliability','Minimum reliability','number'],['minimum_directness','Minimum directness','number'],['maximum_age','Maximum age','text']],
  RULE:[['id','ID','text'],['name','Name','text'],['criterion','Criterion','text'],['finding','Finding','textarea'],['severity','Severity','select:info|low|medium|high|critical'],['confidence_requirement','Confidence requirement','number'],['recommendation_refs','Recommendations','list'],['conditions','Conditions','rule']],
  DEPENDENCY:[['source','Source criterion','text'],['target','Target criterion','text'],['type','Type','select:requires|influences|blocks|depends_on|contributes_to'],['strength','Strength','number'],['direction','Direction','select:positive|negative']],
  RECOMMENDATION:[['id','ID','text'],['title','Title','text'],['trigger_rules','Trigger rules','list'],['criteria','Target criteria','list'],['target_problem','Target problem','textarea'],['rationale','Rationale','textarea'],['actions','Actions','list'],['expected_impact','Expected impact','textarea'],['implementation_effort','Effort','select:low|medium|high'],['owner_role','Owner role','text'],['success_metrics','Success metrics','list'],['dependencies','Dependencies','list']],
  BENCHMARK:[['id','ID','text'],['metric_id','Metric','text'],['name','Name','text'],['unit','Unit','text'],['segments','Segments JSON','json'],['bands','Benchmark bands','bands'],['source','Source','text'],['valid_from','Valid from','date'],['valid_to','Valid to','date']],
  SCORING:[['criterion','Criterion','text'],['metric','Metric','text'],['normalization','Normalization','select:bands|linear|inverse_linear'],['aggregation','Aggregation','select:weighted_average|average|sum|minimum|maximum'],['weight','Weight','number'],['penalty','Penalty','number'],['bonus','Bonus','number'],['bands','Score bands','bands']]
 };
 let pack='',version='',type='AREA',entities=[],versions=[],editing='';
 const q=s=>root.querySelector(s),qa=s=>[...root.querySelectorAll(s)];
 const api=async(url,options={})=>{options.headers={...(options.headers||{}),'Content-Type':'application/json','X-CSRF-Token':csrf};const response=await fetch(url,options),json=await response.json();if(!json.ok)throw Error(json.error||'Request failed');return json.data};
 const post=(path,body={})=>api(path,{method:'POST',body:JSON.stringify(body)});
 function toast(message,error=false){const el=q('[data-toast]');el.textContent=message;el.classList.toggle('error',error);el.hidden=false;setTimeout(()=>el.hidden=true,3200)}
 function inputField([name,label,kind],value){const safe=String(value??'').replaceAll('&','&amp;').replaceAll('"','&quot;').replaceAll('<','&lt;');if(kind==='textarea')return `<label>${label}<textarea name="${name}">${safe}</textarea></label>`;if(kind==='list')return `<label>${label}<input name="${name}" value="${Array.isArray(value)?value.join(', '):safe}"></label>`;if(kind==='json')return `<label>${label}<textarea name="${name}">${safe||'{}'}</textarea></label>`;if(kind==='rule')return `<fieldset data-rule><legend>${label}</legend><select data-rule-group><option>all</option><option>any</option></select><div data-rule-rows></div><button type="button" data-action="add-condition">+ Condition</button></fieldset>`;if(kind==='bands')return `<fieldset data-bands><legend>${label}</legend><div data-band-rows></div><button type="button" data-action="add-band">+ Band</button></fieldset>`;if(kind.startsWith('select:'))return `<label>${label}<select name="${name}">${kind.slice(7).split('|').map(x=>`<option ${x===value?'selected':''}>${x}</option>`).join('')}</select></label>`;return `<label>${label}<input name="${name}" type="${kind}" step="any" value="${safe}"></label>`}
 function addCondition(value={subject:'',operator:'gt',value:''}){const row=document.createElement('div');row.className='rule-row';row.innerHTML=`<input data-condition="subject" placeholder="metric or fact" value="${value.subject||''}"><select data-condition="operator">${['gt','gte','lt','lte','eq','neq','in','not_in','exists','missing','between'].map(x=>`<option ${x===(value.operator||'gt')?'selected':''}>${x}</option>`).join('')}</select><input data-condition="value" placeholder="value" value="${Array.isArray(value.value)?value.value.join(','):value.value??''}"><button type="button" data-remove>×</button>`;q('[data-rule-rows]').append(row)}
 function addBand(value={}){const row=document.createElement('div');row.className='band-row';row.innerHTML=`<input data-band="label" placeholder="label" value="${value.label||''}"><input data-band="min" type="number" step="any" placeholder="min" value="${value.min??''}"><input data-band="max" type="number" step="any" placeholder="max" value="${value.max??''}"><input data-band="score" type="number" step="any" placeholder="score" value="${value.score??''}"><button type="button" data-remove>×</button>`;q('[data-band-rows]').append(row)}
 function editor(payload={}){editing=payload.id||((type==='DEPENDENCY')?`${payload.source||''}--${payload.target||''}`:'');q('[data-fields]').innerHTML=schemas[type].map(field=>inputField(field,payload[field[0]])).join('');q('[data-editor] [name=enabled]').checked=payload.enabled!==false;q('[data-editor] [name=advanced]').value='{}';q('[data-edit-state]').textContent=editing?'Editing':'New';if(type==='RULE'){const tree=payload.conditions||{all:[]};q('[data-rule-group]').value=tree.any?'any':'all';(tree.any||tree.all||[tree]).forEach(addCondition)}if(['BENCHMARK','SCORING'].includes(type))(payload.bands||[]).forEach(addBand);updateLock()}
 function updateLock(){const row=versions.find(x=>x.methodology_version===version),locked=row&&['PUBLISHED','ARCHIVED'].includes(row.status);qa('[data-editor] input,[data-editor] textarea,[data-editor] select,[data-editor] button').forEach(x=>x.disabled=!!locked);q('[data-version-status]').textContent=row?`${row.status} · schema ${row.schema_version}`:'No version selected'}
 async function loadPacks(select){const data=await api('/api/admin/diagnostics/packs');q('[data-pack-list]').innerHTML=data.packs.map(p=>`<button data-pack="${p.pack_id}" class="${p.pack_id===pack?'selected':''}"><strong>${p.name}</strong><br><small>${p.domain}${p.active_methodology_version?' · active '+p.active_methodology_version:''}</small></button>`).join('')||'<p>No packs yet.</p>';if(select)await selectPack(select)}
 async function selectPack(id){pack=id;const [detail,list]=await Promise.all([api(`/api/admin/diagnostics/packs/${id}`),api(`/api/admin/diagnostics/packs/${id}/versions`)]);versions=list.versions;q('[data-pack-title]').textContent=detail.pack.name;q('[data-version]').innerHTML=versions.map(v=>`<option value="${v.methodology_version}">${v.methodology_version} · ${v.status}</option>`).join('');version=q('[data-version]').value;qa('[data-pack]').forEach(x=>x.classList.toggle('selected',x.dataset.pack===pack));await loadEntities()}
 async function loadEntities(){if(!pack||!version)return;entities=(await api(`/api/admin/diagnostics/packs/${pack}/versions/${version}/entities`)).entities;renderEntities();editor();updateLock()}
 function renderEntities(){const rows=entities.filter(x=>x.entity_type===type);q('[data-entities]').innerHTML=rows.map(x=>`<tr data-entity="${x.entity_id}"><td><strong>${x.payload.name||x.payload.title||x.payload.text||x.entity_id}</strong><br><small>${x.entity_id}</small></td><td><span class="status">${x.enabled?'enabled':'disabled'}</span></td><td>${x.position}</td><td><button type="button" data-edit="${x.entity_id}" title="Edit">Edit</button></td></tr>`).join('')||'<tr><td colspan="4">No entities in this section.</td></tr>';const graph=q('[data-graph]');graph.hidden=type!=='DEPENDENCY';if(type==='DEPENDENCY')graph.innerHTML=rows.map(x=>`<div class="graph-edge"><strong>${x.payload.source}</strong><br><small>${x.payload.type}</small><br><strong>${x.payload.target}</strong></div>`).join('')}
 function payloadFromForm(form){const data={},fd=new FormData(form),schema=schemas[type];for(const [name,,kind]of schema){let value=fd.get(name);if(kind==='list')value=String(value||'').split(',').map(x=>x.trim()).filter(Boolean);else if(kind==='number'&&value!=='')value=Number(value);else if(kind==='json')value=JSON.parse(value||'{}');if(value!==''&&kind!=='rule'&&kind!=='bands')data[name]=value}Object.assign(data,JSON.parse(fd.get('advanced')||'{}'));data.enabled=form.elements.enabled.checked;if(type==='RULE'){const children=qa('[data-rule-rows] .rule-row').map(row=>{const subject=row.querySelector('[data-condition=subject]').value,operator=row.querySelector('[data-condition=operator]').value,raw=row.querySelector('[data-condition=value]').value;const node={subject,operator};if(!['exists','missing'].includes(operator))node.value=['in','not_in','between'].includes(operator)?raw.split(',').map(x=>isNaN(x.trim())?x.trim():Number(x)):isNaN(raw)?raw:Number(raw);return node});data.conditions={[q('[data-rule-group]').value]:children}}if(['BENCHMARK','SCORING'].includes(type))data.bands=qa('[data-band-rows] .band-row').map(row=>{const out={};row.querySelectorAll('[data-band]').forEach(x=>{if(x.value!=='')out[x.dataset.band]=x.type==='number'?Number(x.value):x.value});return out});return data}
 q('.tabs').innerHTML=types.map(t=>`<button data-type="${t}">${t.replaceAll('_',' ')}</button>`).join('');q('.tabs button').classList.add('active');
 q('.tabs').onclick=e=>{const button=e.target.closest('[data-type]');if(!button)return;type=button.dataset.type;qa('.tabs button').forEach(x=>x.classList.toggle('active',x===button));q('[data-section-title]').textContent=button.textContent;renderEntities();editor()};
 q('[data-pack-list]').onclick=e=>{const button=e.target.closest('[data-pack]');if(button)selectPack(button.dataset.pack).catch(x=>toast(x.message,true))};q('[data-version]').onchange=async e=>{version=e.target.value;await loadEntities()};
 q('[data-entities]').onclick=e=>{const button=e.target.closest('[data-edit]');if(!button)return;const row=entities.find(x=>x.entity_type===type&&x.entity_id===button.dataset.edit);if(row)editor({...row.payload,enabled:!!row.enabled})};
 q('[data-editor]').onsubmit=async e=>{e.preventDefault();try{await post(`/api/admin/diagnostics/packs/${pack}/versions/${version}/entities/${type.toLowerCase()}`,payloadFromForm(e.target));await loadEntities();toast('Draft saved')}catch(x){toast(x.message,true)}};
 q('[data-scenario-form]').onsubmit=async e=>{e.preventDefault();const fd=new FormData(e.target);try{await post(`/api/admin/diagnostics/packs/${pack}/versions/${version}/scenarios`,{id:fd.get('id'),name:fd.get('name'),input:JSON.parse(fd.get('input')),expected:JSON.parse(fd.get('expected'))});await loadScenarios();toast('Scenario saved')}catch(x){toast(x.message,true)}};
 async function loadScenarios(){const data=await api(`/api/admin/diagnostics/packs/${pack}/versions/${version}/scenarios`);q('[data-scenario-list]').innerHTML=data.scenarios.map(x=>`<p><strong>${x.name}</strong> <small>${x.scenario_id}</small></p>`).join('')||'<p>No scenarios yet.</p>'}
 root.onclick=async e=>{if(e.target.matches('[data-remove]'))e.target.parentElement.remove();if(e.target.matches('[data-close]'))e.target.closest('.drawer').hidden=true;const action=e.target.dataset.action;if(!action)return;try{if(action==='add')editor();if(action==='add-condition')addCondition();if(action==='add-band')addBand();if(action==='new-pack')q('[data-pack-dialog]').showModal();if(action==='more')q('[data-menu]').hidden=!q('[data-menu]').hidden;if(action==='clone'){const next=prompt('New semantic version');if(next){await post(`/api/admin/diagnostics/packs/${pack}/versions/${version}/clone`,{version:next});await selectPack(pack)}}if(action==='delete'&&editing&&confirm(`Delete ${editing}?`)){await post(`/api/admin/diagnostics/packs/${pack}/versions/${version}/entities/${type.toLowerCase()}/${editing}/delete`);await loadEntities();toast('Entity deleted')}if(action==='validate'){const d=await post(`/api/admin/diagnostics/packs/${pack}/versions/${version}/validate`);q('[data-validation]').hidden=false;q('[data-validation-summary]').textContent=d.valid?'Ready to simulate and publish':`${d.errors.length} errors`;q('[data-validation-items]').innerHTML=[...d.errors,...d.warnings].map(x=>`<li>${typeof x==='string'?x:JSON.stringify(x)}</li>`).join('');await selectPack(pack)}if(action==='simulate')q('[data-simulator]').hidden=false;if(action==='run-simulation'){const d=await post(`/api/admin/diagnostics/packs/${pack}/versions/${version}/simulate`,JSON.parse(q('[data-simulation-input]').value));q('[data-simulation-output]').textContent=JSON.stringify(d,null,2)}if(action==='scenarios'){q('[data-scenarios]').hidden=false;await loadScenarios()}if(action==='regression'){const d=await post(`/api/admin/diagnostics/packs/${pack}/versions/${version}/regression`);q('[data-validation]').hidden=false;q('[data-validation-summary]').textContent=`${d.passed} passed · ${d.changed} changed · ${d.failed} failed`;q('[data-validation-items]').innerHTML=d.results.map(x=>`<li><strong>${x.status}</strong> ${x.name}</li>`).join('')}if(['publish','activate','archive'].includes(action)){await post(`/api/admin/diagnostics/packs/${pack}/versions/${version}/${action}`);await loadPacks(pack);toast(action==='publish'?'Version published':action==='activate'?'Active version changed':'Version archived')}}catch(x){toast(x.message,true)}};
 q('[data-pack-form]').onsubmit=async e=>{if(e.submitter?.value==='cancel')return;e.preventDefault();const data=Object.fromEntries(new FormData(e.target));try{const result=await post('/api/admin/diagnostics/packs',data);q('[data-pack-dialog]').close();await loadPacks(result.created.pack_id);toast('Pack created')}catch(x){toast(x.message,true)}};
 editor();loadPacks().catch(x=>toast(x.message,true));
})();
</script>
