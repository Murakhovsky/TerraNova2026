<?php
$h = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$failureCode = (int) ($failureCode ?? 500);
$failureTitle = (string) ($failureTitle ?? 'Сталася технічна помилка');
$failureMessage = (string) ($failureMessage ?? 'Спробуйте оновити сторінку трохи пізніше.');
$failureRequestId = (string) ($failureRequestId ?? '');
$failureActionUrl = (string) ($failureActionUrl ?? $this->url->get(''));
$failureActionLabel = (string) ($failureActionLabel ?? 'На головну');
?>
<main class="tn-failure" aria-labelledby="tn-failure-title" data-failure-code="<?php echo $h($failureCode); ?>">
  <section class="tn-failure__card">
    <p class="tn-kicker">Terra Nova · <?php echo $h($failureCode); ?></p>
    <h1 id="tn-failure-title"><?php echo $h($failureTitle); ?></h1>
    <p class="tn-failure__message"><?php echo $h($failureMessage); ?></p>
    <div class="tn-failure__actions">
      <a class="tn-ui-button tn-ui-button--primary" href="<?php echo $h($failureActionUrl); ?>"><?php echo $h($failureActionLabel); ?></a>
      <?php if ($failureActionUrl !== $this->url->get('')): ?>
        <a class="tn-ui-button" href="<?php echo $h($this->url->get('')); ?>">На головну</a>
      <?php endif; ?>
    </div>
    <?php if ($failureRequestId !== ''): ?>
      <p class="tn-failure__request">Код звернення: <code><?php echo $h($failureRequestId); ?></code></p>
    <?php endif; ?>
  </section>
</main>
