];
$selected = fn($actual, $expected) => (string) $actual === (string) $expected ? 'selected' : '';
$checkedValue = fn($value) => $value === null ? '' : (string) $value;
$money = function ($amount, $currency): string {
    if ($amount === null || $amount === '') {
        return 'не задано';
    }

    return number_format((float) $amount, 0, '.', ' ') . ' ' . (string) $currency;
};
$statusTone = static function (string $status): string {
    return match ($status) {
        'active' => 'positive',
        'paused' => 'warning',
        'lost' => 'danger',
        default => 'neutral',
    };
};
$stageTone = static function (string $stage): string {
    return match ($stage) {
        'deal', 'aftercare', 'repeat' => 'positive',
        'paused' => 'warning',
        'lost' => 'danger',
        'qualification', 'need_defined', 'matching', 'viewing', 'negotiation' => 'info',
        default => 'neutral',
    };
};
