    'need_defined' => 'Потреба визначена',
    'matching' => 'Підбір',
    'viewing' => 'Покази',
    'negotiation' => 'Перемовини',
    'deal' => 'Угода',
    'aftercare' => 'Післяугодний супровід',
    'repeat' => 'Повторний цикл',
    'paused' => 'Пауза',
    'lost' => 'Втрачено',
];
$typeLabels = [
    'buy' => 'Купівля',
    'sell' => 'Продаж',
    'rent' => 'Оренда',
    'lease_out' => 'Здача',
    'repair' => 'Ремонт',
    'investment' => 'Інвестиція',
    'management' => 'Управління',
    'inheritance' => 'Спадщина',
    'other' => 'Інше',
];
$statusLabels = ['active' => 'Активний', 'paused' => 'Пауза', 'closed' => 'Закритий', 'lost' => 'Втрачено'];
$priorityLabels = ['low' => 'Низький', 'normal' => 'Звичайний', 'high' => 'Високий', 'urgent' => 'Терміновий'];
$intentLabels = [
    'general_contact' => 'Загальний контакт',
    'presentation' => 'Презентація',
    'viewing' => 'Перегляд',
    'similar_search' => 'Підібрати схожий',
];
$selected = fn($actual, $expected) => (string) $actual === (string) $expected ? 'selected' : '';
$money = function ($amount, $currency): string {
    if ($amount === null || $amount === '') return 'не задано';
    return number_format((float) $amount, 0, '.', ' ') . ' ' . (string) $currency;
};
$stageTone = static function (string $stage): string {
    return match ($stage) {
        'deal', 'aftercare', 'repeat' => 'positive',
        'paused' => 'warning',
        'lost' => 'danger',
        'qualification', 'need_defined', 'matching', 'viewing', 'negotiation' => 'accent',
        default => 'neutral',
    };
};
$casesByStage = array_fill_keys(array_keys($stageLabels), []);
foreach ($cases as $caseItem) {
    $stage = (string) ($caseItem['stage'] ?? 'new');
    if (!array_key_exists($stage, $casesByStage)) $stage = 'new';
    $casesByStage[$stage][] = $caseItem;
}
$tabItems = [[
    'key' => 'all',
    'label' => 'Усі · ' . (int) ($stats['all'] ?? 0),
    'href' => 'client-case',
    'active' => ($filters['stage'] ?? '') === '',
]];
foreach ($stageLabels as $code => $label) {
    $tabItems[] = [
        'key' => $code,
        'label' => $label . ' · ' . (int) ($stats[$code] ?? 0),
        'href' => 'client-case?stage=' . $code,
        'active' => ($filters['stage'] ?? '') === $code,
    ];
}
$managerFilterOptions = ['0' => 'Усі'];
foreach ($managerOptions as $manager) $managerFilterOptions[(string) $manager['id']] = (string) ($manager['full_name'] ?: $manager['email']);
?>

