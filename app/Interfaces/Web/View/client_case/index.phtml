$actionStatus = $actionStatus ?? null;
$pipelineStages = $pipelineStages ?? [];
$stageLabels = [
    'new' => 'Новий',
    'qualification' => 'Кваліфікація',
    'need_defined' => 'Потреба визначена',
    'matching' => 'Підбір',
    'viewing' => 'Покази',
    'negotiation' => 'Перемовини',
    'deal' => 'Угода',
    'aftercare' => 'Післяугодний супровід',
    'repeat' => 'Повторний цикл',
    'paused' => 'Пауза',
    'lost' => 'Втрачено',
];
$typeLabels = [
    'buy' => 'Купівля',
    'sell' => 'Продаж',
    'rent' => 'Оренда',
    'lease_out' => 'Здача',
    'repair' => 'Ремонт',
    'investment' => 'Інвестиція',
    'management' => 'Управління',
    'inheritance' => 'Спадщина',
    'other' => 'Інше',
];
$statusLabels = ['active' => 'Активний', 'paused' => 'Пауза', 'closed' => 'Закритий', 'lost' => 'Втрачено'];
$priorityLabels = ['low' => 'Низький', 'normal' => 'Звичайний', 'high' => 'Високий', 'urgent' => 'Терміновий'];
$intentLabels = [
    'general_contact' => 'Загальний контакт',
    'presentation' => 'Презентація',
    'viewing' => 'Перегляд',
    'similar_search' => 'Підібрати схожий',
];
$selected = fn($actual, $expected) => (string) $actual === (string) $expected ? 'selected' : '';
$money = function ($amount, $currency): string {
    if ($amount === null || $amount === '') return 'не задано';
    return number_format((float) $amount, 0, '.', ' ') . ' ' . (string) $currency;
};
$stageTone = static function (string $stage): string {
    return match ($stage) {
        'deal', 'aftercare', 'repeat' => 'positive',
        'paused' => 'warning',
        'lost' => 'danger',
        'qualification', 'need_defined', 'matching', 'viewing', 'negotiation' => 'accent',
        default => 'neutral',
    };
};
$casesByStage = array_fill_keys(array_keys($stageLabels), []);
foreach ($cases as $caseItem) {
    $stage = (string) ($caseItem['stage'] ?? 'new');
    if (!array_key_exists($stage, $casesByStage)) $stage = 'new';
    $casesByStage[$stage][] = $caseItem;
}
$tabItems = [[
    'key' => 'all',
    'label' => 'Усі · ' . (int) ($stats['all'] ?? 0),
    'href' => 'client-case',
    'active' => ($filters['stage'] ?? '') === '',
]];
foreach ($stageLabels as $code => $label) {
    $tabItems[] = [
        'key' => $code,
        'label' => $label . ' · ' . (int) ($stats[$code] ?? 0),
        'href' => 'client-case?stage=' . $code,
        'active' => ($filters['stage'] ?? '') === $code,
    ];
}
$activeTab = (string) (($filters['stage'] ?? '') ?: 'all');
$managerFilterOptions = ['0' => 'Усі'];
foreach ($managerOptions as $manager) $managerFilterOptions[(string) $manager['id']] = (string) ($manager['full_name'] ?: $manager['email']);

$quickStageOptions = [];
foreach ($pipelineStages as $stage) {
    if (!is_array($stage)) continue;
    $quickStageOptions[(string) ($stage['id'] ?? '')] = (string) ($stage['name'] ?? $stage['id'] ?? '');
}
$quickManagerOptions = ['0' => 'Без менеджера'];
foreach ($managerOptions as $manager) {
    if (!is_array($manager)) continue;
    $quickManagerOptions[(string) ($manager['id'] ?? 0)] = (string) (($manager['full_name'] ?? '') ?: ($manager['email'] ?? ''));
}

$caseRows = [];
foreach ($cases as $caseItem) {
    if (!is_array($caseItem)) continue;
    $caseId = (int) ($caseItem['id'] ?? 0);
    $formId = 'case-quick-form-' . $caseId;
    $caseType = (string) ($caseItem['type'] ?? '');
    $priority = (string) ($caseItem['priority'] ?? '');
    $propertyContext = trim(
        (string) ($caseItem['property_type_name'] ?? '')
        . (!empty($caseItem['location_city']) ? ' · ' . (string) $caseItem['location_city'] : ''),
        ' ·'
    );
    $managerName = (string) (($caseItem['manager_name'] ?? '') ?: 'не призначено');
    $caseRows[] = [
        '_form' => [
            'id' => $formId,
            'action' => 'client-case/quickUpdate/' . $caseId,
            'method' => 'post',
            'hidden' => [
                'csrf_token' => (string) ($csrfToken ?? ''),
                'return_url' => 'client-case',
            ],
        ],
        'case' => [
            'primary' => (string) ($caseItem['title'] ?? ''),
            'secondary' => trim(
                (string) ($caseItem['public_id'] ?? '')
                . ' · ' . (string) ($typeLabels[$caseType] ?? $caseType)
                . ' · ' . (string) ($priorityLabels[$priority] ?? $priority)
                . ($propertyContext !== '' ? ' · ' . $propertyContext : '')
                . ' · Менеджер: ' . $managerName,
                ' ·'
            ),
        ],
        'person' => [
            'primary' => (string) ($caseItem['full_name'] ?? ''),
            'secondary' => (string) (($caseItem['phone'] ?? '') ?: ($caseItem['email'] ?? '') ?: ($caseItem['telegram'] ?? '') ?: 'контакт не вказано'),
        ],
        'stage' => [
            'kind' => 'stage',
            'label' => (string) ($stageLabels[(string) ($caseItem['stage'] ?? '')] ?? ($caseItem['stage'] ?? '')),
            'tone' => $stageTone((string) ($caseItem['stage'] ?? '')),
        ],
        'budget' => $money($caseItem['budget_max'] ?? null, $caseItem['currency'] ?? 'USD'),
        'relations' => [
            'primary' => (int) ($caseItem['inquiry_count'] ?? 0) . ' заявок',
            'secondary' => (int) ($caseItem['match_count'] ?? 0) . ' підборів',
        ],
        'next_contact' => [
            'primary' => (string) (($caseItem['next_contact_at'] ?? '') ?: 'не задано'),
            'secondary' => (int) ($caseItem['activity_count'] ?? 0) . ' дій',
        ],
        'workflow' => [
            'kind' => 'fields',
            'items' => [
                ['name' => 'stage_id', 'type' => 'select', 'value' => (string) ($caseItem['stage_id'] ?? ''), 'options' => $quickStageOptions, 'ariaLabel' => 'Етап'],
                ['name' => 'status', 'type' => 'select', 'value' => (string) ($caseItem['status'] ?? ''), 'options' => $statusLabels, 'ariaLabel' => 'Статус'],
                ['name' => 'priority', 'type' => 'select', 'value' => $priority, 'options' => $priorityLabels, 'ariaLabel' => 'Пріоритет'],
                ['name' => 'assigned_user_id', 'type' => 'select', 'value' => (string) ($caseItem['assigned_user_id'] ?? 0), 'options' => $quickManagerOptions, 'ariaLabel' => 'Відповідальний'],
            ],
        ],
        '_actions' => [
            ['kind' => 'submit', 'label' => 'ОК', 'variant' => 'primary'],
            ['kind' => 'link', 'label' => 'Відкрити', 'href' => 'client-case/show/' . $caseId, 'variant' => 'ghost'],
        ],
    ];
}
