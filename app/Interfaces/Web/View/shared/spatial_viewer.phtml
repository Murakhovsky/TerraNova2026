<?php
$h = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
$scene = $scene ?? [];
$viewer = $scene['viewer'] ?? [];
$embedded = (bool) ($embedded ?? false);
$showHeading = (bool) ($showHeading ?? true);
?>
<section class="tn-spatial-stage<?php echo $embedded ? ' tn-spatial-stage--embedded' : ''; ?>" id="tour">
  <?php if ($showHeading): ?>
    <div class="tn-spatial-stage__heading">
      <p class="tn-kicker">Spatial presentation</p>
      <h1><?php echo $h($scene['title'] ?? '3D-сцена'); ?></h1>
      <span><?php echo $h($scene['scene_type'] ?? 'model'); ?> / <?php echo $h($scene['provider'] ?? 'native'); ?></span>
    </div>
  <?php endif; ?>
  <div
    class="tn-spatial-viewer"
    data-spatial-viewer
    data-scene="<?php echo $h($scene['public_id'] ?? ''); ?>"
    data-endpoint="<?php echo $this->url->get('api/spatial/scenes/' . ($scene['public_id'] ?? '')); ?>"
  >
    <?php if (!empty($viewer['poster_url'])): ?>
      <img class="tn-spatial-viewer__poster" src="<?php echo $h($viewer['poster_url']); ?>" alt="<?php echo $h($scene['title'] ?? '3D-сцена'); ?>">
    <?php endif; ?>
    <div class="tn-spatial-viewer__status" data-spatial-status>Завантаження 3D-сцени</div>
    <div class="tn-spatial-viewer__hotspots" data-spatial-hotspots></div>
  </div>
  <div class="tn-spatial-stage__actions">
    <button type="button" data-spatial-reset>Початковий ракурс</button>
    <button type="button" data-spatial-fullscreen>На весь екран</button>
    <?php if (!empty($viewer['ar_url'])): ?><a href="<?php echo $h($viewer['ar_url']); ?>" rel="ar">Відкрити в AR</a><?php endif; ?>
  </div>
</section>
