<?php
$text = $text ?? 'Terra Nova CLUB — нерухомість, продаж, підбір і партнерська робота з об’єктами в одному публічному контурі.';
$links = $links ?? [
    ['path' => 'property/catalog', 'label' => 'Нерухомість'],
    ['path' => 'services', 'label' => 'Послуги'],
    ['path' => 'partners', 'label' => 'Партнерам'],
    ['path' => 'terra-nova', 'label' => 'Terra Nova'],
    ['path' => 'cos/en', 'label' => 'COS'],
    ['path' => 'contacts', 'label' => 'Контакти'],
    ['path' => 'property/submit', 'label' => 'Подати об’єкт'],
];
$href = function (string $path): string {
    if ($path === '' || $path === '/') {
        return $this->url->get();
    }

    if (str_starts_with($path, '#') || str_starts_with($path, 'http://') || str_starts_with($path, 'https://') || str_starts_with($path, 'tel:') || str_starts_with($path, 'mailto:')) {
        return $path;
    }

    return $this->url->get($path);
};
?>
<footer class="tn-footer tn-public-footer" data-interface-surface="public">
  <div>
    <a href="<?php echo $this->url->get(); ?>"><strong>Terra Nova CLUB</strong></a>
    <p><?php echo htmlspecialchars((string) $text, ENT_QUOTES, 'UTF-8'); ?></p>
  </div>
  <nav class="tn-footer__links" aria-label="Додаткова навігація">
    <?php foreach ($links as $link): ?>
      <a href="<?php echo $href((string) $link['path']); ?>"><?php echo htmlspecialchars((string) $link['label'], ENT_QUOTES, 'UTF-8'); ?></a>
    <?php endforeach; ?>
  </nav>
</footer>
