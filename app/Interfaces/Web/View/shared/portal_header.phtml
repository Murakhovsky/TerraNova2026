<?php

$active = (string) ($active ?? 'cabinet');
$brandSuffix = (string) ($brandSuffix ?? 'PORTAL');
$role = (string) ($role ?? ($portalRole ?? 'buyer'));
$currentUser = $user ?? null;

$currentUser = is_array($currentUser ?? $user ?? null) ? ($currentUser ?? $user) : null;
$navigation = is_array($portalNavigation ?? null)
    ? $portalNavigation
    : ['primary' => [], 'utility' => []];
$href = function (string $path): string {
    $fragment = '';
    $fragmentPosition = strpos($path, '#');
    if ($fragmentPosition !== false) {
        $fragment = substr($path, $fragmentPosition);
        $path = substr($path, 0, $fragmentPosition);
    }

    $url = ($path === '' || $path === '/')
        ? $this->url->get()
        : $this->url->get($path);

    return $url . $fragment;
};
$h = static fn($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<header class="tn-portal-header" data-interface-surface="portal" data-portal-header>
  <div class="tn-portal-header__inner">
    <a class="tn-portal-brand" href="<?php echo $href('cabinet'); ?>" aria-label="Terra Nova <?php echo $h($brandSuffix); ?>">
      <span class="tn-portal-brand__mark" aria-hidden="true">TN</span>
      <span class="tn-portal-brand__text"><strong>Terra Nova</strong><small><?php echo $h($brandSuffix); ?></small></span>
    </a>

    <button
      class="tn-portal-menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="portal-menu"
      aria-label="Відкрити навігацію"
      data-portal-menu-button
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="tn-portal-nav" id="portal-menu" aria-label="Навігація порталу" data-portal-menu>
      <?php foreach ($navigation['primary'] ?? [] as $item): ?>
        <?php $itemKey = (string) ($item['key'] ?? ''); ?>
        <a
          class="<?php echo $active === $itemKey ? 'is-active' : ''; ?>"
          href="<?php echo $href((string) ($item['path'] ?? '')); ?>"
          <?php echo $active === $itemKey ? 'aria-current="page"' : ''; ?>
        >
          <?php echo $h($item['label'] ?? ''); ?>
        </a>
      <?php endforeach; ?>
    </nav>

    <div class="tn-portal-identity">
      <span class="tn-portal-identity__avatar" aria-hidden="true">
        <?php echo $h(mb_strtoupper(mb_substr((string) ($currentUser['full_name'] ?? 'U'), 0, 1))); ?>
      </span>
      <span class="tn-portal-identity__copy">
        <strong><?php echo $h($currentUser['full_name'] ?? 'Користувач'); ?></strong>
        <small><?php echo $h($currentUser['email'] ?? ''); ?></small>
      </span>
    </div>
  </div>
</header>
