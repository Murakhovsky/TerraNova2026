<?php

use Interfaces\Web\Navigation\FrontendNavigation;

$active = (string) ($active ?? '');
$brandSuffix = (string) ($brandSuffix ?? 'CLUB');
$currentUser = null;
$authService = null;
try {
    $authService = $this->getDI()->getShared('authService');
    $currentUser = $authService->currentUser();
} catch (Throwable $e) {
    $currentUser = null;
    $authService = null;
}

$role = (string) ($currentUser['role'] ?? '');
$isTeam = FrontendNavigation::isTeam($role);

if ($currentUser && $authService) {
    try {
        $isTeam = $authService->isManager($currentUser);
        if ($isTeam) {
            $role = $authService->isAdmin($currentUser) ? 'admin' : 'manager';
        }
    } catch (Throwable $e) {
        // Fall back to the account role so navigation still renders if the
        // organization membership lookup is temporarily unavailable.
        $isTeam = FrontendNavigation::isTeam($role);
    }
}

$href = function (string $path): string {
    $fragment = '';
    $fragmentPosition = strpos($path, '#');
    if ($fragmentPosition !== false) {
        $fragment = substr($path, $fragmentPosition);
        $path = substr($path, 0, $fragmentPosition);
    }

    $url = ($path === '' || $path === '/')
        ? $this->url->get()
        : $this->url->get($path);

    return $url . $fragment;
};

if ($isTeam) {
    $navigation = FrontendNavigation::workspace($role);
    $activeSection = FrontendNavigation::activeSection($active);
    $this->partial('components/workspace_sidebar', [
        'navigation' => $navigation,
        'active' => $active,
        'activeSection' => $activeSection,
        'href' => $href,
    ]);
    $this->partial('components/workspace_topbar', [
        'navigation' => $navigation,
        'activeSection' => $activeSection,
        'role' => $role,
        'href' => $href,
    ]);
    $this->partial('components/workspace_mobile_nav', [
        'navigation' => $navigation,
        'activeSection' => $activeSection,
        'href' => $href,
    ]);
    return;
}

$navigation = FrontendNavigation::portal($role);
?>
<header class="tn-header tn-portal-header" data-header data-interface-surface="portal">
  <a class="tn-logo" href="<?php echo $href('cabinet'); ?>" aria-label="Terra Nova <?php echo htmlspecialchars($brandSuffix, ENT_QUOTES, 'UTF-8'); ?>">
    <span class="tn-logo__mark">TN</span>
    <span class="tn-logo__text"><strong>Terra Nova</strong><small><?php echo htmlspecialchars($brandSuffix, ENT_QUOTES, 'UTF-8'); ?></small></span>
  </a>
  <button class="tn-menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button><span></span><span></span><span></span></button>
  <nav class="tn-nav" id="site-menu" aria-label="Навігація кабінету">
    <?php foreach ($navigation['primary'] ?? [] as $item): ?>
      <a class="<?php echo $active === ($item['key'] ?? '') ? 'is-active' : ''; ?>" href="<?php echo $href((string) ($item['path'] ?? '')); ?>" <?php echo $active === ($item['key'] ?? '') ? 'aria-current="page"' : ''; ?>>
        <?php echo htmlspecialchars((string) ($item['label'] ?? ''), ENT_QUOTES, 'UTF-8'); ?>
      </a>
    <?php endforeach; ?>
  </nav>
</header>
