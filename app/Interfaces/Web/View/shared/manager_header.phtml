<?php
$active = $active ?? '';
$brandSuffix = $brandSuffix ?? 'CLUB';
$currentUser = null;
try {
    $currentUser = $this->getDI()->getShared('authService')->currentUser();
} catch (Throwable $e) {
    $currentUser = null;
}
$role = (string) ($currentUser['role'] ?? '');
$isTeam = in_array($role, ['manager', 'admin'], true);
$hasListing = in_array($role, ['manager', 'admin', 'realtor', 'partner', 'developer'], true);
$canSubmit = in_array($role, ['seller', 'realtor', 'developer', 'partner', 'manager', 'admin'], true);

if ($isTeam) {
    $navItems = [
        ['key' => 'sales', 'path' => 'sales/dashboard', 'label' => 'Sales'],
        ['key' => 'today', 'path' => 'sales/today', 'label' => 'Today'],
        ['key' => 'pipeline', 'path' => 'sales/pipeline', 'label' => 'Pipeline'],
        ['key' => 'admin', 'path' => 'admin', 'label' => 'Огляд'],
        ['key' => 'objects', 'path' => 'property/manage', 'label' => 'Обʼєкти'],
        ['key' => 'listing', 'path' => 'property/listing', 'label' => 'Listing'],
        ['key' => 'submissions', 'path' => 'property/submissions', 'label' => 'Модерація'],
        ['key' => 'inbox', 'path' => 'client-case/inbox', 'label' => 'Заявки'],
        ['key' => 'cases', 'path' => 'client-case', 'label' => 'Кейси'],
        ['key' => 'analytics', 'path' => 'admin/analytics', 'label' => 'Аналітика'],
        ['key' => 'content', 'path' => 'admin/content', 'label' => 'Контент'],
        ['key' => 'spatial', 'path' => 'spatial/manage', 'label' => '3D'],
        ['key' => 'catalog', 'path' => 'property/catalog', 'label' => 'Каталог'],
        ['key' => 'cabinet', 'path' => 'cabinet', 'label' => 'Кабінет'],
        ['key' => 'cos', 'path' => 'cos/control-center', 'label' => 'COS'],
    ];
} else {
    $navItems = [
        ['key' => 'catalog', 'path' => 'property/catalog', 'label' => 'Каталог'],
        ['key' => 'favour', 'path' => 'property/favour', 'label' => 'Вибрані'],
    ];
    if ($hasListing) {
        $navItems[] = ['key' => 'listing', 'path' => 'property/listing', 'label' => 'Listing'];
    }
    if ($canSubmit) {
        $navItems[] = ['key' => 'submit', 'path' => 'property/submit', 'label' => 'Подати'];
    }
    $navItems[] = ['key' => 'cabinet', 'path' => 'cabinet', 'label' => 'Кабінет'];
}

if ($role === 'admin') {
    array_splice($navItems, 6, 0, [['key' => 'users', 'path' => 'admin/users', 'label' => 'Користувачі']]);
}
$href = function (string $path): string {
    if ($path === '' || $path === '/') {
        return $this->url->get();
    }

    return $this->url->get($path);
};
?>

<header class="tn-header" data-header>
  <a class="tn-logo" href="<?php echo $href('cabinet'); ?>" aria-label="Terra Nova CLUB">
    <span class="tn-logo__mark">TN</span>
    <span class="tn-logo__text"><strong>Terra Nova</strong><small><?php echo htmlspecialchars((string) $brandSuffix, ENT_QUOTES, 'UTF-8'); ?></small></span>
  </a>
  <button class="tn-menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button><span></span><span></span><span></span></button>
  <nav class="tn-nav" id="site-menu" aria-label="Меню керування">
    <?php foreach ($navItems as $item): ?>
      <a class="<?php echo $active === $item['key'] ? 'is-active' : ''; ?>" href="<?php echo $href($item['path']); ?>"><?php echo $item['label']; ?></a>
    <?php endforeach; ?>
  </nav>
</header>
