<?php

use Interfaces\Web\Navigation\FrontendNavigation;

$active = (string) ($active ?? '');
$actions = $actions ?? [];
$navItems = FrontendNavigation::public();
$href = function (string $path): string {
    if ($path === '' || $path === '/') {
        return $this->url->get();
    }

    if (str_starts_with($path, '#') || str_starts_with($path, 'http://') || str_starts_with($path, 'https://') || str_starts_with($path, 'tel:') || str_starts_with($path, 'mailto:')) {
        return $path;
    }

    return $this->url->get($path);
};
?>
<header class="tn-header tn-public-header" data-header data-interface-surface="public">
  <a class="tn-logo" href="<?php echo $this->url->get(); ?>" aria-label="Terra Nova CLUB">
    <span class="tn-logo__mark">TN</span>
    <span class="tn-logo__text"><strong>Terra Nova</strong><small>CLUB</small></span>
  </a>
  <button class="tn-menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button><span></span><span></span><span></span></button>
  <nav class="tn-nav" id="site-menu" aria-label="Головне меню">
    <?php foreach ($navItems as $item): ?>
      <a class="<?php echo $active === $item['key'] ? 'is-active' : ''; ?>" href="<?php echo $href($item['path']); ?>" <?php echo $active === $item['key'] ? 'aria-current="page"' : ''; ?>><?php echo htmlspecialchars($item['label'], ENT_QUOTES, 'UTF-8'); ?></a>
    <?php endforeach; ?>
  </nav>
  <?php if ($actions): ?>
    <div class="tn-header-actions">
      <?php foreach ($actions as $action): ?>
        <a class="tn-btn <?php echo htmlspecialchars((string) ($action['class'] ?? 'tn-btn--ghost'), ENT_QUOTES, 'UTF-8'); ?>" href="<?php echo $href((string) ($action['href'] ?? '')); ?>"><?php echo htmlspecialchars((string) ($action['label'] ?? ''), ENT_QUOTES, 'UTF-8'); ?></a>
      <?php endforeach; ?>
    </div>
  <?php endif; ?>
</header>
