<!DOCTYPE html>
<html lang="<?php echo htmlspecialchars((string) ($lang ?? 'uk'), ENT_QUOTES, 'UTF-8'); ?>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <?php
      $pageTitle = $metaTitle ?? 'Terra Nova CLUB | Каталог нерухомості';
      $pageDescription = $metaDescription ?? 'Terra Nova CLUB - каталог нерухомості для купівлі, оренди, інвестицій, подачі обʼєктів і ручної добірки менеджером.';
      $pageScheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
      $pageHost = $_SERVER['HTTP_HOST'] ?? '127.0.0.1:8001';
      $pageRoot = $pageScheme . '://' . $pageHost . '/';
      $pageImage = $metaImage ?? 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=82';
      $pageUrl = $metaUrl ?? $pageRoot;
      $pageType = $metaType ?? 'website';
      $requestPath = '/' . ltrim((string) parse_url((string) ($_SERVER['REQUEST_URI'] ?? '/'), PHP_URL_PATH), '/');
      $isPrivatePage = preg_match('#^/(admin|auth|cabinet|client-case|sales)(/|$)|^/cos/control-center(/|$)|^/property/(manage|listing|edit|add|submissions|submission|group|moderate|media|note)(/|$)#', $requestPath) === 1;
      $pageRobots = $metaRobots ?? ($isPrivatePage ? 'noindex,nofollow' : 'index,follow');
      $analyticsPropertyId = (int) ($analyticsPropertyId ?? 0);
      $pageAssetEntries = $pageAssetEntries ?? [];
      $workspaceSection = trim((string) ($workspaceSection ?? ''));
      $assetEntries = array_merge(['terranova-club', 'terranova-interface'], !empty($cosSite) ? ['cos-site'] : [], $pageAssetEntries);
      $assets = di('viteAssetManifest')->assets($assetEntries);
      $escape = static fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
    ?>
    <meta name="description" content="<?php echo $escape($pageDescription); ?>">
    <meta name="robots" content="<?php echo $escape($pageRobots); ?>">
    <meta name="theme-color" content="#111714">
    <meta property="og:type" content="<?php echo $escape($pageType); ?>">
    <meta property="og:title" content="<?php echo $escape($pageTitle); ?>">
    <meta property="og:description" content="<?php echo $escape($pageDescription); ?>">
    <meta property="og:image" content="<?php echo $escape($pageImage); ?>">
    <meta property="og:url" content="<?php echo $escape($pageUrl); ?>">
    <meta property="og:locale" content="uk_UA">
    <meta property="og:site_name" content="Terra Nova CLUB">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<?php echo $escape($pageTitle); ?>">
    <meta name="twitter:description" content="<?php echo $escape($pageDescription); ?>">
    <meta name="twitter:image" content="<?php echo $escape($pageImage); ?>">
    <link rel="canonical" href="<?php echo $escape($pageUrl); ?>">

    <title><?php echo $escape($pageTitle); ?></title>

    <?php foreach ($assets['styles'] as $assetStyle): ?>
      <link rel="stylesheet" href="<?php echo $escape($assetStyle); ?>">
    <?php endforeach; ?>
    <link rel="shortcut icon" type="image/x-icon" href="<?php echo $this->url->get('img/favicon.ico'); ?>">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "RealEstateAgent",
        "name": "Terra Nova CLUB",
        "description": "Публічний портал екосистеми Terra Nova для нерухомості, девелопменту, інвестицій та технологій.",
        "areaServed": ["Львів", "Київ", "Варшава", "Краків", "Вроцлав", "Париж", "Рим", "Будва"]
      }
    </script>
  </head>
  <body class="<?php echo !empty($cosSite) ? 'cos-site' : ''; ?>">
    <?php if ($workspaceSection !== ''): ?>
      <?php $this->partial('shared/manager_header', ['active' => $workspaceSection]); ?>
    <?php endif; ?>

    <?php echo $this->getContent(); ?>

    <?php foreach ($assets['scripts'] as $assetScript): ?>
      <script type="module" src="<?php echo $escape($assetScript); ?>"></script>
    <?php endforeach; ?>
  </body>
</html>
