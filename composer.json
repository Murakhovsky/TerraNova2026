{
  "name": "terranova/cos",
  "description": "Terra Nova COS SaaS platform",
  "type": "project",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "Kernel\\": "app/Kernel/",
      "Platform\\": "app/Platform/",
      "Domains\\": "app/Domains/",
      "Infrastructure\\": "app/Infrastructure/",
      "Interfaces\\": "app/Interfaces/",
      "Bootstrap\\": "app/Bootstrap/"
    },
    "exclude-from-classmap": [
      "/app/Interfaces/Telegram/Command/UserCommands/SearchAdvertsCommand.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "longman/telegram-bot": "^0.83.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "config": {
    "platform": {
      "php": "8.2.33"
    },
    "sort-packages": true
  }
}
